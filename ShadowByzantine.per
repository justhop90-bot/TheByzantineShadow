; ============================================================
; THE BYZANTINE SHADOW -- root entrypoint
; ============================================================
;
; Pass 1 loads the minimum clean dependency surface for one
; complete economic transaction plus the authenticated donor
; slices (strategy bootstrap, tech/production, construction)
; and the Byzantine UU doctrine.
;
; The older 05-15 modules remain in the repository as historical
; scaffolding. They are NOT loaded here because several are
; incomplete and/or represent parallel implementations of the
; transaction lifecycle. Loading them would create competing
; writers and destroy the forensic boundary of this pass.
;
; Runtime objective:
;   Byzantine Spearman x1.
;
; Transaction chain:
;   objective -> progression -> capital -> escrow -> authority
;   -> baseline -> execution -> world verification -> release
;   -> release observation -> idle.
;
; Load order is donor-relative where donor slices are concerned
; (03a tech/production precedes 03b strategy precedes 04
; construction) and dependency order otherwise (constants and
; state before all consumers).
;
; ============================================================

(load "ShadowByzantine/01_constants")
(load "ShadowByzantine/01a_shadow_r07_compat")
(load "ShadowByzantine/01b_byz_constants")
(load "ShadowByzantine/02_state")
(load "ShadowByzantine/02b_donor_scouting")
(load "ShadowByzantine/03_economy")
(load "ShadowByzantine/03a_donor_tech_production")
(load "ShadowByzantine/03b_strategy_bootstrap")
(load "ShadowByzantine/03c_byzantine_uu_doctrine")
(load "ShadowByzantine/03d_donor_boot_init")
(load "ShadowByzantine/03e_donor_explorers")
(load "ShadowByzantine/04_construction")

; ------------------------------------------------------------
; PASS 1 TRANSACTION KERNEL
; ------------------------------------------------------------
(load "ShadowByzantine/16_pass1_transaction")

; ============================================================
; END PASS 1 RUNTIME GRAPH
; ============================================================
