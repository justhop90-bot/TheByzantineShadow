; ============================================================
; THE BYZANTINE SHADOW
; MODULE 10 -- ESCROW
; ============================================================
;
; Authority: protected-capital lifecycle for an active construction
; obligation.
;
; IMPORTANT DISTINCTION:
;   BYZ-ESCROW-STATE = lifecycle / commitment state
;   BYZ-ESCROW-MODE  = engine command mode consumed by Module 12
;
; Numeric escrow percentages/caps remain policy-owned and are NOT
; synthesized here. A policy provider must establish a valid engine
; percentage/cap before BYZ-ESCROW-POLICY-APPLIED becomes true.
; ============================================================

; ------------------------------------------------------------
; INITIALIZATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-ESCROW-STATE -1)
=>
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-IDLE)
    (set-goal BYZ-ESCROW-RELEASE-REQUEST BYZ-ESCROW-RELEASE-NO)
    (set-goal BYZ-ESCROW-COMMIT-REQUEST BYZ-ESCROW-COMMIT-NO)
    (set-goal BYZ-ESCROW-RECONCILIATION BYZ-ESCROW-RECONCILE-NONE)
    (set-goal BYZ-ESCROW-MODE BYZ-ESCROW-EXCLUDED)
)

; ------------------------------------------------------------
; RESERVATION REQUEST
; ------------------------------------------------------------
; Capital feasibility and requirements are upstream observations. This
; module converts a qualified construction obligation into a reservation
; request; it does not invent the economic policy.
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-QUALIFIED)
    (goal BYZ-CONSTRUCTION-REQUIREMENTS BYZ-REQUIREMENTS-READY)
    (goal BYZ-CAPITAL-STATE BYZ-CAPITAL-SUFFICIENT)
    (goal BYZ-ESCROW-POLICY-APPLIED 1)
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-IDLE)
=>
    (set-goal BYZ-ESCROW-COMMIT-REQUEST BYZ-ESCROW-COMMIT-YES)
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-REQUESTED)
)

(defrule
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-REQUESTED)
    (goal BYZ-ESCROW-COMMIT-REQUEST BYZ-ESCROW-COMMIT-YES)
=>
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-RESERVING)
)

; ------------------------------------------------------------
; COMMITMENT CONFIRMATION
; ------------------------------------------------------------
; Policy application is an explicit upstream contract. This rule does
; not assign the percentage; it only records that a policy provider has
; made one available to the executor.
(defrule
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-RESERVING)
    (goal BYZ-ESCROW-POLICY-APPLIED 1)
=>
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-COMMITTED)
    (set-goal BYZ-ESCROW-COMMIT-REQUEST BYZ-ESCROW-COMMIT-NO)
)

; ------------------------------------------------------------
; RELEASE REQUEST
; ------------------------------------------------------------
(defrule
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-COMMITTED)
    (goal BYZ-ESCROW-RELEASE-REQUEST BYZ-ESCROW-RELEASE-YES)
=>
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-RELEASE-REQUESTED)
)

; ------------------------------------------------------------
; RELEASE COMMAND / IN-FLIGHT STATE
; ------------------------------------------------------------
; The engine command is a request, not proof of release.
(defrule
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-RELEASE-REQUESTED)
=>
    (up-release-escrow)
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-RELEASING)
    (set-goal BYZ-ESCROW-RECONCILIATION BYZ-ESCROW-RECONCILE-PENDING)
)

; ------------------------------------------------------------
; RECONCILIATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-RELEASING)
    (goal BYZ-ESCROW-RECONCILIATION BYZ-ESCROW-RECONCILE-PENDING)
=>
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-RECONCILING)
)

; Exact zero is the engine-empty state. This is not a policy threshold.
(defrule
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-RECONCILING)
    (escrow-amount food == 0)
    (escrow-amount wood == 0)
    (escrow-amount gold == 0)
    (escrow-amount stone == 0)
=>
    (set-goal BYZ-ESCROW-RECONCILIATION BYZ-ESCROW-RECONCILE-CONFIRMED)
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-RELEASED)
)

; Contradictory observation is not success.
(defrule
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-RECONCILING)
    (goal BYZ-ESCROW-RECONCILIATION BYZ-ESCROW-RECONCILE-CONTRADICTED)
=>
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-RECOVERY)
)

; Preserve RELEASED until the construction transaction has actually
; left the lifecycle. This prevents immediate repeated release requests.
(defrule
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-RELEASED)
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-IDLE)
=>
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-IDLE)
    (set-goal BYZ-ESCROW-RELEASE-REQUEST BYZ-ESCROW-RELEASE-NO)
    (set-goal BYZ-ESCROW-COMMIT-REQUEST BYZ-ESCROW-COMMIT-NO)
    (set-goal BYZ-ESCROW-RECONCILIATION BYZ-ESCROW-RECONCILE-NONE)
    (set-goal BYZ-ESCROW-MODE BYZ-ESCROW-EXCLUDED)
)

; INVARIANTS:
; release command != release completion
; lifecycle state != engine escrow mode
; escrow protects an active obligation, not a building category
; no percentage/cap/timer/priority is invented here
; escrow never grants authority or declares construction complete
; ============================================================
