; =============================================================
; THE BYZANTINE SHADOW -- MODULE 09 CAPITAL
; =============================================================
;
; CAPITAL FEASIBILITY
;
; Module 08 owns the engine-derived transaction cost vector:
;   500 food
;   501 wood
;   502 stone
;   503 gold
;
; Module 07 owns protected reserve floors:
;   561 food
;   562 wood
;   563 gold
;   564 stone
;
; UserPatch cost-data commands operate only on legal extended-goal
; ranges. Module 09 therefore reads the 500-503 cost vector into
; the engine scratch vector 504-507, then copies the resulting
; resource-minus-cost delta into the public Shadow outputs 594-597.
;
; Public Module 09 outputs:
;   594 food slack
;   595 wood slack
;   596 stone slack
;   597 gold slack
;   598 feasibility
;   599 active
;   600 initialized
;
; Feasibility is true only when all four resulting slack values
; are non-negative while Module 08 reports an active requirement.
;
; This module does NOT:
;   - choose reserve policy
;   - change reserve floors
;   - construct cost data
;   - modify escrow
;   - release escrow
;   - execute production
;   - grant authority
;   - alter production demand
;
; =============================================================
; INITIALIZATION
; =============================================================

(defrule
    (true)
=>
    (set-goal SHADOW-CAPITAL-COST-DELTA-FOOD 0)
    (set-goal SHADOW-CAPITAL-SLACK-FOOD 0)
    (set-goal SHADOW-CAPITAL-SLACK-WOOD 0)
    (set-goal SHADOW-CAPITAL-SLACK-STONE 0)
    (set-goal SHADOW-CAPITAL-SLACK-GOLD 0)
    (set-goal SHADOW-CAPITAL-FEASIBILITY SHADOW-CAPITAL-INSUFFICIENT)
    (set-goal SHADOW-CAPITAL-ACTIVE SHADOW-CAPITAL-INACTIVE)
    (set-goal SHADOW-CAPITAL-INITIALIZED 1)
)

; =============================================================
; ENGINE COST DELTA
; =============================================================
;
; up-setup-cost-data with reset flag 0 selects the existing Module 08
; cost vector without clearing it. up-get-cost-delta then computes:
;
;   current resources - transaction cost
;
; into the legal 504-507 engine scratch vector.
;
; =============================================================

(defrule
    (goal SHADOW-CAPITAL-INITIALIZED 1)
=>
    (up-setup-cost-data 0 SHADOW-PROD-COST-FOOD)
    (up-get-cost-delta SHADOW-CAPITAL-COST-DELTA-FOOD)
)

; =============================================================
; PUBLIC SLACK MATERIALIZATION
; =============================================================
;
; Copy the engine delta vector into the public Shadow capital slots.
; The reserve deduction is performed only after the copy so that the
; public outputs remain the authoritative capital slack vector.
; =============================================================

(defrule
    (goal SHADOW-CAPITAL-INITIALIZED 1)
=>
    (up-modify-goal SHADOW-CAPITAL-SLACK-FOOD g:= SHADOW-CAPITAL-COST-DELTA-FOOD)
    (up-modify-goal SHADOW-CAPITAL-SLACK-WOOD g:= SHADOW-CAPITAL-COST-DELTA-WOOD)
    (up-modify-goal SHADOW-CAPITAL-SLACK-STONE g:= SHADOW-CAPITAL-COST-DELTA-STONE)
    (up-modify-goal SHADOW-CAPITAL-SLACK-GOLD g:= SHADOW-CAPITAL-COST-DELTA-GOLD)
)

; =============================================================
; PROTECTED-RESERVE DEDUCTION
; =============================================================
;
; up-get-cost-delta gives current resources minus transaction cost.
; Subtract the Module 07 protected reserve from each resource.
;
; Do NOT clamp these values to zero. Negative slack is the evidence
; required by the feasibility gate.
; =============================================================

(defrule
    (goal SHADOW-CAPITAL-INITIALIZED 1)
=>
    (up-modify-goal SHADOW-CAPITAL-SLACK-FOOD c:- SHADOW-RESERVE-FOOD)
    (up-modify-goal SHADOW-CAPITAL-SLACK-WOOD c:- SHADOW-RESERVE-WOOD)
    (up-modify-goal SHADOW-CAPITAL-SLACK-STONE c:- SHADOW-RESERVE-STONE)
    (up-modify-goal SHADOW-CAPITAL-SLACK-GOLD c:- SHADOW-RESERVE-GOLD)
)

; =============================================================
; ACTIVE STATE
; =============================================================
;
; Capital feasibility is meaningful only while Module 08 has an
; active production requirement. Capital does not invent demand.
;
; All comparisons here are against constants or the literal zero.
; Therefore the ordinary three-argument up-compare-goal form is used;
; no typed goal-operator is required.
; =============================================================

(defrule
    (up-compare-goal SHADOW-REQ-ACTIVE == SHADOW-REQ-ACTIVE-VALUE)
=>
    (set-goal SHADOW-CAPITAL-ACTIVE SHADOW-CAPITAL-ACTIVE-VALUE)
)

(defrule
    (up-compare-goal SHADOW-REQ-ACTIVE == SHADOW-REQ-INACTIVE)
=>
    (set-goal SHADOW-CAPITAL-ACTIVE SHADOW-CAPITAL-INACTIVE)
)

; =============================================================
; CAPITAL FEASIBILITY -- SUFFICIENT
; =============================================================

(defrule
    (up-compare-goal SHADOW-CAPITAL-ACTIVE == SHADOW-CAPITAL-ACTIVE-VALUE)
    (up-compare-goal SHADOW-CAPITAL-SLACK-FOOD >= 0)
    (up-compare-goal SHADOW-CAPITAL-SLACK-WOOD >= 0)
    (up-compare-goal SHADOW-CAPITAL-SLACK-STONE >= 0)
    (up-compare-goal SHADOW-CAPITAL-SLACK-GOLD >= 0)
=>
    (set-goal SHADOW-CAPITAL-FEASIBILITY SHADOW-CAPITAL-SUFFICIENT)
)

; =============================================================
; CAPITAL FEASIBILITY -- INSUFFICIENT
; =============================================================
;
; OR is binary in the UserPatch grammar, so the four resource
; predicates are explicitly nested.
; =============================================================

(defrule
    (up-compare-goal SHADOW-CAPITAL-ACTIVE == SHADOW-CAPITAL-ACTIVE-VALUE)
    (or
        (up-compare-goal SHADOW-CAPITAL-SLACK-FOOD < 0)
        (or
            (up-compare-goal SHADOW-CAPITAL-SLACK-WOOD < 0)
            (or
                (up-compare-goal SHADOW-CAPITAL-SLACK-STONE < 0)
                (up-compare-goal SHADOW-CAPITAL-SLACK-GOLD < 0)
            )
        )
    )
=>
    (set-goal SHADOW-CAPITAL-FEASIBILITY SHADOW-CAPITAL-INSUFFICIENT)
)

; =============================================================
; INACTIVE REQUIREMENT STATE
; =============================================================
;
; No active production requirement means no capital feasibility
; admission exists. The module therefore reports INSUFFICIENT,
; not SUCCESS, when there is no demand to evaluate.
; =============================================================

(defrule
    (up-compare-goal SHADOW-CAPITAL-ACTIVE == SHADOW-CAPITAL-INACTIVE)
=>
    (set-goal SHADOW-CAPITAL-FEASIBILITY SHADOW-CAPITAL-INSUFFICIENT)
)
