; =============================================================
; THE BYZANTINE SHADOW -- MODULE 09 CAPITAL
; =============================================================
;
; CAPITAL FEASIBILITY
;
; Module 08 owns the engine-derived transaction cost vector:
;   500 food
;   501 wood
;   502 stone
;   503 gold
;
; Module 07 owns protected reserve floors:
;   561 food
;   562 wood
;   563 gold
;   564 stone
;
; Module 09 derives capital slack as:
;
;   current resources
;   - Module 08 transaction cost
;   - Module 07 protected reserve
;
; Feasibility is true only when all four resulting slack values
; are non-negative while Module 08 reports an active requirement.
;
; This module does NOT:
;   - choose reserve policy
;   - change reserve floors
;   - construct cost data
;   - modify escrow
;   - release escrow
;   - execute production
;   - grant authority
;   - alter production demand
;
; =============================================================


; =============================================================
; INITIALIZATION
; =============================================================

(defrule
    (true)
=>
    (set-goal SHADOW-CAPITAL-SLACK-FOOD 0)
    (set-goal SHADOW-CAPITAL-SLACK-WOOD 0)
    (set-goal SHADOW-CAPITAL-SLACK-STONE 0)
    (set-goal SHADOW-CAPITAL-SLACK-GOLD 0)
    (set-goal SHADOW-CAPITAL-FEASIBILITY SHADOW-CAPITAL-INSUFFICIENT)
    (set-goal SHADOW-CAPITAL-ACTIVE SHADOW-CAPITAL-INACTIVE)
    (set-goal SHADOW-CAPITAL-INITIALIZED 1)
)


; =============================================================
; COST-DATA SELECTION
; =============================================================
;
; up-get-cost-delta reads the current engine resource stockpile
; against the cost data selected by the most recent
; up-setup-cost-data command. Explicitly select the Shadow
; production cost vector here rather than depending on another
; module's most recent cost-data selection.
;
; The command writes four consecutive goals in the order:
; FOOD, WOOD, STONE, GOLD.
;
; 594-597 are the Shadow Module 09 slack vector.
; =============================================================

(defrule
    (goal SHADOW-CAPITAL-INITIALIZED 1)
=>
    (up-setup-cost-data 0 SHADOW-PROD-COST-FOOD)
    (up-get-cost-delta SHADOW-CAPITAL-SLACK-FOOD)
)


; =============================================================
; PROTECTED-RESERVE DEDUCTION
; =============================================================
;
; up-get-cost-delta gives:
;
;   current resources - transaction cost
;
; Subtract the Module 07 protected reserve from each resource.
;
; Do NOT clamp these values to zero. Negative slack is the
; evidence required by the feasibility gate.
; =============================================================

(defrule
    (goal SHADOW-CAPITAL-INITIALIZED 1)
=>
    (up-modify-goal SHADOW-CAPITAL-SLACK-FOOD c:- SHADOW-RESERVE-FOOD)
    (up-modify-goal SHADOW-CAPITAL-SLACK-WOOD c:- SHADOW-RESERVE-WOOD)
    (up-modify-goal SHADOW-CAPITAL-SLACK-STONE c:- SHADOW-RESERVE-STONE)
    (up-modify-goal SHADOW-CAPITAL-SLACK-GOLD c:- SHADOW-RESERVE-GOLD)
)


; =============================================================
; ACTIVE STATE
; =============================================================
;
; Capital feasibility is meaningful only while Module 08 has an
; active production requirement. Capital does not invent demand.
; =============================================================

(defrule
    (up-compare-goal SHADOW-REQ-ACTIVE g:= SHADOW-REQ-ACTIVE-VALUE)
=>
    (set-goal SHADOW-CAPITAL-ACTIVE SHADOW-CAPITAL-ACTIVE-VALUE)
)

(defrule
    (up-compare-goal SHADOW-REQ-ACTIVE g:= SHADOW-REQ-INACTIVE)
=>
    (set-goal SHADOW-CAPITAL-ACTIVE SHADOW-CAPITAL-INACTIVE)
)


; =============================================================
; CAPITAL FEASIBILITY -- SUFFICIENT
; =============================================================
;
; Goal-to-goal comparison uses g:<op> syntax.
; =============================================================

(defrule
    (up-compare-goal SHADOW-CAPITAL-ACTIVE g:= SHADOW-CAPITAL-ACTIVE-VALUE)
    (up-compare-goal SHADOW-CAPITAL-SLACK-FOOD g:>= 0)
    (up-compare-goal SHADOW-CAPITAL-SLACK-WOOD g:>= 0)
    (up-compare-goal SHADOW-CAPITAL-SLACK-STONE g:>= 0)
    (up-compare-goal SHADOW-CAPITAL-SLACK-GOLD g:>= 0)
=>
    (set-goal SHADOW-CAPITAL-FEASIBILITY SHADOW-CAPITAL-SUFFICIENT)
)


; =============================================================
; CAPITAL FEASIBILITY -- INSUFFICIENT
; =============================================================
;
; OR is binary in the UserPatch grammar, so the four resource
; predicates are explicitly nested.
; =============================================================

(defrule
    (up-compare-goal SHADOW-CAPITAL-ACTIVE g:= SHADOW-CAPITAL-ACTIVE-VALUE)
    (or
        (up-compare-goal SHADOW-CAPITAL-SLACK-FOOD g:< 0)
        (or
            (up-compare-goal SHADOW-CAPITAL-SLACK-WOOD g:< 0)
            (or
                (up-compare-goal SHADOW-CAPITAL-SLACK-STONE g:< 0)
                (up-compare-goal SHADOW-CAPITAL-SLACK-GOLD g:< 0)
            )
        )
    )
=>
    (set-goal SHADOW-CAPITAL-FEASIBILITY SHADOW-CAPITAL-INSUFFICIENT)
)


; =============================================================
; INACTIVE REQUIREMENT STATE
; =============================================================
;
; No active production requirement means no capital feasibility
; admission exists. The module therefore reports INSUFFICIENT,
; not SUCCESS, when there is no demand to evaluate.
; =============================================================

(defrule
    (up-compare-goal SHADOW-CAPITAL-ACTIVE g:= SHADOW-CAPITAL-INACTIVE)
=>
    (set-goal SHADOW-CAPITAL-FEASIBILITY SHADOW-CAPITAL-INSUFFICIENT)
)
