; ============================================
; AEGIS
; 09_capital.per
; ============================================
;
; CAPITAL MODEL
;
; Gross
;   = resources currently held by the AI.
;
; Committed
;   = resources currently held in engine escrow.
;
; Liquid
;   = gross - committed.
;
; Reserve
;   = strategically protected liquid capital,
;     produced by 07_strategic reserve.per.
;
; Discretionary
;   = liquid - reserve.
;
; Transaction demand
;   = engine-defined capital required by the
;     active transaction, produced by 08_requirements.per.
;
; Capital feasibility
;   = discretionary capital >= transaction demand
;     across all four resource dimensions.
;
; ============================================
;
; RESPONSIBILITY
; --------------
; This module calculates capital state.
;
; This module does NOT:
;   - choose reserve policy
;   - set resource reserve values
;   - choose the strategic objective
;   - construct cost data
;   - modify engine escrow
;   - release escrow
;   - grant authority
;   - execute the transaction
;   - verify completion
;
; Reserve policy belongs to 07.
; Requirement cost construction belongs to 08.
;
; ============================================


; ============================================
; GROSS RESOURCE OBSERVATION
; ============================================

(defrule
    (true)
=>
    (up-get-fact food-amount 0 AEGIS-GROSS-FOOD)
    (up-get-fact wood-amount 0 AEGIS-GROSS-WOOD)
    (up-get-fact gold-amount 0 AEGIS-GROSS-GOLD)
    (up-get-fact stone-amount 0 AEGIS-GROSS-STONE)
)


; ============================================
; ENGINE ESCROW OBSERVATION
; ============================================

(defrule
    (true)
=>
    (up-get-fact escrow-amount food AEGIS-COMMITTED-FOOD)
    (up-get-fact escrow-amount wood AEGIS-COMMITTED-WOOD)
    (up-get-fact escrow-amount gold AEGIS-COMMITTED-GOLD)
    (up-get-fact escrow-amount stone AEGIS-COMMITTED-STONE)
)


; ============================================
; LIQUID CAPITAL
; ============================================
;
; UserPatch math semantics: c:min stores the lesser
; of the current value and the supplied value; c:max
; stores the greater. Therefore c:max 0 is the floor.
;
; ============================================

(defrule
    (true)
=>
    (up-modify-goal AEGIS-LIQUID-FOOD c:= AEGIS-GROSS-FOOD)
    (up-modify-goal AEGIS-LIQUID-FOOD c:- AEGIS-COMMITTED-FOOD)
    (up-modify-goal AEGIS-LIQUID-FOOD c:max 0)
)

(defrule
    (true)
=>
    (up-modify-goal AEGIS-LIQUID-WOOD c:= AEGIS-GROSS-WOOD)
    (up-modify-goal AEGIS-LIQUID-WOOD c:- AEGIS-COMMITTED-WOOD)
    (up-modify-goal AEGIS-LIQUID-WOOD c:max 0)
)

(defrule
    (true)
=>
    (up-modify-goal AEGIS-LIQUID-GOLD c:= AEGIS-GROSS-GOLD)
    (up-modify-goal AEGIS-LIQUID-GOLD c:- AEGIS-COMMITTED-GOLD)
    (up-modify-goal AEGIS-LIQUID-GOLD c:max 0)
)

(defrule
    (true)
=>
    (up-modify-goal AEGIS-LIQUID-STONE c:= AEGIS-GROSS-STONE)
    (up-modify-goal AEGIS-LIQUID-STONE c:- AEGIS-COMMITTED-STONE)
    (up-modify-goal AEGIS-LIQUID-STONE c:max 0)
)


; ============================================
; DISCRETIONARY CAPITAL
; ============================================
;
; Reserve policy and resource-specific reserve
; values are supplied by Module 07.
;
; ============================================

(defrule
    (true)
=>
    (up-modify-goal AEGIS-DISCRETIONARY-FOOD c:= AEGIS-LIQUID-FOOD)
    (up-modify-goal AEGIS-DISCRETIONARY-FOOD c:- AEGIS-RESERVE-FOOD)
    (up-modify-goal AEGIS-DISCRETIONARY-FOOD c:max 0)
)

(defrule
    (true)
=>
    (up-modify-goal AEGIS-DISCRETIONARY-WOOD c:= AEGIS-LIQUID-WOOD)
    (up-modify-goal AEGIS-DISCRETIONARY-WOOD c:- AEGIS-RESERVE-WOOD)
    (up-modify-goal AEGIS-DISCRETIONARY-WOOD c:max 0)
)

(defrule
    (true)
=>
    (up-modify-goal AEGIS-DISCRETIONARY-GOLD c:= AEGIS-LIQUID-GOLD)
    (up-modify-goal AEGIS-DISCRETIONARY-GOLD c:- AEGIS-RESERVE-GOLD)
    (up-modify-goal AEGIS-DISCRETIONARY-GOLD c:max 0)
)

(defrule
    (true)
=>
    (up-modify-goal AEGIS-DISCRETIONARY-STONE c:= AEGIS-LIQUID-STONE)
    (up-modify-goal AEGIS-DISCRETIONARY-STONE c:- AEGIS-RESERVE-STONE)
    (up-modify-goal AEGIS-DISCRETIONARY-STONE c:max 0)
)


; ============================================
; DEMAND ACTIVE STATE
; ============================================
;
; Cost demand is relevant while a transaction
; is being reserved, prepared, or executed.
;
; ============================================

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
=>
    (set-goal AEGIS-DEMAND-ACTIVE AEGIS-DEMAND-ACTIVE-VALUE)
)

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-READY)
=>
    (set-goal AEGIS-DEMAND-ACTIVE AEGIS-DEMAND-ACTIVE-VALUE)
)

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-EXECUTING)
=>
    (set-goal AEGIS-DEMAND-ACTIVE AEGIS-DEMAND-ACTIVE-VALUE)
)

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-IDLE)
=>
    (set-goal AEGIS-DEMAND-ACTIVE AEGIS-DEMAND-INACTIVE)
)

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-COMPLETE)
=>
    (set-goal AEGIS-DEMAND-ACTIVE AEGIS-DEMAND-INACTIVE)
)

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-FAILED)
=>
    (set-goal AEGIS-DEMAND-ACTIVE AEGIS-DEMAND-INACTIVE)
)


; ============================================
; CAPITAL FEASIBILITY
; ============================================
;
; IMPORTANT:
; (goal GoalId Value) performs equality only.
; Comparisons against another goal use
; up-compare-goal.
;
; Demand goals follow UserPatch cost-data order:
; FOOD, WOOD, STONE, GOLD.
;
; ============================================

(defrule
    (goal AEGIS-DEMAND-ACTIVE AEGIS-DEMAND-ACTIVE-VALUE)
    (up-compare-goal AEGIS-DISCRETIONARY-FOOD >= AEGIS-DEMAND-FOOD)
    (up-compare-goal AEGIS-DISCRETIONARY-WOOD >= AEGIS-DEMAND-WOOD)
    (up-compare-goal AEGIS-DISCRETIONARY-STONE >= AEGIS-DEMAND-STONE)
    (up-compare-goal AEGIS-DISCRETIONARY-GOLD >= AEGIS-DEMAND-GOLD)
=>
    (set-goal AEGIS-CAPITAL-FEASIBILITY AEGIS-CAPITAL-SUFFICIENT)
)

(defrule
    (goal AEGIS-DEMAND-ACTIVE AEGIS-DEMAND-ACTIVE-VALUE)
    (or
        (up-compare-goal AEGIS-DISCRETIONARY-FOOD < AEGIS-DEMAND-FOOD)
        (up-compare-goal AEGIS-DISCRETIONARY-WOOD < AEGIS-DEMAND-WOOD)
        (up-compare-goal AEGIS-DISCRETIONARY-STONE < AEGIS-DEMAND-STONE)
        (up-compare-goal AEGIS-DISCRETIONARY-GOLD < AEGIS-DEMAND-GOLD)
    )
=>
    (set-goal AEGIS-CAPITAL-FEASIBILITY AEGIS-CAPITAL-INSUFFICIENT)
)

(defrule
    (goal AEGIS-DEMAND-ACTIVE AEGIS-DEMAND-INACTIVE)
=>
    (set-goal AEGIS-CAPITAL-FEASIBILITY AEGIS-CAPITAL-INSUFFICIENT)
)
