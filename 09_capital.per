; ============================================================
; THE BYZANTINE SHADOW
; MODULE 09 -- CAPITAL FEASIBILITY
; ============================================================
;
; Authority: reserve-adjusted construction capital feasibility.
;
; This module answers whether the currently requested construction
; package is fundable from current stockpile state. It does not choose
; strategy, set escrow percentages, release escrow, grant authority,
; execute construction, or verify completion.
;
; Engine escrow remains a separate protected-capital lifecycle owned by
; Module 10. This module therefore measures liquid affordability only;
; escrow-inclusive execution remains guarded by up-can-build in Module 12.
; ============================================================

; ------------------------------------------------------------
; INITIALIZATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-CAPITAL-STATE -1)
=>
    (set-goal BYZ-CAPITAL-STATE BYZ-CAPITAL-INACTIVE)
    (set-goal BYZ-CAPITAL-SLACK-FOOD 0)
    (set-goal BYZ-CAPITAL-SLACK-WOOD 0)
    (set-goal BYZ-CAPITAL-SLACK-GOLD 0)
    (set-goal BYZ-CAPITAL-SLACK-STONE 0)
)

; ------------------------------------------------------------
; SNAPSHOT CURRENT COST DELTA
; ------------------------------------------------------------
; Module 08 establishes the active four-resource cost vector. The
; engine writes current stockpile minus that cost into four consecutive
; goals starting at BYZ-CAPITAL-SLACK-FOOD.
(defrule
    (goal BYZ-CONSTRUCTION-REQUIREMENTS BYZ-REQUIREMENTS-READY)
=>
    (up-get-cost-delta BYZ-CAPITAL-SLACK-FOOD)
)

; ------------------------------------------------------------
; INACTIVE WHEN NO REQUIREMENT EXISTS
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-REQUIREMENTS BYZ-REQUIREMENTS-NOT-READY)
=>
    (set-goal BYZ-CAPITAL-STATE BYZ-CAPITAL-INACTIVE)
)

; ------------------------------------------------------------
; SUFFICIENT LIQUID CAPITAL
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-REQUIREMENTS BYZ-REQUIREMENTS-READY)
    (up-compare-goal BYZ-CAPITAL-SLACK-FOOD >= 0)
    (up-compare-goal BYZ-CAPITAL-SLACK-WOOD >= 0)
    (up-compare-goal BYZ-CAPITAL-SLACK-GOLD >= 0)
    (up-compare-goal BYZ-CAPITAL-SLACK-STONE >= 0)
=>
    (set-goal BYZ-CAPITAL-STATE BYZ-CAPITAL-SUFFICIENT)
)

; ------------------------------------------------------------
; INSUFFICIENT LIQUID CAPITAL
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-REQUIREMENTS BYZ-REQUIREMENTS-READY)
    (or
        (or
            (up-compare-goal BYZ-CAPITAL-SLACK-FOOD < 0)
            (up-compare-goal BYZ-CAPITAL-SLACK-WOOD < 0)
        )
        (or
            (up-compare-goal BYZ-CAPITAL-SLACK-GOLD < 0)
            (up-compare-goal BYZ-CAPITAL-SLACK-STONE < 0)
        )
    )
=>
    (set-goal BYZ-CAPITAL-STATE BYZ-CAPITAL-INSUFFICIENT)
)

; INVARIANTS:
; capital feasibility is an observation, not an authority grant
; capital feasibility does not consume escrow
; no strategic reserve number is invented here
; engine escrow-inclusive feasibility remains an execution guard
; ============================================================
