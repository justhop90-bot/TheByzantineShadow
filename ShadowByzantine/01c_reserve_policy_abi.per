; ============================================================
; THE BYZANTINE SHADOW
; MODULE 01C -- STRATEGIC RESERVE POLICY ABI
; ============================================================
;
; PURPOSE
;   Define the storage/handshake ABI required to connect Module 07
;   strategic reserve policy to Module 09 capital feasibility.
;
; IMPORTANT
;   These numbers are STORAGE IDENTIFIERS only.
;   No reserve amount is encoded here.
;   No food/wood/gold/stone policy value is invented here.
;
; ============================================================
; POLICY CLASS
; ============================================================

(defconst AEGIS-RESERVE-EARLY 1)
(defconst AEGIS-RESERVE-DEVELOPMENT 2)
(defconst AEGIS-RESERVE-MILITARY 3)
(defconst AEGIS-RESERVE-LATE 4)

; ============================================================
; POLICY INPUT BOUNDARY
; ============================================================
;
; 574 = selected policy source / class already exists at 485.
; 575 = reserve-policy materialization state.
; 576-579 = authoritative reserve vector, F/W/G/S.
;
; The four vector slots are DATA SLOTS. Their eventual numeric
; contents must be supplied by a qualified policy provider. This
; ABI intentionally does not initialize them with policy amounts.

(defconst AEGIS-RESERVE-POLICY-SOURCE 574)
(defconst AEGIS-RESERVE-POLICY-READY 575)
(defconst AEGIS-RESERVE-INPUT-FOOD 576)
(defconst AEGIS-RESERVE-INPUT-WOOD 577)
(defconst AEGIS-RESERVE-INPUT-GOLD 578)
(defconst AEGIS-RESERVE-INPUT-STONE 579)

(defconst AEGIS-RESERVE-UNBOUND 0)
(defconst AEGIS-RESERVE-BOUND 1)

; ============================================================
; RESERVE-ADJUSTED CAPITAL ABI
; ============================================================
;
; 580 = reserve-adjusted capital state.
; 581-584 = discretionary capital slack, F/W/G/S.
; 585 = reserve-adjusted feasibility result.
;
; Required semantic formula:
;
;   discretionary(resource)
;       = gross(resource) - reserve(resource)
;
;   reserve-adjusted feasibility
;       = every discretionary(resource) >= transaction(resource)
;
; Equivalently:
;
;   gross(resource) - transaction(resource) - reserve(resource) >= 0
;
; The arithmetic implementation remains a Module 09 engine/ABI
; qualification task. No new arithmetic opcode is assumed here.

(defconst AEGIS-CAPITAL-RESERVE-STATE 580)
(defconst AEGIS-DISCRETIONARY-SLACK-FOOD 581)
(defconst AEGIS-DISCRETIONARY-SLACK-WOOD 582)
(defconst AEGIS-DISCRETIONARY-SLACK-GOLD 583)
(defconst AEGIS-DISCRETIONARY-SLACK-STONE 584)
(defconst AEGIS-RESERVE-CAPITAL-FEASIBILITY 585)

(defconst AEGIS-RESERVE-CAPITAL-UNQUALIFIED 0)
(defconst AEGIS-RESERVE-CAPITAL-SUFFICIENT 1)
(defconst AEGIS-RESERVE-CAPITAL-INSUFFICIENT 2)

; ============================================================
; PROVIDER CONTRACT
; ============================================================
;
; A qualified reserve provider MUST:
;   1. select one policy class in AEGIS-RESERVE-POLICY;
;   2. populate 576-579 from an authoritative policy source;
;   3. set AEGIS-RESERVE-POLICY-READY = AEGIS-RESERVE-BOUND;
;   4. never claim READY merely because a policy class was selected.
;
; Until step 3 is observed, Module 09 MUST NOT use reserve-adjusted
; feasibility as an authorization input.
;
; ============================================================
; NON-NEGOTIABLE INVARIANT
; ============================================================
;
; A policy class is metadata.
; A reserve vector is data.
; They are not interchangeable.
;
; Therefore these identifiers do NOT constitute policy values:
;   AEGIS-RESERVE-EARLY
;   AEGIS-RESERVE-DEVELOPMENT
;   AEGIS-RESERVE-MILITARY
;   AEGIS-RESERVE-LATE
;
; The actual reserve vector remains UNQUALIFIED until an
; authoritative provider populates 576-579.
