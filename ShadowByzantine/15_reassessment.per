; ============================================
; THE BYZANTINE SHADOW
; MODULE 15 -- REASSESSMENT
; ============================================
;
; Responsibility:
;   Close a terminal transaction only after its result and escrow
;   release are observed, then return strategic control to IDLE.
;
; Lifecycle boundary:
;
;   TERMINAL RESULT
;        -> ESCROW RELEASED
;        -> RECOVERY CLEARED (failure path)
;        -> IDLE
;        -> STRATEGIC CONTROL AVAILABLE
;
; This module does NOT execute engine commands, mutate escrow,
; determine success, or choose the next strategy.
;
; ============================================
; SUCCESSFUL TRANSACTION -> IDLE
; ============================================

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-COMPLETE)
    (goal AEGIS-VERIFICATION AEGIS-VERIFIED)
    (goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-RELEASED)
=>
    (set-goal AEGIS-AUTHORITY AEGIS-AUTHORITY-DENIED)
    (set-goal AEGIS-EXECUTION-STATE AEGIS-EXECUTION-IDLE)
    (set-goal AEGIS-VERIFICATION AEGIS-UNVERIFIED)
    (set-goal AEGIS-ESCROW-RELEASE-REQUEST AEGIS-ESCROW-RELEASE-NO)
    (set-goal AEGIS-TRANSACTION-ACTIVE 0)
    (set-goal AEGIS-TRANSACTION AEGIS-TRANSACTION-IDLE)
)

; ============================================
; FAILED TRANSACTION -> IDLE
; ============================================
;
; Failure cannot bypass RECOVERY-CLEARED.
;
(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-FAILED)
    (goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-CLEARED)
    (goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-RELEASED)
=>
    (set-goal AEGIS-AUTHORITY AEGIS-AUTHORITY-DENIED)
    (set-goal AEGIS-EXECUTION-STATE AEGIS-EXECUTION-IDLE)
    (set-goal AEGIS-VERIFICATION AEGIS-UNVERIFIED)
    (set-goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-IDLE)
    (set-goal AEGIS-ESCROW-RELEASE-REQUEST AEGIS-ESCROW-RELEASE-NO)
    (set-goal AEGIS-TRANSACTION-ACTIVE 0)
    (set-goal AEGIS-TRANSACTION AEGIS-TRANSACTION-IDLE)
)
