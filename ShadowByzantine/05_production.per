;=============================================================
; THE BYZANTINE SHADOW
; MODULE 05 -- PRODUCTION AUTHORITY
;=============================================================
;
; Required load order:
;
;   05_production_registry.per
;   05_composition_policy.per
;   05_production.per
;
; POLICY:
;   owns absolute desired composition.
;
; AUTHORITY:
;   owns production-site acquisition, escrow, admission,
;   execution, completion observation, and withdrawal.
;
; Runtime counts are first materialized with up-get-fact.
; Dynamic targets are then compared with up-compare-goal.
;
;=============================================================
(defrule
    (goal SHADOW-PROD-STATE -1)
=>
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
    (set-goal SHADOW-PROD-ESCROW-STATE escrow-included)
    (set-goal SHADOW-PROD-SITE-STATE 0)
    (set-goal SHADOW-PROD-ADMISSION 0)
    (set-goal SHADOW-PROD-LOCK 0)
)

;-------------------------------------------------------------
; PASS INITIALIZATION
;-------------------------------------------------------------
(defrule
    (true)
=>
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
    (set-goal SHADOW-PROD-LOCK 0)
    (set-goal SHADOW-PROD-ADMISSION 0)
)

```lisp
;-------------------------------------------------------------
; OBSERVED PRODUCTION TOTALS
;
; up-get-fact syntax:
;   (up-get-fact <FactId> <FactParameter> <OutputGoalId>)
;
; unit-type-count-total includes trained + queued units.
; Therefore these cached goals represent the actual production
; commitment already visible to the engine.
;-------------------------------------------------------------
(defrule
    (true)
=>
    (up-get-fact unit-type-count-total militia-line
    SHADOW-PROD-COUNT-INFANTRY)
)

