; AUTHENTICATED DONOR RULE 1445 | DONOR_LINE=17180
(defrule
    (game-time > 7)
    (game-time < 50)
    (goal gl-early-gar -1)
    (current-age == dark-age)
    (or (game-time > 30)
    (up-compare-goal goal > 0))
=>
    (set-goal SPLIT 1)
)

; AUTHENTICATED DONOR RULE 1446 | DONOR_LINE=17191
(defrule
    (goal SPLIT 1)
=>
    ;	(chat-to-player me "No explo")
    (set-strategic-number sn-percent-civilian-explorers 0)
    (set-strategic-number sn-cap-civilian-explorers 0)
    (up-full-reset-search)
    (up-filter-exclude -1 actionid-build -1 -1)
    (up-find-local c: villager-class c: 240)
    (up-set-target-by-id g: home-id)
    (up-target-objects 1 action-garrison -1 -1)
    (enable-timer t-relure 1)
    (set-goal gl-early-gar 0)
    (set-goal SPLIT 0)
)

; AUTHENTICATED DONOR RULE 1447 | DONOR_LINE=17207
(defrule
    (goal gl-early-gar 0)
    (current-age == dark-age)
    (timer-triggered t-relure)
=>
    ;	(chat-to-player me "No explo2")
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: 6 c: -1)
    (up-filter-exclude -1 actionid-build -1 -1)
    (up-find-local c: villager-class c: 240)
    (up-set-target-by-id g: home-id)
    (up-target-objects 1 action-garrison -1 -1)
    (disable-timer t-relure)
    (disable-self)
)

