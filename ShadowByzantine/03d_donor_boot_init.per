)

; AUTHENTICATED DONOR RULE 1439 | DONOR_LINE=17119
(defrule
    (true)
=>
    (up-get-threat-data gl-threat-time gl-threat-player gl-threat-source gl-threat-target)
    (up-get-fact unit-type-count villager-hunter goal)
    (up-get-fact unit-type-count villager-shepherd goal1)
    (up-modify-goal goal g:+ goal1)
    (up-modify-goal gl-vills-under-tc g:= goal)
)

