; ============================================================
; THE BYZANTINE SHADOW
; 03D -- AUTHENTICATED DONOR BOOT/EXPLORATION INIT
; ============================================================
;
; Donor rules 1430-1456 (27 rules) + 1611-1612 (explorer counts).
; Contents: dark-build selection, exploration setup
; (sn-initial-exploration-required, civilian explorers, mill
; placement, gatherer percentages, livestock-to-TC, threat-data
; snapshot, villager counts, build-system SNs incl.
; sn-enable-boar-hunting, boar-unit id, early-garrison logic).
; This slice is WHY the scout moves: sn-total-number-explorers
; and sn-number-explore-groups (1611-1612) task the engine
; explorer; 1438/1442/1448/1454/1456 establish exploration,
; gatherer, boar-hunting, and build-system SN defaults.
;
; Transplanted verbatim. No explicit jumps in range.
; Loaded after 03c_byzantine_uu_doctrine (donor order).
; ============================================================

; AUTHENTICATED DONOR RULE 1430 | DONOR_LINE=17026
(defrule
    (goal gl-dark-build -1)
    (or (current-age >= feudal-age)
    (and(game-time > 80)
    (up-compare-goal gl-current-sheep-count >= 6)))
=>
    (set-goal gl-dark-build LumberFirst)
    ;	(chat-to-player me "Lumber First 1")
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1431 | DONOR_LINE=17037
(defrule
    (game-time > 50)
    (wood-amount >= 200)
    (goal gl-dark-build MillFirst)
    (building-type-count-total mill < 1)
=>
    (set-goal gl-dark-build LumberFirst)
    ;	(chat-to-player me "Lumber First 2")
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1432 | DONOR_LINE=17048
(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 35)
)

; AUTHENTICATED DONOR RULE 1433 | DONOR_LINE=17056
(defrule
    (game-time > 37)
    (goal gl-dark-build -1)
    (not(up-find-remote c: sheep c: 1))
    (up-compare-goal gl-current-sheep-count < 1)
=>
    (set-goal gl-dark-build MillFirst)
    ;	(chat-to-player me "Mill First 1")
    (up-assign-builders c: mill c: 2)
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1434 | DONOR_LINE=17068
(defrule
    (goal gl-dark-build -1)
    (not(up-find-remote c: sheep c: 1))
    (or	(and(game-time > 80)
    (unit-type-count sheep < 1))
    (and(game-time > 120)
    (up-compare-goal gl-current-sheep-count < 5)))
=>
    (set-goal gl-dark-build MillFirst)
    ;	(chat-to-player me "Mill First 2")
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1435 | DONOR_LINE=17082
(defrule
