; AUTHENTICATED DONOR RULE 1453 | DONOR_LINE=17272
(defrule
    (or (taunt-detected me 14)
    (taunt-detected any-enemy 14))
=>
    (up-chat-data-to-player me "Adjacent dropsites? %d" s: sn-allow-adjacent-dropsites)
    (up-chat-data-to-player me "Dropsite separation distance: %d" s: sn-dropsite-separation-distance)
    (acknowledge-taunt this-any-enemy 14)
    (acknowledge-taunt me 14)
)

