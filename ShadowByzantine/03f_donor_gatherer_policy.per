; AUTHENTICATED DONOR RULE 1154 | DONOR_LINE=13983
(defrule
    (civilian-population == 18)
    (goal gl-strategy FLUSH)
=>
    (set-goal SPLIT 1)
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1155 | DONOR_LINE=13991
(defrule
    (goal SPLIT 1)
    (food-amount < 230)
    (or	(up-compare-goal gl-killed-boar-count < 2)
    (and(up-compare-goal gl-killed-deer-count < 1)
    (up-compare-goal gl-current-sheep-count < 7)))
=>
    (set-strategic-number sn-food-gatherer-percentage 79)
    (set-strategic-number sn-wood-gatherer-percentage 21)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    ;	(chat-to-player me "Need More Food")
    (disable-self)
    (set-goal SPLIT 0)
)

