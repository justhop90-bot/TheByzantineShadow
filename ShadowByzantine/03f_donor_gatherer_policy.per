; ============================================================
; THE BYZANTINE SHADOW
; 03F -- AUTHENTICATED DONOR GATHERER POLICY (1142-1164)
; ============================================================
;
; Donor rules 1142-1164 (23 rules): the staged gatherer-
; percentage machine. Opens 100% food, shifts to wood as the
; population grows (77/23, 75/25, 60/40), adds gold on dropsite
; proximity and Castle progression, and rebalances per FLUSH
; milestones (food stock, Feudal, blacksmith, fletching,
; market, CA-loading). One-shot disable-self stages; the KRUSH
; gate at 1145 skips to 1153 for non-KRUSH.
;
; Transplanted verbatim. Single in-slice jump (1145->1153).
; Loaded before 03a_donor_tech_production (donor order).
; Replaces the static 60/40 boot rule formerly in 03_economy.
; ============================================================

; AUTHENTICATED DONOR RULE 1142 | DONOR_LINE=13826
(defrule
    (true)
=>
    (set-strategic-number sn-food-gatherer-percentage 100)
    (set-strategic-number sn-wood-gatherer-percentage 0)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1143 | DONOR_LINE=13837
(defrule
    (current-age-time >= 15)
    (civilian-population >= 7)
=>
    (set-strategic-number sn-food-gatherer-percentage 77)
    (set-strategic-number sn-wood-gatherer-percentage 23)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)

    (set-strategic-number sn-maximum-wood-drop-distance 5)
    (set-strategic-number sn-wood-dropsite-distance 3)
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1144 | DONOR_LINE=13851
(defrule
    (civilian-population >= 14)
=>
    (set-strategic-number sn-food-gatherer-percentage 75)
    (set-strategic-number sn-wood-gatherer-percentage 25)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1145 | DONOR_LINE=13862
(defrule
    (up-compare-goal gl-strategy != KRUSH)
=>
    (up-jump-rule 8)
)

; AUTHENTICATED DONOR RULE 1146 | DONOR_LINE=13870
(defrule
    (civilian-population >= 15)
=>
    (set-strategic-number sn-food-gatherer-percentage 60)
    (set-strategic-number sn-wood-gatherer-percentage 40)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    ;	(chat-to-player me "More wood krush")
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1147 | DONOR_LINE=13882
(defrule
    (false)
    (civilian-population >= 16)
=>
    (set-strategic-number sn-food-gatherer-percentage 65)
    (set-strategic-number sn-wood-gatherer-percentage 35)
    (set-strategic-number sn-gold-gatherer-percentage 0)
    (set-strategic-number sn-stone-gatherer-percentage 0)
    ;	(chat-to-player me "More wood krush 2")
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1148 | DONOR_LINE=13895
(defrule
    (game-time > 10)
    (dropsite-min-distance gold < 5)
    (dropsite-min-distance gold > -1)
=>
    (set-strategic-number sn-food-gatherer-percentage 63)
    (set-strategic-number sn-wood-gatherer-percentage 32)
    (set-strategic-number sn-gold-gatherer-percentage 5)
    (set-strategic-number sn-stone-gatherer-percentage 0)	;3
    ;	(chat-to-player me "KRUSH START GOLD")
    (disable-self)
)

; AUTHENTICATED DONOR RULE 1149 | DONOR_LINE=13909
(defrule
    (game-time > 10)
    (dropsite-min-distance gold < 5)
    (dropsite-min-distance gold > -1)
    (up-research-status c: feudal-age >= research-pending)
=>
    (set-strategic-number sn-food-gatherer-percentage 43)
    (set-strategic-number sn-wood-gatherer-percentage 42)
    (set-strategic-number sn-gold-gatherer-percentage 15)
    (set-strategic-number sn-stone-gatherer-percentage 0)	;3
    ;	(chat-to-player me "13KRUSH MORE GOLD 2")
    (disable-self)
)

