)

; ============================================================
; R07 RULE 1823
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house, housing-headroom < 4,
;        population-headroom != 0, house count < 5,
;        pending house < 1.
; Writes: placement-data; sn-placement-zone-size = 5;
;         sn-placement-fail-delta = 2.
; Escrow: none.
; Pending guard: up-pending-objects c: house < 1.
; Command: up-set-placement-data me -1 c: 10;
;          up-build place-control 0 c: house;
;          up-assign-builders c: house c: 1.
; Completion observer: none.
; Jump: none; fall-through -> 1824.
(defrule
    (can-build house)
    (housing-headroom < 4)
    (population-headroom != 0)
    (building-type-count house < 5)
    (up-pending-objects c: house < 1)
=>
    (up-set-placement-data me -1 c: 10)
    (set-strategic-number sn-placement-zone-size 5)
    (set-strategic-number sn-placement-fail-delta 2)
    (up-build place-control 0 c: house)
    (up-assign-builders c: house c: 1)
)

; ============================================================
; R07 RULE 1824
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house, housing-headroom < 4,
;        population-headroom != 0, house count >= 5,
;        pending house < 1, archery-range < 1.
; Writes: placement-data; sn-placement-zone-size = 5;
;         sn-placement-fail-delta = 2.
; Escrow: none.
; Pending guard: up-pending-objects c: house < 1.
; Command: up-set-placement-data me -1 g: goal;
;          up-build place-control 0 c: house;
;          up-assign-builders c: house c: 1.
; Completion observer: house >= 5 and archery-range < 1 are
;                     decision predicates, not completion proof.
; Jump: none; fall-through -> 1825.
(defrule
    (can-build house)
    (housing-headroom < 4)
    (population-headroom != 0)
    (building-type-count house >= 5)
    (up-pending-objects c: house < 1)
    (building-type-count archery-range < 1)
=>
    (up-set-placement-data me -1 g: goal)
    (set-strategic-number sn-placement-zone-size 5)
    (set-strategic-number sn-placement-fail-delta 2)
    (up-build place-control 0 c: house)
    (up-assign-builders c: house c: 1)
)

; ============================================================
; R07 RULE 1825
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house, housing-headroom < 10,
;        population-headroom != 0, pending house < 1,
;        (KRUSH AND stable >= 2) OR archery-range >= 2.
; Writes: placement-data; sn-placement-zone-size = 5;
;         sn-placement-fail-delta = 2.
; Escrow: none.
; Pending guard: up-pending-objects c: house < 1.
; Command: up-set-placement-data me -1 g: goal;
;          up-build place-control 0 c: house.
; Completion observer: none.
; Jump: none; fall-through -> 1826.
(defrule
    (can-build house)
    (housing-headroom < 10)
    (population-headroom != 0)
    (up-pending-objects c: house < 1)
    (or	(and(goal gl-strategy KRUSH)
    (building-type-count-total stable >= 2))
    (building-type-count-total archery-range >= 2))
=>
    (up-set-placement-data me -1 g: goal)
    (set-strategic-number sn-placement-zone-size 5)
    (set-strategic-number sn-placement-fail-delta 2)
    (up-build place-control 0 c: house)
)

; ============================================================
; R07 RULE 1826
; ============================================================
; QHOUSE arbitration entry.
; Reads: can-build house, housing-headroom < 15,
;        population-headroom != 0, pending house < 2,
;        FLUSH+stable>=1 OR KRUSH+stable>=3 OR
;        SIEGE+siege-workshop>=1.
; Writes: SPLIT = 1.
; Escrow: none.
; Pending guard: up-pending-objects c: house < 2.
; Command: none.
; Completion observer: none.
; Jump: none; fall-through -> 1827.
(defrule
    (can-build house)
    (housing-headroom < 15)
    (population-headroom != 0)
    (up-pending-objects c: house < 2)
    (or	(and(goal gl-strategy FLUSH)
    (building-type-count stable >= 1))
    (or	(and(goal gl-strategy KRUSH)
    (building-type-count-total stable >= 3))
    (and(goal gl-strategy SIEGE)
    (building-type-count siege-workshop >= 1))))
=>
    (set-goal SPLIT 1)
)

; ============================================================
; R07 RULE 1827
; ============================================================
; QHOUSE arbitration execution.
; Reads: SPLIT == 1.
; Writes: placement-data; sn-placement-zone-size = 5;
;         sn-placement-fail-delta = 2; SPLIT = 0.
; Escrow: none.
; Pending guard: none.
; Command: up-set-placement-data me -1 g: goal;
;          up-build place-control 0 c: house.
; Completion observer: none.
; Jump: none; fall-through -> 1828.
(defrule
    (goal SPLIT 1)
=>
    (up-set-placement-data me -1 g: goal)
    (set-strategic-number sn-placement-zone-size 5)
    (set-strategic-number sn-placement-fail-delta 2)
    (up-build place-control 0 c: house)
    (set-goal SPLIT 0)
)

; ============================================================
; R07 RULE 1828
; ============================================================
; QLC FIRST / lumber-camp construction.
; Reads: gl-fifth-turn, civilian-population, housing-headroom,
;        gl-current-build-item, can-build-with-escrow lumber-camp.
; Writes: sn-allow-adjacent-dropsites = 1; wood escrow percentage = 0.
; Escrow: release-escrow wood after escrow percentage reset.
; Pending guard: none.
; Placement operations: none; direct build command.
; Command: build lumber-camp.
; Completion observer: none in this rule.
; Jump: none; fall-through -> 1829.
(defrule
    (goal gl-fifth-turn 1)
    (civilian-population >= 7)
    (or	(housing-headroom >= 5)
    (civilian-population >= 15))
    (goal gl-current-build-item LC1)
    (can-build-with-escrow lumber-camp)
=>
    (set-strategic-number sn-allow-adjacent-dropsites 1)
    (set-escrow-percentage wood 0)
    (release-escrow wood)
    (build lumber-camp)
)

; ============================================================
; R07 RULE 1829
; ============================================================
; QLC skipped-state reconciliation.
; Reads: gl-dark-build, gl-build-progress, lumber-camp count.
; Writes: gl-build-progress = 1 when LumberFirst is active.
; Escrow: none.
; Pending guard: none.
; Placement operations: none.
; Command: none.
; Completion observer: lumber-camp < 1 is rollback/reconciliation evidence.
; Jump: none; fall-through -> 1830.
(defrule
    (goal gl-dark-build LumberFirst)
    (up-compare-goal gl-build-progress > 1)
    (building-type-count-total lumber-camp < 1)
=>
    (set-goal gl-build-progress 1)
)

; ============================================================
; R07 RULE 1830
; ============================================================
; QLC skipped-state reconciliation.
; Reads: gl-dark-build, gl-build-progress, lumber-camp count.
; Writes: gl-build-progress = 2 when MillFirst is active.
; Escrow: none.
; Pending guard: none.
; Placement operations: none.
; Command: none.
; Completion observer: lumber-camp < 1 is rollback/reconciliation evidence.
; Jump: none; fall-through -> 1831.
(defrule
    (goal gl-dark-build MillFirst)
    (up-compare-goal gl-build-progress > 2)
    (building-type-count-total lumber-camp < 1)
=>
    (set-goal gl-build-progress 2)
)

; ============================================================
; R07 RULE 1831
; ============================================================
; QLC progression arbitration to LC1.
; Reads: gl-current-build-item, gl-dark-build, gl-build-progress.
; Writes: wood escrow percentage = LOW-ESCROW; gl-current-build-item = LC1.
; Escrow: set-escrow-percentage wood LOW-ESCROW.
; Pending guard: none.
; Placement operations: none.
; Command: none.
; Completion observer: none.
; Jump: none; fall-through -> 1832.
(defrule
    (up-compare-goal gl-current-build-item != LC1)
    (or	(and(goal gl-dark-build MillFirst)
    (up-compare-goal gl-build-progress == 2))
    (and(goal gl-dark-build LumberFirst)
    (up-compare-goal gl-build-progress == 1)))
=>
    (set-escrow-percentage wood LOW-ESCROW)
    (set-goal gl-current-build-item LC1)
)

; ============================================================
; R07 RULE 1832
; ============================================================
; QLC LC1 completion/progression observer.
; Reads: gl-current-build-item, lumber-camp count.
; Writes: gl-build-progress += 1.
; Escrow: none.
; Pending guard: none.
; Placement operations: none.
; Command: none.
; Completion observer: lumber-camp >= 1.
; Jump: none; fall-through -> 1833.
(defrule
    (goal gl-current-build-item LC1)
    (building-type-count-total lumber-camp >= 1)
=>
    (up-modify-goal gl-build-progress c:+ 1)
)

; ============================================================
; R07 RULE 1833
; ============================================================
; QLC alternate LC1 construction path.
; Reads: can-build lumber-camp, current-age >= feudal-age,
;        Gaia wood count > 20, lumber-camp count < 1.
; Writes: none; disables self.
; Escrow: none.
; Pending guard: none.
; Placement operations: none; direct build command.
; Command: build lumber-camp.
; Completion observer: lumber-camp < 1 is an entry guard, not completion proof.
; Jump: none; fall-through -> 1834.
(defrule
