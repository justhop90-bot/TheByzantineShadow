; State reads: goal gl-progression-pause -1; can-build-with-escrow mining-camp; goal gl-current-build-item GOLDMC2; up-set-target-object search-remote c: 0; up-timer-status t-build-delay != timer-running
; State writes: set-strategic-number sn-placement-zone-size 15; set-strategic-number sn-placement-fail-delta 2; set-strategic-number sn-allow-adjacent-dropsites 0; set-strategic-number sn-dropsite-separation-distance 25
; Pending guards: none
; Commands: release-escrow wood; up-build place-point 0 c: mining-camp
; Placement operations: up-get-point position-object point-x; up-set-target-point point-x; up-build place-point 0 c: mining-camp
; Completion/world observers: none
; Explicit jumps: none
; Source-order semantics: fall-through successor is R07 rule 1894;
;                        explicit jump targets, if any, are preserved verbatim.
; Evidence: DIRECT_DONOR_TEXT for the rule body; documentation fields are
;          mechanically extracted annotations and are not runtime proof.

(defrule
    (false)
    (goal gl-progression-pause -1)
    (can-build-with-escrow mining-camp)
    (goal gl-current-build-item GOLDMC2)
    (up-set-target-object search-remote c: 0)
    ;	(up-timer-status t-build-delay != timer-running)
=>
    (up-get-point position-object point-x)
    (up-set-target-point point-x)
    (chat-to-player me "Second Gold Mining Camp")
    (set-strategic-number sn-placement-zone-size 15)
    (set-strategic-number sn-placement-fail-delta 2)
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-dropsite-separation-distance 25)
    (release-escrow wood)
    (up-build place-point 0 c: mining-camp)
    ;	(enable-timer t-build-delay 3)
)

