; AUTHENTICATED DONOR RULE 1794 | REGION=R07 | BODY_SHA256=2b3e8112fc8d52890acdcb8ca33967a2ef851790bf82221d3bafdad65a7b73b6
(defrule
    (idle-farm-count < 2)
    (goal gl-strategy KRUSH)
    (current-age == feudal-age)
    (can-build-with-escrow farm)
    (up-pending-objects c: farm < 3)
    (building-type-count-total farm < 17)
    (or	(wood-amount >= 320)
    (and(wood-amount >= 90)
    (up-compare-goal rt < 2)))
    (building-type-count-total stable > 0)
    (building-type-count-total blacksmith > 0)
    ;	(up-compare-goal gl-build-progress > KrushSmithNumber)
    (up-compare-goal gl-build-progress < KrushStable2Number)
=>
    (up-build place-normal gl-escrow-state c: farm)
    ;	(chat-to-all "Krush ExcessFarm")
)

