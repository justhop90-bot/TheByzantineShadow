; ============================================================
; R07 RULE 1802
; ============================================================
;
; Reads: dark-age; can-build-with-escrow(farm); FLUSH;
;       pending farm < 1; current item FARMS;
;       wood >= 310 OR farm count < 2
; Writes: wood escrow percentage = 0
; Escrow: set-escrow-percentage wood 0; release-escrow wood
; Pending guard: up-pending-objects c: farm < 1
; Command: build farm
; Completion observer: none
; Jump: none; fall-through -> 1803
;
(defrule
    (current-age == dark-age)
    (can-build-with-escrow farm)
    (goal gl-strategy FLUSH)
    (up-pending-objects c: farm < 1)
    (goal gl-current-build-item FARMS)
    (or	(wood-amount >= 310)
    (building-type-count-total farm < 2))
=>
    (set-escrow-percentage wood 0)
    (release-escrow wood)
    (build farm)
)

; ============================================================
