; AUTHENTICATED DONOR RULE 1950 | REGION=QSPECIAL_TIMERS_TAIL | DONOR_LINE=22548
; Timer re-arm block + turn counter (donor rules 1950-1956). Transplanted
; 2026-09-17: these rules self-maintain all heartbeat timers and derive the
; gl-*-turn phase goals consumed across the construction interval. No jumps,
; no escrow, no search; order appended after 1949 preserves donor sequence.
(defrule
    (up-timer-status 30SEC != timer-running)
=>
    (enable-timer 30SEC 30)
)

; AUTHENTICATED DONOR RULE 1951 | REGION=QSPECIAL_TIMERS_TAIL | DONOR_LINE=22554
(defrule
    (up-timer-status ONE-MINUTE != timer-running)
=>
    (enable-timer ONE-MINUTE 60)
)

