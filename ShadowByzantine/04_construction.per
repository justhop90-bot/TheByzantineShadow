    (up-compare-goal MILL != YES)
    (up-pending-objects c: farm < 3)
    (building-type-count-total farm < 50)
    (building-type-count-total archery-range >= 2)
    (or	(wood-amount >= 120)
    (and(wood-amount >= 80)
    (building-type-count-total farm < 10)))
=>
    (set-goal SPLIT 1)
)

