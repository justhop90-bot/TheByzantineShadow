)

; ============================================================
; R07 RULE 1816
; ============================================================
; QHOUSE.
; Reads: game-time >= 50, gl-fifth-turn == 1, housing-headroom < 2.
; Writes: none.
; Escrow: none.
; Pending guard: none.
; Command: chat warning; up-assign-builders c: house c: 3.
; Completion observer: none.
; Note: false predicate is preserved exactly; it is not optimized away.
; Jump: none; fall-through -> 1817.
(defrule
    (false)
    (game-time >= 50)
    (goal gl-fifth-turn 1)
    (housing-headroom < 2)
=>
    (chat-to-player me "WARNING: Housed!!")
    (up-assign-builders c: house c: 3)
)

; ============================================================
; R07 RULE 1817
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: game-time > 6, housing-headroom < 5,
;        population-headroom != 0, can-build-with-escrow house,
;        pending house < 1, archery-range >= 2.
; Writes: placement-data state via up-set-placement-data.
; Escrow: feasibility through can-build-with-escrow house.
; Pending guard: up-pending-objects c: house < 1.
; Command: up-build place-control gl-escrow-state c: house;
;          up-set-placement-data me -1 c: -5.
; Completion observer: none.
; Jump: none; fall-through -> 1818.
(defrule
    (game-time > 6)
    (housing-headroom < 5)
    (population-headroom != 0)
    (can-build-with-escrow house)
    (up-pending-objects c: house < 1)
    (building-type-count archery-range >= 2)
=>
    (up-build place-control gl-escrow-state c: house)
    (up-set-placement-data me -1 c: -5)
)

; ============================================================
; R07 RULE 1818
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: game-time > 6, housing-headroom < 2,
;        population-headroom != 0, can-build-with-escrow house,
;        pending house < 1.
; Writes: placement-data state via up-set-placement-data.
; Escrow: feasibility through can-build-with-escrow house.
; Pending guard: up-pending-objects c: house < 1.
; Command: up-build place-control gl-escrow-state c: house;
;          up-set-placement-data me -1 c: -5.
; Completion observer: none.
; Jump: none; fall-through -> 1819.
(defrule
    (game-time > 6)
    (housing-headroom < 2)
    (population-headroom != 0)
    (can-build-with-escrow house)
    (up-pending-objects c: house < 1)
=>
    (up-build place-control gl-escrow-state c: house)
    (up-set-placement-data me -1 c: -5)
)

; ============================================================
; R07 RULE 1819
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house.
; Writes: placement-data; disables self.
; Escrow: none.
; Pending guard: none.
; Command: up-set-placement-data me villager-class c: 0;
;          up-build place-control 0 c: house;
;          up-assign-builders c: house c: 2.
; Completion observer: none.
; Jump: none; fall-through -> 1820.
(defrule
    (can-build house)
=>
    (up-set-placement-data me villager-class c: 0)
    (up-build place-control 0 c: house)
    (up-assign-builders c: house c: 2)
    (disable-self)
)

; ============================================================
; R07 RULE 1820
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house, civilian-population < 6, house count > 0,
;        sheep availability.
; Writes: placement-data; disables self.
; Escrow: none.
; Pending guard: none.
; Command: up-set-placement-data me villager-class c: 1;
;          up-build place-control 0 c: house;
;          up-assign-builders c: house c: 1.
; Completion observer: house count > 0 is an input predicate only;
;                     it is not a completion write.
; Jump: none; fall-through -> 1821.
(defrule
    (can-build house)
    (civilian-population < 6)
    (building-type-count-total house > 0)
    (or	(up-gaia-type-count c: sheep > 1)
    (up-object-type-count c: sheep > 0))
=>
    (up-set-placement-data me villager-class c: 1)
    (up-build place-control 0 c: house)
    (up-assign-builders c: house c: 1)
    (disable-self)
)

