    (or	(food-amount < 750)
    (gold-amount < 160))
    (can-sell-commodity wood)
    (goal gl-current-build-item CUP)
=>
    (chat-to-player me "Sell wood for up")
    (sell-commodity wood)
)

; ============================================================
; R07 RULE 1865
; ============================================================
; Reads disabled false predicate, commodity-sell feasibility and food/wood/stone thresholds; writes no persistent state; command sell-commodity stone is unreachable while false remains false; no pending, placement, or completion observer.
(defrule
    (false)
    (can-sell-commodity stone)
    (or	(and(gold-amount < 100)
    (stone-amount >= 220))
    (or	(and(wood-amount < 100)
    (stone-amount >= 220))
    (and(food-amount < 100)
    (stone-amount >= 230))))
=>
    (chat-to-player me "Sell stone")
    (sell-commodity stone)
)

; ============================================================
; R07 RULE 1866
; ============================================================
; Reads can-build-with-escrow(mill), food resource/time, gl-current-build-item=MILL1, mill count and build-delay timer; writes adjacent-dropsite policy, wood escrow percentage=0, and timer t-build-delay; escrow releases wood; command build mill; no pending/placement; no completion observer in this rule.
(defrule
    (can-build-with-escrow mill)
    (or (resource-found food)
    (game-time >= SkipMillTime))
    (goal gl-current-build-item MILL1)
    (building-type-count-total mill < 1)
    (up-timer-status t-build-delay != timer-running)
=>
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-escrow-percentage wood 0)
    (enable-timer t-build-delay 3)
    ;	(chat-to-player me "Mill1")
    (release-escrow wood)
    (build mill)
)

