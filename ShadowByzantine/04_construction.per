)

; AUTHENTICATED DONOR RULE 1796 | REGION=R07 | BODY_SHA256=ad8c49cde3a107f31ebded4483befb289e826c53df8606490c647ba9ae297863
(defrule	;basically, build farms unless time for blacksmith (12 farms with berries
    (idle-farm-count < 2)
