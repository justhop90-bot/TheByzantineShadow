; Reads commodity-sell feasibility, gl-current-build-item, food/gold/wood thresholds and gl-build-progress; writes no persistent state; command sell-commodity wood; no pending, placement, or completion observer.
(defrule
    (can-sell-commodity wood)
    (up-compare-goal gl-current-build-item != EXTRA-STABLES)
    (or	(and(gold-amount < 60)
    (wood-amount >= 260))
    (and(food-amount < 60)
    (or	(wood-amount >= 270)
    (and(wood-amount >= 190)
    (up-compare-goal gl-build-progress < 13)))))
=>
    ;	(chat-to-player me "Sell wood")
