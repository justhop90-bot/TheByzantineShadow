(defrule
    (up-timer-status THREE-MINUTE != timer-running)
=>
    (enable-timer THREE-MINUTE 180)
)

; AUTHENTICATED DONOR RULE 1953 | REGION=QSPECIAL_TIMERS_TAIL | DONOR_LINE=22566
(defrule
    (up-timer-status TWO-MINUTE != timer-running)
=>
    (enable-timer TWO-MINUTE 120)
)

; AUTHENTICATED DONOR RULE 1954 | REGION=QSPECIAL_TIMERS_TAIL | DONOR_LINE=22572
(defrule
    (up-timer-status five-seconds-timer != timer-running)
=>
    (enable-timer five-seconds-timer 5)
)

; AUTHENTICATED DONOR RULE 1955 | REGION=QSPECIAL_TIMERS_TAIL | DONOR_LINE=22578
(defrule
    (true)
=>
    (up-modify-goal gl-turn-count c:+ 1)
    (up-modify-goal gl-second-turn g:= gl-turn-count)
    (up-modify-goal gl-second-turn c:mod 2)
    (up-modify-goal gl-fifth-turn g:= gl-turn-count)
    (up-modify-goal gl-fifth-turn c:mod 5)
    (up-modify-goal gl-seventh-turn g:= gl-turn-count)
    (up-modify-goal gl-seventh-turn c:mod 7)
    (up-modify-goal gl-tenth-turn g:= gl-turn-count)
    (up-modify-goal gl-tenth-turn c:mod 10)
)

; AUTHENTICATED DONOR RULE 1956 | REGION=QSPECIAL_TIMERS_TAIL | DONOR_LINE=22592
(defrule
    (true)
=>
    (up-modify-goal gl-twenty-turn g:= gl-turn-count)
    (up-modify-goal gl-twenty-turn c:mod 20)
    (up-modify-goal gl-fifty-turn g:= gl-turn-count)
    (up-modify-goal gl-fifty-turn c:mod 50)
    (up-modify-goal gl-ninety-turn g:= gl-turn-count)
    (up-modify-goal gl-ninety-turn c:mod 90)
    (up-modify-goal gl-thirty-turn g:= gl-turn-count)
    (up-modify-goal gl-thirty-turn c:mod 30)
)
