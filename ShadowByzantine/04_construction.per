; ============================================================
; DONOR COMPATIBILITY CONSTANTS
; ============================================================
;
; These are exact donor numeric identities required by rules
; 1794-1814 and not yet present in the central constant registry.
; They are kept local temporarily so the implementation can be
; statically closed without inventing values. Migration into
; 01_constants.per is a follow-up cleanup once the complete R07
; identifier set is centralized.
;
(defconst with-escrow 0)
(defconst without-escrow 1)
(defconst place-control 2)
(defconst place-point 3)
(defconst MILL 225)
(defconst ESKIRMS 19)
(defconst FletchingNumber 9)
(defconst goal 165)
(defconst gl-enemy-strategy 170)
(defconst gl-town-safe 300)
(defconst DRUSH -1)
(defconst SIEGE 184)

; ============================================================
; R07 RULE 1794
; ============================================================
;
; DIRECT DONOR MAPPING
; Reads:
;   gl-second-turn == 1
;   gl-strategy == FLUSH
;   gl-escrow-state via up-can-build
;   gl-build-progress < FletchingNumber
;   wood-amount >= 370 OR (wood >= 250 AND archery-range >= 2)
; Writes:
;   none
; Escrow:
;   feasibility is evaluated through up-can-build with
;   gl-escrow-state; no explicit release/mutation occurs here.
; Pending guard:
;   none
; Command:
;   up-build place-normal gl-escrow-state c: farm
; Completion observer:
;   none
; Jump:
;   none; fall-through -> 1795
;
(defrule
    (goal gl-second-turn 1)
    (goal gl-strategy FLUSH)
    (up-can-build gl-escrow-state c: farm)
    (up-compare-goal gl-build-progress < FletchingNumber)
    (or	(wood-amount >= 370)
    (and(wood-amount >= 250)
    (building-type-count-total archery-range >= 2)))
=>
    (up-build place-normal gl-escrow-state c: farm)
)

; ============================================================
; R07 RULE 1795
; ============================================================
;
; Reads:
;   current-age == dark-age
;   can-build-with-escrow(farm)
;   gl-strategy == KRUSH
;   pending farm < 1
;   gl-current-build-item == FARMS
;   farm count < 4
;   wood >= 90 OR housing-headroom >= 4 OR pending farm < 1
; Writes: none
; Escrow: release-escrow wood
; Pending guard: up-pending-objects c: farm < 1
; Command: build farm
; Completion observer: none
; Jump: none; fall-through -> 1796
;
(defrule
    (current-age == dark-age)
    (can-build-with-escrow farm)
    (goal gl-strategy KRUSH)
    (up-pending-objects c: farm < 1)
    (goal gl-current-build-item FARMS)
    (building-type-count-total farm < 4)
    (or (wood-amount >= 90)
    (or	(housing-headroom >= 4)
    (up-pending-objects c: farm < 1)))
=>
    (release-escrow wood)
    (build farm)
)

; ============================================================
; R07 RULE 1796
; ============================================================
;
; Reads: gl-strategy == KRUSH; gl-current-build-item == FARMS;
;       farm count >= 4
; Writes: gl-build-progress += 1
; Escrow: none
; Pending guard: none
; Command: none
; Completion observer: building-type-count-total farm >= 4
; Jump: none; fall-through -> 1797
;
(defrule
    (goal gl-strategy KRUSH)
    (goal gl-current-build-item FARMS)
    (building-type-count-total farm >= 4)
=>
    (up-modify-goal gl-build-progress c:+ 1)
    (disable-self)
)

; ============================================================
; R07 RULE 1797
; ============================================================
;
; Reads: gl-strategy == KRUSH; farm count < 4;
;       gl-build-progress > KrushFarmsNumber
; Writes: gl-build-progress = KrushFarmsNumber
; Escrow: none
; Pending guard: none
; Command: none
; Completion observer: contradiction/reconciliation condition only
; Jump: none; fall-through -> 1798
;
(defrule
    (goal gl-strategy KRUSH)
    (building-type-count-total farm < 4)
    (up-compare-goal gl-build-progress > KrushFarmsNumber)
=>
    (set-goal gl-build-progress KrushFarmsNumber)
)

; ============================================================
; R07 RULE 1798
; ============================================================
;
; Reads: gl-current-build-item != FARMS;
;       gl-build-progress == KrushFarmsNumber
; Writes: gl-current-build-item = FARMS
; Escrow: none
; Pending guard: none
; Command: none
; Completion observer: none
; Jump: none; fall-through -> 1799
;
(defrule
    (goal gl-strategy KRUSH)
    (up-compare-goal gl-current-build-item != FARMS)
    (up-compare-goal gl-build-progress == KrushFarmsNumber)
=>
    (set-goal gl-current-build-item FARMS)
)

; ============================================================
; R07 RULE 1799
; ============================================================
;
; Reads: current-age == dark-age; can-build-with-escrow(farm);
;       KRUSH; pending farm < 1; current item FARMS2; farm < 7;
;       wood >= 90 OR housing-headroom >= 3
; Writes: none
; Escrow: release-escrow wood
; Pending guard: up-pending-objects c: farm < 1
; Command: build farm
; Completion observer: none
; Jump: none; fall-through -> 1800
;
(defrule
    (current-age == dark-age)
    (can-build-with-escrow farm)
    (or (wood-amount >= 90)
    (housing-headroom >= 3))
    (goal gl-strategy KRUSH)
    (up-pending-objects c: farm < 1)
    (goal gl-current-build-item FARMS2)
    (building-type-count-total farm < 7)
=>
    (release-escrow wood)
    (build farm)
)

