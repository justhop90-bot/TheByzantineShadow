; ============================================================
; R07 SOURCE-ORDER / CONTROL-FLOW NOTE
; ============================================================
; 1794-1849 contains no explicit up-jump-rule in the authenticated donor.
; The source-order fall-through successor after rule 1849 is 1850.
; QLC preserves the donor's distributed progression topology:
;   objective/build item -> feasibility -> escrow -> build command
;   -> world-state lumber-camp observer -> progression/reconciliation
;   -> current-build-item re-entry.
; Build commands and builder/placement operations remain execution
; mechanisms; they are not completion proof without world-state evidence.

; ============================================================
; R07 RULE 1850
; ============================================================
; Control-flow jump: reads no persistent state; writes none; command is up-jump-rule 4; no pending/placement/completion observer; explicit jump target resolves to 1854.
(defrule
    (true)
=>
    (up-jump-rule 4)
)

; ============================================================
; R07 RULE 1851
; ============================================================
; Reads gl-progression-pause, gl-current-build-item, can-build-with-escrow(lumber-camp); writes wood escrow percentage=0; escrow releases wood; command build lumber-camp; no pending guard or placement operation; no completion observer in this rule.
(defrule
    (goal gl-progression-pause -1)
    (goal gl-current-build-item LC4)
    (can-build-with-escrow lumber-camp)
=>
    (chat-to-player me "Fourth Lumber Camp")
    (set-escrow-percentage wood 0)
    (release-escrow wood)
    (build lumber-camp)
)

; ============================================================
; R07 RULE 1852
; ============================================================
; Reads gl-strategy, gl-build-progress, lumber-camp count; writes gl-build-progress=LC4Number for skipped-state reconciliation; no escrow, pending, placement, or command; lumber-camp<4 is reconciliation evidence.
(defrule	;come back if skipped
    (goal gl-strategy FLUSH)
    (building-type-count-total lumber-camp < 4)
    (up-compare-goal gl-build-progress > LC4Number)
=>
    (set-goal gl-build-progress LC4Number)
)

; ============================================================
; R07 RULE 1853
; ============================================================
; Reads gl-strategy, gl-current-build-item, gl-build-progress; writes gl-current-build-item=LC4 and wood escrow percentage=LOW-ESCROW; no pending/placement/command; no completion observer.
(defrule
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-current-build-item != LC4)
    (up-compare-goal gl-build-progress == LC4Number)
=>
    ;	(chat-to-player me "Setting current build item to LC4")
    (set-goal gl-current-build-item LC4)
    (set-escrow-percentage wood LOW-ESCROW)
)

; ============================================================
; R07 RULE 1854
; ============================================================
; Reads gl-current-build-item and lumber-camp count; writes gl-build-progress+=1; no escrow/pending/placement/command; lumber-camp>=4 is the completion/progression observer.
(defrule
    (goal gl-current-build-item LC4)
    (building-type-count-total lumber-camp >= 4)
=>
    (up-modify-goal gl-build-progress c:+ 1)
    ;	(chat-to-player me "Fourth Lumber Camp Built")
)

; ============================================================
; R07 RULE 1855
; ============================================================
; Reads time, gl-strategy, lumber-camp timer status/distance and gl-escrow-state via up-can-build; writes dropsite separation, placement mode through up-build, adjacent-dropsite policy, and timer t-lc; placement operation is place-normal lumber-camp; no pending guard; command is up-build place-normal; no completion observer.
(defrule
    (or	(game-time >= 1570)	;25.5 min
    (and(game-time >= 1260)	;21 min
    (goal gl-strategy KRUSH)))
    (or	(up-timer-status t-lc != timer-running)
    (dropsite-min-distance wood >= 5))
    (up-can-build gl-escrow-state c: lumber-camp)
=>
    (set-strategic-number sn-dropsite-separation-distance 3)
    (up-build place-normal gl-escrow-state c: lumber-camp)
    (set-strategic-number sn-allow-adjacent-dropsites 1)
    ;	(chat-to-player me "ADDITIONAL LC")
    (enable-timer t-lc 290)
)

; ============================================================
; R07 RULE 1856
; ============================================================
; Reads food amount, commodity-buy feasibility, gold amount and gl-build-progress; writes no persistent AI state; command buy-commodity food; no pending, placement, or completion observer.
(defrule
    (food-amount < 50)
    (can-buy-commodity food)
    (or	(gold-amount >= 230)
    (and(gold-amount >= 170)
    (up-compare-goal gl-build-progress < 13)))
=>
    (chat-to-player me "Buy food")
    (buy-commodity food)
)

; ============================================================
; R07 RULE 1857
; ============================================================
; Reads commodity-buy feasibility, food/gold thresholds and gl-current-build-item=CUP; writes no persistent state; command buy-commodity food; no pending, placement, or completion observer.
(defrule
    (can-buy-commodity food)
    (or	(and(food-amount < 800)
    (gold-amount >= 300))
    (or	(and(food-amount < 550)
    (gold-amount >= 240))
    (and(food-amount < 640)
    (gold-amount >= 280))))
    (goal gl-current-build-item CUP)
=>
    (chat-to-player me "Buy food for cup")
    (buy-commodity food)
)

; ============================================================
; R07 RULE 1858
; ============================================================
; Reads wood amount, gold amount, gl-current-build-item and commodity-buy feasibility; writes no persistent state; command buy-commodity wood; no pending, placement, or completion observer.
(defrule
    (wood-amount < 50)
    (or	(gold-amount >= 320)
    (and(gold-amount >= 240)
    (or	(up-compare-goal gl-current-build-item < LC3)
    (up-compare-goal gl-current-build-item >= GOLDMINING))))
    (can-buy-commodity wood)
=>
    (chat-to-player me "Buy wood")
    (buy-commodity wood)
)

; ============================================================
; R07 RULE 1859
; ============================================================
; Reads gold/food amounts, commodity-sell feasibility and castle-age research status; writes no persistent state; command sell-commodity food; no pending, placement, or completion observer.
(defrule
    (gold-amount < 100)
    (food-amount >= 320)
    (can-sell-commodity food)
    (up-research-status c: castle-age >= research-pending)
=>
    (chat-to-player me "Sell food")
    (sell-commodity food)
)

; ============================================================
; R07 RULE 1860
; ============================================================
; Reads commodity-sell feasibility, gold/food thresholds and gl-current-build-item=CUP; writes no persistent state; command sell-commodity food; no pending, placement, or completion observer.
(defrule
    (can-sell-commodity food)
    (or	(and(gold-amount < 160)
    (food-amount >= 880))
    (and(gold-amount < 200)
    (food-amount >= 980)))
    (goal gl-current-build-item CUP)
=>
    (chat-to-player me "Sell food for up")
    (sell-commodity food)
)

; ============================================================
; R07 RULE 1861
; ============================================================
; Reads wood amount, gl-strategy=FLUSH, commodity-sell feasibility and gl-build-progress; writes no persistent state; command sell-commodity wood; no pending, placement, or completion observer.
