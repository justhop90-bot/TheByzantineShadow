; ============================================================
; R07 RULE 1823
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house, housing-headroom < 4,
;        population-headroom != 0, house count < 5,
;        pending house < 1.
; Writes: placement-data; sn-placement-zone-size = 5;
;         sn-placement-fail-delta = 2.
; Escrow: none.
