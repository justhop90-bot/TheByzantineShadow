; ============================================================
; R07 RULE 1870
; ============================================================
; Reads gl-current-build-item, gl-dark-build and gl-build-progress; writes wood escrow percentage=LOW-ESCROW and gl-current-build-item=MILL1; no pending/placement/command; no completion observer.
(defrule
    (up-compare-goal gl-current-build-item != MILL1)
    (or	(and(goal gl-dark-build MillFirst)
    (up-compare-goal gl-build-progress == 1))
    (and(goal gl-dark-build LumberFirst)
    (up-compare-goal gl-build-progress == 2)))
=>
    ;	(chat-to-player me "Setting current build item to MILL1")
    (set-escrow-percentage wood LOW-ESCROW)
    (set-goal gl-current-build-item MILL1)
)

; ============================================================
; R07 RULE 1871
; ============================================================
; Reads can-build(mill), food resource-found, current age and mill count; writes none persistently; command build mill followed by disable-self; no pending/placement; mill<1 is an entry guard, not completion proof.
(defrule
    (can-build mill)
    (resource-found food)
    (current-age >= feudal-age)
    (building-type-count-total mill < 1)
=>
    (chat-to-player me "Mill B")
    ;	(set-goal gl-allow-mill YES)
    (build mill)
    (disable-self)
)

; ============================================================
; R07 RULE 1872
; ============================================================
; Reads no persistent state; writes generic goal=-12; no escrow/pending/placement/command/completion observer.
(defrule
    (true)
=>
    (set-goal goal -12)
)

; ============================================================
; R07 RULE 1873
; ============================================================
; Reads mill count; writes generic goal=-10; no escrow/pending/placement/command/completion observer.
(defrule
    (building-type-count-total mill == 2)
=>
    (set-goal goal -10)
)

; ============================================================
; R07 RULE 1874
; ============================================================
; Reads mill count; writes generic goal=10; no escrow/pending/placement/command; mill==3 is an observed world-state threshold used to write the goal, not completion of a command in this rule.
(defrule
    (building-type-count-total mill == 3)
=>
    (set-goal goal 10)
)

; ============================================================
; R07 1850-1874 SOURCE-ORDER NOTE
; ============================================================
; Rules are appended in authenticated donor order. Rule 1850 is an explicit
; up-jump-rule (+4) whose positional target is rule 1854. Rules 1851-1874
; then proceed by normal source-order fall-through. Command issuance remains
; distinct from world-state completion; observed building counts are the
; completion/progression evidence where explicitly used by the donor.

; ============================================================
; R07 RULE 1875 -- AUTHENTICATED DONOR DOCUMENTATION
; ============================================================
; State reads: goal MILL YES; can-build mill; building-type-count-total mill < 4
; State writes: set-goal MILL NO
; Pending guards: none
; Commands: up-build place-control 0 c: mill; up-assign-builders c: mill c: 1
; Placement operations: up-set-placement-data me mill g: goal; up-build place-control 0 c: mill
; Completion/world observers: building-type-count-total mill < 4
; Explicit jumps: none
; Source-order semantics: fall-through successor is R07 rule 1876;
;                        explicit jump targets, if any, are preserved verbatim.
; Evidence: DIRECT_DONOR_TEXT for the rule body; documentation fields are
;          mechanically extracted annotations and are not runtime proof.

(defrule
    (goal MILL YES)
    (can-build mill)
    (building-type-count-total mill < 4)
=>
    ;	(up-chat-data-to-player me "FARMING MILL(%d)" g: goal)
    (up-set-placement-data me mill g: goal)
    (up-build place-control 0 c: mill)
    (up-assign-builders c: mill c: 1)
    (set-goal MILL NO)
)

; ============================================================
; R07 RULE 1876 -- AUTHENTICATED DONOR DOCUMENTATION
; ============================================================
; State reads: up-compare-goal MILL != YES; up-pending-placement c: mill; building-type-count-total mill < 2; building-type-count-total farm > 20; building-type-count-total mill < 3; building-type-count-total farm > 28; building-type-count-total mill < 4; building-type-count-total farm > 38
; State writes: set-goal MILL YES
; Pending guards: up-pending-placement c: mill
; Commands: none
; Placement operations: none
; Completion/world observers: building-type-count-total mill < 2; building-type-count-total farm > 20; building-type-count-total mill < 3; building-type-count-total farm > 28; building-type-count-total mill < 4; building-type-count-total farm > 38
; Explicit jumps: none
; Source-order semantics: fall-through successor is R07 rule 1877;
;                        explicit jump targets, if any, are preserved verbatim.
; Evidence: DIRECT_DONOR_TEXT for the rule body; documentation fields are
;          mechanically extracted annotations and are not runtime proof.

(defrule
    (up-compare-goal MILL != YES)
    (not(up-pending-placement c: mill))
    (or	(and(building-type-count-total mill < 2)
    (building-type-count-total farm > 20))
    (or	(and(building-type-count-total mill < 3)
    (building-type-count-total farm > 28))
    (and(building-type-count-total mill < 4)
    (building-type-count-total farm > 38))))
=>
    ;	(chat-to-player me "NEED MILL")
    (set-goal MILL YES)
)

