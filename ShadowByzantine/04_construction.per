    (set-goal gl-current-build-item FARMS)
)

; ============================================================
; R07 RULE 1815
; ============================================================
; QHOUSE.
; Reads: true.
; Writes: none.
; Escrow: none.
; Pending guard: none.
; Command: up-assign-builders c: house c: 1.
; Completion observer: none.
; Jump: none; fall-through -> 1816.
(defrule
    (true)
=>
    (up-assign-builders c: house c: 1)
)

; ============================================================
; R07 RULE 1816
; ============================================================
; QHOUSE.
; Reads: game-time >= 50, gl-fifth-turn == 1, housing-headroom < 2.
; Writes: none.
; Escrow: none.
; Pending guard: none.
; Command: chat warning; up-assign-builders c: house c: 3.
; Completion observer: none.
; Note: false predicate is preserved exactly; it is not optimized away.
; Jump: none; fall-through -> 1817.
(defrule
    (false)
    (game-time >= 50)
    (goal gl-fifth-turn 1)
    (housing-headroom < 2)
=>
    (chat-to-player me "WARNING: Housed!!")
    (up-assign-builders c: house c: 3)
)

; ============================================================
; R07 RULE 1817
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: game-time > 6, housing-headroom < 5,
;        population-headroom != 0, can-build-with-escrow house,
;        pending house < 1, archery-range >= 2.
; Writes: placement-data state via up-set-placement-data.
; Escrow: feasibility through can-build-with-escrow house.
; Pending guard: up-pending-objects c: house < 1.
; Command: up-build place-control gl-escrow-state c: house;
;          up-set-placement-data me -1 c: -5.
; Completion observer: none.
; Jump: none; fall-through -> 1818.
(defrule
    (game-time > 6)
    (housing-headroom < 5)
    (population-headroom != 0)
    (can-build-with-escrow house)
    (up-pending-objects c: house < 1)
    (building-type-count archery-range >= 2)
=>
    (up-build place-control gl-escrow-state c: house)
    (up-set-placement-data me -1 c: -5)
)

; ============================================================
; R07 RULE 1818
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: game-time > 6, housing-headroom < 2,
;        population-headroom != 0, can-build-with-escrow house,
;        pending house < 1.
; Writes: placement-data state via up-set-placement-data.
; Escrow: feasibility through can-build-with-escrow house.
; Pending guard: up-pending-objects c: house < 1.
; Command: up-build place-control gl-escrow-state c: house;
;          up-set-placement-data me -1 c: -5.
; Completion observer: none.
; Jump: none; fall-through -> 1819.
(defrule
    (game-time > 6)
    (housing-headroom < 2)
    (population-headroom != 0)
    (can-build-with-escrow house)
    (up-pending-objects c: house < 1)
=>
    (up-build place-control gl-escrow-state c: house)
    (up-set-placement-data me -1 c: -5)
)

; ============================================================
; R07 RULE 1819
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house.
; Writes: placement-data; disables self.
; Escrow: none.
; Pending guard: none.
; Command: up-set-placement-data me villager-class c: 0;
;          up-build place-control 0 c: house;
;          up-assign-builders c: house c: 2.
; Completion observer: none.
; Jump: none; fall-through -> 1820.
(defrule
    (can-build house)
=>
    (up-set-placement-data me villager-class c: 0)
    (up-build place-control 0 c: house)
    (up-assign-builders c: house c: 2)
    (disable-self)
)

; ============================================================
; R07 RULE 1820
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house, civilian-population < 6, house count > 0,
;        sheep availability.
; Writes: placement-data; disables self.
; Escrow: none.
; Pending guard: none.
; Command: up-set-placement-data me villager-class c: 1;
;          up-build place-control 0 c: house;
;          up-assign-builders c: house c: 1.
; Completion observer: house count > 0 is an input predicate only;
;                     it is not a completion write.
; Jump: none; fall-through -> 1821.
(defrule
    (can-build house)
    (civilian-population < 6)
    (building-type-count-total house > 0)
    (or	(up-gaia-type-count c: sheep > 1)
    (up-object-type-count c: sheep > 0))
=>
    (up-set-placement-data me villager-class c: 1)
    (up-build place-control 0 c: house)
    (up-assign-builders c: house c: 1)
    (disable-self)
)

; ============================================================
; R07 RULE 1821
; ============================================================
; QHOUSE control-state write.
; Reads: true.
; Writes: generic goal = 12.
; Escrow: none.
; Pending guard: none.
; Command: none.
; Completion observer: none.
; Jump: none; fall-through -> 1822.
(defrule
    (true)
=>
    (set-goal goal 12)
)

; ============================================================
; R07 RULE 1822
; ============================================================
; QHOUSE control-state write.
; Reads: gl-enemy-strategy == DRUSH OR gl-town-safe != YES.
; Writes: generic goal = -5.
; Escrow: none.
; Pending guard: none.
; Command: none.
; Completion observer: none.
; Jump: none; fall-through -> 1823.
(defrule
    (or	(goal gl-enemy-strategy DRUSH)
    (up-compare-goal gl-town-safe != YES))
=>
    (set-goal goal -5)
)

; ============================================================
; R07 RULE 1823
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house, housing-headroom < 4,
;        population-headroom != 0, house count < 5,
;        pending house < 1.
; Writes: placement-data; sn-placement-zone-size = 5;
;         sn-placement-fail-delta = 2.
; Escrow: none.
; Pending guard: up-pending-objects c: house < 1.
; Command: up-set-placement-data me -1 c: 10;
;          up-build place-control 0 c: house;
;          up-assign-builders c: house c: 1.
; Completion observer: none.
; Jump: none; fall-through -> 1824.
(defrule
    (can-build house)
    (housing-headroom < 4)
    (population-headroom != 0)
    (building-type-count house < 5)
    (up-pending-objects c: house < 1)
=>
    (up-set-placement-data me -1 c: 10)
    (set-strategic-number sn-placement-zone-size 5)
    (set-strategic-number sn-placement-fail-delta 2)
    (up-build place-control 0 c: house)
    (up-assign-builders c: house c: 1)
)

; ============================================================
; R07 RULE 1824
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house, housing-headroom < 4,
;        population-headroom != 0, house count >= 5,
;        pending house < 1, archery-range < 1.
; Writes: placement-data; sn-placement-zone-size = 5;
;         sn-placement-fail-delta = 2.
; Escrow: none.
; Pending guard: up-pending-objects c: house < 1.
; Command: up-set-placement-data me -1 g: goal;
;          up-build place-control 0 c: house;
;          up-assign-builders c: house c: 1.
; Completion observer: house >= 5 and archery-range < 1 are
;                     decision predicates, not completion proof.
; Jump: none; fall-through -> 1825.
(defrule
    (can-build house)
    (housing-headroom < 4)
    (population-headroom != 0)
    (building-type-count house >= 5)
    (up-pending-objects c: house < 1)
    (building-type-count archery-range < 1)
=>
    (up-set-placement-data me -1 g: goal)
    (set-strategic-number sn-placement-zone-size 5)
    (set-strategic-number sn-placement-fail-delta 2)
    (up-build place-control 0 c: house)
    (up-assign-builders c: house c: 1)
)

; ============================================================
; R07 RULE 1825
; ============================================================
; QHOUSE / CONTROL placement.
; Reads: can-build house, housing-headroom < 10,
;        population-headroom != 0, pending house < 1,
;        (KRUSH AND stable >= 2) OR archery-range >= 2.
; Writes: placement-data; sn-placement-zone-size = 5;
;         sn-placement-fail-delta = 2.
; Escrow: none.
; Pending guard: up-pending-objects c: house < 1.
; Command: up-set-placement-data me -1 g: goal;
;          up-build place-control 0 c: house.
; Completion observer: none.
; Jump: none; fall-through -> 1826.
(defrule
    (can-build house)
    (housing-headroom < 10)
    (population-headroom != 0)
    (up-pending-objects c: house < 1)
    (or	(and(goal gl-strategy KRUSH)
    (building-type-count-total stable >= 2))
    (building-type-count-total archery-range >= 2))
=>
    (up-set-placement-data me -1 g: goal)
    (set-strategic-number sn-placement-zone-size 5)
    (set-strategic-number sn-placement-fail-delta 2)
    (up-build place-control 0 c: house)
)

; ============================================================
; R07 RULE 1826
; ============================================================
; QHOUSE arbitration entry.
; Reads: can-build house, housing-headroom < 15,
;        population-headroom != 0, pending house < 2,
;        FLUSH+stable>=1 OR KRUSH+stable>=3 OR
;        SIEGE+siege-workshop>=1.
; Writes: SPLIT = 1.
; Escrow: none.
; Pending guard: up-pending-objects c: house < 2.
; Command: none.
; Completion observer: none.
; Jump: none; fall-through -> 1827.
(defrule
    (can-build house)
    (housing-headroom < 15)
    (population-headroom != 0)
    (up-pending-objects c: house < 2)
    (or	(and(goal gl-strategy FLUSH)
    (building-type-count stable >= 1))
    (or	(and(goal gl-strategy KRUSH)
    (building-type-count-total stable >= 3))
    (and(goal gl-strategy SIEGE)
    (building-type-count siege-workshop >= 1))))
=>
    (set-goal SPLIT 1)
)

; ============================================================
; R07 RULE 1827
; ============================================================
; QHOUSE arbitration execution.
; Reads: SPLIT == 1.
; Writes: placement-data; sn-placement-zone-size = 5;
;         sn-placement-fail-delta = 2; SPLIT = 0.
; Escrow: none.
; Pending guard: none.
; Command: up-set-placement-data me -1 g: goal;
;          up-build place-control 0 c: house.
; Completion observer: none.
; Jump: none; fall-through -> 1828.
(defrule
    (goal SPLIT 1)
=>
    (up-set-placement-data me -1 g: goal)
    (set-strategic-number sn-placement-zone-size 5)
    (set-strategic-number sn-placement-fail-delta 2)
    (up-build place-control 0 c: house)
    (set-goal SPLIT 0)
)

; ============================================================
; R07 SOURCE-ORDER / CONTROL-FLOW NOTE
; ============================================================
; No explicit up-jump-rule occurs in 1794-1827.
; Therefore the donor fall-through chain is preserved:
;   1794 -> 1795 -> ... -> 1827 -> 1828.
; Builder assignment is execution authority, not completion evidence.
; CONTROL placement is spatial realization; it does not advance
; construction progression by itself.
