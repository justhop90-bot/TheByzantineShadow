; ============================================================
; Reads gl-dark-build=MillFirst, mill count and gl-build-progress; writes gl-build-progress=1 for skipped-state reconciliation; no escrow/pending/placement/command; mill<1 is reconciliation evidence.
(defrule	;if skipped come back
    ;	(game-time < SkipMillTime)
    (goal gl-dark-build MillFirst)
    (building-type-count-total mill < 1)
    (up-compare-goal gl-build-progress > 1)
=>
    (set-goal gl-build-progress 1)
)

; ============================================================
; R07 RULE 1869
; ============================================================
; Reads gl-dark-build=LumberFirst, mill count and gl-build-progress; writes gl-build-progress=2 for skipped-state reconciliation; no escrow/pending/placement/command; mill<1 is reconciliation evidence.
