    (set-goal gl-current-build-item FARMS)
)

; ============================================================
; R07 RULE 1806 -- QHOUSE, NOT FARM
; ============================================================
;
; Reads: true
; Writes: none
; Escrow: none
; Pending guard: none
; Command: up-assign-builders house 1
; Completion observer: none
; Jump: none; fall-through -> 1807
;
(defrule
    (true)
=>
    (up-assign-builders c: house c: 1)
)

; ============================================================
; R07 RULE 1807 -- QHOUSE, NOT FARM
; ============================================================
;
; Reads: false; game-time >= 50; gl-fifth-turn == 1;
;       housing-headroom < 2
; Writes: none
; Escrow: none
; Pending guard: none
; Command: chat + up-assign-builders house 3
; Completion observer: none
; Jump: none; fall-through -> 1808
;
(defrule
    (false)
    (game-time >= 50)
    (goal gl-fifth-turn 1)
    (housing-headroom < 2)
=>
    (chat-to-player me "WARNING: Housed!!")
    (up-assign-builders c: house c: 3)
)

; ============================================================
; R07 RULE 1808 -- QHOUSE, NOT FARM
; ============================================================
;
; Reads: game-time > 6; housing-headroom < 5; population-headroom != 0;
;       can-build-with-escrow house; archery-range >= 2
; Writes: placement data via up-set-placement-data
; Escrow: feasibility uses escrow-aware build path
; Pending guard: house pending < 1
; Command: up-build place-control gl-escrow-state c: house;
;          up-set-placement-data me -1 c: -5
; Completion observer: none
; Jump: none; fall-through -> 1809
;
(defrule
    (game-time > 6)
    (housing-headroom < 5)
    (population-headroom != 0)
    (can-build-with-escrow house)
    (up-pending-objects c: house < 1)
    (building-type-count archery-range >= 2)
=>
    (up-build place-control gl-escrow-state c: house)
    (up-set-placement-data me -1 c: -5)
)

; ============================================================
; R07 RULE 1809 -- QHOUSE, NOT FARM
; ============================================================
;
; Reads: game-time > 6; housing-headroom < 2; population-headroom != 0;
;       can-build-with-escrow house
; Writes: placement data
; Escrow: feasibility uses escrow-aware build path
; Pending guard: house pending < 1
; Command: up-build place-control gl-escrow-state c: house;
;          up-set-placement-data me -1 c: -5
; Completion observer: none
; Jump: none; fall-through -> 1810
;
(defrule
    (game-time > 6)
    (housing-headroom < 2)
    (population-headroom != 0)
    (can-build-with-escrow house)
    (up-pending-objects c: house < 1)
=>
    (up-build place-control gl-escrow-state c: house)
    (up-set-placement-data me -1 c: -5)
)

; ============================================================
; R07 RULE 1810 -- QHOUSE, NOT FARM
; ============================================================
;
; Reads: can-build house
; Writes: placement data; rule self disabled
; Escrow: none
; Pending guard: none
; Command: up-set-placement-data; place-control house;
;          up-assign-builders house 2
; Completion observer: none
; Jump: none; fall-through -> 1811
;
(defrule
    (can-build house)
=>
    (up-set-placement-data me villager-class c: 0)
    (up-build place-control 0 c: house)
    (up-assign-builders c: house c: 2)
    (disable-self)
)

; ============================================================
; R07 RULE 1811 -- QHOUSE, NOT FARM
; ============================================================
;
; Reads: can-build house; civilian-population < 6;
;       house count > 0; sheep availability
; Writes: placement data; rule self disabled
; Escrow: none
; Pending guard: none
; Command: up-set-placement-data; place-control house;
;          up-assign-builders house 1
; Completion observer: house count > 0 is a predicate, not a
;                       completion write
; Jump: none; fall-through -> 1812
;
(defrule
    (can-build house)
    (civilian-population < 6)
    (building-type-count-total house > 0)
    (or	(up-gaia-type-count c: sheep > 1)
    (up-object-type-count c: sheep > 0))
=>
    (up-set-placement-data me villager-class c: 1)
    (up-build place-control 0 c: house)
    (up-assign-builders c: house c: 1)
    (disable-self)
)

