; ============================================
; THE BYZANTINE SHADOW
; MODULE 07 -- STRATEGIC RESERVE POLICY
; ============================================
;
; PURPOSE
;   Select the strategic reserve POLICY CLASS from engine state.
;
; IMPORTANT
;   Policy class != reserve amount.
;   This module no longer fabricates the missing numeric reserve
;   constants. The four resource reserve values remain an explicit
;   provider ABI input.
;
; Architecture:
;
;   ENGINE STATE
;       |
;       +-- current-age
;       +-- military-population
;       v
;   POLICY CLASS
;       |
;       v
;   AUTHORITATIVE RESERVE PROVIDER [UNQUALIFIED]
;       |
;       v
;   AEGIS-RESERVE-FOOD..STONE
;       |
;       v
;   MODULE 09
;
; Engine escrow remains separate from strategic reserve.
;
; ============================================
; POLICY INITIALIZATION
; ============================================

(defrule
    (true)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-EARLY)
    (set-goal AEGIS-RESERVE-POLICY-READY AEGIS-RESERVE-UNBOUND)
)

; ============================================
; POLICY CLASS SELECTION
; ============================================

(defrule
    (current-age == dark-age)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-EARLY)
)

(defrule
    (current-age == feudal-age)
    (military-population < 6)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-DEVELOPMENT)
)

(defrule
    (current-age == feudal-age)
    (military-population >= 6)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-MILITARY)
)

(defrule
    (current-age == castle-age)
    (military-population < 12)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-DEVELOPMENT)
)

(defrule
    (current-age == castle-age)
    (military-population >= 12)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-MILITARY)
)

(defrule
    (current-age == imperial-age)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-LATE)
)

; ============================================
; PROVIDER HANDSHAKE
; ============================================
;
; No rule in this module writes a numeric reserve amount.
;
; A separate authoritative provider must populate:
;   AEGIS-RESERVE-INPUT-FOOD
;   AEGIS-RESERVE-INPUT-WOOD
;   AEGIS-RESERVE-INPUT-GOLD
;   AEGIS-RESERVE-INPUT-STONE
;
; and only then set:
;   AEGIS-RESERVE-POLICY-READY = AEGIS-RESERVE-BOUND
;
; Module 09 must treat UNBOUND as a hard stop for reserve-adjusted
; feasibility.
