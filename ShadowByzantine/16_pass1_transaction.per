; ============================================================
; THE BYZANTINE SHADOW
; PASS 1 -- VERTICAL TRANSACTION DEMONSTRATOR / ABI EXPERIMENT
; ============================================================
;
; STATUS:
;   Experimental / forensic design slice.
;   NOT the authenticated Shadow production architecture.
;
; Purpose:
;   Demonstrate one complete Byzantine Spearman production
;   lifecycle while exercising the module boundaries that own each
;   state transition.
;
; Closed slice:
;
;   OBJECTIVE
;      -> REQUIREMENT
;      -> ENGINE-DERIVED COST
;      -> CAPITAL FEASIBILITY
;      -> ESCROW COMMITMENT
;      -> AUTHORITY
;      -> PRE-EXECUTION BASELINE
;      -> ENGINE TRAIN REQUEST
;      -> WORLD-STATE VERIFICATION
;      -> ESCROW RELEASE REQUEST
;      -> ACTUAL ESCROW RELEASE
;      -> RELEASE OBSERVATION
;      -> REASSESSMENT / IDLE
;
; Ownership in this experiment:
;   Pass 1  = objective admission + transaction preparation only
;   Module 08 = engine-derived transaction requirement
;   Module 09 = capital feasibility
;   Module 10 = physical escrow commit/release + observations
;   Module 11 = execution authority
;   Module 12 = training command
;   Module 13 = completion verification
;   Module 14 = failed-transaction recovery
;   Module 15 = terminal lifecycle closure
;
; This file deliberately does NOT:
;   - become an orchestrator for the production architecture;
;   - perform engine escrow mutation;
;   - hard-code resource prices;
;   - infer commitment from a command;
;   - issue training directly;
;   - infer completion from training issuance;
;   - perform release directly;
;   - implement full Shadow composition arbitration;
;   - implement construction, research, search, retry, supersession,
;     or multi-objective arbitration.
;
; ============================================================
; INITIALIZATION
; ============================================================

(defrule
    (goal AEGIS-TRANSACTION-ACTIVE 0)
=>
    (set-goal AEGIS-TRANSACTION-ACTIVE 0)
    (set-goal AEGIS-TRANSACTION AEGIS-TRANSACTION-IDLE)
    (set-goal AEGIS-OBJECTIVE 0)
    (set-goal AEGIS-REQUIREMENT 0)
    (set-goal AEGIS-AUTHORITY AEGIS-AUTHORITY-DENIED)
    (set-goal AEGIS-VERIFICATION AEGIS-UNVERIFIED)
    (set-goal AEGIS-CAPITAL-FEASIBILITY 0)
    (set-goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-UNCOMMITTED)
    (set-goal AEGIS-ESCROW-RELEASE-REQUEST AEGIS-ESCROW-RELEASE-NO)
    (set-goal AEGIS-EXECUTION-STATE AEGIS-EXECUTION-IDLE)
    (set-goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-IDLE)
)

; ============================================================
; IDLE -> RESERVING
; ============================================================
;
; The demonstrator uses an existing barracks as the production
; prerequisite and requests the first Spearman objective only while
; no trained Spearman exists.
;
(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-IDLE)
    (goal AEGIS-TRANSACTION-ACTIVE 0)
    (building-type-count-total barracks > 0)
    (unit-type-count spearman-line < 1)
=>
    (set-goal AEGIS-OBJECTIVE AEGIS-OBJECTIVE-SPEARMAN)
    (set-goal AEGIS-REQUIREMENT AEGIS-REQUIREMENT-SPEARMAN)
    (set-goal AEGIS-TRANSACTION-ACTIVE 1)
    (set-goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (set-goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-COMMITTING)
)

; ============================================================
; REQUIREMENT / CAPITAL HANDOFF
; ============================================================
;
; Module 08 now materializes AEGIS-TRANSACTION-FOOD..STONE from
; the engine's current Spearman object cost. Module 09 consumes that
; vector and owns the capital decision.
;
; Pass 1 therefore contains no resource-price literals.
;
(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (goal AEGIS-REQUIREMENT AEGIS-REQUIREMENT-SPEARMAN)
    (goal AEGIS-CAPITAL-FEASIBILITY 1)
=>
    (set-goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-COMMITTING)
)

; ============================================================
; INSUFFICIENT CAPITAL FAIL-SAFE
; ============================================================

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (goal AEGIS-CAPITAL-FEASIBILITY 0)
=>
    (set-goal AEGIS-AUTHORITY AEGIS-AUTHORITY-DENIED)
)

; ============================================================
; END PASS 1
; ============================================================
;
; Downstream lifecycle is intentionally owned by Modules 10-15.
