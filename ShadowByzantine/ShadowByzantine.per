    ;	(up-send-flare point-x)
    ;	(up-send-flare point2-x)
    ;	(up-send-flare scout-x)
    (up-get-point-distance point-x scout-x goal)	;distance to nearest ally from scout
    (up-get-point-distance point2-x point-x goal1)	;distance to nearest ally after crossing
    ;	(up-chat-data-to-all "scout to ally: %d" g: goal)
    ;	(up-chat-data-to-all "cross to ally: %d" g: goal1)
