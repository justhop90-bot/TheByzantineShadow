(defrule
    (taunt-detected me 27)
=>
    (up-chat-data-to-player me "Group State: %d" g: gl-ranged-group-state)
)

(defrule
    (taunt-detected me 28)
=>
    (acknowledge-taunt me 27)
    (acknowledge-taunt me 28)
)

(defrule
    (false)
    (up-group-size c: RaidGroup > 0)
    (goal gl-current-group RaidGroup)
=>
    (set-goal gl-current-group RangedGroup)
    (chat-to-player me "Switch to Ranged")
    (up-jump-rule 1)
)

(defrule
    (false)
    (up-group-size c: RangedGroup > 0)
    (goal gl-current-group RangedGroup)
=>
    (chat-to-player me "Switch to Raid")
    (set-goal gl-current-group RaidGroup)
)

(defrule
    (true)
=>
    (set-goal gl-defend-town NO)
    (set-goal gl-current-group RangedGroup)
    (set-strategic-number sn-number-tasked-units 40)
    (set-goal gl-max-ranged-group-size 40)
    (set-goal gl-range-advantage 0)
    ;	(enable-timer t-mpoints 5)
    ;	(set-goal gl-formation-type 1)
    (set-goal gl-ranged-group-state FIRING)
    ;	(set-goal gl-can-move YES)
    (set-goal gl-can-fire NO)
    (set-goal gl-raid-can-fire NO)
    (set-goal gl-enemy-tower-range 9)
    (set-goal gl-my-tower-range 9)
    (set-goal gl-ranged-group-range 4)	;4
    (set-goal gl-raid-group-range 4)
    (set-goal gl-march-type DefendingLC)
    (set-goal gl-close-ranged-group-range 3)
    (disable-self)
)

;WWWWWWWWWWWWWWWWWW TRACKING RANGE
