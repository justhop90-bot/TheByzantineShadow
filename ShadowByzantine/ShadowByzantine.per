    (up-modify-escrow food c:max 100)
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (release-escrow wood)
    (release-escrow gold)
)

(defrule
    (goal gl-current-build-item PAA)
    (up-research-status c: ri-padded-archer-armor >= research-pending)
=>
    ;	(chat-to-player me "Padded Archer Armor Researched")
    (up-modify-goal gl-build-progress c:+ 1)
)

;###################### QBODKIN
(defrule
    (goal gl-progression-pause -1)
    (goal gl-current-build-item BODKIN)
    (can-research-with-escrow ri-bodkin-arrow)
=>
    (up-research gl-escrow-state c: ri-bodkin-arrow)
    ;	(chat-to-player me "Bodkin Arrow")
)

(defrule	;come back if skipped
    (goal gl-strategy FLUSH)
    (up-research-status c: ri-bodkin-arrow < research-pending)
    (up-compare-goal gl-build-progress > BodkinNumber)
=>
    (set-goal gl-build-progress BodkinNumber)
)

(defrule
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-current-build-item != BODKIN)
    (up-compare-goal gl-build-progress == BodkinNumber)
=>
    ;	(chat-to-player me "Setting current build item to BODKIN")
    (set-goal gl-current-build-item BODKIN)
)

(defrule
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-progression-pause == -1)
    (up-compare-goal gl-current-build-item == BODKIN)
=>
    (set-escrow-percentage food HIGH-ESCROW)
    (set-escrow-percentage wood HIGH-ESCROW)
    (set-escrow-percentage gold HIGH-ESCROW)
)

(defrule
    (false)
    (up-compare-goal gl-current-build-item == BODKIN)
=>
    (up-modify-escrow food c:max 200)
    (up-modify-escrow gold c:max 100)
    (chat-to-player me "Escrow for Bodkin")
)

(defrule
    (goal gl-current-build-item BODKIN)
    (up-research-status c: ri-bodkin-arrow >= research-pending)
=>
    ;	(chat-to-player me "Bodkin Arrow Researched")
    (up-modify-goal gl-build-progress c:+ 1)
)

;###################### QLOOM
(defrule
    (research-available ri-loom)
    (unit-type-count villager >= 9)
    (up-timer-status t-relure != timer-running)
    (dropsite-min-distance live-boar < max-bh-distance)
    (dropsite-min-distance live-boar > safe-bh-distance)
=>
    (set-goal gl-need-vills LOOM)
    ;	(chat-to-player me "Need loom")
)

(defrule
    (can-research ri-loom)
    (or	(and(game-time > 35)
    (housing-headroom < 1))
    (or	(goal gl-need-vills LOOM)
    (or	(current-age > dark-age)
    (and(food-amount < 40)
    (up-pending-objects c: villager < 1)))))
=>
    (set-goal gl-need-vills YES)
    ;	(chat-to-player me "Loom")
    (research ri-loom)
)

