    (up-remove-objects search-local -1 > 6)
    (up-get-search-state lt)
    (up-target-objects 1 action-default -1 -1)
    ;	(up-chat-data-to-player me "Attacking ram with %d villagers" g: lt)
)

;###################### QSHEEP
;WWWWWWWWWWWWWWWWWW	SENDING SHEEP HOME
(defrule
    (game-time < 300)	;5min
    (goal gl-thirty-turn 1)
    (unit-type-count livestock-class >= 1)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: 5 c: -1)
    (up-find-local c: livestock-class c: 5)
    (up-remove-objects search-local object-data-idling == 0)
    (up-remove-objects search-local object-data-id g:== sheep1-id)
    (up-get-search-state lt)
    (up-target-point home-x action-move -1 -1)
)

;WWWWWWWWWWWWWWWWWW SHEEP SCOUTING
(defrule
    (or	(up-compare-goal gl-current-sheep-count < 3)
    (goal gl-sheep-scouting FINISHED))
=>
    (up-jump-rule 11)
)

(defrule
    (up-compare-goal gl-current-sheep-count >= 3)
=>
    (up-full-reset-search)
    (up-find-local c: sheep c: 6)
    (up-clean-search search-local 44 search-order-desc)
    (up-set-target-object search-local c: 0)
    (up-get-object-data object-data-id sheep1-id)
    ;	(up-chat-data-to-player me "First sheep scout found(%d)" g: sheep1-id)
    (set-goal gl-sheep-scouting 0)
    (disable-self)
)

(defrule
    (up-set-target-by-id g: sheep1-id)
=>
    (up-get-point position-object point2-x)
    ;	(up-send-flare point2-x)
)

(defrule
    (goal gl-fifth-turn 1)
    (up-compare-goal gl-sheep-scouting >= 0)
=>
    (up-copy-point point-x point2-x)
    ;	(up-send-flare point-x)
)

(defrule
    (goal gl-sheep-scouting 0)
    (up-point-distance point2-x home-x < 50)
    (up-point-distance point2-x home-x >= 18)
=>
    ;	(chat-to-player me "Move around now")
    (set-goal gl-sheep-scouting 1)
    (disable-self)
)

(defrule
    (goal gl-fifth-turn 1)
    (goal gl-sheep-scouting 0)
=>
    ;	(chat-to-player me "Move out")
    (up-lerp-tiles point-x home-x c: -10)
    (up-cross-tiles point-x home-x c: 0)
    (up-bound-point point-x point-x)
)

(defrule
    (goal gl-fifth-turn 1)
    (goal gl-sheep-scouting 1)
=>
    (up-lerp-tiles point-x home-x c: -5)
    (up-cross-tiles point-x home-x c: -20)
    (up-bound-point point-x point-x)
    ;	(up-send-flare point-x)
)

(defrule
    (goal gl-fifth-turn 1)
    (goal gl-sheep-scouting 1)
    ;	(up-point-explored
    (up-point-distance point2-x home-x >= 24)
=>
    ;	(chat-to-player me "Bring closer")
    (up-lerp-tiles point-x home-x c: 8)
    (up-bound-point point-x point-x)
)

(defrule
    (goal gl-fifth-turn 1)
    (goal gl-sheep-scouting 1)
    (up-point-distance point-x point2-x < 3)
=>
    (up-get-point-distance point-x point2-x goal2)
    (up-chat-data-to-player me "Distance too close(%d)" g: goal2)
    (up-lerp-tiles point-x home-x c: -8)
    (up-lerp-tiles point-x point2-x c: -8)
    (up-bound-point point-x point-x)
)

(defrule
    (goal gl-fifth-turn 1)
    (up-set-target-by-id g: sheep1-id)
    (up-compare-goal gl-sheep-scouting < 2)
    (up-compare-goal gl-sheep-scouting >= 0)
=>
    (up-get-point-distance point-x point2-x goal2)
    ;	(up-chat-data-to-player me "Move(%d)" g: goal2)
    (up-full-reset-search)
    (up-add-object-by-id search-local g: sheep1-id)
    (up-target-point point-x action-move -1 -1)
    ;	(up-send-flare point-x)
)

(defrule
    (game-time >= 60)
    (up-set-target-by-id g: sheep1-id)
    (or	(game-time >= 200)
    (and(game-time >= 122)
    (up-compare-goal gl-current-sheep-count == 4)))
=>
    ;	(chat-to-player me "Send Sheep Home")
    (up-full-reset-search)
    (up-add-object-by-id search-local g: sheep1-id)
    (up-target-point home-x action-move -1 -1)
    (set-goal gl-sheep-scouting FINISHED)
    ;	(set-goal gl-sheep-scouting 2)
)

(defrule
    (false)
    (goal gl-sheep-scouting 2)
    (up-set-target-by-id g: sheep1-id)
=>
    (do-nothing)
)

