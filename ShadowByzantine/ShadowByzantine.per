)

;###################### QFARMS ;from Illu
;WWWWWWWWWWWWWWWWWW FORAGERS
(defrule
    (idle-farm-count > 0)
    ;	(building-type-count farm < 10)
    (dropsite-min-distance live-boar > 15)
    (or	(up-compare-goal gl-vills-under-tc >= 8)
    (unit-type-count villager-forager >= 2))
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number c:= me)
    (up-find-remote c: farm c: 40)
    (up-remove-objects search-remote object-data-tasks-count > 0)
    (up-remove-objects search-remote -1 > 0)
    (up-set-target-object search-remote c: 0)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (up-get-point position-object point-x)
    (up-set-target-point point-x)
    ;	(up-send-flare point-x)
    (up-find-local c: villager-class c: 40)
    ;	(chat-to-player me "Tasking Villager to Farm")
    (up-clean-search search-local object-data-distance search-order-asc)
    (up-remove-objects search-local object-data-action == actionid-build)
    (up-remove-objects search-local object-data-target == farm-class)
    (up-remove-objects search-local object-data-target == deer-food)
    (up-remove-objects search-local object-data-target-id g:== old-boar-id)
    (up-remove-objects search-local object-data-target-id g:== current-boar-id)
    (up-remove-objects search-local object-data-id g:== lurer-id)
    (up-remove-objects search-local object-data-index > 0)
    (up-target-objects 0 action-default -1 -1)
    (set-goal SPLIT 0)
)

(defrule
    (goal SPLIT 1)
=>
    (chat-to-player me "Leak 5")
    (set-goal SPLIT 0)
)

;###################### QARCHERS
;WWWWWWWWWWWWWWWWWW RETREATING ARCHERS FROM SKIRMS
(defrule
    (false)
    (or	(game-time < 10)
    (or	(unit-type-count archer < 1)
    (up-group-size c: RangedGroup < 1)))
=>
    (up-jump-rule 2)
)

;@@@@@@@@@@@@@@  STATS
;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal gl-enemy-skirms-nearby 0)
    (set-goal rt 0)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: 10)
    (up-find-remote c: skirmisher-line c: 10)
    (up-get-search-state lt)
    (up-modify-goal gl-enemy-skirms-nearby g:+ rt)
)

;3. LOOP THE SEARCH
(defrule
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (up-compare-goal rt >= 1)
=>
    (up-clean-search search-remote 44 search-order-asc)
    (up-set-target-object search-remote c: 0)
    (up-get-object-data object-data-range gl-enemy-skirm-range)
    (up-modify-goal gl-enemy-skirms-nearby c:+ 1)
    (up-get-point position-object nearest-skirm-x)
    ;	(up-chat-data-to-player me "rt: %d" g: gl-enemy-skirms-nearby)
)

;@@@@@@@@@@@@@@ RETREATING
(defrule
    ;	(false)
    (up-compare-goal gl-enemy-skirms-nearby >= 4)
    (up-compare-goal gl-ranged-group-state != HOME-RETREAT)
=>
    (up-full-reset-search)
    (up-find-local c: archer-line c: 40)
    (up-set-target-point nearest-skirm-x)
    (up-remove-objects search-local 44 g:> gl-enemy-skirm-range)
    ;	(up-remove-objects search-local object-data-group-flag != RangedGroup)
    (up-get-search-state lt)
    (up-copy-point point-x ranged-group-x)
    (up-lerp-tiles point-x enemy-group-x c: -1)
    (up-lerp-tiles point-x nearest-skirm-x c: -2)
    (up-target-point point-x action-move formation-box no-attack)
    ;	(up-chat-data-to-player me "Retreat/Remove Archers(%d)" g: gl-enemy-skirms-nearby)
)

