;@@@@@@@@@@@@@@ ID-LOOP FOR FINDING BOARS(from Barbarian)
(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 33)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: boar-class c: 1)
    (up-get-search-state lt)
)

(defrule
    (or	(goal gl-town-safe NO)
    (or	(up-compare-goal BH >= 2)
    (or	(up-compare-goal lt > 0)
    (or	(unit-type-count-total villager < 10)
    (up-compare-goal gl-killed-boar-count >= 2)))))
=>
    (up-jump-rule 6)
)

(defrule	;initialize
    (true)
=>
    (set-goal goal2 0)	;basically just the progression
    (set-goal goal4 0)	;the id-checker
)

(defrule	;narrowing down the type/get its position
    (up-set-target-by-id g: goal4)
    (up-object-data object-data-carry >= 50)
    (up-object-data object-data-hitpoints > 0)
    (up-object-data object-data-base-attack > 4)
    (up-object-data object-data-hitpoints < 100); Not an iron boar
=>
    (up-get-point position-object point-x)
    (set-goal goal2 1)
)

(defrule	;make sure the point is right position/explored, then set up the search
    (goal goal2 1)
    (up-point-distance point-x home-x < 33)
    (up-point-explored point-x != explored-no)
=>
    (up-get-object-data object-data-type goal3)
    (set-goal goal2 2)
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 33)
)

(defrule	;if the boar isn't found normally, the search worked, and you can lure it
    (goal goal2 2)
    (not(up-find-remote g: goal3 c: 1))
=>
    ;	(chat-to-player my-player-number "Boar watch")
    (up-modify-goal current-boar-id g:= goal4)
    (set-goal BH 10)
    (up-jump-rule 1)
)

(defrule	;if the boar wasn't found, repeat
    (up-compare-goal goal4 < 50000)
=>
    (up-modify-goal goal4 c:+ 1)
    (set-goal goal2 0)
    (up-jump-rule -4)
)

(defrule
    (true)
    (false)
    ;	(taunt-detected 1)
=>
