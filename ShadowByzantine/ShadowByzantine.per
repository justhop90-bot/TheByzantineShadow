;###################### QECTECHS
;WWWWWWWWWWWWWWWWWW Q2BA
;@@@@@@@@@@@@@@ KRUSH
(defrule
    (goal gl-strategy KRUSH)
    (goal gl-current-build-item 2BA)
    (can-research-with-escrow ri-double-bit-axe)
=>
    ;	(chat-to-player me "Krush Double-Bit Axe")
    (set-escrow-percentage food 0)
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (release-escrow food)
    (release-escrow wood)
    (release-escrow gold)
    (research ri-double-bit-axe)
)

(defrule	;come back if skipped
    (goal gl-strategy KRUSH)
    (up-compare-goal gl-build-progress > Krush2BANumber)
    (up-research-status c: ri-double-bit-axe < research-pending)
=>
    (set-goal gl-build-progress Krush2BANumber)
)

(defrule
    (goal gl-strategy KRUSH)
    (up-compare-goal gl-current-build-item != 2BA)
    (up-compare-goal gl-build-progress == Krush2BANumber)
=>
    ;	(chat-to-player me "Krush Setting current build item to 2BA")
    (set-escrow-percentage food LOW-ESCROW)
    (set-goal gl-current-build-item 2BA)
)

(defrule
    (goal gl-strategy KRUSH)
    (goal gl-current-build-item 2BA)
    (up-research-status c: ri-double-bit-axe >= research-pending)
=>
    ;	(chat-to-player me "Krush Double-Bit Axe Researched")
    (up-modify-goal gl-build-progress c:+ 1)
)

;@@@@@@@@@@@@@@ FLUSH
(defrule
    (goal gl-strategy FLUSH)
    (goal gl-current-build-item 2BA)
    (can-research-with-escrow ri-double-bit-axe)
=>
    ;	(chat-to-player me "Double-Bit Axe")
    (set-escrow-percentage food 0)
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (release-escrow food)
