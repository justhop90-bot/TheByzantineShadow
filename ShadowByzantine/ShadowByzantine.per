;WWWWWWWWWWWWWWWWWW QREGROUPING
(defrule
    (false)
    ;	(goal gl-thirty-turn 1)
    ;	(up-compare-goal rt > 5)
    (up-compare-goal gl-army-damage-potential < CostOfIgnoringEverything)
=>
