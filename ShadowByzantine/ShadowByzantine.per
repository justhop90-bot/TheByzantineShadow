)

;WWWWWWWWWWWWWWWWWW GET TARGET STATS
(defrule
    (up-compare-goal rt >= 1)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-object-data object-data-class gl-target-class)
    (up-get-object-data object-data-type gl-target-type)
    (up-get-object-data object-data-id target-id)
    (up-get-object-data object-data-hitpoints gl-target-hp)
    (up-get-point position-object target-x)
    (up-get-point-distance target-x ranged-group-x gl-target-distance)
    ;	(chat-to-player me "Get target Data")
)

;WWWWWWWWWWWWWWWWWW DEBUG
(defrule
    (taunt-detected me 61)
    (goal gl-fifth-turn 1)
=>
    (up-send-flare target-x)
)

(defrule
    (taunt-detected me 61)
=>
    (chat-to-player me "--------------")
    ;	(up-chat-data-to-player me "Possible Targets: %d" g: rt)
    ;	(up-chat-data-to-player me "Target id: %d" g: target-id)
    ;	(up-chat-data-to-player me "Target type: %d" g: gl-target-type)
    (up-chat-data-to-player me "Target class: %d" g: gl-target-class)
    (up-chat-data-to-player me "Target hp: %d" g: gl-target-hp)
    (up-chat-data-to-player me "Tracking range: %d" g: gl-tracking-range)
    (up-chat-data-to-player me "Target distance: %d" g: gl-target-distance)
)

(defrule
    (taunt-detected me 62)
=>
    (acknowledge-taunt me 61)
    (acknowledge-taunt me 62)
)

