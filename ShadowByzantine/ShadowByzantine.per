    (up-remove-objects search-local -1 < 3)
)

(defrule
    (false)
    (goal SPLIT 1)
=>
    (up-find-local c: archer-line c: 40)
)

(defrule
    (goal SPLIT 1)
    (goal gl-town-safe NO)
    (up-point-distance ranged-group-x home-x >= 25)
=>
    (up-set-target-point home-x)
    (up-remove-objects search-local 44 < DefenseRadius)
)

(defrule
    (goal SPLIT 1)
=>
    (up-remove-objects search-local object-data-group-flag == RangedGroup)
    (up-remove-objects search-local object-data-group-flag == RaidGroup)
