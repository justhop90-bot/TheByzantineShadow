    (player-valid 3)
    (game-time > 900)	;15min
    (up-compare-goal gl-find-new-target != -1)
=>
    (up-get-player-color target-player goal7)
    ;	(up-chat-data-to-all "Privileged Found New Target(%d)" g: goal7)
    (set-goal gl-find-new-target -1)
