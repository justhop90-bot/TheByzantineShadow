)

(defrule
    (false)
    (goal gl-inside-forest 2)
=>
    (chat-to-player me "Don't Go Inside 2")
    (set-goal gl-inside-forest -1)
)

(defrule
    (game-time < 100)
    (up-point-contains explo-x c: tree-class)
=>
    (enable-timer t-misc 2)
)

(defrule
    (up-point-distance scout-x home-x >= 33)
    (up-point-contains explo-x c: tree-class)
=>
    (enable-timer t-misc 15)
)

(defrule
    (up-point-contains explo-x c: tree-class)
    (up-timer-status t-misc == timer-running)
=>
    ;	(chat-to-player me "Lerp in")
    (set-goal goal1 2)
)

;@@@@@@@@@@@@@@ OTHER
(defrule	;move the point out of obstacles
    (goal NEWSCOUTING 0)
    (up-point-distance explo-x home-x < MaxDistance)
    (or	(game-time < 100)
    (up-point-distance explo-x scout-x < 12))
    (or	(goal goal 65535)
    (or	(up-point-contains explo-x c: tree-class)
    (up-point-explored explo-x != explored-no)))
=>
    ;	(chat-to-player me "Lerp")
    (up-lerp-tiles explo-x home-x g: goal1)
    (up-bound-point explo-x explo-x)
    ;	(up-send-flare explo-x)
)

(defrule	;move the point out of obstacles
    (goal NEWSCOUTING 0)
    (up-point-explored explo-x == explored-no)
    (up-point-distance explo-x home-x >= MaxDistance)
=>
    ;	(chat-to-player me "Lerp 2")
    (up-lerp-tiles explo-x home-x c: 5)
    (up-bound-point explo-x explo-x)
    ;	(up-send-flare explo-x)
)

(defrule	;cross the point out of obstacles if too far out
    (goal NEWSCOUTING 0)
    (up-point-distance explo-x home-x >= MaxDistance)
    (or	(goal goal 65535)
    (or	(up-point-contains explo-x c: tree-class)
    (up-point-explored explo-x != explored-no)))
=>
    (up-cross-tiles explo-x home-x g: CROSS)
    (up-lerp-tiles explo-x home-x c: 2)
    (up-bound-point explo-x explo-x)
    ;	(chat-to-player me "Cross 2")
    ;	(up-send-flare explo-x)
)

(defrule
    (goal NEWSCOUTING 0)
    (up-compare-goal goal >= 6)
=>
    (up-full-reset-search)
    (up-add-object-by-id search-local g: scout-id)
    (up-target-point explo-x action-move -1 no-attack)
)

(defrule
    (goal NEWSCOUTING 0)
    (up-compare-goal goal < 6)
=>
    ;	(chat-to-player me "Reset")
    (set-goal NEWSCOUTING -1)
)

(defrule
    (or	(up-compare-goal explo-x >= 116)
    (or	(up-compare-goal explo-y >= 116)
    (or	(up-compare-goal explo-x < 4)
    (up-compare-goal explo-y < 4))))
=>
    (up-jump-rule 1)
)

(defrule	;if the point is out of obstacles and too far, reset
    (false)
    (goal NEWSCOUTING 0)
    (up-compare-goal goal g:>= goal2)	;17 closer/11 further
    (up-point-explored explo-x == explored-no)
    (not(up-point-contains explo-x c: tree-class))
    (up-compare-goal goal != 65535)
    ;		(or	(up-compare-goal explo-x g:>= gl-max-coordinate-value)
    ;			(or	(up-compare-goal explo-y g:>= gl-max-coordinate-value)
    ;				(or	(up-compare-goal explo-x < 2)
    ;					(up-compare-goal explo-y < 2)))))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (up-send-flare explo-x)
    (chat-to-player me "Reset 2")
    (set-goal NEWSCOUTING -1)
    (up-send-flare explo-x)
    (set-goal SPLIT 0)
)

