;###################### QXBOW
(defrule
    (current-age >= castle-age)
    (goal gl-progression-pause -1)
    (unit-type-count-total archer-line >= 4)
    (up-compare-goal gl-build-progress >= BowsawNumber)
    (up-research-status c: ri-crossbow < research-pending)
=>
    (set-goal gl-progression-pause XBOW)
    ;	(chat-to-player me "NEED XBOWS")
)

(defrule
    (goal gl-progression-pause XBOW)
    (up-can-research gl-escrow-state c: ri-crossbow)
=>
    (up-research gl-escrow-state c: ri-crossbow)
    (set-goal gl-progression-pause -1)
    ;	(chat-to-player me "Crossbows")
    (research ri-crossbow)
)

;###################### QPIKES
(defrule
    (goal gl-strategy FLUSH)
    (goal gl-enemy-civ NORMAL)
    (current-age >= castle-age)
    (up-compare-goal gl-progression-pause == -1)
    (up-compare-goal gl-build-progress > BodkinNumber)
    (players-current-age any-enemy >= castle-age)
    (up-research-status c: ri-pikeman < research-pending)
    (or	(player-valid 5)
    (or	(players-current-age-time any-enemy >= 300)
    (players-building-type-count any-enemy stable >= 1)))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (set-escrow-percentage food HIGH-ESCROW)
    (set-escrow-percentage gold HIGH-ESCROW)
    (set-goal gl-progression-pause PIKES)
    ;	(chat-to-all "NEED PIKES")
    (set-goal SPLIT 0)
)

(defrule
    (goal gl-progression-pause PIKES)
    (can-research-with-escrow ri-pikeman)
=>
    (set-goal gl-progression-pause -1)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    ;	(chat-to-all "Pikemen")
    (release-escrow food)
    (release-escrow gold)
    (research ri-pikeman)
)

;###################### QAGE
;WWWWWWWWWWWWWWWWWW FUP
(defrule
    (goal gl-strategy KRUSH)
    (research-available feudal-age)
    (up-compare-goal gl-need-vills != NO)
    (unit-type-count-total villager >= KrushDarkAgeVills)
=>
    ;	(chat-to-all "Krush Stop Vills for fup")
    (set-goal gl-need-vills NO)
)

(defrule
    (goal gl-strategy FLUSH)
    (research-available feudal-age)
    (up-compare-goal gl-need-vills != NO)
    (unit-type-count-total villager >= FlushDarkAgeVills)
=>
    (set-goal gl-need-vills NO)
)

(defrule
    (goal gl-strategy FLUSH)
    (research-available feudal-age)
    (up-compare-goal gl-need-vills == NO)
    (unit-type-count-total villager < FlushDarkAgeVills)
=>
    (chat-to-all "Start Vills for fup again")
    (set-goal gl-need-vills YES)
)

(defrule
    (can-research feudal-age)
    (or	(and(goal gl-strategy FLUSH)
    (unit-type-count-total villager >= FlushDarkAgeVills))
    (and(goal gl-strategy KRUSH)
    (unit-type-count-total villager >= KrushDarkAgeVills)))
=>
    (set-goal gl-age-loading FA-loading)
    ;	(chat-to-player me "Feudal Age")
    (set-goal gl-need-vills YES)
    (enable-timer t-rax 70)
    (research feudal-age)
)

;WWWWWWWWWWWWWWWWWW QCUP
;@@@@@@@@@@@@@@@ RESEARCH
(defrule
    (goal gl-strategy KRUSH)
    (current-age == feudal-age)
    (up-compare-goal gl-need-vills != NO)
    (up-research-status c: castle-age < research-pending)
    (unit-type-count-total villager >= KrushFeudalAgeVills)
=>
    ;	(chat-to-all "Krush Stop vills for cup")
    (set-goal gl-need-vills NO)
)

(defrule
    (food-amount >= 640)
    (gold-amount >= 150)
    (goal gl-strategy FLUSH)
    (research-available castle-age)
    (or (goal gl-current-build-item CUP)
    (unit-type-count villager >= 50))
    (up-compare-goal gl-need-vills != NO)
=>
    (set-goal gl-need-vills NO)
)

(defrule
    (goal gl-progression-pause -1)
    (goal gl-current-build-item CUP)
    (can-research-with-escrow castle-age)
=>
    ;	(chat-to-player me "Castle Age")
    (release-escrow food)
    (release-escrow gold)
    (set-goal gl-age-loading CA-loading)
    (enable-timer BECO-TIMER 60)
    (set-goal gl-need-vills YES)
    (research castle-age)
)

;@@@@@@@@@@@@@@@ MOVE PROGRESSION
(defrule
    (goal gl-current-build-item CUP)
    (up-research-status c: castle-age >= research-pending)
=>
    ;	(chat-to-player me "Castle Age Researched")
    (up-modify-goal gl-build-progress c:+ 1)
)

