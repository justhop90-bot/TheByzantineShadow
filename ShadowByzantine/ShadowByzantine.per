(defrule
    (or	(player-in-game any-ally)
    (up-compare-goal gl-circle-direcion != -1))
=>
    (up-jump-rule 3)
)

(defrule
    (goal gl-twenty-turn 1)
    (goal gl-dlure FINISHED)
    (unit-type-count scout-cavalry > 0)
    (up-timer-status 28 != timer-running)
    ;	(game-time s:> sn-home-exploration-time)
    (players-building-type-count target-player farm < 1)
    (players-building-type-count target-player house < 1)
=>
    (up-copy-point point-x scout-x)
    (up-cross-tiles point-x center-x c: 10)	;cross counterclockwise
    (up-get-point-distance home-x scout-x goal)
    (up-get-point-distance home-x point-x goal1)
    ;	(up-chat-data-to-player me "scout to tc: %d" g: goal)
    ;	(up-chat-data-to-player me "point to tc: %d" g: goal1)
    ;	(up-send-flare point-x)
    (set-goal SPLIT 1)
    (disable-self)
)

(defrule	;clockwise
    (goal SPLIT 1)
    (up-compare-goal goal1 g:< goal)
=>
    ;	(chat-to-player me "I will explore by the CLOCKWISE")
    (set-goal gl-circle-direcion CLOCKWISE)
    (set-goal SPLIT 0)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal goal1 g:> goal)
=>
    ;	(chat-to-player me "i will explore by the COUNTERCLOCKWISE")
    (set-goal gl-circle-direcion COUNTERCLOCKWISE)
    (set-goal SPLIT 0)
)

;WWWWWWWWWWWWWWWWWW CIRCLING
(defrule
    (true)
=>
    (set-goal goal 0)
)

(defrule
    (goal gl-circle-direcion COUNTERCLOCKWISE)
=>
    (set-goal goal1 18)
)

(defrule
    (goal gl-circle-direcion CLOCKWISE)
=>
    (set-goal goal1 -18)
)

(defrule
    (goal gl-twenty-turn 1)
    (goal gl-dlure FINISHED)
    (goal gl-strategy KRUSH)
    (unit-type-count scout-cavalry > 0)
    (up-timer-status 28 != timer-running)
    (up-compare-goal gl-scout-added != FINISHED)
=>
    (up-copy-point point-x scout-x)
    (up-cross-tiles point-x center-x g: goal1)	; +-18
    (up-lerp-tiles point-x center-x c: -12)
    (up-lerp-tiles point-x point-x g: goal)
    (set-goal SPLIT 1)
)

(defrule
    (player-valid 3)
    (game-time < 900)	;15min
    (goal gl-twenty-turn 1)
    (goal gl-dlure FINISHED)
    (goal gl-strategy FLUSH)
    (unit-type-count scout-cavalry > 0)
    (up-timer-status 28 != timer-running)
    (up-point-distance enemy-x home-x > 95)
=>
    (up-copy-point point-x scout-x)
    (up-cross-tiles point-x center-x g: goal1)	; +-18
    (up-lerp-tiles point-x center-x c: -12)
    (up-lerp-tiles point-x point-x g: goal)
    (up-get-point-distance enemy-x home-x goal)
    ;	(up-chat-data-to-all "NewSplit(%d)" g: goal)
    (set-goal SPLIT 1)
)

(defrule
    ;	(not(player-valid 3))
    (goal gl-twenty-turn 1)
    (goal gl-dlure FINISHED)
    (goal gl-strategy FLUSH)
    (unit-type-count scout-cavalry > 0)
    (up-timer-status 28 != timer-running)
    (players-building-type-count every-enemy mill < 1)
    (players-building-type-count every-enemy farm < 1)
    (players-building-type-count every-enemy house < 1)
    (players-building-type-count every-enemy barracks < 1)
    (players-building-type-count every-enemy archery-range < 1)
=>
    (up-copy-point point-x scout-x)
    (up-cross-tiles point-x center-x g: goal1)	; +-18
    (up-lerp-tiles point-x center-x c: -12)
    (up-lerp-tiles point-x point-x g: goal)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (up-point-distance scout-x center-x >= max-circle-scout-distance)
=>
    ;	(chat-to-player me "Lerp in")
    (up-lerp-tiles point-x center-x c: 27)
    (up-lerp-tiles point-x point-x g: goal)
)

(defrule
    (goal SPLIT 1)
=>
    (up-get-point-distance scout-x center-x goal)
    ;	(up-chat-data-to-all "Move(%d)" g: gl-circle-direcion)
    (up-full-reset-search)
    (up-add-object-by-id search-local g: scout-id)
    (up-lerp-tiles point-x scout-x c: -10)
    (up-bound-point point-x point-x)
    ;	(up-send-flare point-x)
    (up-target-point point-x action-move -1 no-attack)
    (set-goal SPLIT 0)
)

;###################### QFORAGE
(defrule
    (building-type-count mill >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: mill c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object object-x)
)

(defrule
    (goal gl-tenth-turn 1)
    (up-compare-goal BH < 1)
    (building-type-count mill >= 1)
    (unit-type-count villager-forager < 1)
    (or	(and(unit-type-count sheep < 1)
    (up-compare-goal gl-killed-boar-count < 2))
    (unit-type-count villager-shepherd >= 7))
=>
    (up-full-reset-search)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (up-set-target-point object-x)
    (up-find-local c: villager-class c: 240)
    (up-clean-search search-local object-data-distance search-order-asc)
    (up-remove-objects search-local object-data-tasks-count > 0)
    (up-remove-objects search-local object-data-action == actionid-build)
    (up-remove-objects search-local object-data-target == forage-food)
    (up-remove-objects search-local object-data-target == deer-food)
    (up-remove-objects search-local object-data-id g:== lurer-id)
    (up-remove-objects search-local object-data-target == tree-class)
    (up-get-search-state lt)
)

(defrule
    (goal SPLIT 1)
=>
    (up-remove-objects search-local -1 > 0)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: forage-bush c: 10)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-clean-search search-local object-data-distance search-order-asc)
    (up-remove-objects search-remote -1 > 0)
    (up-target-objects 0 action-default -1 -1)
    ;	(up-chat-data-to-player me "Send vill to forage(%d)" g: lt)
    (set-goal SPLIT 0)
)

;###################### QCOUNTING SHEEP ;based on Tribal
(defrule
    (true)
    =>	(set-goal gl-current-sheep-count 0)
    (set-goal gl-sheep-count-last 0)
    (set-goal gl-new-sheep-count 0)
    (disable-self))

(defrule
    (true)
    =>	(up-get-player-fact me unit-type-count livestock-class gl-sheep-count))

(defrule
    (up-compare-goal gl-sheep-count g:> gl-sheep-count-last)
    (dropsite-min-distance livestock-class < 8)
    (building-type-count town-center > 0)
    =>	(up-modify-goal gl-new-sheep-count g:= gl-sheep-count)
    (up-modify-goal gl-new-sheep-count g:- gl-sheep-count-last)
    (up-modify-goal gl-sheep-count-last g:= gl-sheep-count)
    (up-modify-goal gl-current-sheep-count g:+ gl-new-sheep-count)
    (set-goal gl-new-sheep-count 0)
    ;(up-chat-data-to-player me "-> %d sheep found" g: gl-current-sheep-count)
)

(defrule
    (up-compare-goal gl-sheep-count g:< gl-sheep-count-last)
    =>	(up-modify-goal gl-sheep-count-last g:= gl-sheep-count))

;###################### QDLURING
(defrule
    (true)
    (or	(up-compare-goal gl-dlure == -1)
    (up-compare-goal gl-deer-distance >= 20))
    (or	(up-group-size c: RangedGroup >= 1)
    (game-time s:> sn-home-exploration-time))
=>
    (set-strategic-number sn-maximum-hunt-drop-distance 17)
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
    ;	(chat-to-player me "No more dluring")
    (up-reset-unit c: scout-unit)
    (set-goal gl-dlure FINISHED)
    (up-reset-scouts)
    (disable-self)
)

(defrule	;doesn't jump shooting the deer
    ;	(false)
    (or	(up-timer-status 28 == timer-running)
    (or	(goal gl-dlure FINISHED)
    (or	(up-group-size c: RangedGroup >= 1)
    (up-compare-goal NEWSCOUTING < FINISHED))))
=>
    ;	(chat-to-player me "jump")
    (up-jump-rule 12)
)

(defrule
    (true)
=>
    (up-set-target-point home-x)
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 50)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: deer-class c: 40)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-clean-search search-remote object-data-distance search-order-asc)
    (up-get-search-state lt)
    (up-modify-goal goal4 g:= rt)
    (up-remove-objects search-remote -1 > 0)
)

(defrule
    (goal gl-deer-walking 3)
=>
    (up-set-target-point home-x)
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 60)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: deer-class c: 10)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-clean-search search-remote object-data-distance search-order-asc)
    (up-get-search-state lt)
    (up-modify-goal goal4 g:= rt)
    (up-remove-objects search-remote -1 == 0)
    (up-remove-objects search-remote -1 > 1)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object point-x)
    ;	(up-send-flare point-x)
    (set-goal gl-deer-walking 4)
)

(defrule	;get initial deer info
    (goal gl-dlure -1)
    (up-compare-goal rt >= 1)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-object-data object-data-id deer-id)
    (up-get-point position-object saved-x)
    (set-goal gl-dlure 0)
)

(defrule 	;get constant deer info
    (up-set-target-by-id g: deer-id)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-get-object-data object-data-distance gl-deer-distance)
    (up-get-object-data object-data-move-x point2-x)
    (up-get-object-data object-data-move-y point2-y)
    (up-get-object-data object-data-hitpoints goal1)
    (up-get-point position-object object-x)
)

(defrule
    (up-compare-goal gl-dlure >= 0)
    (up-compare-goal gl-deer-walking == -1)
    (up-point-distance point2-x saved-x < 7)	;deer moving back to original position
    (up-point-distance object-x saved-x >= 9)	;deer is far enough away
=>
    ;	(chat-to-player me "Deer is Walking")
    (set-goal gl-deer-walking 0)
)

(defrule
    (goal gl-deer-walking 0)
=>
    (up-full-reset-search)
    (up-set-target-point object-x)
    (up-filter-distance c: -1 c: 15)
    (up-find-local c: villager-class c: 20)
    (up-get-search-state lt)
)

(defrule 	;switch deer if no shooter closeby
    (goal gl-deer-walking 0)
    (or	(up-compare-goal lt < 1)
    (up-point-distance object-x saved-x < 7))
=>
    ;	(chat-to-player me "Switch deer")
    (up-full-reset-search)
    (up-add-object-by-id search-local g: shooter-id)
    (up-target-point home-x action-move -1 -1)
    (set-goal gl-deer-walking 3)
    (set-goal gl-dlure -1)
    (set-goal deer-id -1)
    (up-reset-scouts)
)

(defrule	;shoot the deer once with the nearest vill if it's close
    (goal gl-deer-walking 0)
    (up-compare-goal lt >= 1)
    (up-set-target-by-id g: deer-id)
    (up-point-distance object-x saved-x >= 10)
=>
    ;	(up-chat-data-to-player me "Shoot Walker(%d)" g: lt)
    (up-clean-search search-local object-data-distance search-order-asc)
    (up-remove-objects search-local object-data-id g:== lurer-id)
    (up-remove-objects search-local -1 > 0)
    (up-target-objects 1 action-default -1 -1)
    (up-set-target-object search-local c: 0)
    (up-get-object-data object-data-id shooter-id)
    (set-goal gl-deer-walking 1)
)

(defrule 	;don't kill the deer--stop the shooter when deer is hit once
    (goal gl-deer-walking 1)
    (up-compare-goal goal1 < 5)
    (up-set-target-by-id g: shooter-id)
=>
    ;	(chat-to-player me "Stop Shooter")
    (up-full-reset-search)
    (up-add-object-by-id search-local g: shooter-id)
    (up-target-point home-x action-move -1 -1)
    (set-goal gl-deer-walking 2)
)

(defrule
    (up-compare-goal goal1 > 0)
    (up-set-target-by-id g: deer-id)
=>
    (up-copy-point point-x object-x)
    (up-lerp-tiles point-x home-x c: -1)
    (up-bound-point point-x point-x)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (or	(goal gl-fifth-turn 1)
    (goal gl-fifth-turn 2))
    (up-point-contains point-x c: tree-class)
=>
    (up-lerp-tiles point-x home-x c: 1)
    (up-bound-point point-x point-x)
    ;	(chat-to-player me "Lerp out of tree")
)

(defrule
    (goal SPLIT 1)
=>
    ;	(chat-to-player me "push the deer")
    (up-full-reset-search)
    (up-set-target-point point-x)
    (set-strategic-number sn-target-point-adjustment 5)
    (up-add-object-by-id search-local g: scout-id)
    (up-reset-unit c: scout-cavalry)
    (up-target-point point-x action-move -1 no-attack)
    (set-goal SPLIT 0)
)

