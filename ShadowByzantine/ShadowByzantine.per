    (current-age-time >= 30)
    (current-age >= castle-age)
=>
    (up-modify-goal gl-army-damage-potential c:+ 15)
)

(defrule
    (players-current-age-time target-player >= 30)
    (players-current-age target-player >= castle-age)
=>
    (up-modify-goal gl-army-damage-potential c:- 15)
)

