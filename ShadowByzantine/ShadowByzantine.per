)

;----- IF ALLY IN TROUBLE (2v2's)
(defrule
    (player-valid 3)
    (game-time > 1200)	;20min
    (not(player-valid 5))
    (up-compare-goal CIVSUP >= 40)
    (up-compare-goal SUPERIORITY >= 20)
    (players-building-count any-enemy > 0)
    (up-allied-goal any-ally CIVSUP < -10)
    (up-allied-goal any-ally SUPERIORITY < 10)
    (players-civilian-population target-player < 50)
    (up-timer-status t-target-switch != timer-running)
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (up-find-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-modify-sn sn-focus-player-number g:= goal)
    (up-modify-sn sn-target-player-number g:= goal)
    (chat-to-all "85 ALLY WEAK--SWITCH TARGETS")
    (enable-timer t-target-switch 120)
    (set-goal SPLIT 0)
)

(defrule
    (game-time < 30)
    (up-compare-goal gl-last-target-player s:!= sn-target-player-number)
=>
    (up-modify-goal gl-last-target-player s:= sn-target-player-number)
)

(defrule
    (game-time >= 30)
    (up-compare-goal gl-last-target-player s:!= sn-target-player-number)
=>
    (up-get-player-color target-player goal)
    (up-chat-data-to-all "New Target: %d" g: goal)
    (up-modify-goal gl-last-target-player s:= sn-target-player-number)
    (up-reset-unit c: -1)
)

