;###################### QVILLAGERS
(defrule
    (not(goal gl-need-vills YES))
    (up-timer-status t-vill-training != timer-disabled)
=>
    (disable-timer t-vill-training)
)

;WWWWWWWWWWWWWWWWWW FLUSH
(defrule
    (or (and(food-amount > 550)
    (gold-amount > 155))
    (and(gold-amount > 90)
    (food-amount > 750)))
    (research-available castle-age)
=>
    ;	(chat-to-player me "Skip vill")
    (up-jump-rule 3)
)

(defrule
    (goal gl-current-build-item PAA)
    (research-completed ri-fletching)
    (players-unit-type-count target-player skirmisher < 5)
=>
    ;	(chat-to-player me "Jump for PAA")
    (up-jump-rule 2)
)

(defrule
    (false)
    (goal gl-current-build-item FLTCH)
    (building-type-count blacksmith > 0)
=>
    (up-jump-rule 1)
)

(defrule
    (goal gl-strategy FLUSH)
    (up-can-train gl-escrow-state c: villager)
    (or	(goal gl-need-vills YES)
    (and(unit-type-count-total villager < 25)
    (and(food-amount < 400)
    (up-pending-objects c: villager < 1))))
=>
    (up-train gl-escrow-state c: villager)
    (enable-timer t-vill-training 21)
    ;	(chat-to-player me "Villager")
)

;WWWWWWWWWWWWWWWWWW GENERAL
(defrule
    (goal gl-need-vills YES)
    (up-pending-objects c: villager < 1)
    (or (current-age >= castle-age)
    (and(current-age >= feudal-age)
    (goal gl-strategy FLUSH)))
    (up-can-train gl-escrow-state c: villager)
=>
    (up-train gl-escrow-state c: villager)
    ;	(chat-to-player me "New Villager")
    (enable-timer t-vill-training 21)
)

;WWWWWWWWWWWWWWWWWW KRUSH
(defrule
    (goal gl-strategy KRUSH)
    (up-can-train gl-escrow-state c: villager)
    (or	(goal gl-need-vills YES)
    (and(unit-type-count-total villager < KrushDarkAgeVills)
    (and(food-amount < 400)
    (up-pending-objects c: villager < 1))))
=>
    (up-train gl-escrow-state c: villager)
    ;	(chat-to-player me "KrushVillager")
    (enable-timer t-vill-training 21)
)

;###################### QESCROW
;essentially just set the escrow if needed for any build item
(defrule	;progression pause
    (false)
    (goal gl-twenty-turn 1)
    (up-compare-goal gl-progression-pause != -1)
=>
    (up-chat-data-to-player me "ProgressionPause is at %d" g: gl-progression-pause)
)

(defrule	;siege pause
    (false)
    (goal gl-twenty-turn 1)
    (up-compare-goal SIEGE != -1)
=>
    (up-chat-data-to-player me "SIEGE is at %d" g: SIEGE)
)

;WWWWWWWWWWWWWWWWWW FINISHED
(defrule
    (goal gl-current-build-item FINISHED)
=>
    (set-escrow-percentage food 0)
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (set-escrow-percentage stone 0)
    (release-escrow stone)
    (release-escrow food)
    (release-escrow wood)
    (release-escrow gold)
)

;WWWWWWWWWWWWWWWWWW RELEASE
(defrule
    (taunt-detected me 21)
=>
    (chat-to-player me "ESCROWS TO ZERO")
    (set-escrow-percentage stone 0)
    (set-escrow-percentage food 0)
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (acknowledge-taunt me 21)
    (release-escrow stone)
    (release-escrow food)
    (release-escrow wood)
    (release-escrow gold)
)

(defrule
    (or	(escrow-amount food > 850)
    (and(escrow-amount food > 700)
    (up-compare-goal gl-current-build-item != CUP)))
=>
    ;	(chat-to-player me "Release escrowed food")
    (release-escrow food)
)

(defrule
    (or	(escrow-amount wood > 700)
    (and(escrow-amount wood > 250)
    (and(up-compare-goal gl-build-progress >= FletchingNumber)
    (up-research-status c: castle-age < research-pending))))
=>
    ;	(chat-to-player me "Release escrowed wood")
    (release-escrow wood)
)

(defrule
    (or	(escrow-amount gold > 700)
    (and(escrow-amount gold > 200)
    (up-research-status c: castle-age < research-pending)))
=>
    ;	(chat-to-player me "Release escrowed gold")
    (release-escrow gold)
)

(defrule
    (escrow-amount stone > 400)
=>
    ;	(chat-to-player me "Release escrowed stone")
    (release-escrow stone)
)

(defrule
    ;	(true)
    (taunt-detected me 15)
=>
    (up-get-fact escrow-amount food gl-food-escrow)
    (up-get-fact escrow-amount wood gl-wood-escrow)
    (up-get-fact escrow-amount gold gl-gold-escrow)
    (up-get-fact escrow-amount stone gl-stone-escrow)
    (up-chat-data-to-player me "Food escrowed: %d" g: gl-food-escrow)
    (up-chat-data-to-player me "Wood escrowed: %d" g: gl-wood-escrow)
    (up-chat-data-to-player me "Gold escrowed: %d" g: gl-gold-escrow)
    (up-chat-data-to-player me "Stone escrowed: %d" g: 	gl-stone-escrow)
    (up-chat-data-to-player me "ProgPause: %d" g: gl-progression-pause)
    (up-chat-data-to-player me "Build progress is %d" g: gl-build-progress)
    (up-chat-data-to-player me "Build Item: %d" g: gl-current-build-item)
    (acknowledge-taunt me 15)
)

;###################### QTSB
;WWWWWWWWWWWWWWWWWW DEBUG
;@@@@@@@@@@@@@@@ ANTI-TRUSH
(defrule
    (goal gl-trushed YES)
=>
    (up-modify-goal gl-original-ts s:= sn-maximum-town-size)
    (up-modify-sn sn-maximum-town-size c:+ 30)
    (up-chat-data-to-player me "Original TS: %d" g: gl-original-ts)
    (up-chat-data-to-player me "Increased TS to %d" s: sn-maximum-town-size)
    (disable-self)
)

(defrule
    (goal gl-trushed NO)
=>
    (up-modify-sn sn-maximum-town-size g:= gl-original-ts)
    (up-chat-data-to-player me "Original TS: %d" g: gl-original-ts)
    (up-chat-data-to-player me "Current TS: %d" s: sn-maximum-town-size)
    (disable-self)
)

;@@@@@@@@@@@@@@@ CAMP DISTANCE
(defrule
    (game-time > 1800)
=>
    (set-strategic-number sn-camp-max-distance 100)
    ;	(chat-to-player me "HIGH camp distance")
    (disable-self)
)

;@@@@@@@@@@@@@@@ CONTROLLED
(defrule
    (or	(taunt-detected me 26)
    (taunt-detected any-enemy 26))
=>
    (up-modify-sn sn-maximum-town-size g:= gl-original-ts)
    (acknowledge-taunt this-any-enemy 26)
    (acknowledge-taunt me 26)
    (chat-to-player me "TSA off")
)

(defrule
    (taunt-detected me 30)
=>
    (set-strategic-number sn-maximum-town-size 1000)
    (acknowledge-taunt this-any-enemy 30)
    (acknowledge-taunt me 30)
    (chat-to-player me "TSA on")
)

;@@@@@@@@@@@@@@@ AGE-BASED
;>>>>>>>>>>> DARK AGE
(defrule
    (current-age == dark-age)
=>
    (set-strategic-number sn-maximum-town-size 12)
    (up-modify-goal gl-original-ts s:= sn-maximum-town-size)
    (set-strategic-number sn-camp-max-distance 20)
    (disable-self)
)

;>>>>>>>>>>> FEUDAL AGE
(defrule
    (current-age == feudal-age)
=>
    (set-strategic-number sn-maximum-town-size 15)
    (up-modify-goal gl-original-ts s:= sn-maximum-town-size)
    (set-strategic-number sn-camp-max-distance 32)
    (disable-self)
)

;>>>>>>>>>>> CASTLE AGE
(defrule
    (current-age == castle-age)
=>
    ;	(set-strategic-number sn-maximum-town-size 27)
    (set-strategic-number sn-camp-max-distance 40)
    (up-modify-goal gl-original-ts c:= 27)
    (disable-self)
)

(defrule
    (current-age-time >= 120)
    (current-age == castle-age)
=>
    ;	(set-strategic-number sn-maximum-town-size 32)
    (up-modify-goal gl-original-ts c:= 32)
    (disable-self)
)

;###################### QRANGES
;WWWWWWWWWWWWWWWWWW FIRST TWO
(defrule
    (goal gl-current-build-item RANGES)
    (building-type-count-total archery-range >= 2)
=>
    (up-modify-goal gl-build-progress c:+ 1)
    (up-modify-goal gl-current-build-item c:= 2BA)
    ;	(chat-to-player me "Ranges Built")
    ;	(chat-to-player me "Setting current build item to 2BA")
)

(defrule
    (true)
=>
    (set-goal goal 3)
)

(defrule
    (or	(goal gl-enemy-strategy DRUSH)
    (up-compare-goal gl-town-safe != YES))
=>
    (set-goal goal -5)
)

(defrule
    (goal gl-progression-pause -1)
    (goal gl-current-build-item RANGES)
    (can-build-with-escrow archery-range)
    ;	(not(up-pending-placement c: archery-range))
    (up-timer-status t-build-delay != timer-running)
=>
    (set-escrow-percentage wood 0)
    (release-escrow wood)
    ;	(up-chat-data-to-player me "Range(%d)" g: goal)
    (enable-timer t-build-delay 3)
    (up-set-placement-data me -1 g: goal)
    (set-strategic-number sn-placement-zone-size 3)
    (up-build place-control 0 c: archery-range)
)

(defrule	;come back if skipped
    (goal gl-strategy FLUSH)
    (building-type-count-total archery-range < 2)
    (up-compare-goal gl-build-progress > RangesNumber)
=>
    (set-goal gl-build-progress RangesNumber)
)

(defrule
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-current-build-item != RANGES)
    (up-compare-goal gl-build-progress == RangesNumber)
=>
    ;	(chat-to-player me "Setting current build item to RANGES")
    (set-goal gl-current-build-item RANGES)
    (set-escrow-percentage wood LOW-ESCROW)
)

;WWWWWWWWWWWWWWWWWW ADDITIONAL
(defrule
    (goal gl-progression-pause -1)
    (can-build-with-escrow archery-range)
    (goal gl-current-build-item EXTRA-RANGES)
=>
    (up-set-placement-data me -1 c: 0)
    (set-strategic-number sn-placement-zone-size 3)
    (set-escrow-percentage wood 0)
    (release-escrow wood)
    (chat-to-player me "ExtraRange")
    (up-build place-control 0 c: archery-range)
)

(defrule	;come back if skipped
    (false)
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-build-progress > 33)
=>
    (set-goal gl-build-progress 33)
)

(defrule
    (false)
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-build-progress == 33)
    (up-compare-goal gl-current-build-item != EXTRA-RANGES)
=>
    ;	(chat-to-player me "Setting current build item to EXTRA-RANGES")
    (set-goal gl-current-build-item EXTRA-RANGES)
    (set-escrow-percentage wood LOW-ESCROW)
)

(defrule
    (false)
    (goal gl-current-build-item EXTRA-RANGES)
    (building-type-count-total archery-range >= 2)
=>
    (up-modify-goal gl-build-progress c:+ 1)
    ;	(chat-to-player me "Ranges Built")
)

;WWWWWWWWWWWWWWWWWW TECHS
;@@@@@@@@@@@@@@@ CASTLE AGE
;>>>>>>>>>>> QESKIRMS
(defrule
    ;	(goal gl-progression-pause -1)
    (goal gl-current-build-item ESKIRMS)
    (or	(can-research ri-elite-skirmisher)
    (or	(can-research-with-escrow ri-elite-skirmisher)
    (up-can-research gl-escrow-state c: ri-elite-skirmisher)))
=>
    (up-research gl-escrow-state c: ri-elite-skirmisher)
    ;	(chat-to-player me "Elite Skirmishers")
    (set-goal gl-escrow-state with-escrow)
)

(defrule	;come back if skipped
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-build-progress > EskirmsNumber)
    (up-research-status c: ri-elite-skirmisher < research-pending)
=>
    (set-goal gl-build-progress EskirmsNumber)
)

(defrule
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-current-build-item != ESKIRMS)
    (up-compare-goal gl-build-progress == EskirmsNumber)
=>
    ;	(chat-to-player me "Setting current build item to ESKIRMS")
    (set-goal gl-current-build-item ESKIRMS)
)

(defrule
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-progression-pause == -1)
    (up-compare-goal gl-current-build-item == ESKIRMS)
=>
    (set-escrow-percentage wood HIGH-ESCROW)
    (set-escrow-percentage gold HIGH-ESCROW)
    (set-escrow-percentage food HIGH-ESCROW)
)

(defrule
    (goal gl-current-build-item ESKIRMS)
    (up-research-status c: ri-elite-skirmisher >= research-pending)
=>
    ;	(chat-to-player me "Elite Skirmisher Researched")
    (up-modify-goal gl-build-progress c:+ 1)
)

