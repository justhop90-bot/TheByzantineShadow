    (true)
=>
    (up-jump-rule 11)
)

(defrule
    (up-group-size c: RangedGroup > 0)
    (up-point-distance ranged-group-x knight-group-x >= 8)
=>
    (set-goal goal 13)
)

(defrule
    (true)
=>
    (set-goal goal2 0)
)

(defrule
    (up-group-size c: RangedGroup > 0)
=>
    (set-goal goal2 4)
)

(defrule	;tc fire
    (up-compare-goal gl-knight-eval < CostOfIgnoringTCFire)
    (up-projectile-detected projectile-town-center c:< 3000)
    (or	(goal gl-fifth-turn 1)
    (up-compare-goal gl-knight-group-state != RETREATING))
    (up-projectile-target projectile-town-center == cavalry-class)
=>
    (set-goal gl-knight-retreat 3)
    (set-goal SPLIT 1)
)

(defrule	;if bad fight
    (up-compare-goal goal1 > 1)
    (up-compare-goal gl-knight-eval < CostOfFighting)
    (or	(goal gl-fifth-turn 1)
    (up-compare-goal gl-knight-group-state != RETREATING))
=>
    (set-goal gl-knight-retreat 1)
    (set-goal SPLIT 1)
)

(defrule	;if too far
    (false)
    (up-point-distance knight-group-x ranged-group-x >= 17)
    (or	(goal gl-fifth-turn 1)
    (up-compare-goal gl-knight-group-state != RETREATING))
=>
    (chat-to-player me "Distance Retreat")
    (set-goal gl-knight-retreat 2)
    (set-goal SPLIT 1)
)

(defrule
    (false)
    (goal gl-knight-retreat 2)
=>
    (set-goal goal2 20)
)

(defrule
    (goal SPLIT 1)
=>
    (chat-to-player me "Retreat!")
    (up-full-reset-search)
    (up-set-group search-local c: KnightGroup)
    (up-copy-point point-x home-x)
    (up-lerp-tiles point-x home-x c: 9)
    (up-lerp-tiles point-x ranged-group-x g: goal2)
    (up-target-point point-x action-move -1 no-attack)
    (set-goal gl-knight-group-state RETREATING)
    (set-goal SPLIT 0)
)

(defrule
    (goal gl-knight-retreat 1)
    (up-compare-goal gl-knight-eval >= CostOfFighting)
=>
    (chat-to-player me "Reset Knight Retreat 1")
    (set-goal gl-knight-retreat -1)
)

(defrule
    (goal gl-knight-retreat 3)
    (or	(up-compare-goal gl-knight-eval >= CostOfIgnoringTCFire)
    (or	(not(up-projectile-detected projectile-town-center c:< 3000))
    (up-projectile-target projectile-town-center != cavalry-class)))
=>
    (chat-to-player me "Reset Knight Retreat 3")
    (set-goal gl-knight-retreat -1)
)

(defrule
    (false)
    (goal gl-knight-retreat 2)
    (up-point-distance knight-group-x ranged-group-x < 10)
=>
    (chat-to-player me "Reset Knight Retreat 2")
    (set-goal gl-knight-retreat -1)
)

;###################### QRAIDING
;WWWWWWWWWWWWWWWWWW RANGED STYLE
(defrule
    (up-group-size c: RangedGroup > 0)
    (up-compare-goal gl-enemy-strategy != KRUSH)
    (up-compare-goal gl-ranged-style != SEPARATE)
    (players-unit-type-count target-player knight-line < 4)
    (players-unit-type-count target-player eagle-warrior-line < 4)
    (or	(players-military-population target-player < 5)
    (players-unit-type-count target-player skirmisher-line >= 7))
=>
    ;	(chat-to-player me "USE SEPARATE RANGED STYLE")
    (set-goal gl-ranged-style SEPARATE)
)

(defrule
    (up-group-size c: RangedGroup > 0)
    (up-compare-goal gl-ranged-style != COMBINED)
    (or	(up-compare-goal gl-enemy-strategy == KRUSH)
    (or	(players-unit-type-count target-player knight-line >= 5)
    (players-unit-type-count target-player eagle-warrior-line >= 5)))
=>
    ;	(chat-to-player me "USE COMBINED RANGED STYLE")
    (set-goal gl-ranged-style COMBINED)
)

(defrule
    (up-group-size c: RangedGroup < 1)
    (up-compare-goal gl-ranged-style != -1)
=>
    ;	(chat-to-player me "REMOVE RANGED STYLE")
    (set-goal gl-ranged-style -1)
)

