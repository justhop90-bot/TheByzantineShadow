    (up-compare-goal SUPERIORITY >= 30)
=>
    (up-set-defense-priority c: town-center c: 700)
    (up-set-defense-priority c: castle c: 800)
    (up-set-defense-priority c: watch-tower c: 500)

    (up-set-defense-priority c: lumber-camp c: 100)
    (up-set-defense-priority c: mining-camp c: 100)
    (up-set-defense-priority c: mill c: 100)
)

(defrule
    (goal gl-strategy FLUSH)
    (or	(unit-type-count knight < 3)
    (up-compare-goal SUPERIORITY < 30))
=>
    (up-set-defense-priority c: town-center c: 1000)
    (up-set-defense-priority c: castle c: 700)
    (up-set-defense-priority c: watch-tower c: 1100)

    (up-set-defense-priority c: lumber-camp c: 100)
    (up-set-defense-priority c: mining-camp c: 100)
    (up-set-defense-priority c: mill c: 100)
)

