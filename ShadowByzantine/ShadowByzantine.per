;WWWWWWWWWWWWWWWWWW DARK BUILD
;1 at > 80 game-time evaluate if lc can be built
;2 if yes, build
;3 otherwise, at 120 game-time, build mill
(defrule
    (goal gl-dark-build -1)
    (or (current-age >= feudal-age)
    (and(game-time > 80)
    (up-compare-goal gl-current-sheep-count >= 6)))
=>
    (set-goal gl-dark-build LumberFirst)
    ;	(chat-to-player me "Lumber First 1")
    (disable-self)
)

(defrule
    (game-time > 50)
    (wood-amount >= 200)
    (goal gl-dark-build MillFirst)
    (building-type-count-total mill < 1)
=>
    (set-goal gl-dark-build LumberFirst)
    ;	(chat-to-player me "Lumber First 2")
    (disable-self)
)

(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 35)
)

(defrule
    (game-time > 37)
    (goal gl-dark-build -1)
    (not(up-find-remote c: sheep c: 1))
    (up-compare-goal gl-current-sheep-count < 1)
=>
    (set-goal gl-dark-build MillFirst)
    ;	(chat-to-player me "Mill First 1")
    (up-assign-builders c: mill c: 2)
    (disable-self)
)

(defrule
    (goal gl-dark-build -1)
    (not(up-find-remote c: sheep c: 1))
    (or	(and(game-time > 80)
    (unit-type-count sheep < 1))
    (and(game-time > 120)
    (up-compare-goal gl-current-sheep-count < 5)))
=>
    (set-goal gl-dark-build MillFirst)
    ;	(chat-to-player me "Mill First 2")
    (disable-self)
)

