;WWWWWWWWWWWWWWWWWW FIGHT SKIRMS
;@@@@@@@@@@@@@@ WITH ONE VILL
(defrule
    (players-military-population every-enemy >= 17)
=>
    (up-jump-rule 6)
)

;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal goal 0)
    (set-goal rt 0)
)

;2. SEARCH
(defrule	;first check if any enemy skirms are around
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 35)
    (up-find-remote c: skirmisher c: 1)
    (up-get-search-state lt)
    ;	(up-modify-goal goal g:= rt)
)

;3. LOOP THE SEARCH
(defrule	;once one is found, don't need to keep searching
    (up-compare-goal rt < 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule	;find vills close to the unit
    (up-compare-goal rt >= 1)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-point position-object point-x)
    (up-set-target-point point-x)
    (up-filter-distance c: -1 c: 4)
    (up-find-local c: villager-class c: 10)
    (up-remove-objects search-local object-data-hitpoints < 25)
    (up-get-search-state lt)
)

(defrule
    (goal gl-fifth-turn 1)
    (up-compare-goal lt >= 1)
    (up-point-distance point-x home-x < 25)
=>
    (up-clean-search search-local object-data-precise-distance search-order-asc)
    (up-remove-objects search-local -1 > 2)
    (up-find-remote c: skirmisher c: 10)
    (up-set-target-point home-x)
    (up-clean-search search-remote object-data-precise-distance search-order-asc)
    (up-remove-objects search-remote -1 > 0)
    (up-get-point position-object point-x)
    (up-set-target-point point-x)
    (up-target-objects 1 action-default -1 -1)
    ;	(chat-to-all "Attack Enemy Skirms")
    (set-goal gl-skirm-vills 3)
)

(defrule
    (goal gl-skirm-vills 3)
    (or	(goal gl-ninety-turn 1)
    (or	(up-compare-goal lt < 1)
    (up-point-distance point-x home-x >= 30)))
=>
    ;	(chat-to-all "Stop Attacking Skirms")
    (up-full-reset-search)
    (up-filter-include -1 actionid-attack -1 -1)
    (up-find-local c: villager-class c: 10)
    (up-target-point home-x action-stop -1 -1)
    (set-goal gl-skirm-vills -1)
)

;WWWWWWWWWWWWWWWWWW ENEMY-ATTACK-X
(defrule
    (false)
    (goal gl-town-safe YES)
=>
    (up-jump-rule 8)
)

;1 the basic idea: get the position of the enemy army in your town, then search near that for weak vills, and if any found, garrison him to the tc repeatedly
;@@@@@@@@@@@@@@ Find enemy attack group center of gravity - By KnightPanda
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal enemy-attack-x -1)
    (set-goal enemy-attack-y -1)
    (set-goal point-x 0)
    (set-goal point-y 0)
    (set-goal goal 35)
    (set-goal goal1 0)
    (set-goal rt 0)
)

(defrule
    (current-age == feudal-age)
=>
    (set-goal goal 47)
)

(defrule
    (current-age >= castle-age)
=>
    (set-goal goal 56)
)

(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 g: goal)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-remote c: all-units-class c: 40)
)

(defrule
    (stance-toward focus-player enemy)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-object-data object-data-point-x point2-x)
    (up-get-object-data object-data-point-y point2-y)
    (up-modify-goal point-x g:+ point2-x)
    (up-modify-goal point-y g:+ point2-y)
    (up-get-search-state lt)
    (up-modify-goal goal1 c:+ 1) ;number of points checked
)

(defrule
    (up-compare-goal rt > 0)
    (stance-toward focus-player enemy)
=>
    (up-remove-objects search-remote -1 == 0)
    (up-get-search-state lt)
    (up-jump-rule -2)
)

(defrule
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -4)
)

(defrule
    (up-compare-goal goal1 > 0)
=>
    (up-modify-goal point-x g:/ goal1)
    (up-modify-goal point-y g:/ goal1)
    (up-copy-point enemy-attack-x point-x)	;remote group point
)

;@@@@@@@@@@@@@@ ANTI-SCOUT
;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal goal 0)
    (set-goal goal1 0)
    (set-goal goal2 0)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 35)
    (up-find-remote c: scout-cavalry-line c: 1)
    (up-find-remote c: eagle-warrior-line c: 1)
    (up-get-search-state lt)
)

;3. LOOP THE SEARCH
(defrule
    (up-compare-goal rt < 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (up-compare-goal rt >= 1)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-point position-object point-x)
    (up-set-target-point point-x)
    (up-filter-distance c: -1 c: 5)
    (up-find-local c: villager-class c: 10)
    (up-remove-objects search-local object-data-hitpoints < 30)
    (up-get-search-state lt)
    (up-modify-goal goal g:= lt)
    (up-remove-objects search-local object-data-hitpoints >= 25)
    (up-get-search-state lt)
    (up-modify-goal goal1 g:= lt)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (up-full-reset-search)
    (up-set-target-point point-x)
    (up-filter-distance c: -1 c: 5)
    (up-find-local c: villager-class c: 20)
    (up-remove-objects search-local object-data-hitpoints >= 10)
    (up-get-search-state lt)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal goal1 > 0)	;weak vill
    (or	(up-compare-goal lt >= 1)	;superweak vill
    (up-compare-goal goal < 3))	;not enough strong vills
=>
    (up-clean-search search-local object-data-hitpoints search-order-asc)
    (up-remove-objects search-local -1 > 0)
    (up-target-point home-x action-garrison -1 no-attack)
    (chat-to-all "Garrisoning weak vill near enemy scout")
    )	;SPLIT reset below debug

(defrule
    (taunt-detected me 30)
    (goal gl-fifth-turn 1)
=>
    (up-chat-data-to-player me "Weak vills: %d" g: goal1)
    (up-chat-data-to-player me "Very weak vills: %d" g: lt)
    (up-chat-data-to-player me "Total vills: %d" g: goal)
    (up-chat-data-to-player me "SPLIT: %d" g: SPLIT)
)

(defrule
    (taunt-detected me 31)
=>
    (acknowledge-taunt me 30)
    (acknowledge-taunt me 31)
)

(defrule
    (true)
=>
    (set-goal SPLIT 0)
)

;WWWWWWWWWWWWWWWWWW HURT MILITIA/MAA
(defrule
    (players-current-age-time every-enemy >= 60)
    (players-current-age every-enemy >= castle-age)
=>
    (up-jump-rule 8)
)

;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
)

;2. SEARCH
(defrule	;first check if any enemy infantry are around
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 35)
    (up-find-remote c: militiaman-line c: 5)
    (up-find-remote c: spearman-line c: 5)
    (up-remove-objects search-remote object-data-action != actionid-attack)
    (up-remove-objects search-remote object-data-target != villager-class)
    (up-clean-search search-remote 44 search-order-asc)
    (up-get-search-state lt)
    (up-modify-goal goal g:= rt)
)

;3. LOOP THE SEARCH
(defrule
    (up-compare-goal rt < 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule	;find vills close to the infantry
    (up-compare-goal rt >= 1)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-point position-object point-x)
    (up-set-target-point point-x)
    (up-filter-distance c: -1 c: 6)
    (up-find-local c: villager-class c: 10)
    (up-remove-objects search-local object-data-hitpoints < 28)
    ;	(up-filter-distance c: -1 c: 2)
    ;	(up-find-local c: villager-class c: 10)
    ;	(up-remove-objects search-local object-data-action != actionid-build)
    (up-set-target-point home-x)
    (up-remove-objects search-local 44 < 7)
    (up-get-search-state lt)
)

(defrule
    (up-compare-goal lt == 1)
    (up-set-target-object search-local c: 0)
=>
    ;	(chat-to-all "Retreat From Enemy Infantry")
    (up-get-point position-object object-x)	;vill-x
    (up-copy-point point2-x point-x)	;point is the enemy unit
    (up-lerp-tiles point2-x home-x c: 3)	;lerp toward home
    (up-lerp-tiles point2-x point-x c: -2)	;lerp away from the attacker
    (up-target-point point2-x action-default -1 -1)
    ;	(up-send-flare point2-x)
)

(defrule
    (goal gl-fifth-turn 1)
    (up-compare-goal lt >= 1)
    (up-point-distance point-x home-x < 25)
=>
    (up-set-target-point point-x)
    (up-clean-search search-local object-data-precise-distance search-order-asc)
    (up-remove-objects search-local -1 > 2)
    (up-find-remote c: militiaman-line c: 5)
    (up-find-remote c: spearman-line c: 5)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (up-remove-objects search-remote object-data-action != actionid-attack)
    (up-remove-objects search-remote object-data-target != villager-class)
    (up-set-target-point home-x)
    (up-clean-search search-remote object-data-precise-distance search-order-asc)
    (up-remove-objects search-remote -1 > 0)
    (up-target-objects 1 action-default -1 -1)
    ;	(chat-to-all "Attack Enemy Infantry")
    (enable-timer t-infantry-attack 2)
    (set-goal gl-aggressive-vills 3)
    ;	(up-send-flare point-x)
    (set-goal SPLIT 0)
)

(defrule
    (goal gl-aggressive-vills 3)
    (or	(goal gl-ninety-turn 1)
    (or	(up-point-distance point-x home-x >= 30)
    (and(up-compare-goal lt < 1)
    (up-timer-status t-infantry-attack != timer-running))))
=>
    ;	(chat-to-all "Stop Attacking Infantry")
    (up-full-reset-search)
    (up-filter-include -1 actionid-attack -1 -1)
    (up-find-local c: villager-class c: 10)
    (up-target-point home-x action-stop -1 -1)
    (set-goal gl-aggressive-vills -1)
)

;WWWWWWWWWWWWWWWWWW HURT CARELESS ENEMY SCOUT
;@@@@@@@@@@@@@@ WITH ONE VILL
(defrule
    (or	(goal gl-aggressive-vills 1)	;already attacking scout with two vills
    (players-current-age every-enemy >= castle-age))
=>
    (up-jump-rule 5)
)

