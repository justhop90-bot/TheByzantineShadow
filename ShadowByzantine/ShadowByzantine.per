    (up-find-remote c: cavalry-archer-class c: 40)
    (up-find-remote c: archery-cannon-class c: 40)
    (up-get-search-state lt)
    (set-goal goal 0)
    (set-goal point-x 0)
    (set-goal point-y 0)
    (set-goal rt 0)
)

