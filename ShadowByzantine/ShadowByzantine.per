(defrule	;then reset when close
    (goal gl-scout-added 1)
    (up-compare-goal goal2 < 1)
    (up-point-distance scout-x point-x < 2)
=>
    (up-full-reset-search)
    (up-add-object-by-id search-local g: scout-id)
    (up-target-point point-x action-stop -1 aggressive)
    ;	(chat-to-all "Reset scout")
    (set-goal gl-scout-added 2)
)

(defrule	;stop scout from fighting if too far when not attacking
    (up-compare-goal gl-scout-added == 2)
    (up-point-distance scout-x point-x >= 5)
=>
    ;	(chat-to-all "Micro scout behind army while marching")
    (set-goal gl-scout-added 1)
)

;1. SET UP THE SEARCH
