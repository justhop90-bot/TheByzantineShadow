    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule	;inspired by Barbarian by TheMax
    (goal gl-strategy FLUSH)
    (or	(goal gl-town-safe NO)
    (up-compare-goal rt >= 1))
    (up-timer-status t-defense != timer-running)
=>
    ;	(chat-to-player me "PatrolDefense")
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: DefenseRadius)
    (up-filter-exclude -1 actionid-attack orderid-explore -1)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: all-units-class c: 80)
    (up-remove-objects search-local object-data-type == battering-ram)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal gl-cavalry-in-town < 3)
    (up-compare-goal gl-archery-in-town >= 4)
=>
    (up-remove-objects search-local object-data-type == spearman)
    (up-remove-objects search-local object-data-type == pikeman)
)

(defrule
    (goal SPLIT 1)
=>
    (up-remove-objects search-local object-data-type == scout-cavalry)
    (up-remove-objects search-local object-data-group-flag == RangedGroup)
    (up-remove-objects search-local object-data-group-flag == KnightGroup)
    (up-remove-objects search-local object-data-group-flag == RaidGroup)
    (up-set-target-point ranged-group-x)
    (up-remove-objects search-local object-data-distance < 10)
    (up-reset-filters)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: DefenseRadius)
    ;	(up-find-remote c: all-units-class c: 40)
    ;	(up-target-objects 0 action-patrol -1 aggressive)
    (up-target-point home-x action-patrol -1 aggressive)
    (enable-timer t-defense 10)
    (set-goal SPLIT 0)
)

