    (goal gl-target-age FA)
    (false)
    (up-compare-goal gl-target-score1 > 65)
    (players-current-age-time target-player > 30)
=>
    ;	(enable-timer t-enemy-age-cancel 150)
    (set-goal gl-target-age CA-loading)
)

(defrule
    (false)
    (goal gl-target-age CA-loading)
    (goal gl-target-age-checking YES)
    (up-compare-goal gl-target-score1 < -65)
    (up-timer-status t-enemy-age-cancel == timer-running)
=>
    ;	(chat-to-player me "Target cancelled Castle Age")
    (set-goal gl-target-age FA)
)

(defrule
    (goal gl-target-age CA-loading)
    (goal gl-target-age-checking YES)
    (players-current-age target-player == castle-age)
=>
    (set-goal gl-target-age CA)
)

;WWWWWWWWWWWWWWWWWW IMPERIAL AGE
(defrule
    (goal gl-target-age CA)
    (up-compare-goal gl-target-score1 > 100)
    (players-current-age-time target-player > 30)
=>
    ;	(enable-timer t-enemy-age-cancel 200)
    (set-goal gl-target-age IA-loading)
)

(defrule
    (false)
    (goal gl-target-age-checking YES)
    (goal gl-target-age IA-loading)
    (up-compare-goal gl-target-score1 < -100)
    (up-timer-status t-enemy-age-cancel == timer-running)
=>
    (chat-to-player me "Target cancelled Imperial Age")
    (set-goal gl-target-age CA)
)

(defrule
    (goal gl-target-age IA-loading)
    (goal gl-target-age-checking YES)
    (players-current-age target-player == imperial-age)
=>
    (set-goal gl-target-age IA)
)

(defrule	;update the score
    (goal gl-target-age-checking YES)
    (up-compare-goal gl-target-score2 g:!= gl-target-score1)
=>
    (up-get-target-fact current-score 0 gl-target-score1)
    (up-get-target-fact current-score 0 gl-target-score2)
)

;###################### QSPECIAL TIMERS
(defrule
    (timer-triggered 30SEC)
=>
    (up-modify-goal gl-switch c:* -1)
)

(defrule
    (up-timer-status 30SEC != timer-running)
=>
    (enable-timer 30SEC 30)
)

(defrule
    (up-timer-status ONE-MINUTE != timer-running)
=>
    (enable-timer ONE-MINUTE 60)
)

(defrule
    (up-timer-status THREE-MINUTE != timer-running)
=>
    (enable-timer THREE-MINUTE 180)
)

(defrule
    (up-timer-status TWO-MINUTE != timer-running)
=>
    (enable-timer TWO-MINUTE 120)
)

(defrule
    (up-timer-status five-seconds-timer != timer-running)
=>
    (enable-timer five-seconds-timer 5)
)

(defrule
    (true)
=>
    (up-modify-goal gl-turn-count c:+ 1)
    (up-modify-goal gl-second-turn g:= gl-turn-count)
    (up-modify-goal gl-second-turn c:mod 2)
    (up-modify-goal gl-fifth-turn g:= gl-turn-count)
    (up-modify-goal gl-fifth-turn c:mod 5)
    (up-modify-goal gl-seventh-turn g:= gl-turn-count)
    (up-modify-goal gl-seventh-turn c:mod 7)
    (up-modify-goal gl-tenth-turn g:= gl-turn-count)
    (up-modify-goal gl-tenth-turn c:mod 10)
)

(defrule
    (true)
=>
    (up-modify-goal gl-twenty-turn g:= gl-turn-count)
    (up-modify-goal gl-twenty-turn c:mod 20)
    (up-modify-goal gl-fifty-turn g:= gl-turn-count)
    (up-modify-goal gl-fifty-turn c:mod 50)
    (up-modify-goal gl-ninety-turn g:= gl-turn-count)
    (up-modify-goal gl-ninety-turn c:mod 90)
    (up-modify-goal gl-thirty-turn g:= gl-turn-count)
    (up-modify-goal gl-thirty-turn c:mod 30)
)
