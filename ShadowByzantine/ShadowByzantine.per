    (false)
    (goal SPLIT 1)
    (up-group-size c: RangedGroup > 10)
    (up-point-distance target-x ranged-group-x < 20)
=>
    (up-lerp-tiles ranged-group-x target-x c: 1)
    ;	(chat-to-player me "Lerp Once")
)

(defrule
    (goal SPLIT 1)
=>
    (set-goal SPLIT 0)
)

(defrule
    (false)
    (goal gl-fifty-turn 1)
=>
    (chat-to-player me "SkirmReset")
    ;	(up-full-reset-search)
    ;	(up-find-local c: skirmisher-line c: 50)
    ;	(up-remove-objects search-local object-data-group-flag == RaidGroup)
    ;	(up-remove-objects search-local object-data-group-flag == RangedGroup)
    (up-set-attack-stance skirmisher-line c: aggressive)
)

(defrule
    (up-group-size c: RangedGroup > 0)
    (unit-type-count skirmisher-line >= 25)
    (research-completed ri-elite-skirmisher)
    (players-unit-type-count every-enemy knight-line < 3)
    (players-unit-type-count every-enemy eagle-warrior-line < 3)
    (up-compare-goal gl-army-damage-potential >= CostOfIgnoringEverything)
=>
    ;	(chat-to-all "REMOVE RANGED ARMY")
    (up-modify-group-flag 0 c: RangedGroup)
    (up-reset-group c: RangedGroup)
    (up-full-reset-search)
    (up-find-local c: skirmisher-line c: 50)
    ;	(up-find-local c: archer-line c: 40)
    (up-target-point enemy-x action-stop formation-stagger aggressive)
    (up-modify-goal gl-army-damage-potential c:+ 5)
)

;WWWWWWWWWWWWWWWWWW QINITIALIZING GROUP
(defrule
    (up-group-size c: RangedGroup < 1)
    (or	(and(unit-type-count skirmisher-line >= 1)
    (up-research-status c: ri-elite-skirmisher < research-complete))
    (and(unit-type-count skirmisher-line < 17)
    (research-completed ri-elite-skirmisher)))
=>
    (set-goal SPLIT 1)
)

(defrule
    (up-group-size c: RangedGroup < 1)
    (unit-type-count skirmisher-line >= 1)
    (or	(players-unit-type-count any-enemy knight-line >= 3)
    (players-unit-type-count any-enemy eagle-warrior-line >= 3))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    ;	(chat-to-player me "CREATE NEW RANGED ARMY")
    (up-modify-group-flag 0 c: RangedGroup)
    (up-reset-group c: RangedGroup)
    (up-full-reset-search)
    (up-filter-exclude actionid-explore -1 orderid-explore -1)
    (up-find-local c: skirmisher-line c: 40)
    ;	(up-find-local c: archer-line c: 40)
    (up-remove-objects search-local object-data-group-flag == RaidGroup)
    (up-set-target-point home-x)
    (up-clean-search search-local object-data-distance search-order-desc)
    (up-remove-objects search-local -1 > 0)
    (up-create-group 0 0 c: RangedGroup)
    (up-modify-group-flag 1 c: RangedGroup)
    (up-modify-goal gl-army-damage-potential c:- 5)
    (set-goal SPLIT 0)
)

(defrule
    (up-group-size c: RangedGroup < 1)
=>
    (up-jump-rule 1)
)

