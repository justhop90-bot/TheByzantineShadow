;###################### QSKIRMS
;WWWWWWWWWWWWWWWWWW GENERAL
(defrule
    (current-age >= castle-age)
=>
    (set-goal gl-escrow-state without-escrow)
)

(defrule	;fewer skirms if ahead in tg--saving for spears/castle age
    (player-valid 5)	;have atleast one pocket
    (not(player-valid 7))	;only one flank will have support
    (goal gl-strategy FLUSH)
    (up-compare-goal SUPERIORITY >= 15)
    (up-compare-goal gl-skirm-total >= 23)
    (unit-type-count-total skirmisher-line >= 10)
    (up-research-status c: castle-age < research-pending)
=>
    (up-jump-rule 2)
)

(defrule	;fewer skirms if enemy castled and not up
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-skirm-total >= 23)
    ;	(unit-type-count-total skirmisher-line >= 10)
    (or	(player-valid 7)	;have support from enemies
    (or	(goal gl-enemy-strategy KRUSH)
    (goal gl-enemy-strategy POSSIBLE-KRUSH)))
    (up-research-status c: castle-age < research-pending)
=>
    (up-jump-rule 1)
)

(defrule	;all
    (goal gl-strategy FLUSH)
    (or	(housing-headroom >= 3)
    (up-pending-objects c: house > 0))
    (up-pending-objects c: villager-class > 0)
    (or	(building-type-count-total blacksmith >= 1)
    (unit-type-count-total skirmisher-line < 16))
    (or	(game-time < 1020)	;17min
    (building-type-count-total mining-camp >= 1))
    (up-can-train gl-escrow-state c: skirmisher-line)
    (nand	(building-type-count blacksmith >= 1)
    (up-compare-goal gl-current-build-item == FLTCH))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (or	(up-compare-goal SUPERIORITY < -5)
    (or	(up-compare-goal gl-skirm-total < 35)
    (up-research-status c: castle-age >= research-pending)))
    (or	(current-age < castle-age)
    (and(up-compare-goal gl-progression-pause != XBOW)
    (up-research-status c: ri-elite-skirmisher >= research-pending)))
=>
    (set-goal SPLIT 2)
)

(defrule
    (goal SPLIT 2)
=>
    (up-modify-goal gl-skirm-total c:+ 1)
    ;	(up-chat-data-to-all "GeneralSkirm (%d)" g: gl-skirm-total)
    (up-train gl-escrow-state c: skirmisher-line)
    (set-goal gl-escrow-state with-escrow)
    (set-goal SPLIT 0)
)

(defrule
    (true)
=>
    (set-goal gl-escrow-state with-escrow)
    (set-goal SPLIT 0)
)

