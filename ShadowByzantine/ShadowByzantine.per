    (chat-to-all "Soooooo FRUSTRATING!!!")
    (enable-timer 5 10)
    (disable-self)
)

(defrule
    (military-population < 5)	;10
    (up-compare-goal goal1 >= 0)	;-5
    (up-compare-goal SUPERIORITY < 0)	;5
    (players-current-age target-player >= castle-age)
    (up-research-status c: castle-age < research-pending)
=>
    (chat-to-all "nice job, I couldn't break you")
