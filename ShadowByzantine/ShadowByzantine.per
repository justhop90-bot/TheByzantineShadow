;WWWWWWWWWWWWWWWWWW QTARGET PLAYER
;@@@@@@@@@@@@@@ PRIVILEGED
;>>>>>>>>>>> USING
(defrule
    (player-valid 5)
    (goal gl-fifth-turn 1)
    (goal gl-position POCKET)
=>
    (up-modify-sn sn-focus-player-number g:= gl-privileged-player)	;set focus to get his info
    (up-get-focus-fact allied-sn sn-target-player-number goal)
    (up-modify-sn sn-target-player-number g:= goal)	;set it to it
)

;>>>>>>>>>>> CHOOSING
(defrule
    (or	(game-time < 5)
    (or (game-time > 10)
    (not(player-valid 5))))
=>
    (up-jump-rule 4)
)

;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (up-full-reset-search)
    (set-goal rt 0)
)

;2. SEARCH
(defrule
    (not(stance-toward focus-player enemy))
    (up-allied-goal focus-player gl-position != POCKET)
=>
    (up-find-remote c: town-center c: 1)
)

;3. LOOP THE SEARCH
(defrule
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (true)
=>
    (up-set-target-point null-x)
    (up-clean-search search-remote 44 search-order-asc)
    (up-set-target-object search-remote c: 0)
    (up-get-object-data object-data-player gl-privileged-player)
    (up-modify-sn sn-focus-player-number g:= gl-privileged-player)
    (up-get-player-color focus-player goal)
    (up-chat-data-to-player me "Privileged Player is %d" g: goal)
    (up-get-point position-object point-x)
    (up-send-flare point-x)
    ;	(up-send-flare null-x)
    (disable-self)
)

;@@@@@@@@@@@@@@ FORCED-SWITCH
;----- FIRST
(defrule
    (taunt-detected me 122)
=>
    (chat-to-all "Switching to Closest Target")
    (up-find-player enemy find-closest goal)
    (up-modify-sn sn-target-player-number g:= goal)
    (acknowledge-taunt me 122)
)

;----- SECOND
(defrule
    (taunt-detected me 123)
=>
    (chat-to-all "Switching to 2nd Closest Target")
    (up-find-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-modify-sn sn-target-player-number g:= goal)
    (acknowledge-taunt me 123)
)

;----- THIRD
(defrule
    (taunt-detected me 124)
=>
    (chat-to-all "Switching to 3rd Closest Target")
    (up-find-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-modify-sn sn-target-player-number g:= goal)
    (acknowledge-taunt me 124)
)

;----- FOURTH
(defrule
    (taunt-detected me 125)
=>
    (chat-to-all "Switching to 4th Closest Target")
    (up-find-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-modify-sn sn-target-player-number g:= goal)
    (acknowledge-taunt me 125)
)

;@@@@@@@@@@@@@@ DEBUG
(defrule
    (or	(taunt-detected me 22)
    (or	(taunt-detected any-ally 22)
    (taunt-detected any-enemy 22)))
=>
    (up-get-player-color target-player goal)
    (up-chat-data-to-all "My Target is %d" g: goal)
    (acknowledge-taunt this-any-enemy 22)
    (acknowledge-taunt this-any-ally 22)
    (acknowledge-taunt me 22)
)

;@@@@@@@@@@@@@@ MULTI
;>>>>>>>>>>> FLANKS
;at first find the closest player as target
(defrule
    (player-valid 3)
    (game-time < 1020)	;17 min
    (goal gl-fifth-turn 1)
    (goal gl-position FLANK)
    (players-building-count any-enemy > 0)
=>
    (up-find-player enemy find-closest goal)
    (up-modify-sn sn-target-player-number g:= goal)
)

;>>>>>>>>>>> KRUSH
(defconst KrushTimeToRetarget 1260)	;21min

;======== 3v3
;======== NO ALLY
;----- FIRST
(defrule
    (player-valid 3)
    (goal gl-strategy KRUSH)
    (goal gl-find-new-target -1)
    (not(player-in-game any-ally))
    (game-time >= KrushTimeToRetarget)
    (or	(not(player-in-game target-player))
    (and(players-civilian-population any-enemy >= 35)	;another target worth going for
    (players-civilian-population target-player < 28)))
=>
    ;	(chat-to-all "No-ally Current Target Destroyed 1")
    (set-goal gl-find-new-target 0)
)

(defrule	;if need to find new target, just start with closest and check
    (goal gl-find-new-target 0)
=>
    (up-find-player enemy find-closest goal)
    (up-modify-sn sn-target-player-number g:= goal)
    (set-goal gl-find-new-target 1)
)

;----- SECOND
(defrule
    (player-valid 3)
    (goal gl-strategy KRUSH)
    (goal gl-find-new-target 1)
    (not(player-in-game any-ally))
    (game-time >= KrushTimeToRetarget)
    (or	(not(player-in-game target-player))
    (and(players-civilian-population any-enemy >= 35)	;another target worth going for
    (players-civilian-population target-player < 28)))
=>
    ;	(chat-to-all "No-ally Current Target Destroyed 2")
    (set-goal gl-find-new-target 2)
)

(defrule	;find next
    (goal gl-find-new-target 2)
=>
    (up-find-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-modify-sn sn-target-player-number g:= goal)
    (set-goal gl-find-new-target 3)
)

;----- THIRD
(defrule
    (player-valid 3)
    (goal gl-strategy KRUSH)
    (goal gl-find-new-target 3)
    (not(player-in-game any-ally))
    (game-time >= KrushTimeToRetarget)
    (or	(not(player-in-game target-player))
    (and(players-civilian-population any-enemy >= 35)	;another target worth going for
    (players-civilian-population target-player < 28)))
=>
    ;	(chat-to-all "No-ally Current Target Destroyed 3")
    (set-goal gl-find-new-target 4)
)

(defrule	;find next
    (goal gl-find-new-target 4)
=>
    (up-find-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-modify-sn sn-target-player-number g:= goal)
    (set-goal gl-find-new-target 5)
)

;----- FOURTH
(defrule
    (player-valid 3)
    (goal gl-strategy KRUSH)
    (goal gl-find-new-target 5)
    (not(player-in-game any-ally))
    (game-time >= KrushTimeToRetarget)
    (or	(not(player-in-game target-player))
    (and(players-civilian-population any-enemy >= 35)	;another target worth going for
    (players-civilian-population target-player < 28)))
=>
    ;	(chat-to-all "No-ally Current Target Destroyed 4")
    (set-goal gl-find-new-target 6)
)

(defrule	;find next
    (goal gl-find-new-target 6)
=>
    (up-find-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-modify-sn sn-target-player-number g:= goal)
    (set-goal gl-find-new-target 7)
)

;----- RESET
(defrule
    (player-valid 3)
    (game-time >= 1200)
    (goal gl-strategy KRUSH)
    (not(player-in-game any-ally))
    (player-in-game target-player)
    (up-compare-goal gl-find-new-target != -1)
    (players-civilian-population target-player >= 15)
=>
    ;	(chat-to-all "No-ally Found New Target")
    (set-goal gl-find-new-target -1)
)

