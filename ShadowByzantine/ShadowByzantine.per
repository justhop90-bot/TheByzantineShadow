    (up-compare-goal gl-target-age < CA-loading)
    (up-research-status c: castle-age >= research-pending)
=>
    ;	(chat-to-player me "I'm Up First")
    (set-goal UP-FIRST 1)
    (disable-self)
)

(defrule
    (goal UP-FIRST 1)
=>
    (up-modify-goal gl-army-damage-potential c:- 15)
)

(defrule
    (goal UP-FIRST -1)
    (up-compare-goal gl-target-age == CA-loading)
    (up-research-status c: castle-age < research-pending)
=>
    (set-goal UP-FIRST 0)
    (chat-to-player me "Enemy Up First")
    (disable-self)
)

(defrule
    (goal UP-FIRST 0)
=>
    (up-modify-goal gl-army-damage-potential c:+ 15)
)

