    (set-goal goal5 0)
    (set-goal rt 0)
)

;2. SEARCH
;all this needs to match with the code for attacking vills to ensure no leaks
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: 8)
    (up-find-remote c: villager-class c: 10)
    (up-set-target-point nearest-tc-x)
    (up-remove-objects search-remote 44 < 10)
    (up-get-search-state lt)
    (up-modify-goal goal2 g:+ rt)
    ;	(up-remove-objects search-remote object-data-action != actionid-attack)
    (up-remove-objects search-remote object-data-target != infantry-class)
    (up-get-search-state lt)
    (up-modify-goal goal5 g:+ rt)	;aggressive vills
)

(defrule
    (stance-toward focus-player enemy)
=>
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: 12)
    (up-find-remote c: archery-class c: 5)
    (up-get-search-state lt)
    (up-modify-goal goal3 g:+ rl)
)

;3. LOOP THE SEARCH
(defrule
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -3)
)

;@@@@@@@@@@@@@@ FIND TOWERS NEAR SPEAR GROUP
