    (research-completed ri-bodkin-arrow)
=>
    (up-modify-goal gl-enemy-tower-range c:+ 1)
    (up-modify-goal gl-my-tower-range c:+ 1)
    (up-modify-goal gl-ranged-group-range c:+ 1)
    (up-modify-goal gl-raid-group-range c:+ 1)
    (up-modify-goal gl-close-ranged-group-range c:+ 1)
    (disable-self)
)

