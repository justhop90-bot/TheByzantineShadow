=>
    (up-full-reset-search)
    (up-find-local c: spearman-line c: 240)
    (up-target-point null-x action-stop -1 aggressive)
)

(defrule
    (true)
=>
    (set-goal goal8 4)	;remove four closest spears to ranged from defense
)

(defrule
    (game-time >= 1020)	;17min
    (or	(player-valid 5)	;enemy pocket
    (or	(goal gl-enemy-strategy KRUSH)
    (goal gl-enemy-strategy POSSIBLE-KRUSH)))
=>
    (set-goal goal8 10)	;remove 10 closest spears to ranged from defense
)

