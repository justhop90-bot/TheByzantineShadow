    (or	(and(gold-amount < 100)
    (stone-amount >= 220))
    (or	(and(wood-amount < 100)
    (stone-amount >= 220))
    (and(food-amount < 100)
    (stone-amount >= 230))))
=>
    (chat-to-player me "Sell stone")
    (sell-commodity stone)
)

;###################### QMILL
;WWWWWWWWWWWWWWWWWW MILL1
(defrule
    (can-build-with-escrow mill)
    (or (resource-found food)
    (game-time >= SkipMillTime))
    (goal gl-current-build-item MILL1)
    (building-type-count-total mill < 1)
    (up-timer-status t-build-delay != timer-running)
=>
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-escrow-percentage wood 0)
    (enable-timer t-build-delay 3)
    ;	(chat-to-player me "Mill1")
    (release-escrow wood)
    (build mill)
)

(defrule
    (goal gl-current-build-item MILL1)
    (building-type-count-total mill >= 1)
=>
    (up-modify-goal gl-build-progress c:+ 1)
    ;	(chat-to-player me "Mill1 Built")
)

(defrule	;if skipped come back
    ;	(game-time < SkipMillTime)
    (goal gl-dark-build MillFirst)
    (building-type-count-total mill < 1)
    (up-compare-goal gl-build-progress > 1)
=>
    (set-goal gl-build-progress 1)
)

(defrule	;if skipped come back
    ;	(game-time >= SkipMillTime)
    (goal gl-dark-build LumberFirst)
    (building-type-count-total mill < 1)
    (up-compare-goal gl-build-progress > 2)
=>
    (set-goal gl-build-progress 2)
)

(defrule
    (up-compare-goal gl-current-build-item != MILL1)
    (or	(and(goal gl-dark-build MillFirst)
    (up-compare-goal gl-build-progress == 1))
    (and(goal gl-dark-build LumberFirst)
    (up-compare-goal gl-build-progress == 2)))
=>
    ;	(chat-to-player me "Setting current build item to MILL1")
    (set-escrow-percentage wood LOW-ESCROW)
    (set-goal gl-current-build-item MILL1)
)

;WWWWWWWWWWWWWWWWWW OTHER
(defrule
    (can-build mill)
    (resource-found food)
    (current-age >= feudal-age)
    (building-type-count-total mill < 1)
=>
    (chat-to-player me "Mill B")
    ;	(set-goal gl-allow-mill YES)
    (build mill)
    (disable-self)
)

(defrule
    (true)
=>
    (set-goal goal -12)
)

(defrule
    (building-type-count-total mill == 2)
=>
    (set-goal goal -10)
)

(defrule
    (building-type-count-total mill == 3)
=>
    (set-goal goal 10)
)

(defrule
    (goal MILL YES)
    (can-build mill)
    (building-type-count-total mill < 4)
=>
    ;	(up-chat-data-to-player me "FARMING MILL(%d)" g: goal)
    (up-set-placement-data me mill g: goal)
    (up-build place-control 0 c: mill)
    (up-assign-builders c: mill c: 1)
    (set-goal MILL NO)
)

(defrule
    (up-compare-goal MILL != YES)
    (not(up-pending-placement c: mill))
    (or	(and(building-type-count-total mill < 2)
    (building-type-count-total farm > 20))
    (or	(and(building-type-count-total mill < 3)
    (building-type-count-total farm > 28))
    (and(building-type-count-total mill < 4)
    (building-type-count-total farm > 38))))
=>
    ;	(chat-to-player me "NEED MILL")
