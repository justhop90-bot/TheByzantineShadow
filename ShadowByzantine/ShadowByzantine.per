    (up-lerp-tiles point-x nearest-tc-x g: goal2)
    (up-lerp-tiles point-x nearest-tower-x g: goal3)
    (up-lerp-tiles point-x home-x g: goal4)
)

(defrule
    (goal SPLIT 1)
=>
    (up-bound-point point-x point-x)
    ;	(up-send-flare target-x)
    ;	(up-send-flare point-x)
    (up-target-point null-x action-move formation-line no-attack)
    (up-target-point point-x action-move formation-line no-attack)
    (set-goal gl-ranged-group-state TRACKING)
    (set-goal SPLIT 0)
    ;	(set-goal gl-can-move NO)
    (enable-timer t-failsafe failsafe-delay)
)

