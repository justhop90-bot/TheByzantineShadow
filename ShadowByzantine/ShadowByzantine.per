;###################### QFAILSAFE
(defrule
    (food-amount < 400)
    (gold-amount >= 180)
    (goal gl-fifth-turn 1)
    (unit-type-count-total archer >= 2)
    (up-compare-sn sn-gold-gatherer-percentage > 0)
    (up-research-status c: castle-age < research-pending)
=>
    (up-modify-sn sn-gold-gatherer-percentage c:- 1)
    (up-modify-sn sn-food-gatherer-percentage c:+ 1)
    ;	(chat-to-player me "FAILSAFE--GOLD DOWN")
)

;###################### QDARK
;@@@@@@@@@@@@@@@ GET ENOUGH FOOD FOR VILLAGERS
