    (up-find-local c: skirmisher-line c: 240)
    (up-remove-objects search-local object-data-group-flag == RangedGroup)
    (up-copy-point point-x home-x)
    (up-lerp-tiles point-x enemy-x c: -3)
    (up-target-point point-x action-move -1 no-attack)
    (up-reset-search 1 1 1 1)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 16)
    (up-find-local c: skirmisher-line c: 240)
    (up-find-local c: archer-line c: 240)
    (up-target-point enemy-x action-patrol -1 aggressive)
)

