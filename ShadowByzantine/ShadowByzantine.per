    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal rt 0)
    (up-full-reset-search)
    (up-set-target-point scout-x)
    (up-filter-distance c: -1 c: 20)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-find-remote c: all-units-class c: 20)
    (up-remove-objects search-remote object-data-class == infantry-class)
    (up-remove-objects search-remote object-data-class == farm-class)
    (up-remove-objects search-remote object-data-class == building-class)
)

;3. LOOP THE SEARCH THE SEARCH
(defrule
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: wolf c: 5)
    (up-remove-objects search-remote object-data-idling == 1)
    (up-remove-objects search-remote object-data-target == villager-class)
    (up-clean-search search-remote 44 search-order-asc)
    (up-get-search-state lt)
    (up-modify-goal goal4 g:= rt)
)

(defrule	;let scout join combat with ranged
    (goal gl-scout-added 2)
    (up-compare-goal goal2 < 1)
    (up-compare-goal goal3 < 1)	;towers
    (up-compare-goal goal5 < 3)	;no archers around
    (up-compare-goal goal4 >= 1)	;something to attack
    (up-compare-goal gl-ranged-group-state != HOME-RETREAT)

=>
    (up-add-object-by-id search-local g: scout-id)
    (up-target-objects 0 action-default -1 aggressive)
    ;	(up-chat-data-to-all "Attack with scout(%d)" g: goal2)
    (set-goal gl-scout-added 3)
)

;@@@@@@@@@@@@@@ PULLING BACK
(defrule	;retreat from towers targeting the scout
    (up-compare-goal goal3 >= 1)
    (up-compare-goal gl-scout-added != 1)
=>
    ;	(chat-to-all "Retreat Scout From Tower")
    (set-goal gl-scout-added 1)
)

(defrule	;stop scout from fighting if too far or if losing the fight
    (up-compare-goal gl-scout-added != 1)
    (or	(up-point-distance scout-x point-x >= 15)
    (up-compare-goal gl-ranged-eval < LosingFight))
=>
    (up-get-point-distance point-x scout-x goal9)
    ;	(up-chat-data-to-all "Micro scout behind army 2a(%d)" g: goal9)
    ;	(up-send-flare point-x)
    (set-goal gl-scout-added 1)
)

(defrule
    (or	(up-compare-goal goal2 >= 1)	;spears
    (up-compare-goal goal5 >= 3))	;archers
    (up-compare-goal gl-scout-added != 1)
=>
    ;	(chat-to-all "Micro scout away from danger")
    (set-goal gl-scout-added 1)
)

(defrule	;send scout to army initially/when too far away
    (goal gl-scout-added 1)
    (up-point-distance scout-x point-x >= 3)
=>
    (up-add-object-by-id search-local g: scout-id)
    (up-target-point point-x action-move -1 stand-ground)
    ;	(chat-to-all "Scout to army")
)

;@@@@@@@@@@@@@@ RETURNING TO SCOUTING
(defrule	;return to scouting when enemy army is too large
    (false)
    (up-compare-goal goal1 < 25)
    (up-compare-goal gl-scout-added != FINISHED)
    (players-military-population target-player >= 11)
=>
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
    (chat-to-all "REMOVE SCOUT FROM BATTLE")
    (set-goal gl-scout-added FINISHED)
    (up-reset-scouts)
    (up-add-object-by-id search-local g: scout-id)
    (up-target-point home-x action-move -1 no-attack)
    ;	(enable-timer t-scout-enemy 60)
    (enable-timer 28 15)
)

(defrule
    (taunt-detected me 9)
    (goal gl-second-turn 1)
=>
    (up-chat-data-to-player me "HP: %d" g: goal1)
    (up-chat-data-to-player me "ScoutStatus: %d" g: gl-scout-added)
    (up-chat-data-to-player me "TowersTargeting: %d" g: goal3)
    (up-chat-data-to-player me "DangerousUnits: %d" g: goal2)
    (up-chat-data-to-player me "Targets: %d" g: goal4)
)

(defrule
    (taunt-detected me 10)
=>
    (acknowledge-taunt me 9)
    (acknowledge-taunt me 10)
)

;WWWWWWWWWWWWWWWWWW EXPLO DEBUG
(defrule
    (taunt-detected me 69)
=>
    (up-chat-data-to-player me "Number of explore groups: %d" s: sn-number-explore-groups)
    (up-chat-data-to-player me "Number of explorers: %d" s: sn-total-number-explorers)
    (up-full-reset-search)
    (up-filter-include -1 -1 orderid-explore -1)
    (up-find-local c: all-units-class c: 240)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object point-x)
    (up-send-flare point-x)
    (acknowledge-taunt me 69)
)

(defrule
    (taunt-detected me 70)
=>
    (up-modify-sn sn-number-explore-groups c:+ 1)
    (up-modify-sn sn-total-number-explorers c:+ 1)
    (up-chat-data-to-player me "Number of explore groups: %d" s: sn-number-explore-groups)
    (up-chat-data-to-player me "Number of explorers: %d" s: sn-total-number-explorers)
    (acknowledge-taunt me 70)
)

(defrule
    (taunt-detected me 71)
=>
    (up-modify-sn sn-number-explore-groups c:- 1)
    (up-modify-sn sn-total-number-explorers c:- 1)
    (up-chat-data-to-player me "Number of explore groups: %d" s: sn-number-explore-groups)
    (up-chat-data-to-player me "Number of explorers: %d" s: sn-total-number-explorers)
    (acknowledge-taunt me 71)
)

;WWWWWWWWWWWWWWWWWW RESET SCOUTS
(defrule
    (or	(timer-triggered 28)
    (taunt-detected me 11))
    (up-compare-goal gl-scout-added != FINISHED)
=>
    ;	(chat-to-player me "Reset scout")
    (set-goal gl-getting-sheep NO)
    (set-goal gl-scout-added 1)
    (acknowledge-taunt me 11)
    (disable-timer 28)
    (up-reset-scouts)
)

(defrule
    (or	(timer-triggered 28)
    (taunt-detected me 11))
    (up-compare-goal gl-scout-added == FINISHED)
=>
    (set-goal gl-getting-sheep NO)
    (acknowledge-taunt me 11)
    (disable-timer 28)
    (up-reset-scouts)
)

;###################### QSOD
(defrule
    ;	(current-age >= feudal-age)
    (false)
    (goal gl-strategy FLUSH)
    (up-group-size c: RangedGroup > 0)
    (up-compare-goal gl-scout-added != FINISHED)
=>
    (up-jump-rule 15)
)

(defrule
    (or	(not(up-set-target-by-id g: scout-id))
    (and(goal SOD -1)
    (unit-type-count scout-cavalry-line < 1)))
=>
    (up-jump-rule 14)
)

(defrule
    (true)
=>
    (up-modify-goal goal2 s:= sn-focus-player-number)
    (set-goal goal 0)	;lerping to rgroup/scout hp
    (set-goal goal1 0)	;for searching tc's
    (set-goal goal5 0)	;tc count close
    (set-goal SPLIT 0)
    (set-goal rt 0)
    (set-strategic-number sn-focus-player-number 1)
)

;WWWWWWWWWWWWWWWWWW SEARCH AROUND SCOUT FOR ENEMY TC'S
(defrule
    (up-set-target-by-id g: scout-id)
=>
    (up-get-object-data object-data-hitpoints goal)
    (set-goal goal1 9)
)

(defrule
    (military-population < 6)
    (current-age >= feudal-age)
=>
    (set-goal goal1 7)
)

(defrule
    (players-building-type-count every-enemy town-center < 1)
=>
    (set-goal goal1 12)
)

(defrule	;ignore tc's more when krushing
    (goal gl-strategy KRUSH)
    (current-age >= feudal-age)
=>
    (set-goal goal1 9)
)

(defrule	;be safer if low hp
    (up-compare-goal goal < 27)
    (up-compare-goal gl-strategy != KRUSH)
=>
    (set-goal goal1 10)
)

;okay, basically just search around scout for tc, starting with player 1
;then loop through again with the next number focus
;if the tc is found and it's an enemy, skip the loop and get the point of the tc
;then perform the tc dodging method
;after a certain time, stop the system
(defrule	;next few rules from Barbie
    (goal SOD -1)
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point scout-x)
    (up-filter-distance c: -1 g: goal1)
    (up-find-remote c: town-center c: 1)
    (up-get-search-state lt)
)

(defrule
    (goal SOD -1)
    (up-compare-goal rt > 0)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-point position-object object-x)
    ;	(up-send-flare object-x)
    (set-goal SPLIT 1)
    (up-jump-rule 1)
)

(defrule
    (goal SOD -1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -3)
)

;WWWWWWWWWWWWWWWWWW MOVE
(defrule
    (true)
=>
    (set-goal goal -10)
    (set-goal goal1 1)
    (set-goal goal2 0)
)

(defrule
    (goal gl-strategy KRUSH)
=>
    (set-goal goal -6)
    (set-goal goal1 0)
    (set-goal goal2 10)	;just default counterclockwise
)

(defrule
    (goal gl-strategy KRUSH)
    (goal gl-circle-direcion CLOCKWISE)
=>
    (set-goal goal2 -10)
)

(defrule
    (goal SPLIT 1)
=>
    (up-full-reset-search)
    ;	(up-chat-data-to-all "SOF! (%d)" g: goal2)
    (up-copy-point point-x scout-x)
    (up-lerp-tiles point-x object-x g: goal)
    (up-cross-tiles point-x object-x g: goal1)
    (up-cross-tiles point-x center-x g: goal2)	;zero except when krushing
    (up-lerp-tiles point-x home-x c: 3)
    (up-lerp-tiles point-x scout-x c: -5)
    (up-bound-point point-x point-x)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-target-point point-x action-move -1 no-attack)
    ;	(up-send-flare point-x)
    (enable-timer 28 7)
    (set-goal SPLIT 0)
    (set-goal SOD 0)
)

(defrule
    (goal SOD 0)
    (or	(up-timer-status 28 != timer-running)
    (unit-type-count scout-cavalry-line < 1))
=>
    (up-full-reset-search)
    ;	(chat-to-all "SOD")
    (set-goal SOD -1)
)

;###################### QKNIGHT GROUP
;WWWWWWWWWWWWWWWWWW KRUSH
(defrule
    (goal gl-attacking -1)
    (goal gl-tenth-turn 1)
    (goal gl-town-safe YES)
    (goal gl-strategy KRUSH)
    (unit-type-count knight-line > 0)
=>
    (up-retreat-to blacksmith c: knight-line)
    ;	(chat-to-all "KrushRegroup")
)

;WWWWWWWWWWWWWWWWWW Find knight group center of gravity - By KnightPanda
(defrule
    (true)
=>
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)

    (up-full-reset-search)
    (up-find-local c: knight-line c: 60)
    (up-remove-objects search-local object-data-group-flag != KnightGroup)
    (up-get-search-state lt)
    (set-goal goal 0)
    (set-goal point-x 0)
    (set-goal point-y 0)
    (set-goal lt 0)
)

(defrule
    (up-set-target-object search-local c: 0)
=>
    (up-get-object-data object-data-point-x point2-x) ;coordinate * 100
    (up-get-object-data object-data-point-y point2-y)
    (up-modify-goal point-x g:+ point2-x)
    (up-modify-goal point-y g:+ point2-y)
    (up-get-search-state lt)
    (up-modify-goal goal c:+ 1) ;number of points checked
)

(defrule
    (up-compare-goal lt > 0)
=>
    (up-remove-objects search-local -1 == 0)
    (up-get-search-state lt)
    (up-jump-rule -2)
)

(defrule
    (up-compare-goal goal > 0)
=>
    (up-modify-goal point-x g:/ goal)
    (up-modify-goal point-y g:/ goal)
    (up-copy-point knight-group-x point-x) ;local group center of gravity
)

;WWWWWWWWWWWWWWWWWW QEVAL
(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 14)
    (up-find-remote c: all-units-class c: 40)
    (up-remove-objects search-remote object-data-class == farm-class)
    (up-remove-objects search-remote object-data-class == building-class)
    (up-remove-objects search-remote object-data-type == watch-tower)
    (up-get-search-state lt)
    (up-modify-goal goal1 g:= rt)
)

(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 8)
    (up-find-remote c: spearman-line c: 40)
    (up-get-search-state lt)
    (up-modify-goal goal g:= rt)
)

(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 15)
    (up-find-remote c: archer-line c: 40)
    (up-get-search-state lt)
    (up-modify-goal goal2 g:= rt)
    (up-modify-goal goal2 c:* 4)
    (up-modify-goal goal2 c:/ 5)
)

(defrule
    (up-group-size c: KnightGroup < 1)
=>
    (up-jump-rule 10)
)

;@@@@@@@@@@@@@@ SETUP
(defrule
    (true)
=>
    (set-goal gl-knight-eval 0)
    (up-modify-goal gl-knight-eval g:+ gl-knight-group-size)
    (up-modify-goal gl-knight-eval c:/ 2)
)

(defrule
    (research-completed ri-scale-barding)
=>
    (up-modify-goal gl-knight-eval c:* 2)
)

;@@@@@@@@@@@@@@ ENEMY UNITS
(defrule	;subtract spears
    (true)
=>
    (up-modify-goal gl-knight-eval g:- goal)
)

(defrule	;subtract pikes again
    (players-unit-type-count target-player pikeman > 0)
=>
    (up-modify-goal gl-knight-eval g:- goal)
)

(defrule	;subtract archers
    (true)
=>
    (up-modify-goal gl-knight-eval g:- goal2)
)

;@@@@@@@@@@@@@@ MY UNITS
(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 20)
    (up-find-local c: skirmisher-line c: 40)
    (up-find-local c: archer-line c: 40)
    (up-get-search-state lt)
    (up-modify-goal goal3 g:= lt)
)

(defrule	;add skirms close
    (true)
=>
    (up-modify-goal gl-knight-eval g:+ lt)
    ;	(up-modify-goal gl-knight-eval g:+ lt)
)

;@@@@@@@@@@@@@@ MY TECHS
(defrule
    (research-completed ri-chain-barding)
=>
    (up-modify-goal gl-knight-eval g:+ gl-knight-group-size)
    (up-modify-goal gl-knight-eval g:+ gl-knight-group-size)
)

(defrule
    (research-completed ri-forging)
=>
    (up-modify-goal gl-knight-eval g:+ gl-knight-group-size)
)

(defrule
    (research-completed ri-iron-casting)
=>
    (up-modify-goal gl-knight-eval g:+ gl-knight-group-size)
)

;WWWWWWWWWWWWWWWWWW ACTIONS
(defrule
    (up-group-size c: KnightGroup < 1)
=>
    (up-jump-rule 30)
)

(defrule
    (true)
=>
    (set-goal goal 0)
    (set-goal goal1 0)
    (set-goal goal2 0)
    (set-goal goal3 0)
)

(defrule	;find all units
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 14)
    (up-find-remote c: all-units-class c: 40)
    (up-remove-objects search-remote object-data-class == farm-class)
    (up-remove-objects search-remote object-data-class == building-class)
    (up-remove-objects search-remote object-data-type == watch-tower)
    (up-get-search-state lt)
    (up-modify-goal goal1 g:= rt)
)

(defrule	;find spears
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 6)
    (up-find-remote c: spearman-line c: 40)
    (up-get-search-state lt)
    (up-modify-goal goal g:= rt)
)

(defrule	;find monks
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 10)
    (up-find-remote c: monk c: 20)
    ;	(up-remove-objects search-remote object-data-target != knight-line)
    ;	(up-remove-objects search-remote object-data-carry < 100)
    (up-get-search-state lt)
    (up-modify-goal goal2 g:= rt)
    ;	(up-chat-data-to-player me "Monks rt: %d" g: rt)
    ;	(up-chat-data-to-player me "Monks: %d" g: goal2)
)

(defrule	;find siege
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 11)
    (up-find-remote c: mangonel-line c: 10)
    (up-find-remote c: scorpion-line c: 10)
    (up-get-search-state lt)
    (up-modify-goal goal3 g:= rt)
)

;@@@@@@@@@@@@@@ ATTACK
;>>>>>>>>>>> SIEGE
(defrule
    (up-compare-goal goal3 >= 1)	;there are mangos to target
    (goal gl-knight-retreat -1)
    (or	(goal gl-second-turn 1)
    (up-compare-goal gl-knight-group-state != SATTACKING))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    ;	(chat-to-player me "SiegeAttack!")
    (up-full-reset-search)
    (up-set-group search-local c: KnightGroup)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 20)
    (up-find-remote c: mangonel-line c: 10)
    (up-find-remote c: scorpion-line c: 10)
    (up-set-target-point ranged-group-x)
    (up-clean-search search-remote 44 search-order-asc)
    (up-remove-objects search-remote -1 > 0)
    (up-target-objects 0 action-default -1 stand-ground)
    (set-goal gl-knight-group-state SATTACKING)
    (set-goal SPLIT 0)
)

;>>>>>>>>>>> NORMAL
(defrule
    (up-compare-goal goal3 < 1)	;no siege to target
    (goal gl-knight-retreat -1)
    (up-compare-goal goal1 > 0)	;units around
    ;	(or	(goal gl-second-turn 1)
    (up-compare-goal gl-knight-group-state != ATTACKING);)
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    ;	(chat-to-player me "Attack!")
    (up-full-reset-search)
    (up-set-group search-local c: KnightGroup)
    (up-target-point enemy-x action-stop -1 aggressive)
    (set-goal gl-knight-group-state ATTACKING)
    (set-goal SPLIT 0)
)

;basically, set it from the group center, then search around for any in the group (remove close ones), then take the furthest one and target the closest enemy
(defrule	;check if knights need to be brought back
    (goal gl-knight-group-state ATTACKING)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 15)
    (up-find-local c: knight-line c: 20)
    (up-remove-objects search-local object-data-group-flag != KnightGroup)
    (up-remove-objects search-local object-data-distance < 7)
    (up-clean-search search-local 44 search-order-desc)
    (up-get-search-state lt)
)

(defrule	;refocus knights getting too far from group center
    (up-compare-goal lt > 0)
    (goal gl-knight-group-state ATTACKING)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 15)
    (up-find-local c: knight-line c: 30)
    (up-remove-objects search-local object-data-group-flag != KnightGroup)
    (up-remove-objects search-local object-data-distance < 7)
    (up-clean-search search-local 44 search-order-desc)
    (up-remove-objects search-local -1 > 0)
    (up-get-point position-object point-x)
    (up-send-flare point-x)
    (set-goal SPLIT 1)
)

(defrule	;now find the nearest enemy unit to target
    (goal SPLIT 1)
=>
    (up-find-remote c: all-units-class c: 40)
    (up-remove-objects search-remote object-data-class == building-class)
    (up-remove-objects search-remote object-data-class == farm-class)
    (up-remove-objects search-remote object-data-class == tower-class)
    (up-clean-search search-remote 44 search-order-asc)
    (up-remove-objects search-remote -1 > 0)
    (up-get-point position-object point-x)
    ;	(up-send-flare point-x)
    (up-target-objects 0 action-default -1 aggressive)
    ;	(chat-to-player me "Retargeting Here")
)

;@@@@@@@@@@@@@@ RETREAT(0-4)
(defrule	;set up the retreat point
    (true)
=>
    (up-copy-point point-x ranged-group-x)
    (up-lerp-tiles point-x enemy-x c: -5)
)

;>>>>>>>>>>> CASTLE
(defrule
    (goal gl-knight-retreat -1)
    (nand	(up-compare-goal SUPERIORITY >= 20)
    (research-completed ri-chain-barding))
    (up-point-distance knight-group-x nearest-castle-x < 15)
=>
    ;	(chat-to-player me "CASTLE Retreat")
    (set-goal gl-knight-retreat 4)
)

(defrule
    (goal gl-knight-retreat 4)
    (up-point-distance knight-group-x point-x < 3)
    (up-point-distance knight-group-x nearest-castle-x >= 18)
=>
    ;	(chat-to-player me "Reset CASTLE Retreat")
    (set-goal gl-knight-retreat -1)
)

;>>>>>>>>>>> MONKS
(defrule
    (up-compare-goal goal2 < 4)
    (up-group-size c: KnightGroup >= 2)
    (up-compare-goal gl-knight-group-state == SATTACKING)
=>
    (up-jump-rule 1)
)

(defrule
    (false)
    (goal gl-knight-retreat -1)
    (up-compare-goal goal2 >= 1)
    (up-group-size c: KnightGroup < 5)
    (or	(up-compare-goal goal2 >= 3)	;always if too many monks
    (and(up-compare-goal goal2 < 3)	;if fewer monks, only retreat if few knights
    (up-group-size c: KnightGroup < 4)))
=>
    (chat-to-player me "Monk Retreat")
    (set-goal gl-knight-retreat 3)
)

(defrule
    (goal gl-knight-retreat 3)
    (up-compare-goal goal2 < 1)
=>
    (chat-to-player me "RESET Monk Retreat")
    (set-goal gl-knight-retreat -1)
)

;>>>>>>>>>>> SPEARS
(defrule
    (goal gl-knight-retreat -1)
    (up-group-size c: KnightGroup < 8)
    (not(research-completed ri-chain-barding))
    (or	(up-compare-goal goal >= 4)
    (and(up-compare-goal goal >= 2)
    (up-compare-goal gl-knight-group-state != SATTACKING)))
=>
    ;	(chat-to-player me "Spear Retreat 1")
    (set-goal gl-knight-retreat 2)
)

(defrule
    (goal gl-knight-retreat -1)
    (up-group-size c: KnightGroup < 7)
    (research-completed ri-chain-barding)
    (or	(up-compare-goal goal >= 6)
    (and(up-compare-goal goal >= 4)
    (up-compare-goal gl-knight-group-state != SATTACKING)))
=>
    ;	(chat-to-player me "Spear Retreat 2")
    (set-goal gl-knight-retreat 2)
)

(defrule
    (goal gl-knight-retreat 2)
    (up-compare-goal goal < 1)
=>
    ;	(chat-to-player me "RESET Spear Retreat")
    (set-goal gl-knight-retreat -1)
)

;>>>>>>>>>>> TC
(defrule
    (goal gl-knight-retreat -1)
    (up-group-size c: KnightGroup < 7)
    (nand	(up-compare-goal SUPERIORITY >= 8)
    (research-completed ri-chain-barding))
    (up-point-distance knight-group-x nearest-tc-x < 9)
    (up-compare-goal gl-knight-group-state != SATTACKING)
=>
    ;	(chat-to-player me "TC Retreat")
    (set-goal gl-knight-retreat 1)
)

(defrule
    (goal gl-knight-retreat 1)
    (up-point-distance knight-group-x point-x < 3)
    (up-point-distance knight-group-x nearest-tc-x >= 12)
=>
    ;	(chat-to-player me "RESET TC Retreat")
    (set-goal gl-knight-retreat -1)
)

;>>>>>>>>>>> DISTANCE
(defrule
    (goal gl-knight-retreat -1)
    (or	(up-point-distance knight-group-x ranged-group-x >= 25)
    (and(up-compare-goal gl-knight-group-state != SATTACKING)
    (up-point-distance knight-group-x ranged-group-x >= 12)))
=>
    ;	(chat-to-player me "Distance Retreat")
    (set-goal gl-knight-retreat 0)
)

(defrule
    (goal gl-knight-retreat 0)
    (up-point-distance knight-group-x ranged-group-x < 7)
=>
    ;	(chat-to-player me "RESET Distance Retreat")
    (set-goal gl-knight-retreat -1)
)

(defrule
    (goal gl-second-turn 1)
    (up-compare-goal gl-knight-retreat != -1)
=>
    ;	(chat-to-player me "Retreat")
    (up-full-reset-search)
    (up-set-group search-local c: KnightGroup)
    (up-bound-point point-x point-x)
    (up-target-point null-x action-default formation-line no-attack)
    (up-target-point point-x action-move formation-line no-attack)
    (set-goal gl-knight-group-state RETREATING)
)

;@@@@@@@@@@@@@@ MARCH
(defrule	;move toward march-x when no units around
    (up-compare-goal goal1 < 1)
    (goal gl-knight-retreat -1)
    (or	(goal gl-tenth-turn 1)
    (up-compare-goal gl-knight-group-state != MARCHING))
=>
    ;	(chat-to-player me "Marching")
    (up-full-reset-search)
    (up-set-group search-local c: KnightGroup)
    (up-copy-point point-x knight-group-x)
    (up-lerp-tiles point-x march-x c: 10)
    (up-bound-point point-x point-x)
    (up-target-point null-x action-default formation-line no-attack)
    (up-target-point point-x action-move formation-line no-attack)
    (set-goal gl-knight-group-state MARCHING)
    ;	(up-send-flare point-x)
)

;WWWWWWWWWWWWWWWWWW GROUP SETUP
(defrule	;add new knights to group
    (goal gl-town-safe NO)
    (goal gl-second-turn 1)
    (up-group-size c: KnightGroup > 0)
    (up-compare-goal gl-army-damage-potential < CostOfAllowingKnightsToGoFree)
=>
    (up-modify-group-flag 0 c: KnightGroup)
    (up-reset-group c: KnightGroup)
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-filter-distance c: -1 c: 4)
    (up-find-local c: knight-line c: 240)
    (up-remove-objects search-local object-data-group-flag == RaidGroup)
    (up-create-group 0 0 c: KnightGroup)
    (up-modify-group-flag 1 c: KnightGroup)
    (up-get-group-size c: KnightGroup gl-knight-group-size)
)

(defrule	;regroup the knights
    (goal gl-fifth-turn 1)
    (up-group-size c: KnightGroup > 0)
    (up-compare-goal gl-army-damage-potential < CostOfAllowingKnightsToGoFree)
=>
    (up-full-reset-search)
    (up-set-target-point knight-group-x)
    (up-find-local c: knight-line c: 40)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (goal gl-town-safe NO)
    ;	(up-point-distance ranged-group-x home-x >= 25)
=>
    (up-set-target-point home-x)
    (up-remove-objects search-local 44 < DefenseRadius)
)

(defrule
    (goal SPLIT 1)
=>
    (up-remove-objects search-local object-data-group-flag == KnightGroup)
    (up-target-point knight-group-x action-move -1 -1)
)

(defrule
    (unit-type-count knight-line >= 1)
    (up-group-size c: KnightGroup < 1)
    (up-compare-goal SUPERIORITY < 15)
    (up-group-size c: RangedGroup >= 1)
=>
    ;	(chat-to-player me "CREATE NEW KNIGHT GROUP")
    (up-modify-group-flag 0 c: KnightGroup)
    (up-reset-group c: KnightGroup)
    (up-full-reset-search)
    (up-find-local c: knight-line c: 240)
    (up-remove-objects search-local object-data-group-flag == RaidGroup)
    (up-set-target-point march-x)
    (up-clean-search search-local object-data-distance search-order-asc)
    (up-remove-objects search-local -1 > 0)
    (up-create-group 0 0 c: KnightGroup)
    (up-modify-group-flag 1 c: KnightGroup)
    (up-modify-goal gl-army-damage-potential c:- 5)
)

(defrule
    (up-group-size c: KnightGroup > 0)
    (or	(up-group-size c: RangedGroup < 1)
    (up-compare-goal SUPERIORITY >= 20))
=>
    ;	(chat-to-player me "CLEAR KNIGHT GROUP")
    (up-modify-group-flag 0 c: KnightGroup)
    (up-reset-group c: KnightGroup)
    (up-set-attack-stance knight-line c: aggressive)
    (up-reset-unit c: knight-line)
    (up-modify-goal gl-army-damage-potential c:+ 5)
)

;WWWWWWWWWWWWWWWWWW DEBUG
(defrule
    (taunt-detected me 77)
    (goal gl-fifth-turn 1)
=>
    (up-chat-data-to-player me "GroupSize: %d" g: gl-knight-group-size)
    (up-chat-data-to-player me "Eval: %d" g: gl-knight-eval)
    (up-chat-data-to-player me "EnemyMonks: %d" g: goal2)
    (up-chat-data-to-player me "TotalEnemies: %d" g: goal1)
    (up-chat-data-to-player me "Spears: %d" g: goal)
    (up-chat-data-to-player me "EnemySiege: %d" g: goal3)
    (up-chat-data-to-player me "Group state: %d" g: gl-knight-group-state)
)

