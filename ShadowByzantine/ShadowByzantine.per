)

;@@@@@@@@@@@@@@ SAVING VILLS FROM BOAR(thanks to LeifEricson for helping me with this)
(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 5)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: boar-class c: 1)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object point-x)
    (up-get-search-state lt)
)

(defrule
    (up-compare-goal rt > 0)
    (up-set-target-by-id g: current-boar-id)
    (up-object-data object-data-hitpoints > 25)
    (up-get-object-data object-data-target-id goal)
    (up-set-target-by-id g: goal)
=>
    (up-add-object-by-id search-local g: goal)
    (up-copy-point point2-x point-x)
    (up-lerp-tiles point2-x home-x c: 3)
    ;	(up-send-flare point2-x)
    ;	(chat-to-player me "Go here")
    (up-target-point point2-x action-move -1 -1)
)

(defrule
    (true)
=>
    (set-goal goal1 18)
)

(defrule
    (research-completed ri-loom)
=>
    (set-goal goal1 28)
)

(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 10)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: boar-class c: 1)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object point-x)
    (up-get-search-state lt)
)

(defrule
    (up-compare-goal rt > 0)
    (up-set-target-by-id g: current-boar-id)
    (up-get-object-data object-data-target-id goal)
    (up-set-target-by-id g: goal)
    ;	(or	(up-point-distance point-x home-x < 3)
    ;		(up-object-data object-data-hitpoints g:< goal1))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    ;   (up-full-reset-search)
    (up-add-object-by-id search-local g: home-id)
    ;	(up-target-objects 1 action-gather -1 -1)
    ;	(up-target-objects 0 action-gather -1 -1)
