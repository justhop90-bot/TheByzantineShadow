    (up-compare-goal lt > 0)
=>
    (up-clean-search search-local 44 search-order-asc)
    (up-remove-objects search-local -1 > 0)
    (up-target-point point-x action-move -1 -1)
    ;	(chat-to-player me "Move to sheep")
    ;	(up-send-flare point-x)
)

