;###################### QSCALEMAIL
(defrule
    (goal gl-strategy FLUSH)
    (game-time >= 1080)	;18min
    (current-age >= feudal-age)
    (goal gl-progression-pause -1)
    (building-type-count blacksmith > 0)
    (or	(player-valid 5)	;enemy pocket
    (or	(goal gl-enemy-strategy KRUSH)
    (goal gl-enemy-strategy POSSIBLE-KRUSH)))
    (up-research-status c: ri-scale-mail < research-pending)
=>
    (set-goal gl-progression-pause SCALEMAIL)
    ;	(chat-to-all "Need Scale Mail")
)

(defrule
    (goal gl-progression-pause SCALEMAIL)
=>
    (up-modify-escrow food c:max 100)
)

(defrule
    (goal gl-progression-pause SCALEMAIL)
    (can-research-with-escrow ri-scale-mail)
=>
    (up-research gl-escrow-state c: ri-scale-mail)
    (set-goal gl-progression-pause -1)
    (set-escrow-percentage food 0)
    ;	(chat-to-all "Scale Mail")
    (release-escrow food)
)

;###################### QCHAINMAIL
(defrule
    (goal gl-strategy FLUSH)
    (goal gl-progression-pause -1)
    (research-completed ri-pikeman)
    (up-research-status c: ri-chain-mail < research-pending)
    (up-research-status c: ri-scale-mail >= research-pending)
    (up-research-status c: ri-bodkin-arrow >= research-pending)
    (or	(players-building-type-count any-enemy stable >= 2)
    (or	(players-unit-type-count any-enemy knight-line >= 4)
    (players-unit-type-count any-enemy scout-cavalry-line >= 6)))
=>
    (set-goal gl-progression-pause CHAINMAIL)
    ;	(chat-to-all "Need Chain Mail")
)

(defrule
    (goal gl-progression-pause CHAINMAIL)
=>
    (up-modify-escrow food c:max 200)
    (up-modify-escrow gold c:max 100)
)

(defrule
    (goal gl-progression-pause CHAINMAIL)
    (can-research-with-escrow ri-chain-mail)
=>
    (up-research gl-escrow-state c: ri-chain-mail)
    (set-goal gl-progression-pause -1)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    ;	(chat-to-all "Chain Mail")
    (release-escrow food)
    (release-escrow gold)
)

;###################### QIRONCASTING
;WWWWWWWWWWWWWWWWWW KRUSH
(defrule
    (goal gl-strategy KRUSH)
    (goal gl-progression-pause -1)
    (goal gl-current-build-item IRONCASTING)
    (can-research-with-escrow ri-iron-casting)
=>
    (up-research gl-escrow-state c: ri-iron-casting)
    ;	(chat-to-player me "Krush Iron Casting")
)

(defrule	;come back if skipped
    (goal gl-strategy KRUSH)
    (up-research-status c: ri-iron-casting < research-pending)
    (up-compare-goal gl-build-progress > KrushIronCastingNumber)
=>
    (set-goal gl-build-progress KrushIronCastingNumber)
)

(defrule
    (goal gl-strategy KRUSH)
    (up-compare-goal gl-current-build-item != IRONCASTING)
    (up-compare-goal gl-build-progress == KrushIronCastingNumber)
=>
    ;	(chat-to-player me "Krush Setting current build item to IRONCASTING")
    (set-goal gl-current-build-item IRONCASTING)
)

(defrule
    (goal gl-strategy KRUSH)
    (up-compare-goal gl-progression-pause == -1)
    (up-compare-goal gl-current-build-item == IRONCASTING)
=>
    (set-escrow-percentage food LOW-ESCROW)
    (set-escrow-percentage gold LOW-ESCROW)
    (set-escrow-percentage wood 0)
    (release-escrow wood)
)

(defrule
    (goal gl-strategy KRUSH)
    (goal gl-current-build-item IRONCASTING)
    (up-research-status c: ri-iron-casting >= research-pending)
=>
    ;	(chat-to-player me "Krush Iron Casting Researched")
    (up-modify-goal gl-build-progress c:+ 1)
)

