;###################### QRULES
(defrule
    (building-type-count town-center > 0)
=>
    (up-full-reset-search)
    (up-find-local c: town-center c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-object-data object-data-id home-id)
    (up-get-point position-object home-x)
    (disable-self)
)

(defrule
    (unit-type-count scout-cavalry-line > 0)
=>
    (up-full-reset-search)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-object-data object-data-id scout-id)
    (up-get-point position-object scout-x)
)

(defrule
    (true)
=>
    (up-get-point position-center center-x)
    (up-get-point position-map-size point-x)
    (up-modify-goal gl-max-coordinate-value g:= point-x)	;Barbie's
    (disable-self)
)

(defrule
    (true)
=>
    (up-get-fact escrow-amount food gl-food-escrow)
    (up-get-fact escrow-amount wood gl-wood-escrow)
    (up-get-fact escrow-amount gold gl-gold-escrow)
    (up-get-fact escrow-amount stone gl-stone-escrow)
    (up-get-fact food-amount 0 TOTAL-FOOD-AMOUNT)
    (up-get-fact gold-amount 0 TOTAL-GOLD-AMOUNT)
    (up-get-fact wood-amount 0 TOTAL-WOOD-AMOUNT)
    (up-get-fact stone-amount 0 TOTAL-STONE-AMOUNT)
)

(defrule
    (true)
=>
    (up-get-fact food-amount 0 NET-FOOD-AMOUNT)
    (up-get-fact gold-amount 0 NET-GOLD-AMOUNT)
    (up-get-fact wood-amount 0 NET-WOOD-AMOUNT)
    (up-get-fact stone-amount 0 NET-STONE-AMOUNT)
    (up-modify-goal NET-FOOD-AMOUNT g:- gl-food-escrow)
    (up-modify-goal NET-WOOD-AMOUNT g:- gl-wood-escrow)
    (up-modify-goal NET-GOLD-AMOUNT g:- gl-gold-escrow)
    (up-modify-goal NET-STONE-AMOUNT g:- gl-stone-escrow)
)

;###################### DEBUG
(defrule
    (taunt-detected me 100)
    (goal gl-second-turn 1)
=>
    (up-modify-sn sn-focus-player-number g:= gl-privileged-player)	;set focus to get his info
    (up-get-player-color focus-player goal)
    (up-chat-data-to-all "Privileged player: %d" g: goal)

    (up-get-focus-fact allied-sn sn-target-player-number goal)
    (up-modify-sn sn-focus-player-number g:= goal)	;set focus to get his info
    (up-get-player-color focus-player goal)
    (up-chat-data-to-all "Privileged target: %d" g: goal)

    ;	(do-nothing)
)

(defrule
    (goal gl-fifth-turn 1)
    (taunt-detected me 100)
=>
    (up-chat-data-to-all "gl-privileged-player: %d" g: gl-privileged-player)
    ;	(up-send-flare enemy-x)
)

(defrule
    (taunt-detected me 101)
=>
    (acknowledge-taunt me 100)
    (acknowledge-taunt me 101)
)

