(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal goal6 0)
    (set-goal rt 0)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point spear-group-x)
    (up-filter-distance c: -1 c: SpearTowerSearch)
    (up-filter-status c: status-ready c: list-active)
    (up-find-status-remote c: watch-tower c: 5)
    (up-get-search-state lt)
    (up-modify-goal goal6 g:+ rt)
)

;3. LOOP THE SEARCH
(defrule
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

;@@@@@@@@@@@@@@ FIND TOWERS NEAR RANGED GROUP
(defconst RangedTowerSearch 4)	;distance to search for towers
;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal goal4 0)
    (set-goal rt 0)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: RangedTowerSearch)
    (up-filter-status c: status-ready c: list-active)
