;WWWWWWWWWWWWWWWWWW QMOVING
;@@@@@@@@@@@@@@ RETREAT WHEN LOSING FIGHT
;1 if losing the fight, start retreating(timer)(stop other commands)
;2 constantly set the timer if need to keep retreating/when triggered, group goes back to normal
;3 also reset if the ranged group is at tc/don't start if ranged group closer than five tiles
;4 Make sure the army will retreat to tc properly/away from enemy army
(defrule
    (or	(up-group-size c: RangedGroup < 1)
    (and(players-current-age target-player < castle-age)
    (players-military-population target-player < 4)))
=>
    (up-jump-rule 16)
)

(defrule
    (timer-triggered t-ranged-retreat)
=>
    ;	(chat-to-player me "Reset RRetreat")
    (disable-timer t-ranged-retreat)
    (set-goal gl-ranged-retreat -1)
)

(defrule
    (up-compare-goal gl-mangos-nearby >= 1)
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: 15)
    (up-find-local c: knight-line c: 10)
    (up-get-search-state lt)
)

(defrule	;don't retreat far if knights around
    (up-compare-goal lt >= 1)
    (up-group-size c: RangedGroup > 0)
    (up-compare-goal gl-mangos-nearby >= 1)
    (up-point-distance ranged-group-x home-x >= 5)
=>
    ;	(up-chat-data-to-player me "Mango--Enable RRetreat Timer(%d)" g: gl-ranged-eval)
    (enable-timer t-ranged-retreat 2)
    (set-goal gl-ranged-retreat 1)
)

(defrule
    (up-compare-goal lt < 1)
    (up-group-size c: RangedGroup > 0)
    (up-compare-goal gl-mangos-nearby >= 1)
    (up-point-distance ranged-group-x home-x >= 5)
=>
    ;	(up-chat-data-to-player me "Mango--Enable RRetreat Timer(%d)" g: gl-ranged-eval)
    (enable-timer t-ranged-retreat 10)
    (set-goal gl-ranged-retreat 1)
)

(defrule
    (game-time > 10)
    (up-group-size c: RangedGroup > 0)
    (up-point-distance ranged-group-x home-x >= 8)
    (up-point-distance ranged-group-x enemy-group-x < 20)
    (or	(and(up-compare-goal gl-ranged-group-size < 7)
    (up-compare-goal gl-enemy-group-size >= 15))
    (up-compare-goal gl-ranged-eval < LosingFight))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (player-valid 5)
=>
    ;	(up-chat-data-to-all "TG Enable RRetreat Timer(%d)" g: gl-ranged-eval)
    (enable-timer t-ranged-retreat 10)
    ;	(set-goal gl-ranged-retreat 1)
    (set-goal SPLIT 0)
)

(defrule
    (goal SPLIT 1)
    (not(player-valid 5))
    (or	(up-compare-goal SUPERIORITY < 5)
    (or	(current-age-time < 30)
    (up-research-status c: castle-age == research-pending)))
=>
    ;	(up-chat-data-to-all "Long Enable RRetreat Timer(%d)" g: gl-ranged-eval)
    (enable-timer t-ranged-retreat 30)
    ;	(set-goal gl-ranged-retreat 1)
    (set-goal SPLIT 0)
)

(defrule
    (goal SPLIT 1)
    (not(player-valid 5))
    (up-compare-goal SUPERIORITY >= 5)
=>
    ;	(up-chat-data-to-all "Short Enable RRetreat Timer(%d)" g: gl-ranged-eval)
    (enable-timer t-ranged-retreat 10)
    ;	(set-goal gl-ranged-retreat 1)
    (set-goal SPLIT 0)
)

(defrule
    (true)
=>
    (set-goal goal 0)
    (set-goal goal1 8)
)

(defrule
    (up-point-distance ranged-group-x home-x > 40)
=>
    (set-goal goal1 5)
)

(defrule
    (up-point-distance enemy-x ranged-group-x < 30)
=>
    (set-goal goal -8)
)

(defrule
    (up-point-distance ranged-group-x home-x < 15)
=>
    (set-goal goal 0)
    (set-goal goal1 5)
)

(defrule
    (up-compare-goal gl-enemy-group-size < 1)
=>
    (set-goal goal 0)
)

(defrule
    (up-timer-status t-ranged-retreat == timer-running)
    (or	(goal gl-fifth-turn 1)
    (up-compare-goal gl-ranged-group-state != HOME-RETREAT))
=>
    (up-copy-point point-x ranged-group-x)
    (up-lerp-tiles point-x enemy-x g: goal)
    (up-lerp-tiles point-x home-x g: goal1)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (up-point-contains point-x c: tree-class)
=>
    (up-lerp-tiles point-x ranged-group-x c: -10)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal gl-ranged-retreat != 1)
=>
    ;	(up-chat-data-to-all "HomeRetreat(%d)" g: gl-ranged-eval)
    (up-full-reset-search)
    (up-set-group search-local c: RangedGroup)
    (up-bound-point point-x point-x)
    (up-target-point null-x action-move formation-line no-attack)
    (up-target-point point-x action-move formation-line no-attack)
    (set-goal gl-ranged-group-state HOME-RETREAT)
    (disable-timer t-failsafe)
    (set-goal SPLIT 0)
)

(defrule
    (goal SPLIT 1)
    (goal gl-ranged-retreat 1)	;mangonel
=>
    ;	(up-chat-data-to-player me "Mango HomeRetreat(%d)" g: gl-ranged-eval)
    (up-full-reset-search)
    (up-set-group search-local c: RangedGroup)
    (up-bound-point point-x point-x)
    (up-target-point null-x action-move formation-stagger no-attack)
    (up-target-point point-x action-move formation-stagger no-attack)
    (set-goal gl-ranged-group-state HOME-RETREAT)
    (disable-timer t-failsafe)
    (set-goal SPLIT 0)
)

