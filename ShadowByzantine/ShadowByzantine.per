    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-get-search-state lt)
    (up-clean-search search-remote 44 1)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object object-x)
)

(defrule
    (up-compare-goal rt == 1)
    (goal gl-sighted-boar-count 0)
=>
    ;	(chat-to-player me "First boar sighted")
    (set-goal gl-sighted-boar-count 1)
    (disable-self)
)

(defrule
    (goal gl-sighted-boar-count 1)
    (or	(up-compare-goal rl == 2)
    (and(up-compare-goal rl == 1)
    (up-compare-goal gl-killed-boar-count > 0)))
=>
    ;	(chat-to-player me "Second boar sighted")
    (set-goal gl-sighted-boar-count 2)
    (disable-self)
)

(defrule
    (goal gl-town-safe NO)
    (up-compare-goal BH > -1)
=>
    ;	(chat-to-player me "Don't BH")
    (set-goal BH -1)
)

(defrule	;initialize
    (goal BH -1)
    (goal gl-town-safe YES)
    (up-timer-status t-relure != timer-running)
    (dropsite-min-distance live-boar <= max-bh-distance)
    (or	(dropsite-min-distance live-boar <= safe-bh-distance)
    (and(dropsite-min-distance live-boar > safe-bh-distance)
    (up-research-status c: ri-loom >= research-pending)))
=>
    (set-goal BH 0)
)

(defrule
    (goal BH 0)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 40)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: boar-class c: 10)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-clean-search search-remote 44 search-order-asc)
    (up-remove-objects search-remote -1 > 0)
    (up-set-target-object search-remote c: 0)
    (up-get-object-data object-data-id current-boar-id)
    (set-goal BH 1)
)

(defrule
    (goal old-boar-id -1)
    (up-compare-goal current-boar-id != -1)
=>
    (up-modify-goal old-boar-id g:= current-boar-id)
    (disable-self)
)

