    ;	(or	(up-group-size c: RangedGroup > 0)
    (unit-type-count scout-cavalry-line < 1)
    ;		)
=>
    (up-jump-rule 6)
)

(defrule
    (true)
=>
    (set-goal goal 20)
)

(defrule
    (current-age == dark-age)
    (or	(current-age-time > 180)
    (unit-type-count sheep < 1))
=>
    (set-goal goal 45)
)

(defrule
    (up-group-size c: RangedGroup > 0)
=>
    (set-goal goal 15)
)

(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-target-point scout-x)
    (up-filter-distance c: -1 g: goal)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: livestock-class c: 1)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-get-search-state lt)
)

(defrule
    (up-compare-goal rt > 0)
=>
    (up-full-reset-search)
    (up-filter-distance c: -1 g: goal)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: livestock-class c: 5)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-clean-search search-remote 44 search-order-asc)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object point-x)
    (up-find-local c: scout-unit c: 1)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (up-lerp-tiles point-x center-x c: 2)
    (up-bound-point point-x point-x)
    (up-target-point point-x action-move -1 no-attack)
    (set-goal gl-getting-sheep YES)
    (enable-timer 28 4)
    ;	(chat-to-player me "Move")
    ;	(up-send-flare point-x)
    (set-goal SPLIT 0)
)

(defrule
    (false)
    (timer-triggered 28)
=>
