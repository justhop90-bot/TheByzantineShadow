(defrule
    (players-unit-type-count any-ally knight-line > 0)
=>
    (set-strategic-number sn-focus-player-number 1)
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: 15)
    (set-goal goal1 0)
    (set-goal rt 0)
)

;2. SEARCH
(defrule
    (stance-toward focus-player ally)
    (players-unit-type-count any-ally knight-line > 0)
=>
    (up-find-remote c: knight-line c: 10)
    (up-get-search-state lt)
    (up-modify-goal goal1 g:+ rt)
)

;3. LOOP THE SEARCH
(defrule
    (player-valid focus-player)
    (players-unit-type-count any-ally knight-line > 0)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (up-compare-goal goal1 > 0)
    (players-unit-type-count any-ally knight-line > 0)
=>
    (up-modify-goal goal1 c:* 3)
    (up-modify-goal gl-ranged-eval g:+ goal1)
)

;>>>>>>>>>>> LOCAL KNIGHTS
(defrule
    (true)
=>
    (set-goal goal 0)
    (set-goal lt 0)
)

(defrule
    (unit-type-count knight-line > 0)
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
