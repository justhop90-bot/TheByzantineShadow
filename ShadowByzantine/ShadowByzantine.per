    (goal gl-thirty-turn 1)
    (current-age >= feudal-age)
=>
    (up-full-reset-search)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: all-units-class c: 60)
    (up-remove-objects search-local object-data-idling != 1)
    (up-get-search-state lt)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal lt > 0)
=>
    ;	(up-chat-data-to-player me "Retask idles(%d)" g: lt)
    (up-remove-objects search-local object-data-idling != 1)
    (up-remove-objects search-local object-data-group-flag == RaidGroup)
    (up-target-point home-x action-stop -1 aggressive)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object point-x)
    ;	(up-send-flare point-x)
)

(defrule
    (goal SPLIT 1)
=>
    (set-goal SPLIT 0)
)

