    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
)

;2. SEARCH
(defrule
    (up-compare-goal rt < 1)
    (stance-toward focus-player enemy)
=>
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 g: gl-ranged-group-range)
    (up-find-remote c: villager-class c: 10)
    (up-remove-objects search-remote object-data-action != actionid-attack)
    (up-remove-objects search-remote object-data-type == battering-ram)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-remote c: all-units-class c: 40)
    (up-reset-filters)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (goal gl-ranged-group-state MINI-RETREAT)
=>
    (up-clean-search search-remote object-data-hitpoints search-order-asc)
    (up-remove-objects search-remote -1 > 0)
    (up-get-search-state lt)
    (set-goal SPLIT 0)
)

(defrule
