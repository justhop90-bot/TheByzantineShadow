    (not(player-valid 3))
=>
    (up-jump-rule 2)
)

(defrule
    (civilian-population < 5)
    (up-compare-goal CIVSUP < -30)
    (up-compare-goal SUPERIORITY < 10)
    (up-allied-goal every-ally CIVSUP < -30)
    (building-type-count-total town-center < 1)
    (up-allied-goal every-ally SUPERIORITY < 10)
    (players-civilian-population every-enemy >= 20)
=>
    (chat-to-all "you guys don't need me to win")
    (enable-timer 5 8)
    (disable-self)
)

