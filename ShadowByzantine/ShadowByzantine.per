;WWWWWWWWWWWWWWWWWW QADVANTAGE
(defrule
    (or	(up-group-size c: RangedGroup < 1)
    (up-point-distance ranged-group-x enemy-group-x > 15))
=>
    (set-goal gl-ranged-eval WinningFight)
    (up-jump-rule 44)
)

(defrule
    (true)
=>
    (set-goal gl-ranged-eval 0)
    (set-goal goal1 0)
    (set-goal goal 0)
)

;@@@@@@@@@@@@@@ WOLVES
(defrule
    (false)
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: 5)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: wolf c: 5)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-remove-objects search-remote object-data-target == villager-class)
    (up-get-search-state lt)
    (up-modify-goal rt c:* 3)
    (up-modify-goal gl-ranged-eval g:- rt)
)

;@@@@@@@@@@@@@@ SMITH TECHS
(defrule
    (or	(up-research-status c: ri-fletching == research-pending)
    (up-research-status c: ri-padded-archer-armor == research-pending))
=>
    (up-modify-goal gl-ranged-eval c:- 8)
)

;@@@@@@@@@@@@@@ UPFIRST
(defrule
    (goal UP-FIRST 1)
=>
    (up-modify-goal gl-ranged-eval c:- 10)
)

(defrule
    (goal UP-FIRST 0)
=>
    (up-modify-goal gl-ranged-eval c:+ 10)
)

;@@@@@@@@@@@@@@ DAMAGE POTENTIAL
(defrule
    (true)
=>
    (up-modify-goal goal9 g:= gl-army-damage-potential)
    (up-modify-goal goal9 c:/ 6)
    (up-modify-goal gl-ranged-eval g:+ goal9)
)

;@@@@@@@@@@@@@@ ELEVATION
(defrule
    (false)
    (up-point-distance ranged-group-x enemy-group-x > 2)
    (up-point-distance ranged-group-x enemy-group-x < 10)
=>
    (up-full-reset-search)
    (up-set-group search-local c: RangedGroup)
    (up-remove-objects search-local object-data-point-z < 1)
    (up-get-search-state lt)
    ;	(up-chat-data-to-player me "Elevated: %d" g: lt)
    (up-modify-goal goal8 g:= lt)
)

(defrule
    (false)
    (up-compare-goal goal8 >= 1)
=>
    (up-modify-goal goal8 c:* 3)
    (up-modify-goal goal8 c:/ 5)
    (up-modify-goal gl-ranged-eval g:+ goal8)
)

;@@@@@@@@@@@@@@ UNITS IN COMBAT
(defrule
    (true)
=>
    (up-modify-goal gl-ranged-eval g:- gl-enemy-group-size)
    (up-modify-goal gl-ranged-eval g:+ gl-ranged-group-size)
)

;@@@@@@@@@@@@@@ ARMOR DIFFRENCE
(defrule
    (true)
    (false)
=>
    (up-full-reset-search)
    (up-find-remote c: archery-class c: 1)
    (up-get-search-state lt)
    (set-goal goal6 0)
    (set-goal goal7 0)
)

(defrule
    (false)
    (up-compare-goal rt > 0)
    (up-set-target-object search-remote c: 0)
    (up-get-object-data object-data-pierce-armor goal6)
=>
    (up-full-reset-search)
    (up-find-local c: skirmisher-line c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-object-data object-data-pierce-armor goal7)
    ;	(up-modify-goal goal7 c:- 3)	;skirms have more base armor
    (up-modify-goal goal7 g:- goal6)
    (up-modify-goal gl-armor-advantage g:= goal7)
    (set-goal SPLIT 1)
)

(defrule
    (false)
    (players-unit-type-count target-player skirmisher >= 6)
=>
    (set-goal goal 9)
)

(defrule
    (false)
    (goal SPLIT 1)
    (up-compare-goal gl-armor-advantage >= 1)
=>
    (up-modify-goal gl-armor-advantage g:* gl-ranged-group-size)
    (up-modify-goal gl-armor-advantage c:* 2)
    (up-modify-goal gl-armor-advantage c:/ 5)
    (up-modify-goal gl-ranged-eval g:+ gl-armor-advantage)
)

(defrule
    (false)
    (goal SPLIT 1)
    (up-compare-goal gl-armor-advantage < 1)
=>
    (up-modify-goal gl-armor-advantage g:* gl-enemy-group-size)
    (up-modify-goal gl-armor-advantage c:* 2)
    (up-modify-goal gl-armor-advantage c:/ 5)
    (up-modify-goal gl-ranged-eval g:+ gl-armor-advantage)
)

(defrule
    (true)
    (false)
=>
    (set-goal SPLIT 0)
)

;@@@@@@@@@@@@@@ RANGE DIFFRENCE
;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal goal6 0)
    (set-goal goal7 0)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: 15)
    (up-find-remote c: archery-class c: 20)
    (up-get-search-state lt)
)

;3. LOOP THE SEARCH
(defrule
    (up-compare-goal rt < 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (up-compare-goal rt > 0)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-object-data object-data-range goal6)
    (up-full-reset-search)
    (up-find-local c: skirmisher-line c: 1)
    (up-set-target-object search-local c: 0)
    (up-get-object-data object-data-range goal7)
    (up-modify-goal goal7 g:- goal6)
    (up-modify-goal gl-range-advantage g:= goal7)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal gl-range-advantage >= 1)
=>
    (up-modify-goal gl-range-advantage g:* gl-ranged-group-size)
    (up-modify-goal gl-range-advantage c:* 3)
    (up-modify-goal gl-range-advantage c:/ 4)
    ;	(up-modify-goal gl-range-advantage c:min 10)
    (up-modify-goal gl-ranged-eval g:+ gl-range-advantage)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal gl-range-advantage < 1)
=>
    (up-modify-goal gl-range-advantage g:* gl-enemy-group-size)
    (up-modify-goal gl-range-advantage c:* 3)
    (up-modify-goal gl-range-advantage c:/ 4)
    ;	(up-modify-goal gl-range-advantage c:max -10)
    (up-modify-goal gl-ranged-eval g:+ gl-range-advantage)
)

(defrule
    (true)
=>
    (set-goal SPLIT 0)
)

;@@@@@@@@@@@@@@ OTHER UNITS IN FIGHT
(defrule
    (false)
    (unit-type-count scout-cavalry-line > 0)
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: 13)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-get-search-state lt)
)

(defrule
    ;	(up-compare-goal lt > 0)
    ;	(players-current-age target-player < castle-age)
    (goal gl-scout-added 3)
=>
    (up-modify-goal gl-ranged-eval c:+ 9)
)

;@@@@@@@@@@@@@@ TOWERS NEARBY
(defrule	;my towers
    (true)
=>
    (set-goal goal3 0)
    (up-full-reset-search)
    (up-set-target-point enemy-group-x)
    (up-filter-distance c: -1 g: gl-my-tower-range)
    (up-find-local c: watch-tower c: 10)
    (up-get-search-state lt)
    (up-modify-goal goal3 g:= lt)
    (up-full-reset-search)
    (up-filter-distance c: -1 g: gl-my-tower-range)
    (up-filter-status c: status-pending c: list-active)
    (up-find-status-local c: watch-tower c: 10)
    (up-get-search-state lt)
    (up-modify-goal goal3 g:- ll)
    (up-modify-goal goal3 c:* 8)
    (up-modify-goal gl-ranged-eval g:+ goal3)
)

;@@@@@@@@@@@@@@ SMALL ARMY
;>>>>>>>>>>> ENEMY
(defrule
    (true)
=>
    (set-goal goal6 0)
    (up-modify-goal goal g:= gl-enemy-group-size)
    (up-modify-goal goal g:- gl-ranged-group-size)
)

(defrule
    (up-compare-goal goal < 1)
    (up-compare-goal gl-enemy-group-size < 5)
=>
    (up-modify-goal gl-ranged-eval c:+ 10)
    (set-goal goal6 10)
)

;>>>>>>>>>>> MINE
(defrule
    (true)
=>
    (set-goal goal5 0)
    (up-modify-goal goal g:= gl-ranged-group-size)
    (up-modify-goal goal g:- gl-enemy-group-size)
)

(defrule
    (up-compare-goal goal < 1)
    (up-group-size c: RangedGroup < 5)
=>
    (up-modify-goal gl-ranged-eval c:- 10)
    (set-goal goal5 -10)
)

;@@@@@@@@@@@@@@ KNIGHT COUNT
;>>>>>>>>>>> REMOTE KNIGHTS
