    (false)
    (game-time < 660)
    (not(goal EARLY-MINING-NOTICE YES))
    (players-building-type-count target-player mining-camp > 0)
=>
    (chat-to-player me "Enemy mining early")
    (set-goal EARLY-MINING-NOTICE YES)
)

(defrule
    (false)
    (goal gl-enemy-strategy -1)
    (players-current-age-time target-player > 100)
    (players-current-age target-player > dark-age)
=>
    (chat-to-player me "SCOUTING MISSION HAS FAILED")
    (up-chat-data-to-player me "ENEMY STRAT STILL UNKNOWN(%d)" g: gl-enemy-strategy)
    (disable-self)
)

;WWWWWWWWWWWWWWWWWW DARK
(defrule
    (false)
    (goal gl-enemy-strategy -1)
    (players-current-age target-player == dark-age)
    (players-military-population target-player > 2)
=>
    (chat-to-player me "12Target is drushing")
    (set-goal gl-enemy-strategy DRUSH)
    (disable-self)
)

;WWWWWWWWWWWWWWWWWW FEUDAL
(defrule
    (false)
    (not(goal gl-enemy-strategy RANGED-FLUSH))
    (players-current-age target-player == feudal-age)
    (or	(and(players-current-age-time target-player < 100)
    (and(players-military-population target-player > 4)
    (players-building-type-count target-player archery-range == 1)))
    (players-building-type-count target-player archery-range == 2))
=>
    (chat-to-player me "12ENEMY FLUSHING")
    (set-goal gl-enemy-strategy-type RANGED-FLUSH)
    (set-goal gl-enemy-strategy FLUSH)
    (disable-self)
)

(defrule
    (false)
    (not(goal gl-enemy-strategy SCRUSH))
    (players-current-age target-player == feudal-age)
    (players-building-type-count target-player archery-range < 2)
    (or	(players-unit-type-count target-player scout-cavalry-line > 1)
    (players-building-type-count target-player stable > 0))
=>
    (chat-to-player me "12Target is going for a scrush")
    (set-goal gl-enemy-strategy-type FLUSH)
    (set-goal gl-enemy-strategy SCRUSH)
)

(defrule
    (false)
    (goal gl-enemy-strategy-type FC)
    (up-compare-goal gl-target-age < CA-loading)
    (players-current-age-time target-player > 100)
    (players-current-age target-player == feudal-age)
=>
    (chat-to-player me "12Target is flushing, no FC")
    (set-goal gl-enemy-strategy-type FLUSH)
)

;WWWWWWWWWWWWWWWWWW CASTLE
(defrule
    (false)
    (not(goal gl-enemy-strategy KRUSH))
    (players-current-age target-player == feudal-age)
    (players-building-type-count target-player stable > 0)
    (or	(up-compare-goal gl-target-age >= CA-loading)
    (players-building-type-count target-player market > 0))
=>
    (chat-to-player me "12Target is going for a krush")
    (set-goal gl-enemy-strategy-type FC)
    (set-goal gl-enemy-strategy KRUSH)
)

