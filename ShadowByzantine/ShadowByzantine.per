    (up-filter-distance c: -1 c: 20)
    (up-find-local c: villager-class c: 10)
    (up-remove-objects search-local object-data-hitpoints < 25)
    (up-clean-search search-local object-data-hitpoints search-order-desc)
    (up-remove-objects search-local -1 > 5)
    (up-get-search-state lt)
    ;	(up-chat-data-to-player me "!! %d vills attack tower!!" g: lt)
    (set-goal gl-trushed YES)
)

(defrule
    (goal gl-trushed YES)
=>
    (up-target-objects 0 action-default -1 -1)
)

