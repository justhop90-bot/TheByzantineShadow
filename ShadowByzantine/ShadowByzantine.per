;@@@@@@@@@@@@@@ DEBUG
(defrule
    (taunt-detected me 59)
    (goal gl-fifth-turn 1)
=>
    (up-chat-data-to-player me "army-damage-potential: %d" g: goal9)
    (up-chat-data-to-player me "RangeAdvantage: %d" g: gl-range-advantage)
    (up-chat-data-to-player me "My army: %d" g: gl-ranged-group-size)
    ;	(up-chat-data-to-player me "MyElevation: %d" g: goal8)
    (up-chat-data-to-player me "Knights: %d" g: goal)
    (up-chat-data-to-player me "My tc's: %d" g: lt)
    (up-chat-data-to-player me "Enemy tc's: %d" g: rt)
    (up-chat-data-to-player me "Enemy army: %d" g: gl-enemy-group-size)
    (up-chat-data-to-player me "UpFirst: %d" g: UP-FIRST)
    (up-chat-data-to-player me "SmallMyArmy: %d" g: goal5)
    (up-chat-data-to-player me "SmallEnemyArmy: %d" g: goal6)
    (up-chat-data-to-player me "Advantage: %d" g: gl-ranged-eval)
    ;	(up-chat-data-to-player me "ArmorAdvantage: %d" g: gl-armor-advantage)
    (up-chat-data-to-player me "Ally Knights: %d" g: goal1)
)

(defrule
    (taunt-detected me 60)
=>
    (acknowledge-taunt me 59)
    (acknowledge-taunt me 60)
)

(defrule
    (goal SPLIT 1)
=>
    (chat-to-player me "Leak 2")
    (set-goal SPLIT 0)
)

;WWWWWWWWWWWWWWWWWW QGROUP STUFF
;@@@@@@@@@@@@@@ QNA
;>>>>>>>>>>> RANGED
(defrule
    (up-group-size c: RangedGroup < 1)
=>
    (up-jump-rule 12)
)

(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-group search-local c: RangedGroup)
    (up-clean-search search-local object-data-next-attack search-order-desc)
    (up-remove-objects search-local -1 > 0)
    (up-set-target-object search-local c: 0)
    (up-get-object-data object-data-next-attack gl-highest-next-attack)
)

(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-group search-local c: RangedGroup)
    (up-clean-search search-local object-data-next-attack search-order-asc)
    (up-remove-objects search-local object-data-next-attack == 0)
    (up-remove-objects search-local -1 > 0)
    (up-set-target-object search-local c: 0)
    (up-get-object-data object-data-next-attack gl-lowest-next-attack)
)

(defrule
    (false)
    (goal gl-can-move NO)
    (up-compare-goal gl-target-distance g:> gl-ranged-group-range)
=>
    (chat-to-player me "Can't hit anything--MOVE")
    (set-goal gl-can-move YES)
)

(defrule
    (false)
    (goal gl-can-move YES)
    (up-compare-goal gl-target-distance g:<= gl-ranged-group-range)
=>
    (chat-to-player me "Target close enough--FIRE")
    (set-goal gl-can-move NO)
)
#load-if-defined DE-AVAILABLE
	(defconst firing-threshold-1 100)
	(defconst firing-threshold-2 2500)
#else	;UP
	(defconst firing-threshold-1 300)
	(defconst firing-threshold-2 2450)
#end-if

(defrule
    (up-compare-goal gl-can-fire != YES)
    (up-compare-goal gl-highest-next-attack <= firing-threshold-1)	;lower the number, longer group waits to fire
    (up-compare-goal gl-target-distance g:<= gl-ranged-group-range)
=>
    ;	(up-chat-data-to-player me "Time to fire(%d)" g: gl-lowest-next-attack)
    (set-goal gl-can-fire YES)
    (set-goal gl-can-move NO)
)

(defrule
    (timer-triggered t-failsafe)
    (up-compare-goal gl-can-fire != YES)
    (up-compare-goal gl-target-distance g:<= gl-ranged-group-range)
=>
    ;	(up-chat-data-to-player me "Time to fire Failsafe(%d)" g: gl-lowest-next-attack)
    (set-goal gl-can-fire YES)
    (set-goal gl-can-move NO)
    (disable-timer t-failsafe)
)

(defrule	;na decreases after last attack
    (up-compare-goal gl-can-move != YES)
    (up-compare-goal gl-target-distance g:> gl-ranged-group-range)
=>
    ;	(up-chat-data-to-player me "DistanceMove(%d)" g: gl-lowest-next-attack)
    (set-goal gl-can-move YES)
    (set-goal gl-can-fire NO)
)

;if highest-next-attack < x, then lowest cannot be > x, so no conflict
(defrule	;na decreases after last attack
    (up-compare-goal gl-can-move != YES)
    (up-compare-goal gl-lowest-next-attack > firing-threshold-1)
    (up-compare-goal gl-lowest-next-attack < firing-threshold-2)	;higher=group moves sooner after firing--too high will cancel shots
=>
    ;	(up-chat-data-to-player me "Normal Move(%d)" g: gl-lowest-next-attack)
    (set-goal gl-can-move YES)
    (set-goal gl-can-fire NO)
)

(defrule
    (timer-triggered t-failsafe)
    (up-compare-goal gl-can-move != YES)
=>
    ;	(up-chat-data-to-player me "Time to move Failsafe(%d)" g: gl-lowest-next-attack)
    (set-goal gl-can-move YES)
    (set-goal gl-can-fire NO)
    (disable-timer t-failsafe)
)

(defrule
    (taunt-detected me 63)
    ;	(goal gl-second-turn 1)
=>
    (up-chat-data-to-player me "Can fire: %d" g: gl-can-fire)
    (up-chat-data-to-player me "Can move: %d" g: gl-can-move)
    (up-chat-data-to-player me "Highest NA: %d" g: gl-highest-next-attack)
    (up-chat-data-to-player me "Lowest NA: %d" g: gl-highest-next-attack)
)

(defrule
    (taunt-detected me 64)
=>
    (acknowledge-taunt me 63)
    (acknowledge-taunt me 64)
)

(defrule
    (false)
    ;	(goal gl-second-turn 1)
    (timer-triggered t-failsafe)
=>
    (chat-to-player me "Failsafe Triggered!")
)

