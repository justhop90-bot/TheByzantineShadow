    (up-modify-goal goal c:* 3)
)

(defrule
    (up-compare-goal lt > 0)
    (unit-type-count knight-line > 0)
    (research-completed ri-chain-barding)
=>
    (up-modify-goal goal c:* 2)
)

(defrule
    (up-compare-goal lt > 0)
    (unit-type-count knight-line > 0)
=>
    (up-modify-goal gl-ranged-eval g:+ goal)
)

