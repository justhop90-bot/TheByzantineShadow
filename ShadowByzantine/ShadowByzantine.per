    (taunt-detected me 77)
    (goal gl-fifth-turn 1)
=>
    (up-send-flare knight-group-x)
)

(defrule
    (taunt-detected me 78)
=>
    (acknowledge-taunt me 77)
    (acknowledge-taunt me 78)
)

