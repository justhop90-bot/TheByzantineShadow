    (players-military-population target-player < 4)))
=>
    (up-modify-goal gl-army-damage-potential c:+ 55)
)

;@@@@@@@@@@@@@@ UPFIRST
(defrule
    (current-age == castle-age)
    (up-compare-goal UP-FIRST != -1)
    (or (current-age-time >= 30)
    (players-current-age target-player == castle-age))
=>
    ;	(chat-to-player me "Up First Done 1")
    (set-goal UP-FIRST -1)
    (disable-self)
)

(defrule
    (up-compare-goal UP-FIRST != -1)
    (or (players-current-age-time target-player >= 30)
    (current-age == castle-age))
    (players-current-age target-player == castle-age)
=>
    ;	(chat-to-player me "Up First Done 2")
    (set-goal UP-FIRST -1)
    (disable-self)
)

