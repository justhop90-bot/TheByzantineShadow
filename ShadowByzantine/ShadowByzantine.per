    (set-strategic-number sn-focus-player-number 1)
    (set-goal gl-enemy-group-size 0)
)

;2. SEARCH
(defrule	;get enemy group size
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point enemy-group-x)
    (up-filter-distance c: -1 c: 10)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-remote c: skirmisher-line c: 40)
    (up-find-remote c: archer-line c: 40)
    (up-get-search-state lt)
    (up-modify-goal gl-enemy-group-size g:+ rt)
    (up-modify-goal rl c:/ 2)
    (up-modify-goal gl-enemy-group-size g:+ rl)
)

;3. LOOP THE SEARCH
(defrule
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

;DEBUG
(defrule
    (game-time > 5)
    (or	(taunt-detected me 19)
    (taunt-detected any-enemy 19))
=>
    ;	(chat-to-player me "Armies here and here")
    (acknowledge-taunt this-any-enemy 19)
    (acknowledge-taunt me 19)
    (up-send-flare enemy-group-x)
    (up-send-flare ranged-group-x)
)

;WWWWWWWWWWWWWWWWWW QMPOINTS
(defrule
    (goal gl-tenth-turn 1)
    (taunt-detected me 89)
=>
    (up-chat-data-to-player me "Marching type: %d" g: gl-march-type)
    (up-send-flare march1-x)
    (up-send-flare march2-x)
    (up-send-flare march3-x)
    (up-send-flare march4-x)
    (up-send-flare march-x)
    (up-send-flare enemy-x)
)

(defrule
    (taunt-detected me 90)
=>
    (acknowledge-taunt me 89)
    (acknowledge-taunt me 90)
)

;@@@@@@@@@@@@@@ MAINTAINANCE
(defrule
    (goal gl-defend-town NO)
    (goal gl-march-type MarchingFour)
=>
    (up-copy-point march-x march4-x)
)

(defrule
    (goal gl-defend-town NO)
    (goal gl-march-type MarchingThree)
=>
    (up-copy-point march-x march3-x)
)

(defrule
    (goal gl-defend-town NO)
    (goal gl-march-type MarchingTwo)
=>
    (up-copy-point march-x march2-x)
)

(defrule
    (goal gl-defend-town NO)
    (goal gl-march-type MarchingOne)
=>
    (up-copy-point march-x march1-x)
)

;@@@@@@@@@@@@@@ COMING BACK TO DEFEND
(defrule
    (game-time < 1500)	;25min
    (goal gl-defend-town YES)
    (up-group-size c: RangedGroup > 0)
    (up-point-distance march-x home-x > 3)
=>
    (up-copy-point saved-march-x march-x)
    (up-copy-point march-x home-x)
    (chat-to-all "March Home")
)

(defrule
    (goal gl-defend-town NO)
    (up-group-size c: RangedGroup > 0)
    (up-point-distance march-x home-x < 3)
=>
    (chat-to-all "March Back To Enemy")
    (up-copy-point march-x saved-march-x)
    (up-send-flare march-x)
    ;	(up-send-flare home-x)
)

;@@@@@@@@@@@@@@ DEFENDING HOME EARLY
(defrule
    (goal gl-attacking NO)
    (up-group-size c: RangedGroup > 0)
    (up-compare-goal gl-march-type == DefendingLC)
    ;	(or	(up-timer-status t-mpoints != timer-running)
    (up-point-distance ranged-group-x march-x < 5);)
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-find-local c: mill c: 3)
    (up-clean-search search-local 44 search-order-desc)
)

(defrule
    (goal gl-attacking NO)
    (up-group-size c: RangedGroup > 0)
    (up-set-target-object search-local c: 0)
    (up-compare-goal gl-march-type == DefendingLC)
    ;	(or	(up-timer-status t-mpoints != timer-running)
    (up-point-distance ranged-group-x march-x < 5);)
=>
    ;	(chat-to-player me "DefendMill")
    (up-get-point position-object march-x)
    (set-goal gl-march-type DefendingMill)
)

(defrule
    (goal gl-attacking NO)
    (up-group-size c: RangedGroup > 0)
    (up-compare-goal gl-march-type == DefendingMill)
    ;	(or	(up-timer-status t-mpoints != timer-running)
    (up-point-distance ranged-group-x march-x < 5);)
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-find-local c: lumber-camp c: 3)
    (up-clean-search search-local 44 search-order-desc)
)

(defrule
    (goal gl-attacking NO)
    (up-group-size c: RangedGroup > 0)
    (up-set-target-object search-local c: 0)
    (up-compare-goal gl-march-type == DefendingMill)
    ;	(or	(up-timer-status t-mpoints != timer-running)
    (up-point-distance ranged-group-x march-x < 5);)
=>
    ;	(chat-to-player me "DefendLC")
    (up-get-point position-object march-x)
    (set-goal gl-march-type DefendingLC)
)

;@@@@@@@@@@@@@@ ENEMY-X
(defrule
    (game-time > 2)
    (goal gl-tenth-turn 1)
    (players-building-type-count target-player town-center > 0)
=>
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    ;	(chat-to-player me "Enemy tc found")
    (up-full-reset-search)
    (up-find-remote c: town-center c: 1)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object enemy-x)
    ;	(up-send-flare enemy-x)
)

(defrule
    (game-time > 5)
    (goal gl-attacking YES)
    (goal gl-thirty-turn 1)
    (players-building-count target-player > 0)
    (players-building-type-count target-player town-center < 1)
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-find-remote c: building-class c: 40)
    (up-find-remote c: watch-tower c: 40)
    (up-find-remote c: farm-class c: 40)
    (up-clean-search search-remote 44 search-order-desc)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object enemy-x)
    (up-get-point position-object march-x)
    ;	(chat-to-player me "Set temporary enemy-x TSA")
)

(defrule
    (game-time > 5)
    (goal gl-attacking NO)
    (goal gl-thirty-turn 1)
    (players-building-count target-player > 0)
    (players-building-type-count target-player town-center < 1)
=>
    (up-full-reset-search)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-find-remote c: building-class c: 40)
    (up-find-remote c: watch-tower c: 40)
    (up-find-remote c: farm-class c: 40)
    (up-clean-search search-remote 44 search-order-desc)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object enemy-x)
    ;	(chat-to-player me "Set temporary enemy-x NORMAL")
)

;@@@@@@@@@@@@@@ ATTACKING
(defrule 	;get closefrontL point
    (goal gl-tenth-turn 1)
    (up-point-contains enemy-x c: town-center)
    (players-building-type-count target-player town-center > 0)
=>
    (up-copy-point march1-x enemy-x)
    (up-lerp-tiles march1-x home-x c: 10)
    (up-cross-tiles march1-x home-x c: 12)
    (up-bound-point march1-x march1-x)
    ;	(up-send-flare march1-x)
    ;	(chat-to-all "March1")
)

(defrule 	;get closebackL point
    (goal gl-tenth-turn 1)
    (up-point-contains enemy-x c: town-center)
    (players-building-type-count target-player town-center > 0)
=>
    (up-copy-point march2-x enemy-x)
    (up-cross-tiles march2-x home-x c: 15)
    (up-lerp-tiles march2-x home-x c: -10)
    (up-lerp-tiles march3-x enemy-x c: 8)
    (up-bound-point march2-x march2-x)
    ;	(up-send-flare march2-x)
    ;	(chat-to-all "March2")
)

(defrule 	;get closebackR point
    (goal gl-tenth-turn 1)
    (up-point-contains enemy-x c: town-center)
    (players-building-type-count target-player town-center > 0)
=>
    (up-copy-point march3-x enemy-x)
    (up-cross-tiles march3-x home-x c: -15)
    (up-lerp-tiles march3-x home-x c: -10)
    (up-lerp-tiles march3-x enemy-x c: 8)
    (up-bound-point march3-x march3-x)
    ;	(up-send-flare march3-x)
    ;	(chat-to-all "March3")
)

(defrule 	;get closefrontR point
    (goal gl-tenth-turn 1)
    (up-point-contains enemy-x c: town-center)
    (players-building-type-count target-player town-center > 0)
=>
    (up-copy-point march4-x enemy-x)
    (up-cross-tiles march4-x home-x c: -15)
    (up-lerp-tiles march4-x home-x c: 10)
    (up-bound-point march4-x march4-x)
    ;	(up-send-flare march4-x)
    ;	(chat-to-all "March4")
)

(defrule
    (or	(game-time < 5)
    (or	(goal gl-defend-town YES)
    (or	(goal gl-attacking NO)
    (or	(players-building-type-count target-player town-center < 1)
    (up-group-size c: RangedGroup < 1)))))
=>
    (up-jump-rule 12)
)

;======== ONE
(defrule 	;back to one if enemy krushing and not in castle yet (or TG)
    (current-age < castle-age)
    (or	(and(player-valid 5)	;in tg's (case of pocket)
    (game-time > 1080))	;18min
    (or	(goal gl-enemy-strategy KRUSH)
    (goal gl-enemy-strategy POSSIBLE-KRUSH)))
    (up-compare-goal gl-march-type >= MarchingTwo)	;includes all other marches
    (or (taunt-detected me 85)
    (up-point-distance ranged-group-x march-x < 5))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (set-goal gl-march-type MarchingOne)
    ;	(chat-to-all "BACK TO ONE")
    (acknowledge-taunt me 85)
    (set-goal SPLIT 0)
    (up-jump-rule 10)
)

(defrule 	;normal
    (or (taunt-detected me 85)
    (up-point-distance ranged-group-x march-x < 5))
    (or	(up-compare-goal gl-march-type < MarchingOne)
    (up-compare-goal gl-march-type >= MarchingFour))
    (or	(game-time < 1080)	;18min
    (not(player-valid 5)))
    (up-compare-goal gl-enemy-strategy != KRUSH)
    (up-compare-goal gl-enemy-strategy != POSSIBLE-KRUSH)
=>
    (set-goal SPLIT 1)
)

(defrule 	;normal
    (current-age >= castle-age)
    (or (taunt-detected me 85)
    (up-point-distance ranged-group-x march-x < 5))
    (or	(up-compare-goal gl-march-type < MarchingOne)
    (up-compare-goal gl-march-type >= MarchingFour))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (set-goal gl-march-type MarchingOne)
    (acknowledge-taunt me 85)
    ;	(chat-to-all "one")
    (set-goal SPLIT 0)
    (up-jump-rule 7)
)

;======== TWO (OR BACK TO FOUR)
(defrule 	;go back to march4-x if enemy krushing and not castled yet
    (current-age < castle-age)
    (goal gl-march-type MarchingOne)
    (or	(and(player-valid 5)	;in tg's (case of pocket)
    (game-time > 1080))	;18min
    (or	(goal gl-enemy-strategy KRUSH)
    (goal gl-enemy-strategy POSSIBLE-KRUSH)))
    (or (taunt-detected me 85)
    (up-point-distance ranged-group-x march-x < 5))
=>
    (set-goal gl-march-type MarchingFour)
    ;	(chat-to-all "BACK TO FOUR")
    (acknowledge-taunt me 85)
    (up-jump-rule 6)
)

(defrule	;normally just go on to march2-x
    (goal gl-march-type MarchingOne)
    (or (taunt-detected me 85)
    (up-point-distance ranged-group-x march-x < 5))
    (or	(current-age >= castle-age)
    (and(or	(game-time < 1080)
    (not(player-valid 5)))
    (and(up-compare-goal gl-enemy-strategy != KRUSH)
    (up-compare-goal gl-enemy-strategy != POSSIBLE-KRUSH))))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (set-goal gl-march-type MarchingTwo)
    (acknowledge-taunt me 85)
    (set-goal SPLIT 0)
    (up-jump-rule 4)
)

;======== THREE
(defrule
    (goal gl-march-type MarchingTwo)
    (or (taunt-detected me 85)
    (up-point-distance ranged-group-x march-x < 5))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (set-goal gl-march-type MarchingThree)
    (acknowledge-taunt me 85)
    (set-goal SPLIT 0)
    (up-jump-rule 2)
)

;======== FOUR
(defrule
    (goal gl-march-type MarchingThree)
    (or (taunt-detected me 85)
    (up-point-distance ranged-group-x march-x < 5))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (set-goal gl-march-type MarchingFour)
    (acknowledge-taunt me 85)
    (set-goal SPLIT 0)
)

(defrule
    (goal SPLIT 1)
=>
    (chat-to-player me "Leak 6")
    (set-goal SPLIT 0)
)

;###################### QMINIS
;WWWWWWWWWWWWWWWWWW BUILDING-ATTACKERS
(defrule
    (true)
    (goal gl-fifth-turn 1)
    (up-group-size c: RangedGroup < 1)
=>
    (up-full-reset-search)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: all-units-class c: 100)
    (up-remove-objects search-local object-data-target != building-class)
    (up-remove-objects search-local object-data-action == actionid-move)
    (up-set-target-point home-x)
    (up-remove-objects search-local 44 < 30)
    (up-get-search-state lt)
    ;	(up-chat-data-to-player me "BuildingsTargeted(%d)" g: lt)
)

(defrule
    (false)
    ;	(goal gl-fifth-turn 1)
    (up-compare-goal lt >= 1)
    (up-group-size c: RangedGroup < 1)
    (players-military-population target-player >= 5)
=>
    (up-set-target-point home-x)
    (up-clean-search search-local 44 search-order-asc)
    (up-remove-objects search-local -1 > 5)
    (up-set-target-object search-local c: 0)
    (up-get-point position-object point-x)
    (up-target-point enemy-x action-patrol -1 -1)
    ;	(up-chat-data-to-player me "BuildingStop(%d)" g: lt)
    ;	(up-send-flare point-x)
)

;WWWWWWWWWWWWWWWWWW SCOUT STUCK
;1 get current position(saved)
;2 after a while, check to see if scout-x is still close
;3 if they are close, start 28; if not just go back to 1
(defrule
    (or	(game-time < 10)
    (or	(goal gl-getting-sheep YES)
    (or	(unit-type-count scout-cavalry-line < 1)
    (goal NEWSCOUTING FINISHED))))
=>
    (up-jump-rule 6)
)

(defrule
    (goal gl-seventh-turn 1)
    (up-compare-goal NEWSCOUTING >= 45)
    (unit-type-count scout-cavalry-line > 0)
    (up-point-distance saved-scout-x scout-x < 1)
=>
    ;	(chat-to-player me "DEBUG: Normal Scout Stuck!")
    (enable-timer 28 0)
)

(defrule
    (goal gl-tenth-turn 1)
    (goal gl-scout-stuck 0)
    (up-compare-goal NEWSCOUTING < 45)
    (up-point-distance saved-scout-x scout-x < 2)
=>
    (up-get-point-distance saved-scout-x scout-x goal)
    ;	(up-chat-data-to-player me "DEBUG: Manual Scout Stuck! (%d)" g: goal)
    ;	(up-send-flare saved-scout-x)
    (set-goal gl-scout-stuck 2)
    (enable-timer 28 5)
)

(defrule
    (goal gl-scout-stuck 2)
    (up-timer-status 28 == timer-running)
=>
    (up-full-reset-search)
    (up-add-object-by-id search-local g: scout-id)
    ;	(up-copy-point point-x scout-x)
    ;	(up-lerp-tiles point-x home-x c: -10)
    ;	(up-bound-point point-x point-x)
    ;	(up-lerp-tiles point-x home-x c: -10)
    ;	(up-bound-point point-x point-x)
    (up-target-point explo-x action-move -1 defensive)
    ;	(chat-to-player me "Move away!")
    ;	(up-send-flare point-x)
)

(defrule
    (goal gl-scout-stuck 2)
    (or	(timer-triggered 28)
    (up-point-distance scout-x saved-scout-x >= 3))
=>
    (up-get-point-distance saved-scout-x scout-x goal)
    ;	(up-chat-data-to-player me "DEBUG: Reset Scout Stuck! (%d)" g: goal)
    (set-goal gl-scout-stuck -1)
)

(defrule
    (goal gl-twenty-turn 1)
    (goal gl-scout-stuck 0)
    (up-point-distance saved-scout-x scout-x >= 4)
=>
    (up-get-point-distance saved-scout-x scout-x goal)
    ;	(up-chat-data-to-player me "DEBUG: Scout Not Stuck (%d)" g: goal)
    ;	(up-send-flare saved-scout-x)
    (set-goal gl-scout-stuck -1)
)

(defrule
    (goal gl-twenty-turn 1)
    (goal gl-scout-stuck -1)
=>
    ;	(chat-to-player me "Set Initial")
    (up-copy-point saved-scout-x scout-x)
    (set-goal gl-scout-stuck 0)
)

;WWWWWWWWWWWWWWWWWW DEBUG
(defrule
    (taunt-detected me 103)
    (goal gl-second-turn 1)
=>
    (up-chat-data-to-player me "StuckStatus: %d" g: gl-scout-stuck)
    (up-chat-data-to-player me "Distance From Saved: %d" g: goal)
)

(defrule
    (taunt-detected me 103)
    (goal gl-fifth-turn 1)
=>
    (up-send-flare saved-scout-x)
)

(defrule
    (taunt-detected me 104)
=>
    (acknowledge-taunt me 103)
    (acknowledge-taunt me 104)
)

;WWWWWWWWWWWWWWWWWW LC TASK
;1 find closest vill to the lc
;2 find the closest tree to the lc
;3 task the vill to the tree
;WWWWWWWWWWWWWWWWWW ONE
(defrule
    (building-type-count lumber-camp == 1)
=>
    (up-full-reset-search)
    (up-find-local c: lumber-camp c: 1)
    (disable-self)
)

(defrule
    (building-type-count lumber-camp == 1)
    (up-set-target-object search-local c: 0)
=>
    (up-get-point position-object point-x)
    ;	(up-send-flare point-x)
    ;	(chat-to-player me "Camp here")
    (up-full-reset-search)
    (up-set-target-point point-x)
    (up-find-local c: villager-class c: 20)
    (up-clean-search search-local 44 search-order-asc)
    (disable-self)
)

(defrule
    (building-type-count lumber-camp == 1)
    (up-set-target-object search-local c: 0)
=>
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 5)
    (up-filter-status c: status-ready c: list-active)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-resource c: wood c: 50)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-clean-search search-remote 44 search-order-asc)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object point-x)
    ;	(up-send-flare point-x)
    (up-target-objects 1 action-default -1 -1)
    ;	(chat-to-player me "Attack tree")
    (disable-self)
)

;WWWWWWWWWWWWWWWWWW TWO
(defrule
    (false)
    (building-type-count lumber-camp == 2)
=>
    (up-full-reset-search)
    (up-find-local c: lumber-camp c: 2)
    (disable-self)
)

(defrule
    (false)
    (building-type-count lumber-camp == 2)
    (up-set-target-object search-local c: 0)
=>
    (up-get-point position-object point-x)
    (up-send-flare point-x)
    (chat-to-player me "Camp here")
    (up-full-reset-search)
    (up-set-target-point point-x)
    (up-find-local c: villager-class c: 20)
    (up-clean-search search-local 44 search-order-asc)
    (disable-self)
)

(defrule
    (false)
    (building-type-count lumber-camp == 2)
    (up-set-target-object search-local c: 0)
=>
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 5)
    (up-filter-status c: status-ready c: list-active)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-resource c: wood c: 50)
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-clean-search search-remote 44 search-order-asc)
    (up-set-target-object search-remote c: 0)
    (up-get-point position-object point-x)
    (up-send-flare point-x)
    (up-target-objects 1 action-default -1 -1)
    (chat-to-player me "Attack tree")
    (disable-self)
)

;WWWWWWWWWWWWWWWWWW CANCEL
(defrule
    (current-age == castle-age)
    (goal gl-current-build-item ESKIRMS)
    (building-type-count archery-range >= 1)
    (research-available ri-elite-skirmisher)
    (up-pending-objects c: skirmisher-line >= 2)
    (up-research-status c: ri-elite-skirmisher < research-pending)
=>
    (chat-to-player me "Cancel skirms")
    (up-full-reset-search)
    ;	(up-filter-exclude -1 actionid-research -1 -1)
    (up-find-local c: archery-range c: 1)
    (up-get-point position-object point-x)
    (up-set-target-point point-x)
    ;	(up-send-flare point-x)
    (up-target-point 0 action-stop -1 -1)
    (disable-self)
)

;###################### QHOUSES
(defrule
    (true)
    ;	(up-compare-goal gl-tenth-turn != 1)
    ;	(or	(current-age < feudal-age)
    ;		(up-pending-objects c: house < 1))
=>
    (up-jump-rule 6)
)

(defrule
    (true)
=>
    (set-goal goal -1)
    (set-goal goal1 -1)
)

(defrule
    (goal goal -1)
=>
    (up-full-reset-search)
    (up-filter-status c: status-pending c: list-active)
    (up-find-status-local c: house c: 1)
    (up-get-search-state lt)
