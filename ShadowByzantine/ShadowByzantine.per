    (up-set-target-point raid-group-x)
    (up-modify-goal goal g:= gl-raid-group-range)
    (up-modify-goal goal c:+ 2)
    (up-filter-distance c: -1 g: goal)
    (up-modify-goal goal s:= sn-focus-player-number)
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: wolf c: 1)
    (up-remove-objects search-remote object-data-target == villager-class)
    (up-modify-sn sn-focus-player-number g:= goal)
    (up-get-search-state lt)
)

(defrule	;ranged
    (up-compare-goal rt < 1)
=>
    (up-full-reset-search)
    (up-set-target-point raid-group-x)
    (up-filter-distance c: -1 g: gl-raid-group-range)
    (up-find-remote c: archery-class c: 40)
    (up-clean-search search-remote 44 search-order-asc)
    (up-set-target-point raid-nearest-fort-x)
    (up-remove-objects search-remote 44 < 8)
    ;	(up-set-target-point ranged-group-x)
    ;	(up-remove-objects search-remote 44 < 14)
    (up-remove-objects search-remote -1 > 0)
    (up-get-search-state lt)
)

(defrule	;vills
    (up-compare-goal rt < 1)
=>
    (up-full-reset-search)
    (up-set-target-point raid-group-x)
    (up-filter-distance c: -1 c: 15)	;tracking
    (up-find-remote c: villager-class c: 40)
    ;	(up-clean-search search-remote object-data-hitpoints search-order-asc)
    ;	(up-remove-objects search-remote -1 > 3)
    (up-clean-search search-remote 44 search-order-asc)
    (up-set-target-point raid-nearest-fort-x)
    (up-remove-objects search-remote 44 < 8)
    ;	(up-set-target-point ranged-group-x)
    ;	(up-remove-objects search-remote 44 < 14)
    (up-remove-objects search-remote -1 > 0)
    (up-get-search-state lt)
)

(defrule	;repeat
    (up-compare-goal rt < 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -11)
)

(defrule
    (up-compare-goal rt >= 1)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-point position-object object-x)
    (up-get-object-data object-data-id goal1)
    (up-get-object-data object-data-class goal3)
    (up-get-point-distance object-x raid-group-x goal2)
    (up-jump-rule 1)
)

	;FOCUS RESET (FROM START OF ACTION SECTION)
(defrule
    (true)
=>
    (up-modify-sn sn-focus-player-number g:= goal5)
)

;@@@@@@@@@@@@@@ ATTACKING
(defrule
    (up-group-size c: RaidGroup < 1)
=>
    (up-jump-rule 3)
)

(defrule
    (true)
=>
    (set-goal SPLIT 0)
)

(defrule	;attack target
    (goal gl-raid-can-fire YES)
    (up-compare-goal gl-raid-group-state != FIRING)
    (or	(up-compare-goal goal4 >= 1)
    (up-timer-status t-raid-retreat != timer-running))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    ;	(chat-to-player me "RFire")
    (up-full-reset-search)
    (up-set-group search-local c: RaidGroup)
    (up-set-target-by-id g: goal1)
    (up-target-point null-x action-default formation-box stand-ground)
    (up-target-objects 1 action-default formation-box stand-ground)
    (set-goal gl-raid-group-state FIRING)
    (set-goal SPLIT 0)
)

;>>>>>>>>>>> NA
(defrule
    (up-group-size c: RaidGroup < 1)
=>
    (up-jump-rule 4)
)

(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-group search-local c: RaidGroup)
    (up-clean-search search-local object-data-next-attack search-order-desc)
    (up-remove-objects search-local -1 > 0)
    (up-set-target-object search-local c: 0)
    (up-get-object-data object-data-next-attack gl-highest-next-attack)
)

(defrule
    (true)
=>
    (up-full-reset-search)
    (up-set-group search-local c: RaidGroup)
    (up-clean-search search-local object-data-next-attack search-order-asc)
    ;	(up-remove-objects search-local object-data-next-attack == 0)
    (up-remove-objects search-local -1 > 0)
    (up-set-target-object search-local c: 0)
    (up-get-object-data object-data-next-attack gl-lowest-next-attack)
    ;	(up-chat-data-to-player me "NA(%d)" g: gl-lowest-next-attack)
)

#load-if-defined DE-AVAILABLE
	(defconst arch-firing-threshold-1 700)
	(defconst arch-firing-threshold-2 1800)
#else	;UP
	(defconst arch-firing-threshold-1 650)
	(defconst arch-firing-threshold-2 1800)
#end-if

(defrule
    (up-compare-goal gl-raid-can-fire != YES)
    (up-compare-goal gl-highest-next-attack < arch-firing-threshold-1)
    (up-compare-goal goal2 g:<= gl-raid-group-range)
=>
    ;	(up-chat-data-to-player me "Time to fire(%d)" g: gl-highest-next-attack)
    (set-goal gl-raid-can-fire YES)
    (set-goal gl-raid-can-move NO)
)

(defrule	;na decreases after last attack
    (up-compare-goal gl-raid-can-move != YES)
    (or	(up-compare-goal goal2 g:> gl-raid-group-range)
    (and(up-compare-goal gl-lowest-next-attack >= arch-firing-threshold-1)
    (up-compare-goal gl-lowest-next-attack < arch-firing-threshold-2)))
=>
    ;	(up-chat-data-to-player me "Time to move(%d)" g: gl-lowest-next-attack)
    (set-goal gl-raid-can-move YES)
    (set-goal gl-raid-can-fire NO)
)

;@@@@@@@@@@@@@@ MINIRING
(defrule
    (up-group-size c: RaidGroup < 1)
=>
    (up-jump-rule 4)
)

(defrule
    (goal gl-raid-can-move YES)
    (up-compare-goal goal4 >= 1)
    (up-timer-status t-raid-retreat != timer-running)
    (or	(goal gl-fifth-turn 1)
    (up-compare-goal gl-raid-group-state != MINI-RETREAT))
=>
    (set-goal SPLIT 1)
)

(defrule 	;retreat toward home if not combined
    (goal SPLIT 1)
    (up-compare-goal gl-ranged-style != COMBINED)
=>
    (up-full-reset-search)
    (up-set-group search-local c: RaidGroup)
    (up-copy-point point-x raid-group-x)
    (up-lerp-tiles point-x enemy-x c: -5)
    (up-lerp-tiles point-x home-x c: 10)
    (up-lerp-tiles point-x raid-group-x c: -5)
)

(defrule 	;...otherwise retreat behind army
    (goal SPLIT 1)
    (up-compare-goal gl-ranged-style == COMBINED)
=>
    (up-full-reset-search)
    (up-set-group search-local c: RaidGroup)
    (up-copy-point point-x raid-group-x)	;point to move
    (up-copy-point point2-x ranged-group-x)	;target point
    (up-lerp-tiles point2-x enemy-x c: -8)	;lerp target behind ranged group
    (up-lerp-tiles point-x point2-x c: 3)
    (up-lerp-tiles point-x enemy-x c: -2)
    (up-lerp-tiles point-x home-x c: 1)
    ;	(up-send-flare point2-x)
)

(defrule
    (goal SPLIT 1)
    (up-point-contains point-x c: building-class)
=>
    (up-lerp-tiles point-x enemy-x c: -5)
)

(defrule
    (goal SPLIT 1)
=>
    (up-bound-point point-x point-x)
    (up-target-point null-x action-move formation-box no-attack)
    (up-target-point point-x action-move formation-box no-attack)
    ;	(up-chat-data-to-player me "RMiniR(%d)" g: goal4)
    (set-goal gl-raid-group-state MINI-RETREAT)
    ;	(up-send-flare point-x)
    (set-goal SPLIT 0)
)

;@@@@@@@@@@@@@@ TRACKING
(defrule
    (up-group-size c: RaidGroup < 1)
=>
    (up-jump-rule 1)
)

;>>>>>>>>>>> MOVE
(defrule
    (goal gl-raid-can-move YES)
    (up-compare-goal goal4 < 1)	;not miniring
    (up-compare-goal goal2 < 1000)
    (up-timer-status t-raid-retreat != timer-running)
    (or	(goal gl-fifth-turn 1)
    (up-compare-goal gl-raid-group-state != TRACKING))
=>
    ;	(chat-to-player me "RTracking")
    (up-full-reset-search)
    (up-set-group search-local c: RaidGroup)
    (up-copy-point point-x object-x)
    (up-lerp-tiles point-x raid-group-x c: -5) ;make sure the group moves
    (up-bound-point point-x point-x)
    (up-target-point null-x action-move formation-box no-attack)
    (up-target-point object-x action-move formation-box no-attack)
    (set-goal gl-raid-group-state TRACKING)
    ;	(up-send-flare object-x)
)

;@@@@@@@@@@@@@@ MARCHING
(defrule
    (up-group-size c: RaidGroup < 1)
=>
    (up-jump-rule 9)
)

(defrule
    (true)
=>
    (set-goal goal 0)
)

;>>>>>>>>>>> GET THE POINTS
(defrule	;move to target by default
    (true)
    ;	(goal gl-raid-status MOVING-TO-TARGET)
=>
    (up-copy-point point-x raid-group-x)
    (up-lerp-tiles point-x raid-target-x c: 15)
    (up-lerp-tiles point-x enemy-x c: -6)
    (up-lerp-tiles point-x raid-group-x c: -3)
)

(defrule
    (goal gl-raid-status MOVING-TO-WAYPOINT-1)
=>
    (up-copy-point point-x raid-group-x)
    (up-lerp-tiles point-x raid-waypoint1-x c: 15)
    (up-lerp-tiles point-x enemy-x c: -6)
    (up-lerp-tiles point-x raid-group-x c: -3)
)

(defrule
    (goal gl-raid-status MOVING-TO-WAYPOINT-2)
=>
    (up-copy-point point-x raid-group-x)
    (up-lerp-tiles point-x raid-waypoint2-x c: 15)
    (up-lerp-tiles point-x enemy-x c: -6)
    (up-lerp-tiles point-x raid-group-x c: -3)
)

(defrule	;just stay with army if combined
    (goal gl-ranged-style COMBINED)
=>
    (up-copy-point point-x raid-group-x)
    (up-lerp-tiles point-x ranged-group-x c: 10)
    (up-lerp-tiles point-x enemy-x c: -6)
    (up-lerp-tiles point-x raid-group-x c: -3)
)

(defrule
    (up-point-contains point-x c: tree-class)
=>
    (up-lerp-tiles point-x raid-group-x c: -5)
)

(defrule
    (up-point-distance raid-group-x point-x < 8)
=>
    (up-lerp-tiles point-x raid-group-x c: -3)
)

;>>>>>>>>>>> MOVE
(defrule
    (true)
    (false)
=>
    (up-chat-data-to-all "Goal1: %d" g: goal1)
)

(defrule
    (goal goal1 -1)	;no target
    (goal gl-raid-can-move YES)
    ;	(up-compare-goal goal4 < 1)	;not miniring
    (up-compare-goal gl-raid-status != -1)
    (up-timer-status t-raid-retreat != timer-running)
    (or	(goal gl-tenth-turn 1)
    (up-compare-goal gl-raid-group-state != MARCHING))
=>
    ;	(chat-to-all "RMarching")
    (up-full-reset-search)
    (up-set-group search-local c: RaidGroup)
    (up-lerp-tiles point-x ranged-group-x g: goal)
    (up-bound-point point-x point-x)
    (up-target-point null-x action-move formation-box no-attack)
    (up-target-point point-x action-move formation-box no-attack)
    (set-goal gl-raid-group-state MARCHING)
    ;	(up-send-flare point-x)
)

;@@@@@@@@@@@@@@ RETREATING
(defrule
    (or	(game-time < 10)
    (up-group-size c: RaidGroup < 1))
=>
    (up-jump-rule 44)
)

(defrule
    (true)
=>
    (set-goal goal 0)
    (set-goal goal1 0)
)

(defrule
    (timer-triggered t-raid-retreat)
=>
    ;	(chat-to-player me "Reset RaidRetreat")
    (set-goal gl-raid-retreat-type -1)
    (disable-timer t-raid-retreat)
)

;>>>>>>>>>>> ENEMY SIEGE
;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal rt 0)
    (up-set-target-point raid-group-x)
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 12)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-find-remote c: mangonel-line c: 10)
    (up-find-remote c: scorpion-line c: 10)
    (up-get-search-state lt)
)

;3. LOOP THE SEARCH
(defrule
    (up-compare-goal rt < 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule	;skirm-archer
    (up-compare-goal rt >= 1)
=>
    (set-goal gl-raid-retreat-type FROM-SIEGE)
    ;	(chat-to-player me "SiegeRetreat")
    (enable-timer t-raid-retreat 15)
    (set-goal SPLIT 0)
)

;>>>>>>>>>>> ENEMY UNITS
;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (up-set-target-point raid-group-x)
    (set-goal goal1 0)
    (set-goal goal 0)
    (set-goal rt 0)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 10)
    (up-find-remote c: skirmisher-line c: 10)
    (up-get-search-state lt)
    (up-modify-goal goal g:+ rt)
    (up-full-reset-search)
    (up-filter-distance c: -1 c: 10)
    (up-find-remote c: archer-line c: 10)
    (up-get-search-state lt)
    (up-modify-goal goal1 g:+ rt)
)

;3. LOOP THE SEARCH
(defrule
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

;======== IF XBOW
(defrule
    (true)
    ;	(not(research-completed ri-crossbow))
=>
    (up-jump-rule 4)
)

(defrule	;skirm-archer
    (or	(and(up-compare-goal goal >= 2)
    (up-compare-goal goal1 >= 2))
    (and(up-compare-goal goal >= 1)
    (and(up-compare-goal goal1 >= 1)
    (up-group-size c: RaidGroup < 7))))
=>
    (chat-to-player me "Xbow SkarcherRetreat 1")
    (set-goal SPLIT 1)
)

(defrule	;skirm-archer
    (up-compare-goal goal >= 2)
    (up-compare-goal goal1 >= 1)
    (up-group-size c: RaidGroup < 12)
=>
    (chat-to-player me "Xbow SkarcherRetreat 2")
    (set-goal SPLIT 1)
)

(defrule	;archers only
    (or	(up-compare-goal goal1 >= 4)
    (or	(and(up-compare-goal goal1 >= 1)
    (up-group-size c: RaidGroup < 5))
    (or	(and(up-compare-goal goal1 >= 2)
    (up-group-size c: RaidGroup < 7))
    (and(up-compare-goal goal1 >= 4)
    (up-group-size c: RaidGroup < 10)))))
=>
    (chat-to-player me "Xbow ArcherRetreat")
    (set-goal SPLIT 1)
)

(defrule	;skirms only
    (or	(up-compare-goal goal >= 4)
    (or	(and(up-compare-goal goal >= 1)
    (up-group-size c: RaidGroup < 5))
    (or	(and(up-compare-goal goal >= 2)
    (up-group-size c: RaidGroup < 8))
    (and(up-compare-goal goal >= 3)
    (up-group-size c: RaidGroup < 13)))))
=>
    (chat-to-player me "Xbow SkirmRetreat")
    (set-goal SPLIT 1)
)

;======== IF ARCHERS
(defrule
    (false)
    ;	(research-completed ri-crossbow)
=>
    (up-jump-rule 4)
)

(defrule	;skirm-archer
    (or	(and(up-compare-goal goal >= 2)
    (up-compare-goal goal1 >= 2))
    (and(up-compare-goal goal >= 1)
    (and(up-compare-goal goal1 >= 1)
    (up-group-size c: RaidGroup < 7))))
=>
    ;	(chat-to-player me "SkarcherRetreat 1")
    (set-goal SPLIT 1)
)

(defrule	;skirm-archer
    (up-compare-goal goal >= 2)
    (up-compare-goal goal1 >= 1)
    (up-group-size c: RaidGroup < 12)
=>
    ;	(chat-to-player me "SkarcherRetreat 2")
    (set-goal SPLIT 1)
)

(defrule	;archers only
    (or	(up-compare-goal goal1 >= 4)
    (or	(and(up-compare-goal goal1 >= 1)
    (up-group-size c: RaidGroup < 5))
    (or	(and(up-compare-goal goal1 >= 2)
    (up-group-size c: RaidGroup < 7))
    (and(up-compare-goal goal1 >= 4)
    (up-group-size c: RaidGroup < 10)))))
=>
    ;	(chat-to-player me "ArcherRetreat")
    (set-goal SPLIT 1)
)

(defrule	;skirms only
    (or	(up-compare-goal goal >= 4)
    (or	(and(up-compare-goal goal >= 1)
    (up-group-size c: RaidGroup < 5))
    (or	(and(up-compare-goal goal >= 2)
    (up-group-size c: RaidGroup < 8))
    (and(up-compare-goal goal >= 3)
    (up-group-size c: RaidGroup < 13)))))
=>
    ;	(chat-to-player me "SkirmRetreat")
    (set-goal SPLIT 1)
)

;======== SET TIMER
(defrule
    (goal SPLIT 1)
    (goal gl-raid-retreat-type -1)
    (up-compare-goal SUPERIORITY >= 15)
=>
    ;	(chat-to-player me "Enable RaidRetreat Timer Short")
    (set-goal gl-raid-retreat-type FROM-UNITS)
    (enable-timer t-raid-retreat 5)
    (set-goal SPLIT 0)
)

(defrule
    (goal SPLIT 1)
    (goal gl-raid-retreat-type -1)
    (up-compare-goal SUPERIORITY < 15)
=>
    ;	(chat-to-player me "Enable RaidRetreat Timer Long")
    (set-goal gl-raid-retreat-type FROM-UNITS)
    (enable-timer t-raid-retreat 15)
    (set-goal SPLIT 0)
)

;>>>>>>>>>>> FORTIFICATIONS
;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal rt 0)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point raid-group-x)
    (up-filter-distance c: -1 c: 10)
    (up-filter-status c: status-ready c: list-active)
    (up-find-status-remote c: town-center c: 2)
    (up-filter-distance c: -1 c: 7)
    (up-find-status-remote c: watch-tower c: 2)
    (up-filter-distance c: -1 c: 15)
    (up-find-status-remote c: castle c: 2)
    (up-clean-search search-remote 44 search-order-asc)
    (up-get-search-state lt)
    ;	(up-chat-data-to-player me "RT 2: %d" g: rt)
)

;3. LOOP THE SEARCH
(defrule
    (up-compare-goal rt < 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (up-compare-goal rt >= 1)
    (goal gl-raid-retreat-type -1)
=>
    ;	(chat-to-player me "Enable RaidRetreat Timer Fort")
    (set-goal gl-raid-retreat-type FROM-FORTIFICATIONS)
    (enable-timer t-raid-retreat 5)
)

;>>>>>>>>>>> MOVE
;======== DETERMINE MOVING
(defrule
    (true)
=>
    (set-goal goal 0)	;army-x
    (set-goal goal1 0)	;nearest-fort-x
    (set-goal goal2 0)	;target
    (set-goal goal3 0)	;home
    (set-goal goal5 0)	;enemy group(goal4 melee)
)

(defrule
    (goal gl-raid-retreat-type FROM-SIEGE)
=>
    (set-goal goal1 -3)
    (set-goal goal3 7)	;go home
)

(defrule
    (up-compare-goal gl-enemy-group-size > 0)
=>
    (set-goal goal5 -5)	;away from units
)

(defrule
    (up-point-distance raid-group-x raid-nearest-fort-x < 15)
=>
    (set-goal goal1 -5)	;away from fort
)

(defrule
    (goal gl-ranged-style COMBINED)
    (goal gl-raid-retreat-type FROM-UNITS)
=>
    (set-goal goal 8)	;move toward army
    (set-goal goal1 0)
    (set-goal goal2 0)
    (set-goal goal3 2)	;home a little
)

(defrule
    (goal gl-ranged-style SEPARATE)
    (goal gl-raid-retreat-type FROM-UNITS)
=>
    (set-goal goal -2)	;move away from army
    (set-goal goal1 -2)
    (set-goal goal2 0)
    (set-goal goal3 10)	;toward home
)

(defrule
    (goal gl-ranged-style SEPARATE)
    (goal gl-raid-retreat-type FROM-FORTIFICATIONS)
=>
    (set-goal goal1 -9)	;away from fort
    (set-goal goal2 6)	;mdove toward target
)

(defrule
    (goal gl-ranged-style COMBINED)
    (goal gl-raid-retreat-type FROM-FORTIFICATIONS)
=>
    (set-goal goal 5)	;toward army
    (set-goal goal1 -9)	;away from fort
)

(defrule
    (goal gl-ranged-style -1)
    (goal gl-raid-retreat-type FROM-FORTIFICATIONS)
=>
    (set-goal goal 0)	;toward army
    (set-goal goal1 -9)	;away from fort
    (set-goal goal2 6)	;move toward target
)

(defrule
    (up-group-size c: RangedGroup < 1)
=>
    (set-goal goal 0)
)

;======== START THE MOVE-RULE(SPLIT)
(defrule
    (or	(goal gl-raid-can-fire NO)
    (up-compare-goal goal4 < 1))
    (up-timer-status t-raid-retreat == timer-running)
    (or	(goal gl-tenth-turn 1)
    (up-compare-goal gl-raid-group-state != RETREATING))
=>
    (up-full-reset-search)
    (up-copy-point point-x raid-group-x)
    ;	(chat-to-player me "Yes2")
    (set-goal SPLIT 1)
)

;----- DETERMINE BEHIND-ARMY POINT
(defrule
    (goal SPLIT 1)
    (goal gl-raid-retreat-type FROM-UNITS)
    (up-compare-goal gl-enemy-group-size > 0)
=>
    ;	(chat-to-player me "Away from enemy-group-x")
    (up-copy-point point2-x ranged-group-x)
    (up-lerp-tiles point2-x enemy-group-x c: -6)
)

(defrule
    (goal SPLIT 1)
    (or	(up-compare-goal gl-enemy-group-size < 1)
    (up-compare-goal gl-raid-retreat-type != FROM-UNITS))
=>
    ;	(chat-to-player me "Away from enemy-x")
    (up-copy-point point2-x ranged-group-x)
    (up-lerp-tiles point2-x enemy-x c: -6)
)

;----- LERP STUFF
(defrule
    (goal SPLIT 1)
=>
    (up-lerp-tiles point-x enemy-group-x g: goal5)
    (up-lerp-tiles point-x raid-nearest-fort-x g: goal1)
    (up-lerp-tiles point-x raid-target-x g: goal2)
    (up-lerp-tiles point-x point2-x g: goal)	;retreating to ranged-group
    (up-lerp-tiles point-x home-x g: goal3)
)

;----- MISC STUFF
(defrule
    (goal SPLIT 1)
    (up-point-contains point-x c: tree-class)
=>
    (up-lerp-tiles point-x raid-group-x c: -10)
)

(defrule	;retreat if raiders die
    (goal gl-raid-retreat-type -1)
    (up-group-size c: RaidGroup < 3)
    (up-point-distance home-x raid-group-x >= 4)
    (or	(goal gl-tenth-turn 1)
    (up-compare-goal gl-raid-group-state != RETREATING))
=>
    (set-goal gl-raid-retreat-type HOME-RETREAT)
    (enable-timer t-raid-retreat 10)
    (up-copy-point point-x home-x)
    ;	(chat-to-player me "GoHome")
    (set-goal SPLIT 1)
)

;----- FINISH THE COMMAND
(defrule
    (goal SPLIT 1)
    (goal gl-raid-retreat-type HOME-RETREAT)
    (or	(goal gl-tenth-turn 1)
    (up-compare-goal gl-raid-group-state != RETREATING))
=>
    ;	(up-chat-data-to-player me "Home RaidRetreat(%d)" g: gl-ranged-style)
    (up-full-reset-search)
    (up-set-group search-local c: RaidGroup)
    (up-lerp-tiles point-x raid-group-x c: -5)
    (up-bound-point point-x point-x)
    (up-target-point null-x action-move formation-box no-attack)
    (up-target-point point-x action-move formation-box no-attack)
    (set-goal gl-raid-group-state RETREATING)
    ;	(up-send-flare point-x)
    (set-goal SPLIT 0)
)

(defrule
    (goal SPLIT 1)
    (or	(goal gl-raid-retreat-type FROM-UNITS)
    (goal gl-raid-retreat-type FROM-SIEGE))
    (or	(goal gl-tenth-turn 1)
    (up-compare-goal gl-raid-group-state != RETREATING))
=>
    ;	(up-chat-data-to-player me "Siege/Units RaidRetreat(%d)" g: gl-ranged-style)
    (up-full-reset-search)
    (up-set-group search-local c: RaidGroup)
    (up-lerp-tiles point-x raid-group-x c: -5)
    (up-bound-point point-x point-x)
    (up-target-point null-x action-move formation-box no-attack)
    (up-target-point point-x action-move formation-box no-attack)
    (set-goal gl-raid-group-state RETREATING)
    ;	(up-send-flare point-x)
    (set-goal SPLIT 0)
)

(defrule
    (goal SPLIT 1)
    (goal gl-raid-retreat-type FROM-FORTIFICATIONS)
    (or	(goal gl-tenth-turn 1)
    (up-compare-goal gl-raid-group-state != RETREATING))
=>
    ;	(up-chat-data-to-player me "Fort RaidRetreat(%d)" g: gl-ranged-style)
    (up-full-reset-search)
    (up-set-group search-local c: RaidGroup)
    (up-lerp-tiles point-x raid-group-x c: -5)
    (up-bound-point point-x point-x)
    (up-target-point null-x action-move formation-box no-attack)
    (up-target-point point-x action-move formation-box no-attack)
    (set-goal gl-raid-group-state RETREATING)
    ;	(up-send-flare point-x)
    (set-goal SPLIT 0)
)

;WWWWWWWWWWWWWWWWWW Find raid group center of gravity - By KnightPanda
(defrule
    (true)
=>
    (up-full-reset-search)
    (up-find-local c: skirmisher-line c: 60)
    (up-find-local c: archer-line c: 40)
    (up-remove-objects search-local object-data-group-flag != RaidGroup)
    (up-get-search-state lt)
    (set-goal goal 0)
    (set-goal point-x 0)
    (set-goal point-y 0)
    (set-goal lt 0)
)

(defrule
    (up-set-target-object search-local c: 0)
=>
    (up-get-object-data object-data-point-x point2-x) ;coordinate * 100
    (up-get-object-data object-data-point-y point2-y)
    (up-modify-goal point-x g:+ point2-x)
    (up-modify-goal point-y g:+ point2-y)
    (up-get-search-state lt)
    (up-modify-goal goal c:+ 1) ;number of points checked
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal lt > 0)
=>
    (up-remove-objects search-local -1 == 0)
    (up-get-search-state lt)
    (up-jump-rule -2)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal goal > 0)
=>
    (up-modify-goal point-x g:/ goal)
    (up-modify-goal point-y g:/ goal)
    (up-copy-point raid-group-x point-x) ;local group center of gravity
)

(defrule
    (goal SPLIT 1)
=>
    (set-goal SPLIT 0)
)

;WWWWWWWWWWWWWWWWWW OLD
(defrule
    (true)
=>
    (enable-timer t-raid-target-reset 1)
    (disable-self)
)

;@@@@@@@@@@@@@@ CHOOSE TARGET/WAYPOINT
;>>>>>>>>>>> FIND THE CAMPS
(defrule
    (game-time > 5)
    (goal gl-raid-status -1)
    (up-group-size c: RaidGroup >= 3)
=>
    ;	(chat-to-player me "New Group--Choose Initial Points")
    (set-goal gl-raid-status CHOOSING-TARGET)
)

(defrule	;set the target-point
    (goal gl-raid-status CHOOSING-TARGET)
=>
    (up-full-reset-search)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
    (goal gl-ranged-style SEPARATE)
=>
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: 12 c: -1)
)

(defrule
    (goal SPLIT 1)
=>
    (up-modify-sn sn-focus-player-number s:= sn-target-player-number)
    (up-find-remote c: lumber-camp c: 5)
    (up-find-remote c: mining-camp c: 5)
    (up-find-remote c: mill c: 5)
    (up-get-search-state lt)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal rt >= 2)
=>
    (up-remove-objects search-remote object-data-id g:== gl-raid-target-id)
    ;	(chat-to-player me "Remove raid target")
    (up-get-search-state lt)
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal rt >= 2)
=>
    (up-remove-objects search-remote object-data-id g:== gl-old-raid-target-id)
    ;	(chat-to-player me "Remove old raid target")
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal rt >= 2)
=>
    (up-remove-objects search-remote object-data-id g:== gl-ancient-raid-target-id)
    ;	(chat-to-player me "Remove ancient raid target")	;term "ancient" from Barbie
)

(defrule
    (goal SPLIT 1)
    (up-compare-goal rt >= 1)
=>
    (up-set-target-point raid-group-x)
    (up-clean-search search-remote 44 search-order-asc)
    (up-set-target-object search-remote c: 0)
    (up-modify-goal gl-ancient-raid-target-id g:= gl-old-raid-target-id)
    (up-modify-goal gl-old-raid-target-id g:= gl-raid-target-id)
    (up-get-object-data object-data-id gl-raid-target-id)
    (up-get-point position-object point-x)
    ;	(chat-to-player me "Choosing Camp")
    (enable-timer t-raid-target-reset 220)
    (set-goal SPLIT 0)
)

(defrule	;if no camps found
    (goal SPLIT 1)
    (up-compare-goal rt < 1)
=>
    (enable-timer t-raid-target-reset 30)
    (up-copy-point point-x enemy-x)
    ;	(chat-to-player me "No Camps")
    (set-goal SPLIT 0)
)

;>>>>>>>>>>> TARGET-X
(defrule
    (goal gl-raid-status CHOOSING-TARGET)
=>
    ;	(chat-to-player me "Target Chosen--Choose Waypoint 1")
    (set-goal gl-raid-status CHOOSING-WAYPOINT-1)
    (enable-timer t-raid-waypoint-reevaluate 40)
    (up-copy-point raid-target-x point-x)
    ;	(up-send-flare raid-target-x)
)

(defrule
    (up-compare-goal gl-raid-status != -1)
    (up-timer-status t-raid-waypoint-reevaluate != timer-running)
=>
    (set-goal gl-raid-status CHOOSING-WAYPOINT-1)
    (enable-timer t-raid-waypoint-reevaluate 35)
    ;	(chat-to-player me "Reevaluate Waypoints")
    ;	(up-send-flare raid-target-x)
)

;>>>>>>>>>>> WAYPOINT-1
(defrule
    (goal gl-raid-status CHOOSING-WAYPOINT-1)
    (up-point-distance raid-group-x raid-target-x < 25)
=>
    ;	(chat-to-player me "No Waypoints Needed--March To Target")
    (set-goal gl-raid-status MOVING-TO-TARGET)
)

(defrule
    (goal gl-raid-status CHOOSING-WAYPOINT-1)
    (up-point-distance raid-group-x raid-target-x >= 25)
=>
    ;	(chat-to-player me "Waypoint-1 Chosen--Choose Waypoint-2")
    (set-goal gl-raid-status CHOOSING-WAYPOINT-2)
    (up-copy-point raid-waypoint1-x raid-target-x)
    (up-lerp-tiles raid-waypoint1-x enemy-x c: -8)
    (up-lerp-tiles raid-waypoint1-x raid-group-x c: 5)
    (up-lerp-tiles raid-waypoint1-x enemy-x c: -7)
    (up-lerp-tiles raid-waypoint1-x raid-group-x c: 5)
    (up-bound-point raid-waypoint1-x raid-waypoint1-x)
    ;	(up-send-flare raid-waypoint1-x)
)

(defrule
    (goal gl-raid-status MOVING-TO-WAYPOINT-1)
    (up-point-distance raid-group-x raid-waypoint1-x < 4)
=>
    ;	(chat-to-player me "Waypoint Reached--March to Target")
    (set-goal gl-raid-status MOVING-TO-TARGET)
)

;>>>>>>>>>>> WAYPOINT-2
(defrule
    (goal gl-raid-status CHOOSING-WAYPOINT-2)
    (up-point-distance raid-group-x raid-target-x < 45)
=>
    ;	(chat-to-player me "No Waypoint-2 Needed--Move To Waypoint-1")
    (set-goal gl-raid-status MOVING-TO-WAYPOINT-1)
)

(defrule
    (goal gl-raid-status CHOOSING-WAYPOINT-2)
    (up-point-distance raid-group-x raid-target-x >= 45)
=>
    ;	(chat-to-player me "Waypoint-2 Chosen--Move To Waypoint-2")
    (set-goal gl-raid-status MOVING-TO-WAYPOINT-2)
    (up-copy-point raid-waypoint2-x raid-waypoint1-x)
    (up-lerp-tiles raid-waypoint2-x raid-group-x c: 5)
    (up-lerp-tiles raid-waypoint2-x enemy-x c: -5)
    (up-lerp-tiles raid-waypoint2-x raid-group-x c: 5)
    (up-lerp-tiles raid-waypoint2-x enemy-x c: -5)
    (up-bound-point raid-waypoint2-x raid-waypoint2-x)
    ;	(up-send-flare raid-waypoint2-x)
)

(defrule
    (goal gl-raid-status MOVING-TO-WAYPOINT-2)
    (up-point-distance raid-group-x raid-waypoint2-x < 4)
=>
    ;	(chat-to-player me "Waypoint-2 Reached--March to Waypoint-1")
    (set-goal gl-raid-status MOVING-TO-TARGET)
)

(defrule
    (false)
    (goal gl-twenty-turn 1)
    (goal gl-raid-status MOVING-TO-WAYPOINT-2)
=>
    (up-send-flare raid-waypoint2-x)
)

;@@@@@@@@@@@@@@ CHOOSE NEW TARGET
(defrule
    (goal gl-raid-status MOVING-TO-TARGET)
=>
    (up-full-reset-search)
    (up-set-target-point raid-target-x)
    (up-filter-distance c: -1 c: 10)
    (up-find-remote c: watch-tower c: 1)
    (up-get-search-state lt)
)

(defrule
    (up-compare-goal rt >= 1)
    (goal gl-raid-status MOVING-TO-TARGET)
    (up-point-distance raid-group-x raid-target-x < 10)
=>
    ;	(chat-to-player me "Tower--Choose New Target")
    (set-goal gl-raid-status CHOOSING-TARGET)
    (disable-timer t-raid-target-reset)
)

(defrule
    (goal gl-tenth-turn 1)
    (goal gl-raid-status MOVING-TO-TARGET)
    (or	(timer-triggered t-raid-target-reset)
    (up-point-distance raid-group-x raid-target-x < 4))
=>
    ;	(chat-to-player me "Target Reached or Reset Timer--Choose New Target")
    (set-goal gl-raid-status CHOOSING-TARGET)
    (disable-timer t-raid-target-reset)
)

(defrule
    (taunt-detected me 21)
=>
    (up-send-flare raid-target-x)
    (acknowledge-taunt me 21)
)

;@@@@@@@@@@@@@@ RESET IF GROUP DIES
(defrule
    (false)
    (up-group-size c: RaidGroup < 3)
    (up-compare-goal gl-raid-status != -1)
=>
    (chat-to-player me "RAIDERS DIED--RESET")
    (up-modify-group-flag 0 c: RaidGroup)
    (up-reset-group c: RaidGroup)
    (up-full-reset-search)
    (up-find-local c: archer-line c: 40)
    (up-target-point home-x action-move formation-stagger no-attack)
    (set-goal gl-raid-status -1)
    (disable-timer t-raid-target-reset)
)

(defrule	;debug
    (taunt-detected me 98)
    (goal gl-tenth-turn 1)
=>
    (up-chat-data-to-player me "Raid group state: %d" g: gl-raid-group-state)
    (up-chat-data-to-player me "Raid status: %d" g: gl-raid-status)
    (up-chat-data-to-player me "Raid style: %d" g: gl-ranged-style)
)

(defrule	;debug
    (taunt-detected me 98)
    (goal gl-thirty-turn 1)
=>
    (up-send-flare raid-waypoint2-x)
    (up-send-flare raid-waypoint1-x)
    (up-send-flare raid-group-x)
)

(defrule
    (taunt-detected me 99)
=>
    (acknowledge-taunt me 98)
    (acknowledge-taunt me 99)
)

(defrule
    (up-group-size c: RaidGroup < 1)
=>
    (up-jump-rule 1)
)

(defrule	;add new units to group
    (goal gl-second-turn 1)
=>
    ;	(chat-to-player me "Refresh Raid Group")
    (up-modify-group-flag 0 c: RaidGroup)
    (up-reset-group c: RaidGroup)
    (up-full-reset-search)
    (up-set-target-point raid-group-x)
    (up-filter-distance c: -1 c: 5)
    (up-find-local c: archer-line c: 40)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    ;	(up-remove-objects search-local object-data-group-flag == RaidGroup)
    ;	(up-remove-objects search-local object-data-status != 2)
    (up-create-group 0 0 c: RaidGroup)
    (up-modify-group-flag 1 c: RaidGroup)
    (up-get-group-size c: RaidGroup gl-raid-group-size)
    (set-goal SPLIT 0)
)

(defrule
    (goal SPLIT 1)
=>
    (chat-to-player me "Leak 3")
    (set-goal SPLIT 0)
)

;###################### QRANGED MICRO
;WWWWWWWWWWWWWWWWWW DEFENDING HOME
(defrule
    (goal gl-town-safe NO)
    (goal gl-defend-town NO)
    (up-group-size c: RangedGroup > 0)
    (up-compare-goal SUPERIORITY >= 5)	;retreat if you will be able to defend
    (up-compare-goal gl-attack-efficiency < -7)	;only if attacking won't yield as much
    (up-point-distance ranged-group-x home-x >= 35)
=>
    (chat-to-player me "Defend The Homeland!")
    (set-goal gl-defend-town YES)
)

(defrule
    ;	(goal gl-town-safe YES)
    (goal gl-defend-town YES)
    (up-group-size c: RangedGroup > 0)
    (up-point-distance ranged-group-x home-x < 15)
=>
    (chat-to-player me "Resume Attacking!")
    (set-goal gl-defend-town NO)
)

;WWWWWWWWWWWWWWWWWW Find remote group center of gravity - By KnightPanda
(defrule
    (up-group-size c: RangedGroup < 1)
=>
    (up-jump-rule 4)
)

