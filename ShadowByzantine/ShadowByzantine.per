    (false)
    (goal SIEGE 3)
    (can-train-with-escrow mangonel-line)
=>
    (up-train gl-escrow-state c: mangonel-line)
    (chat-to-player me "Mangonel")
)

(defrule
    (false)
    (goal SIEGE 3)
    (unit-type-count-total mangonel-line >= 2)
=>
    (chat-to-player me "NO MORE MANGOS")
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (release-escrow wood)
    (release-escrow gold)
    (set-goal SIEGE -1)
)

(defrule
    (false)
    (goal SIEGE 3)
    (up-pending-objects c: mangonel-line < 1)
    (up-pending-objects c: battering-ram-line < 1)
=>
    (up-modify-escrow wood c:max 160)
    (up-modify-escrow gold c:max 135)
)

(defrule	;don't die to eagles/knights
    (players-unit-type-count target-player archer-line < 10)
    (players-unit-type-count target-player skirmisher-line < 10)
    (or	(players-unit-type-count target-player knight-line >= 3)
    (players-unit-type-count target-player eagle-warrior-line >= 4))
=>
    (up-jump-rule 1)
)

(defrule
    (false)
    (goal SIEGE -1)
    (current-age >= castle-age)
    (building-type-count siege-workshop > 0)
    (up-pending-objects c: mangonel-line < 2)
    (unit-type-count-total mangonel-line < 2)
    (or	(unit-type-count-total battering-ram-line >= 4)
    (players-building-type-count target-player castle < 1))
    (or	(players-unit-type-count target-player archer-line >= 4)
    (or	(players-unit-type-count target-player cavalry-archer-line >= 4)
    (players-unit-type-count target-player skirmisher-line >= 4)))
=>
    ;	(chat-to-player me "NEED SOME MANGOS!")
