;@@@@@@@@@@@@@@ KRUSH
(defrule
    (food-amount >= 175)
    (gold-amount >= 175)
    (goal gl-strategy KRUSH)
    (goal gl-progression-pause -1)
    (can-build-with-escrow stable)
    (up-pending-objects c: stable < 1)
    (not(up-pending-placement c: stable))
    (goal gl-current-build-item EXTRA-STABLES)
=>
    (up-set-placement-data me -1 g: goal)
    (set-strategic-number sn-placement-zone-size 3)
    (up-build place-control gl-escrow-state c: stable)
    ;	(up-chat-data-to-player me "Krush ExtraStable(%d)" g: goal)
)

(defrule	;come back if skipped
    (goal gl-strategy KRUSH)
    (building-type-count-total stable < 4)
    (up-compare-goal gl-build-progress > KrushExtraStablesNumber)
=>
    (set-goal gl-build-progress KrushExtraStablesNumber)
)

(defrule
    (goal gl-strategy KRUSH)
    (up-compare-goal gl-current-build-item != EXTRA-STABLES)
    (up-compare-goal gl-build-progress == KrushExtraStablesNumber)
=>
    ;	(chat-to-player me "Krush Setting current build item to EXTRA-STABLES")
    (set-goal gl-current-build-item EXTRA-STABLES)
)

(defrule
    (goal gl-strategy KRUSH)
    (up-compare-goal gl-current-build-item == EXTRA-STABLES)
=>
    (set-escrow-percentage wood LOW-ESCROW)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    (release-escrow food)
