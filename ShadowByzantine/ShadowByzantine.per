(defrule
    (true)
    (false)
=>
    ;	(chat-to-player me "Go Inside 1")
    (set-goal gl-inside-forest 1)
    (disable-self)
)

(defrule
    (false)
    (goal gl-inside-forest 1)
=>
    (chat-to-player me "Don't Go Inside 1")
    (set-goal gl-inside-forest -1)
)

