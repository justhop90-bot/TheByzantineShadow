=>
    (up-copy-point point-x home-x)
    (up-lerp-tiles point-x center-x c: -5)
)

(defrule
    (goal SPLIT 1)
=>
    (chat-to-player me "Leak Fire")
    (set-goal SPLIT 0)
)

(defrule	;attack group target normally
    ;	(false)
    (goal gl-can-fire YES)
    ;	(up-group-size c: RangedGroup < 23)
    (up-compare-goal gl-ranged-group-state != FIRING)
    (up-timer-status t-ranged-retreat != timer-running)
=>
    (set-goal SPLIT 1)
)

#load-if-defined DE-AVAILABLE

(defrule
    (goal SPLIT 1)
=>
    ;	(up-chat-data-to-player me "DE Fire(%d)" g: gl-target-hp)
    (up-full-reset-search)
    (up-set-group search-local c: RangedGroup)
    (up-set-target-by-id g: target-id)
    (up-target-point null-x action-move formation-line no-attack)
    (up-target-objects 1 action-default formation-line no-attack)
    (set-goal gl-ranged-group-state FIRING)
    (set-goal SPLIT 0)
    (enable-timer t-failsafe failsafe-delay)
)

#else

(defrule
    (goal SPLIT 1)
=>
    ;	(up-chat-data-to-player me "UP Fire(%d)" g: gl-target-hp)
    (up-full-reset-search)
    (up-set-group search-local c: RangedGroup)
    (up-set-target-by-id g: target-id)
    (up-target-point null-x action-move formation-line stand-ground)
    (up-target-objects 1 action-default formation-line stand-ground)
    (set-goal gl-ranged-group-state FIRING)
    (set-goal SPLIT 0)
    (enable-timer t-failsafe failsafe-delay)
)
#end-if

(defrule
    (false)
    (goal gl-can-fire YES)
    (up-group-size c: RangedGroup >= 23)
    (up-compare-goal gl-ranged-group-state != FIRING)
    (up-timer-status t-ranged-retreat != timer-running)
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (up-get-object-data object-data-hitpoints goal)
    ;	(up-chat-data-to-player me "StopFire(%d)" g: goal)
    (up-full-reset-search)
    (up-set-group search-local c: RangedGroup)
    (up-set-target-by-id g: target-id)
    (up-target-point null-x action-stop formation-line stand-ground)
    (up-target-point home-x action-stop formation-line stand-ground)
    (set-goal gl-ranged-group-state FIRING)
    (enable-timer t-failsafe failsafe-delay)
    (set-goal SPLIT 0)
)

