    (true)
=>
    ;From Horde
    (set-strategic-number sn-build-frequency 1);try to build somewhere else when interrupted, 	sometimes it helps when AI tries to build next to enemy
    (set-strategic-number sn-number-build-attempts-before-skip 5)
    (set-strategic-number sn-max-skips-per-attempt 5)
    (set-strategic-number sn-minimum-dropsite-buffer 1)
    (set-strategic-number sn-maximum-food-drop-distance 3)
    (set-strategic-number sn-food-dropsite-distance 4)
    (set-strategic-number sn-maximum-hunt-drop-distance 5)
    (set-strategic-number sn-enable-boar-hunting 1)
    (set-strategic-number sn-mill-max-distance MAX-MILL-DISTANCE)
    (set-strategic-number sn-maximum-fish-boat-drop-distance 30)
    (disable-self)
)

(defrule
    (game-time > 30)
=>
    (set-strategic-number sn-food-dropsite-distance 4)
    (set-strategic-number sn-maximum-food-drop-distance 5)
    (disable-self)
)

(defrule
    (building-type-count farm > 7)
=>
    (set-strategic-number sn-food-dropsite-distance 6)
    (set-strategic-number sn-maximum-food-drop-distance 14)
    (disable-self)
)

;@@@@@@@@@@@@@@@ HUNTING
(defrule
    (game-time > 4000)
=>
    (set-strategic-number sn-maximum-hunt-drop-distance 5)
    (chat-to-player me "No more hunting")
    (disable-self)
)

(defrule
    (true)
=>
    (set-strategic-number sn-maximum-stone-drop-distance MAX-STONE-DISTANCE)
    (set-strategic-number sn-maximum-gold-drop-distance MAX-GOLD-DISTANCE)
    (set-strategic-number sn-stone-dropsite-distance MAX-STONE-DISTANCE)
    (set-strategic-number sn-gold-dropsite-distance MAX-GOLD-DISTANCE)
    (set-strategic-number sn-minimum-boar-hunt-group-size 0)
    (set-strategic-number sn-cap-civilian-builders 200)
    (set-strategic-number sn-required-forest-tiles 15)
    (set-strategic-number sn-retask-gather-amount 0)
    (set-strategic-number sn-maximum-wood-drop-distance 0)
    (set-strategic-number sn-wood-dropsite-distance 0)
    (disable-self)
)

(defrule
    (game-time > 500)
=>
    (set-strategic-number sn-maximum-wood-drop-distance 5)
    (set-strategic-number sn-wood-dropsite-distance 3)
    (disable-self)
)

(defrule
    (current-age == feudal-age)
    (strategic-number sn-stone-gatherer-percentage != 0)
=>
    (set-strategic-number sn-maximum-stone-drop-distance MAX-MAX-STONE-DISTANCE)
    (set-strategic-number sn-dropsite-separation-distance 3)
    (disable-self)
)

(defrule
    (current-age-time > 200)
    (current-age == feudal-age)
    (strategic-number sn-stone-gatherer-percentage == 0)
    (strategic-number sn-maximum-stone-drop-distance != MAX-STONE-DISTANCE)
=>
    (set-strategic-number sn-maximum-stone-drop-distance MAX-STONE-DISTANCE)
    (disable-self)
)

;###################### QBECO
(defrule
    (goal gl-strategy KRUSH)
    (current-age < castle-age)
=>
    (up-jump-rule 15)
)

(defrule
    (or	(current-age-time < 120)
    (and(up-compare-goal gl-town-safe != YES)
    (and(up-compare-goal gl-threat-time < 10000)
    (up-compare-goal gl-threat-target == villager-class))))
=>
    (up-jump-rule 14)
)

(defrule
    (or	(current-age < feudal-age)
    (up-timer-status BECO-TIMER == timer-running))
=>
    (up-jump-rule 13)
)

(defrule
    (true)
=>
    (set-goal SPLIT 0)
)

;WWWWWWWWWWWWWWWWWW DEBUG
(defrule
    (false)
    (goal gl-fifty-turn 1)
    (or	(up-compare-goal NET-WOOD-AMOUNT > 200)
    (or	(up-compare-goal NET-FOOD-AMOUNT > 200)
    (or	(up-compare-goal NET-GOLD-AMOUNT > 200)
    (up-compare-goal NET-STONE-AMOUNT > 200))))
=>
    (chat-to-player me "Need beco?")
)

;WWWWWWWWWWWWWWWWWW ADD WOOD
(defrule
    (goal SPLIT 0)
    (up-compare-goal gl-strategy != KRUSH)
    (up-compare-goal NET-WOOD-AMOUNT < 100)
    (up-compare-goal NET-FOOD-AMOUNT >= 250)
=>
    (chat-to-player me "ECO ADJUST--W+ F- Small")
    (up-modify-sn sn-food-gatherer-percentage c:- 5)
    (up-modify-sn sn-wood-gatherer-percentage c:+ 5)
    (enable-timer BECO-TIMER TIME1)
    (set-goal SPLIT 1)
    ;	(up-jump-rule 10)
)

(defrule
    (goal SPLIT 0)
    (up-compare-goal gl-strategy != KRUSH)
    (up-compare-goal NET-WOOD-AMOUNT < 150)
    (up-compare-goal NET-FOOD-AMOUNT >= 400)
=>
    (chat-to-player me "ECO ADJUST--W+ F- Medium")
    (up-modify-sn sn-food-gatherer-percentage c:- 5)
    (up-modify-sn sn-wood-gatherer-percentage c:+ 5)
    (enable-timer BECO-TIMER TIME1)
    (set-goal SPLIT 1)
    ;	(up-jump-rule 9)
)

(defrule
    (goal SPLIT 0)
    (up-compare-goal gl-strategy != KRUSH)
    (up-compare-goal NET-WOOD-AMOUNT < 300)
    (up-compare-goal NET-FOOD-AMOUNT >= 800)
=>
    (chat-to-player me "ECO ADJUST--W+ F- BIG")
    ;	(up-jump-rule 8)
    (up-modify-sn sn-food-gatherer-percentage c:- 5)
    (up-modify-sn sn-wood-gatherer-percentage c:+ 5)
    (enable-timer BECO-TIMER TIME1)
    (set-goal SPLIT 1)
)

;WWWWWWWWWWWWWWWWWW ADD FOOD
(defrule
    (goal SPLIT 0)
    (gold-amount > 200)
    (food-amount < 600)
    (or	(research-available castle-age)
    (goal gl-current-build-item CUP))
    (up-compare-sn sn-gold-gatherer-percentage >= 3)
=>
    ;	(chat-to-player me "CUP ECO ADJUST--F+ G-")
    ;	(up-jump-rule 7)
    (up-modify-sn sn-food-gatherer-percentage c:+ 3)
    (up-modify-sn sn-gold-gatherer-percentage c:- 3)
    (enable-timer BECO-TIMER TIME1)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 0)
    (up-compare-goal NET-FOOD-AMOUNT < 100)
    (up-compare-goal NET-GOLD-AMOUNT >= 300)
    (up-compare-sn sn-gold-gatherer-percentage >= 2)
=>
    (chat-to-player me "ECO ADJUST--F+ G-")
    (up-modify-sn sn-food-gatherer-percentage c:+ 5)
    (up-modify-sn sn-gold-gatherer-percentage c:- 4)
    ;	(up-jump-rule 6)
    (up-modify-sn sn-wood-gatherer-percentage c:- 1)
    (enable-timer BECO-TIMER TIME1)
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 0)
    (up-compare-goal NET-FOOD-AMOUNT < 100)
    (up-compare-goal NET-WOOD-AMOUNT >= 300)
    (up-compare-sn sn-wood-gatherer-percentage >= 4)
=>
    (chat-to-player me "ECO ADJUST--F+ W-")
    (up-modify-sn sn-food-gatherer-percentage c:+ 4)
    (up-modify-sn sn-wood-gatherer-percentage c:- 4)
    (enable-timer BECO-TIMER TIME1)
    (set-goal SPLIT 1)
    ;	(up-jump-rule 5)
)

;WWWWWWWWWWWWWWWWWW ADD GOLD
(defrule
    (false)
    (goal SPLIT 0)
    (goal gl-current-build-item CUP)
    (unit-type-count villager-gold < 1)
    (up-compare-sn sn-gold-gatherer-percentage < 2)
=>
    (up-modify-sn sn-gold-gatherer-percentage c:+ 3)
    (up-modify-sn sn-wood-gatherer-percentage c:- 2)
    (up-modify-sn sn-food-gatherer-percentage c:- 1)
    (chat-to-player me "Add More Goldies")
    (enable-timer BECO-TIMER TIME1)
    (set-goal SPLIT 1)
    ;	(up-jump-rule 4)
)

(defrule
    (goal SPLIT 0)
    (or	(and(gold-amount < 100)
    (food-amount >= 500))
    (and(gold-amount < 160)
    (food-amount >= 700)))
    (research-available castle-age)
    (goal gl-current-build-item CUP)
=>
    (set-goal SPLIT 2)
)

(defrule
    (goal SPLIT 2)
=>
    ;	(chat-to-player me "CUP ECO ADJUST--G+ F-")
    (up-modify-sn sn-gold-gatherer-percentage c:+ 5)
    (up-modify-sn sn-food-gatherer-percentage c:- 4)
    (up-modify-sn sn-wood-gatherer-percentage c:- 1)
    (enable-timer BECO-TIMER TIME1)
    (set-goal SPLIT 1)
    ;	(up-jump-rule 2)
    (disable-self)
)

(defrule
    (goal SPLIT 0)
    (game-time < 2400)	;40min
    (current-age >= castle-age)
    (up-compare-goal NET-GOLD-AMOUNT < 150)
    (up-compare-goal NET-WOOD-AMOUNT >= 350)
    (up-compare-sn sn-wood-gatherer-percentage >= 4)
=>
    (chat-to-player me "ECO ADJUST--G+ W-")
    (up-modify-sn sn-gold-gatherer-percentage c:+ 5)
    (up-modify-sn sn-wood-gatherer-percentage c:- 4)
    (up-modify-sn sn-food-gatherer-percentage c:- 1)
    (enable-timer BECO-TIMER TIME1)
    (set-goal SPLIT 1)
    ;	(up-jump-rule 1)
)

(defrule
    (goal SPLIT 0)
    (game-time < 2400)	;40min
    (goal gl-fifth-turn 1)
    (current-age >= castle-age)
    (up-compare-goal NET-GOLD-AMOUNT < 150)
    (up-compare-goal NET-FOOD-AMOUNT >= 350)
=>
    ;	(chat-to-player me "CASTLE ECO ADJUST--G+ F-")
    (up-modify-sn sn-gold-gatherer-percentage c:+ 5)
    (up-modify-sn sn-food-gatherer-percentage c:- 4)
    (up-modify-sn sn-wood-gatherer-percentage c:- 1)
    (enable-timer BECO-TIMER TIME1)
    (set-goal SPLIT 1)
)

(defrule
    (true)
=>
    (set-goal SPLIT 0)
    (up-modify-goal goal s:= sn-wood-gatherer-percentage)
    (up-modify-goal goal s:+ sn-food-gatherer-percentage)
    (up-modify-goal goal s:+ sn-gold-gatherer-percentage)
    (up-modify-goal goal s:+ sn-stone-gatherer-percentage)
)

(defrule
    (up-compare-goal goal > 100)
=>
    (up-chat-data-to-player me "Warning: gp's more than 100(%d)" g: goal)
    (up-modify-sn sn-wood-gatherer-percentage c:- 1)
)

(defrule
    (up-compare-goal goal < 100)
=>
    (up-chat-data-to-player me "Warning: gp's less than 100(%d)" g: goal)
    (up-modify-sn sn-wood-gatherer-percentage c:+ 1)
)

(defrule
    (or	(taunt-detected me 13)
    (taunt-detected any-enemy 13))
=>
    (up-chat-data-to-player me "Wood percentage: %d" s: sn-wood-gatherer-percentage)
    (up-chat-data-to-player me "Food percentage: %d" s: sn-food-gatherer-percentage)
    (up-chat-data-to-player me "Gold percentage: %d" s: sn-gold-gatherer-percentage)
    (up-chat-data-to-player me "Stone percentage: %d" s: sn-stone-gatherer-percentage)
    (acknowledge-taunt this-any-enemy 13)
    (acknowledge-taunt me 13)
)

;###################### QMNUMS
;WWWWWWWWWWWWWWWWWW QTOWN SAFETY
(defrule
    (true)
=>
    (set-goal gl-town-under-attack NO)
    (set-goal gl-town-safe YES)
    (disable-self)
)
;1 search around home with goal
;2 if more than certain number found town is under attack
;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal gl-enemies-in-town 0)
    (set-goal goal 30)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 g: goal)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-remote c: all-units-class c: 40)
    (up-get-search-state lt)
    (up-modify-goal gl-enemies-in-town g:+ rt)
)

;3. SEARCH
(defrule
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

;WWWWWWWWWWWWWWWWWW BEING DRUSHED
;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 g: goal)
    (up-find-remote c: militiaman-line c: 15)
    (up-get-search-state lt)
)

;3. SEARCH
(defrule
    (up-compare-goal rt < 2)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (up-compare-goal rt >= 2)
    (goal gl-enemy-strategy DRUSH)
    (up-compare-goal gl-town-safe == YES)
=>
    ;	(up-chat-data-to-player me "DRUSH IN TOWN(%d)" g: rt)
    (set-goal gl-town-safe BeingDrushed)
    (enable-timer t-town-safe 15)
)

(defrule
    (up-compare-goal rt < 1)
    (goal gl-town-safe BeingDrushed)
    (up-compare-goal gl-enemies-in-town < 2)
    (up-timer-status t-town-safe != timer-running)
=>
    ;	(up-chat-data-to-player me "Drush Finished(%d)" g: gl-enemies-in-town)
    (set-goal gl-town-safe YES)
)

;WWWWWWWWWWWWWWWWWW BEING ATTACKED
(defrule
    (up-compare-goal gl-town-safe == YES)
    (up-compare-goal gl-enemies-in-town >= 2)
=>
    ;	(up-chat-data-to-player me "TOWN UNDER ATTACK(%d)" g: gl-enemies-in-town)
    (set-goal gl-town-under-attack YES)
    (set-goal gl-town-safe NO)
)

(defrule
    (goal gl-town-safe NO)
    (up-compare-goal gl-enemies-in-town >= 2)
=>
    (enable-timer t-town-safe 30)
)

(defrule
    (up-compare-goal gl-town-safe != YES)
    (up-compare-goal gl-enemies-in-town < 1)
    (up-timer-status t-town-safe != timer-running)
=>
    ;	(up-chat-data-to-player me "Attack Finished(%d)" g: gl-enemies-in-town)
    (set-goal gl-town-under-attack NO)
    (set-goal gl-town-safe YES)
)

;WWWWWWWWWWWWWWWWWW VILLAGER REACTION
;1. SET UP THE SEARCH
(defrule
    (true)
=>
    (set-strategic-number sn-focus-player-number 1)
    (set-goal rt 0)
)

;2. SEARCH
(defrule
    (stance-toward focus-player enemy)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 30)
    (up-find-remote c: militiaman-line c: 10)
    (up-get-search-state lt)
)

;3. LOOP THE SEARCH
(defrule
    (up-compare-goal rt < 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule	;no reaction
    (or	(up-compare-sn sn-allow-civilian-defense != 0)
    (up-compare-sn sn-allow-civilian-offense != 1))
    (or	(up-compare-goal rt >= 1)
    (or	(up-compare-goal gl-enemies-in-town < 4)
    (or	(players-current-age every-enemy < feudal-age)
    (players-current-age-time every-enemy < 70))))
=>
    (set-strategic-number sn-allow-civilian-defense 0)
    (set-strategic-number sn-allow-civilian-offense 1)
)

(defrule	;fight back
    (up-compare-goal rt < 1)
    (up-compare-goal gl-enemies-in-town >= 4)
    (players-current-age-time any-enemy >= 70)
    (players-current-age any-enemy >= feudal-age)
    (or	(up-compare-sn sn-allow-civilian-defense != 1)
    (up-compare-sn sn-allow-civilian-offense != 0))
=>
    (set-strategic-number sn-allow-civilian-defense 1)
    (set-strategic-number sn-allow-civilian-offense 0)
)

