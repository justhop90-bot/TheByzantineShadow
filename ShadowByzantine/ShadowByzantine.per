)

(defrule	;retreating toward home
    (goal gl-defend-town YES)
=>
    (set-goal goal4 10)
)

(defrule
    (false)
    (goal gl-can-move YES)
    (up-point-distance home-x ranged-group-x < 20)
    (up-timer-status t-ranged-retreat != timer-running)
    (up-compare-goal gl-target-distance g:> gl-ranged-group-range)
    (up-compare-goal gl-ranged-eval < WinningFight)
    (up-compare-goal gl-target-distance g:<= gl-tracking-range)
=>
    (chat-to-player me "Home Tracking")
    (set-goal SPLIT 1)
)

(defrule 	;track even while close
    (goal gl-can-move YES)
    (up-compare-goal gl-melee-in-range < 1)
    (up-compare-goal gl-enemy-group-size < 10)
    (up-timer-status t-ranged-retreat != timer-running)
    (or	(goal gl-second-turn 1)
    (up-compare-goal gl-ranged-group-state != TRACKING))
=>
    (set-goal SPLIT 2)
)

(defrule
    (goal SPLIT 2)
    (or (and(up-compare-goal gl-target-distance g:<= goal)	;t-range+4
    (up-compare-goal gl-target-class == villager-class))
    (and(up-compare-goal gl-ranged-eval >= WinningFight)
    (up-compare-goal gl-target-distance g:<= gl-tracking-range)))
=>
    ;	(chat-to-player me "Tracking 1")
    (set-goal SPLIT 1)
)

(defrule 	;track if too far
    ;	(up-compare-goal gl-target-class != cavalry-class)
    ;	(up-compare-goal gl-target-class != scout-cavalry-class)
    ;	(up-compare-goal gl-enemy-group-size < 10)
    (goal gl-can-move YES)
    (up-compare-goal gl-target-distance g:> goal6)	;gl-ranged-group-range+1
    (up-compare-goal gl-ranged-eval < WinningFight)
    (up-timer-status t-ranged-retreat != timer-running)
    (up-compare-goal gl-target-class != villager-class)
    (or	(goal gl-second-turn 1)
    (up-compare-goal gl-ranged-group-state != TRACKING))
    (up-compare-goal gl-target-distance g:<= gl-tracking-range)
=>
    ;	(chat-to-player me "Tracking 2")
    (set-goal SPLIT 1)
)

