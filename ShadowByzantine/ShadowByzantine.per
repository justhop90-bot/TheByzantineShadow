    (up-find-player enemy find-closest goal)
    (up-find-next-player enemy find-closest goal)
    (up-modify-sn sn-target-player-number g:= goal)
    (set-goal gl-find-new-target 3)
)

;... THIRD
(defrule
    (player-valid 3)
    (game-time > 900)	;15min
    (goal gl-find-new-target -1)
    (players-population any-enemy >= 10)
    (players-civilian-population target-player < 5)
=>
    (set-goal SPLIT 1)
)

(defrule
    (player-valid 5)
    (goal gl-find-new-target 3)
    (players-current-age target-player < castle-age)
=>
    (up-get-player-color target-player goal4)
    ;	(up-chat-data-to-all "Privileged Don't Target Other Flank 2(%d)" g: goal4)
    (set-goal gl-find-new-target 4)
    (disable-self)
)

(defrule
    (player-valid 3)
    (game-time > 900)	;15min
    (goal gl-find-new-target 3)
    (or	(not(player-in-game target-player))
    (or	(and(players-population any-enemy >= 50)
    (players-civilian-population target-player < 32))
    (and(players-civilian-population any-enemy >= 80)
    (players-civilian-population target-player < 50))))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (up-get-player-color target-player goal5)
    ;	(up-chat-data-to-all "Privileged Current Target Destroyed 3(%d)" g: goal5)
    (set-goal gl-find-new-target 4)
    (set-goal SPLIT 0)
)

