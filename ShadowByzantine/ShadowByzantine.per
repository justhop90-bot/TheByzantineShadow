;
; Pass 1 runtime graph.
;
; The historical 15-module architecture remains scaffolding. Pass 1
; intentionally installs one executable vertical slice rather than
; loading incomplete parallel transaction implementations.
;
; Dependency order:
;   constants -> observation/foundation -> basic infrastructure
;   -> Pass 1 transaction kernel
;
; Pass 1 transaction contract:
;   objective
;      -> progression
;      -> capital feasibility
;      -> escrow mutation
;      -> escrow observation
;      -> authority
;      -> baseline
;      -> execution
;      -> world-state verification
;      -> release request
;      -> release observation
;      -> idle/reassessment
;
; ============================================================

(load "01_constants")
(load "01b_byz_constants")
(load "02_state")
(load "03_economy")
(load "04_construction")
(load "05_composition_policy")
(load "05_production")
(load "06_military")
(load "07_placement")
(load "07_strategic reserve")

