    (true)
=>
    (set-goal gl-tracking-range 9)
)

(defrule
    (true)
=>
    (up-modify-goal gl-tracking-range c:+ 35)
)

(defrule
    (or	(goal gl-town-safe YES)
    (up-point-distance home-x ranged-group-x >= 35))
=>
    (up-modify-goal gl-tracking-range c:- 35)
)

(defrule
    (research-completed ri-fletching)
=>
    (up-modify-goal gl-tracking-range c:+ 1)
)

