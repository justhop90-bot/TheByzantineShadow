    (up-set-target-point nearest-tc-x)
    (up-remove-objects search-remote 44 < 10)
    (up-get-search-state lt)
    (up-modify-goal goal4 g:+ rt)
)

;3. LOOP THE SEARCH
(defrule
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

;@@@@@@@@@@@@@@ ATTACKING TOWERS
;1. SET UP THE SEARCH
(defrule
    ;	(goal gl-fifth-turn 1)
    (up-compare-goal goal3 < 3)	;archers
    (up-compare-goal goal5 < 1)	;vills not fighting back
    (up-compare-goal goal4 >= 1)	;tower nearby
    (goal gl-cavalry-attacking 0)
    (or	(up-compare-goal goal2 < 1)	;no normal vills
    (up-compare-goal goal6 >= 1))	;ignore vills if there's a tower
=>
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: RangedTowerSearch)
    (up-filter-status c: status-ready c: list-active)
    (set-strategic-number sn-focus-player-number 1)
    (set-goal SPLIT 1)
)

;2. SEARCH
(defrule
    (goal SPLIT 1)
    (stance-toward focus-player enemy)
=>
    (up-find-status-remote c: watch-tower c: 5)
)

;3. LOOP THE SEARCH
(defrule
    (goal SPLIT 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (goal SPLIT 1)
=>
    (up-set-target-point nearest-tc-x)
    (up-remove-objects search-remote 44 < 10)

    (up-set-target-point spear-group-x)
    (up-clean-search search-remote 44 search-order-asc)
    (up-remove-objects search-remote -1 > 0)
)

(defrule
    (goal SPLIT 1)
    (up-set-target-object search-remote c: 0)
=>
    (up-get-object-data object-data-id goal)	;get tower's id
    ;	(chat-to-all "Attack Tower with Spears!")
    (up-filter-distance c: -1 c: 30)
    (up-find-local c: spearman-line c: 20)
    (up-remove-objects search-local object-data-target-id g:== goal)
    (up-set-target-point home-x)
    (up-remove-objects search-local 44 < DefenseRadius)

    (up-target-point null-x action-default -1 no-attack)
    (up-target-objects 0 action-default -1 -1)	;no-attack
    (set-goal gl-spear-group-state TATTACKING)
)

(defrule
    (true)
=>
    (set-goal SPLIT 0)
)

;@@@@@@@@@@@@@@ ATTACKING VILLS
;1. SET UP THE SEARCH
(defrule
    (up-compare-goal goal6 < 1)	;no towers to shoot spears
    (up-compare-goal goal3 < 3)
    (up-compare-goal goal5 < 1)	;vills not fighting back
    (up-compare-goal goal2 >= 1)	;vills
    (goal gl-cavalry-attacking 0)
=>
    ;	(chat-to-all "Attack Vills with Spears!")
    (up-full-reset-search)
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: 8)
    (set-strategic-number sn-focus-player-number 1)
