    (goal SPLIT 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (goal SPLIT 1)
=>
    (up-set-target-point nearest-tc-x)	;all this needs to match with the code for finding vills in goal2 to ensure no leaks
    (up-remove-objects search-remote 44 < 10)
    (up-set-target-point spear-group-x)
    (up-clean-search search-remote 44 search-order-asc)
    (up-set-target-object search-remote c: 0)
    (up-remove-objects search-remote -1 > 0)
    (up-get-object-data object-data-id goal)	;get target's id
)

(defrule
    (goal SPLIT 1)
=>
    (up-filter-distance c: -1 c: 30)
    (up-find-local c: spearman-line c: 20)
    (up-remove-objects search-local object-data-target-id g:== goal)
    (up-set-target-point home-x)
    (up-remove-objects search-local 44 < DefenseRadius)
    (up-target-point null-x action-default -1 no-attack)
    (up-target-objects 0 action-default -1 -1)	;no-attack
    (set-goal gl-spear-group-state VATTACKING)
    (set-goal SPLIT 0)
)

;@@@@@@@@@@@@@@ ATTACKING CAVALRY
;1. SET UP THE SEARCH
(defrule
    (goal gl-second-turn 1)
    (or	(up-compare-goal goal1 >= 1)	;wolves
    (up-compare-goal gl-cavalry-attacking >= 1))
    (or	(up-compare-goal gl-spear-group-state != MOVING)	;if spears already attacking it's fine
    (up-point-distance spear-group-x ranged-group-x < 4))	;if close enough, turn to attack
=>
    ;	(chat-to-all "Attack with Spears!")
    (set-strategic-number sn-focus-player-number 1)
    (up-full-reset-search)
    (set-goal rt 0)
    (set-goal SPLIT 1)
)

;2. SEARCH
(defrule
    (goal SPLIT 1)
    (stance-toward focus-player enemy)
=>
    (up-set-target-point ranged-group-x)
    (up-filter-distance c: -1 c: 7)
    (up-find-remote c: cavalry-class c: 5)
    (up-find-remote c: scout-cavalry-line c: 5)
)

;3. LOOP THE SEARCH
(defrule
    (goal SPLIT 1)
    (player-valid focus-player)
=>
    (up-modify-sn sn-focus-player-number c:+ 1)
    (up-jump-rule -2)
)

(defrule
    (goal SPLIT 1)
=>
    (set-strategic-number sn-focus-player-number 0)
    (up-find-remote c: wolf c: 5)
    (up-set-target-point spear-group-x)
    (up-clean-search search-remote 44 search-order-asc)
    (up-remove-objects search-remote -1 > 0)
    (up-set-target-object search-remote c: 0)
    (up-get-object-data object-data-id goal)	;get target's id
)

(defrule
    (goal SPLIT 1)
=>
    (up-filter-distance c: -1 c: 30)
    (up-find-local c: spearman-line c: 10)
    (up-remove-objects search-local object-data-target-id g:== goal)
    (up-set-target-point home-x)
    (up-remove-objects search-local 44 < DefenseRadius)
    (up-target-point null-x action-default -1 no-attack)
    (up-target-objects 0 action-default -1 -1)	;no-attack
    (set-goal gl-spear-group-state ATTACKING)
    (set-goal SPLIT 0)
)

;@@@@@@@@@@@@@@ MOVING
(defrule
    (goal gl-second-turn 1)
    (up-compare-goal goal1 < 1)	;no wolves
    (goal gl-cavalry-attacking 0)
    (or	(or	(up-compare-goal goal5 >= 1)	;vills fighting back
    (up-compare-goal goal3 >= 3))	;archers
    (and(up-compare-goal goal4 < 1)	;towers
    (or	(up-compare-goal goal2 < 1)	;villagers
    (up-compare-goal goal6 >= 1))))	;ignore vills if there's a tower
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    ;	(chat-to-all "Move spears")
    (up-set-target-point ranged-group-x)
    (up-full-reset-search)
    (up-find-local c: spearman-line c: 20)
    (set-goal gl-spear-group-state MOVING)
)

(defrule
    (goal SPLIT 1)
    (goal gl-town-safe NO)
    (up-point-distance ranged-group-x home-x >= 25)
=>
    (up-set-target-point home-x)
    (up-remove-objects search-local 44 < DefenseRadius)
)

(defrule
    (goal SPLIT 1)
=>
    (up-set-target-point ranged-group-x)
    (up-clean-search search-local 44 search-order-asc)
    (up-remove-objects search-local -1 g:>= goal8)	;number of spears to keep nearby
    (up-copy-point point-x ranged-group-x)
    (up-lerp-tiles point-x enemy-x c: -1)
)

(defrule
    (goal SPLIT 1)
    (up-point-distance spear-group-x nearest-tower-x < 9)
=>
    (up-lerp-tiles point-x nearest-tower-x c: -3)
)

(defrule
    (goal SPLIT 1)
=>
    (up-lerp-tiles point-x enemy-group-x g: goal)
    (up-bound-point point-x point-x)
    (up-target-point null-x action-move -1 no-attack)
    (up-target-point point-x action-move -1 -1)
    (set-goal SPLIT 0)
)

;@@@@@@@@@@@@@@ DEBUG
(defrule
    (taunt-detected me 53)
    (goal gl-second-turn 1)
=>
    (up-chat-data-to-player me "SpearTowers: %d" g: goal6)
    (up-chat-data-to-player me "AggVills: %d" g: goal5)
    (up-chat-data-to-player me "RangedTowers: %d" g: goal4)
    (up-chat-data-to-player me "Archers: %d" g: goal3)
    (up-chat-data-to-player me "Vills: %d" g: goal2)
    (up-chat-data-to-player me "Wolves: %d" g: goal1)
    (up-chat-data-to-player me "SpearCountNearRanged: %d" g: goal8)
)

(defrule
    (taunt-detected me 54)
=>
    (acknowledge-taunt me 53)
    (acknowledge-taunt me 54)
)

;###################### QSCOUT
;WWWWWWWWWWWWWWWWWW NO-ATTACK
(defrule
    (game-time > 300)
    (goal gl-ninety-turn 1)
    (unit-type-count scout-cavalry-line > 0)
=>
    (up-set-attack-stance scout-cavalry-line c: no-attack)
)

;WWWWWWWWWWWWWWWWWW FIGHT WITH THE SCOUT
(defrule
    (up-set-target-by-id g: scout-id)
    (unit-type-count scout-cavalry-line >= 1)
=>
    (up-get-object-data object-data-hitpoints goal1)
)

(defrule	;return to scouting when enemy army is too large or when lowhp
    (goal gl-strategy KRUSH)
    (unit-type-count scout-cavalry-line >= 1)
    (up-compare-goal gl-scout-added != FINISHED)
    (or (game-time >= 1110)	;18.5min
    (players-building-count every-enemy > 0))
=>
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
    ;	(chat-to-all "KRUSH REMOVE SCOUT FROM BATTLE")
    (set-goal gl-scout-added FINISHED)
    (set-goal SPLIT 0)
    (up-reset-scouts)
    (disable-self)

)

(defrule	;return to scouting when enemy army is too large or when lowhp
    (goal gl-strategy FLUSH)
    (unit-type-count scout-cavalry-line >= 1)
    (up-compare-goal gl-scout-added != FINISHED)
    (or	(game-time >= 1320)	;22min
    (or	(and(game-time >= 1020)	;17min
    (up-compare-goal SUPERIORITY >= 10))
    (or	(up-compare-goal goal1 < min-scout-hp1)
    (and(up-compare-goal goal1 < min-scout-hp2)
    (players-military-population target-player >= 14)))))
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal SPLIT 1)
=>
    (set-strategic-number sn-total-number-explorers 1)
    (set-strategic-number sn-number-explore-groups 1)
    ;	(chat-to-all "REMOVE SCOUT FROM BATTLE")
    (set-goal gl-scout-added FINISHED)
    (set-goal SPLIT 0)
    (up-reset-scouts)
    (disable-self)
)

(defrule
    (true)
=>
    (set-goal goal 0)
)

(defrule
    (game-time < 860)	;14min
    (goal gl-strategy FLUSH)
    (player-in-game any-ally)
    (up-point-distance enemy-x home-x > 95)
=>
    (up-jump-rule 37)
)

(defrule
    (or	(goal SOD 0)
    (or	(goal gl-strategy KRUSH)
    (or	(goal gl-position POCKET)
    (unit-type-count scout-cavalry < 1))))
=>
    (up-jump-rule 36)
)

(defrule
    (or	(goal gl-scout-added FINISHED)
    (players-building-type-count target-player town-center < 1))
    (or	(up-timer-status 28 == timer-running)
    (or	(goal gl-scout-added FINISHED)
    (or	(and(up-compare-goal gl-total-units-in-range < 5)
    (goal gl-attacking NO))
    (players-building-type-count target-player town-center < 1))))
=>
    (up-jump-rule 35)
)

(defrule
    (true)
=>
    (set-goal goal 0)
    (set-goal goal1 0)
    (set-goal goal2 0)
    (set-goal goal3 0)
    (set-goal goal4 0)
    (set-goal goal5 0)
)

(defrule
    (goal gl-fifth-turn 1)
    (strategic-number sn-total-number-explorers > 0)
=>
    (set-strategic-number sn-total-number-explorers 0)
    (set-strategic-number sn-number-explore-groups 0)
    (up-get-point-distance enemy-x home-x goal)
    ;	(up-chat-data-to-all "Stop scouting(%d)" g: goal)
    ;	(chat-to-all "Stop scouting")
    (set-goal gl-scout-added 1)
    (disable-self)
)

(defrule
    (goal gl-fifth-turn 1)
    (current-age-time < 400)
    (goal gl-strategy FLUSH)
    (current-age < castle-age)
    (goal NEWSCOUTING FINISHED)
    (up-group-size c: RangedGroup < 1)
=>
    ;	(chat-to-all "Go home")
    (up-get-point-distance enemy-x home-x goal)
    ;	(up-chat-data-to-all "Go home(%d)" g: goal)
    (up-full-reset-search)
    (up-find-local c: scout-cavalry-line c: 1)
    (up-copy-point point-x scout-x)
    (up-lerp-tiles point-x home-x c: 10)
    (up-lerp-tiles point-x center-x c: -3)
    (up-lerp-tiles point-x enemy-x c: -3)
    (up-target-point point-x action-move -1 no-attack)
)

(defrule
    (up-group-size c: RangedGroup < 1)
=>
    (up-jump-rule 31)
)

