;WWWWWWWWWWWWWWWWWW KRUSH
;@@@@@@@@@@@@@@ FFA/2V1 ETC
(defrule
    (player-valid 3)
    (game-time >= 5)
    (not(player-in-game any-ally))
    (up-compare-goal gl-strategy != KRUSH)
=>
    (set-strategic-number sn-home-exploration-time KrushHomeTime)	;11 min
    (set-goal gl-strategy-type FC)
    (chat-to-player me "Krushing")
    (set-goal gl-strategy KRUSH)
    (disable-self)
)

;@@@@@@@@@@@@@@ TAUNT
(defrule
    (game-time > 10)
    (current-age == dark-age)
    (up-compare-goal gl-strategy != KRUSH)
=>
    (chat-to-all "Taunt 131 before 60 seconds if you want me to perform a Krush")
    (disable-self)
)

(defrule
    (game-time > 5)
    (game-time < 60)
    (current-age == dark-age)
    (up-compare-goal gl-strategy != KRUSH)
    (or	(taunt-detected me 131)
    (or	(taunt-detected any-ally 131)
    (taunt-detected any-enemy 131)))
=>
    (set-strategic-number sn-home-exploration-time KrushHomeTime)
    (chat-to-all "Git redy fer sum hosses y'all!")
    (acknowledge-taunt this-any-enemy 131)
    (acknowledge-taunt this-any-ally 131)
    (set-goal gl-strategy-type FC)
    (set-goal gl-strategy KRUSH)
    (acknowledge-taunt me 131)
)

