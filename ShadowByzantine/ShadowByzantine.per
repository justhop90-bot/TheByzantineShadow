;WWWWWWWWWWWWWWWWWW HOW FAR TO LERP
(defrule
    (game-time < 60)
    (unit-type-count sheep < 4)
=>
    (set-goal goal1 -7)
)

(defrule
    (game-time >= 200)
    (up-gaia-type-count c: deer-class < 1)
    (or	(game-time > 410)
    (and(goal gl-sighted-boar-count 2)
    (or (and(game-time > 320)
    (up-compare-goal gl-current-sheep-count >= 6))
    (up-compare-goal gl-current-sheep-count >= 7))))
=>
    ;	(chat-to-player me "Wider scouting for deer")
    (disable-self)
)

(defrule	;lerp out a tiny bit more
    (game-time >= 200)
    (or	(game-time > 410)
    (and(goal gl-sighted-boar-count 2)
    (or (and(game-time > 320)
    (up-compare-goal gl-current-sheep-count >= 6))
    (up-compare-goal gl-current-sheep-count >= 7))))
=>
    (set-goal goal1 -11)
)

(defrule
    (game-time >= 200)
    (goal gl-sighted-boar-count 2)
    (up-compare-goal gl-current-sheep-count < 7)
=>
    ;	(chat-to-player me "Wider scouting for sheep")
    (disable-self)
)

(defrule	;lerp out a tiny bit more
    (game-time >= 200)
    (goal gl-sighted-boar-count 2)
    (up-compare-goal gl-current-sheep-count < 7)
=>
    (set-goal goal1 -14)
)

;WWWWWWWWWWWWWWWWWW DIRECTION SWITCH
(defrule	;jump for direction switch
    (or	(game-time < 90)
    (or	(game-time > 450)	;7.5m
    (and(up-compare-goal scout-x >= 5)
    (and(up-compare-goal scout-y >= 5)
    (and(up-compare-goal scout-x < 115)
    (up-compare-goal scout-y < 115))))))
=>
    (up-jump-rule 8)
)

(defrule
    (goal gl-scouting-switch -1)
    ;	(up-point-distance scout-x explo-x >= 6)
    (or	(up-point-contains explo-x c: tree-class)
    (or	(up-point-distance scout-x explo-x >= 50)
    (up-point-explored explo-x != explored-no)))
    (or	(up-compare-goal explo-x < 2)
    (or	(up-compare-goal explo-y < 2)
    (or	(up-compare-goal explo-x g:>= gl-max-coordinate-value)
    (up-compare-goal explo-y g:>= gl-max-coordinate-value))))
    (up-timer-status t-direction-switch != timer-running)
=>
    (set-goal SPLIT 1)
)

(defrule
    (false)
    (goal SPLIT 1)
    (up-point-contains explo-x c: tree-class)
=>
    (chat-to-player me "Tree")
)

(defrule
    (false)
    (goal SPLIT 1)
    (up-point-distance scout-x explo-x >= 50)
=>
    (chat-to-player me ">50")
)

(defrule
    (false)
    (goal SPLIT 1)
    (up-point-explored explo-x != explored-no)
=>
    (chat-to-player me "!=ExploredNo")
)

(defrule
    (goal SPLIT 1)
=>
    ;	(chat-to-player me "Switch direction maybe")
    (enable-timer t-direction-switch 5)
    (set-goal gl-scouting-switch 0)
    ;	(up-send-flare explo-x)
    (set-goal SPLIT 0)
)

(defrule
    (goal gl-scouting-switch 0)
    ;	(up-point-distance scout-x explo-x >= 6)
    (or	(up-point-contains explo-x c: tree-class)
    (or	(up-point-distance scout-x explo-x >= 50)
    (up-point-explored explo-x != explored-no)))
    (or	(up-compare-goal explo-x < 2)
    (or	(up-compare-goal explo-y < 2)
    (or	(up-compare-goal explo-x g:>= gl-max-coordinate-value)
    (up-compare-goal explo-y g:>= gl-max-coordinate-value))))
    (up-timer-status t-direction-switch != timer-running)
=>
    (set-goal SPLIT 1)
)

(defrule
    (goal gl-scouting-switch 0)
    (up-timer-status t-direction-switch != timer-running)
=>
    (set-goal gl-scouting-switch -1)
)

(defrule
    (goal SPLIT 1)
=>
    ;	(chat-to-player me "Switch direction")
    (enable-timer t-direction-switch 50)
    (set-goal gl-scouting-switch -1)
    (up-modify-goal CROSS c:* -1)
    (set-goal NEWSCOUTING -1)
    ;	(up-send-flare explo-x)
    (set-goal SPLIT 0)
)

;WWWWWWWWWWWWWWWWWW NORMAL MOVING
(defrule
    (goal NEWSCOUTING -1)
=>
    ;	(chat-to-player me "Cross")
    (up-copy-point explo-x scout-x)
    (up-cross-tiles explo-x home-x g: CROSS)
    (up-lerp-tiles explo-x home-x g: goal3)
    (up-bound-point explo-x explo-x)
    ;	(up-send-flare explo-x)
    (set-goal NEWSCOUTING 0)
)

