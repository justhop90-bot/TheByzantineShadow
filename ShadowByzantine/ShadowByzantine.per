    (true)
    (or	(game-time < 2)
    (or	(current-age > dark-age)
    (or	(up-compare-goal NEWSCOUTING >= 50)
    (up-timer-status 28 == timer-running))))
=>
    (up-jump-rule 33)
)

(defrule
    (true)
=>
    (set-goal CROSS 9)
    (disable-self)
)

