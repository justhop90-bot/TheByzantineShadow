    (up-get-target-fact military-population 0 goal)
    (up-modify-goal SUPERIORITY g:- goal)
)

;###################### QCIVSUP
(defrule
    (players-building-count target-player > 0)
=>
    (set-goal CIVSUP 0)
    (up-get-fact civilian-population 0 goal)
    (up-modify-goal CIVSUP g:+ goal)
    (up-get-target-fact civilian-population 0 goal)
    (up-modify-goal CIVSUP g:- goal)
)

;###################### QATTACKING
;WWWWWWWWWWWWWWWWWW QTSA
;>>>>>>>>>>> KRUSH
(defrule	;start if target in feudal or if not behind in military
    (goal gl-attacking NO)
    (goal gl-strategy KRUSH)
    (unit-type-count knight >= 3)
    ;	(players-building-count target-player >= 1)
    (or	(military-population >= 20)
    (or	(up-compare-goal SUPERIORITY >= 0)
    (players-current-age target-player < castle-age)))
=>
    (set-strategic-number sn-maximum-town-size 1000)
    (chat-to-all "Attack Now")
    (set-goal gl-attacking YES)
    (enable-timer TSA 3)
)

(defrule	;stop if behind target who's in castle
    (goal gl-attacking YES)
    (goal gl-strategy KRUSH)
    (or	(unit-type-count knight < 3)
    (and(military-population < 17)
    (and(up-compare-goal SUPERIORITY < -5)
    (players-current-age target-player >= castle-age))))

=>
    (up-modify-sn sn-maximum-town-size g:= gl-original-ts)
    (chat-to-all "Stop Attacking!")
    (up-retreat-to -1 c: knight-line)
    (set-goal gl-attacking NO)
    (disable-timer TSA)
)

;>>>>>>>>>>> FLUSH
(defrule
    (goal gl-attacking NO)
    (goal gl-strategy FLUSH)
    (players-building-count target-player >= 1)
    (or	(up-group-size c: RangedGroup >= 6)
    (and(up-group-size c: RangedGroup >= 4)
    (players-military-population target-player < 3)))
=>
    (set-strategic-number sn-maximum-town-size 1000)
    (chat-to-player me "85 Let's dive in!")
    ;	(chat-to-allies "Let's dive in!")
    (set-goal gl-attacking YES)
    (enable-timer TSA 3)
)

;>>>>>>>>>>> OLD
(defrule
    ;	(false)
    ;	(timer-triggered TSA)
    (game-time > 600)	;10min
    (goal gl-attacking -1)
    (strategic-number sn-maximum-town-size g:!= gl-original-ts)
=>
    (up-modify-sn sn-maximum-town-size g:= gl-original-ts)
    ;	(up-chat-data-to-player me "TSA back off (%d)" s: sn-maximum-town-size)
    ;	(enable-timer TSA 7)
)

(defrule
    ;	(false)
    ;	(timer-triggered TSA)
    (game-time > 600)	;10min
    (goal gl-attacking YES)
    (up-compare-sn sn-maximum-town-size != 1000)
=>
    (set-strategic-number sn-maximum-town-size 1000)
    ;	(up-chat-data-to-player me "TSA back on (%d)" s: sn-maximum-town-size)
    ;	(enable-timer TSA 1)
)

;WWWWWWWWWWWWWWWWWW LATE ATTACKING
(defrule
    (false)
    (goal gl-ninety-turn 1)
    (up-group-size c: RangedGroup < 1)
    (up-group-size c: KnightGroup < 1)
=>
    (up-full-reset-search)
    (up-set-target-point home-x)
    (up-filter-distance c: -1 c: 30)
    (up-filter-include cmdid-military -1 -1 -1)
    (up-find-local c: all-units-class c: 80)
    (up-remove-objects search-local object-data-type == battering-ram)
    (up-target-point enemy-x action-patrol -1 aggressive)
    ;	(chat-to-player me "LatePatrol")
)

;###################### QPROGRESSION
;###################### QENEMY STRAT
(defrule
    (players-unit-type-count target-player scout-cavalry-line >= 2)
=>
    (set-goal ENEMY-STABLE YES)
    (disable-self)
)

;WWWWWWWWWWWWWWWWWW KRUSH
(defrule
    ;	(game-time > 900)	;not before 15min
    (players-current-age-time target-player >= 60)
    (players-current-age target-player < castle-age)
    (or	(up-compare-goal SUPERIORITY >= 15)
    (players-military-population target-player < 5))
    (up-compare-goal gl-enemy-strategy != POSSIBLE-KRUSH)
    (players-building-type-count target-player stable >= 1)
    (or	(game-time > 990)	;if past 16.5min
    (or	(players-building-type-count target-player stable >= 2)
    (or	(players-building-type-count target-player market >= 1)
    (players-building-type-count target-player blacksmith >= 1))))
=>
    (set-goal gl-enemy-strategy POSSIBLE-KRUSH)
    ;	(chat-to-all "85 Possible Krush Detected")
)

(defrule
    ;	(not(player-valid 3))
    (up-compare-goal gl-enemy-strategy != KRUSH)
    (players-current-age target-player >= castle-age)
    (or	(players-building-type-count target-player stable >= 1)
    (players-unit-type-count target-player knight-line >= 2))
    (players-building-type-count target-player archery-range < 2)
=>
    ;	(chat-to-all "85 Target is Krushing!")
    (set-goal gl-enemy-strategy KRUSH)
)

;WWWWWWWWWWWWWWWWWW FC
(defrule
    (up-compare-goal gl-target-age >= CA-loading)
    (players-civilian-population target-player < 33)
=>
    (set-goal gl-enemy-strategy-type FC)
    ;	(chat-to-player me "Enemy FCing!")
    (disable-self)
)

;WWWWWWWWWWWWWWWWWW DRUSH
(defrule
    (players-current-age target-player == dark-age)
    (players-military-population target-player >= 2)
=>
    ;	(chat-to-player me "Opponent is Drushing")
    (set-goal gl-enemy-strategy DRUSH)
    (disable-self)
)

(defrule
    (current-age > dark-age)
    (current-age-time >= 210)
    (goal gl-enemy-strategy DRUSH)
=>
    ;	(chat-to-player me "Reset Opponent Drushing")
    (set-goal gl-enemy-strategy FLUSH)
    (disable-self)
)

