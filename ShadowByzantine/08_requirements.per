(defrule (true) =>
    (up-modify-goal SHADOW-REQ-DEFICIT-ANTI-MASS-SIEGE g:= SHADOW-PROD-ANTI-MASS-SIEGE)
    (up-modify-goal SHADOW-REQ-DEFICIT-ANTI-MASS-SIEGE c:- SHADOW-PROD-COUNT-ANTI-MASS-SIEGE)
