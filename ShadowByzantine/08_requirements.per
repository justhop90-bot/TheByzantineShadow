; ============================================================
; THE BYZANTINE SHADOW
; MODULE 08 -- REQUIREMENTS
; ============================================================
;
; PURPOSE
; -------
; Translate Shadow production deficits into an engine-defined
; four-resource requirement vector.
;
; ARCHITECTURE
; ------------
; COMPOSITION TARGET
;        |
;        v
; ENGINE OBSERVED TOTAL
;        |
;        v
; TRUE PRODUCTION DEFICIT
;        |
;        v
; ENGINE OBJECT COST
;        |
;        v
; COST-SET MULTIPLICATION
;        |
;        v
; SHADOW-PROD-COST-FOOD..GOLD
;
; COST AUTHORITY
; --------------
; The engine remains authoritative for unit costs.
;
; This module does NOT hard-code food, wood, stone, or gold
; prices for production targets.
;
; up-add-object-cost obtains the engine cost of one concrete
; DE object.
;
; up-add-cost-data then multiplies that four-resource cost set
; by the Shadow production deficit and adds it to the aggregate
; Shadow production cost vector.
;
; SCRATCH COST VECTOR
; -------------------
; Goals 41-44 are used as the temporary four-goal engine cost
; vector:
;
;     41 = food
;     42 = wood
;     43 = stone
;     44 = gold
;
; The authoritative Shadow production vector remains:
;
;     SHADOW-PROD-COST-FOOD  = 500
;     SHADOW-PROD-COST-WOOD  = 501
;     SHADOW-PROD-COST-STONE = 502
;     SHADOW-PROD-COST-GOLD  = 503
;
; These goals are part of the UserPatch extended-goal cost-data
; range. They are not declared as Shadow policy/state goals.
;
; PRODUCTION COUNT AUTHORITY
; --------------------------
; Module 05 supplies unit-type-count-total mirrors.
;
; unit-type-count-total includes completed + queued units.
; Therefore the requirement calculation does not subtract queued
; production a second time.
;
; THIS MODULE DOES NOT:
;   - choose composition targets
;   - build production infrastructure
;   - train units
;   - modify escrow
;   - determine reserve floors
;   - determine capital feasibility
;   - authorize execution
;   - verify completion
;
; ============================================================
; INITIALIZATION
; ============================================================

(defrule
    (goal SHADOW-REQ-INITIALIZED -1)
=>
    (set-goal SHADOW-REQ-INITIALIZED 1)
    (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-INACTIVE)

    (set-goal SHADOW-REQ-DEFICIT-INFANTRY 0)
    (set-goal SHADOW-REQ-DEFICIT-ANTI-CAVALRY 0)
    (set-goal SHADOW-REQ-DEFICIT-RANGED 0)
    (set-goal SHADOW-REQ-DEFICIT-ANTI-RANGED 0)
    (set-goal SHADOW-REQ-DEFICIT-LIGHT-CAVALRY 0)
    (set-goal SHADOW-REQ-DEFICIT-HEAVY-CAVALRY 0)
    (set-goal SHADOW-REQ-DEFICIT-CAMEL 0)
    (set-goal SHADOW-REQ-DEFICIT-MOBILE-RANGED 0)
    (set-goal SHADOW-REQ-DEFICIT-UNIQUE-CAVALRY 0)
    (set-goal SHADOW-REQ-DEFICIT-RAM-SIEGE 0)
    (set-goal SHADOW-REQ-DEFICIT-AREA-SIEGE 0)
    (set-goal SHADOW-REQ-DEFICIT-ANTI-MASS-SIEGE 0)
    (set-goal SHADOW-REQ-DEFICIT-SIEGE-TOWER 0)
    (set-goal SHADOW-REQ-DEFICIT-GUNPOWDER-SIEGE 0)
    (set-goal SHADOW-REQ-DEFICIT-CASTLE-SIEGE 0)
    (set-goal SHADOW-REQ-DEFICIT-MONK 0)
    (set-goal SHADOW-REQ-DEFICIT-HAND-CANNONEER 0)
    (set-goal SHADOW-REQ-DEFICIT-GALLEY-NAVY 0)
    (set-goal SHADOW-REQ-DEFICIT-FIRE-NAVY 0)
    (set-goal SHADOW-REQ-DEFICIT-DEMO-NAVY 0)
    (set-goal SHADOW-REQ-DEFICIT-IMPERIAL-NAVY 0)
    (set-goal SHADOW-REQ-DEFICIT-PETARD 0)

    (up-setup-cost-data 1 SHADOW-PROD-COST-FOOD)
)

; ============================================================
; DEFICIT MATERIALIZATION
; ============================================================
;
; Deficit = max(Target - ObservedTotal, 0).
;
; The observed count already includes queued production.
;

(defrule (true) =>
    (up-modify-goal SHADOW-REQ-DEFICIT-INFANTRY g:= SHADOW-PROD-INFANTRY)
    (up-modify-goal SHADOW-REQ-DEFICIT-INFANTRY c:- SHADOW-PROD-COUNT-INFANTRY)
    (up-modify-goal SHADOW-REQ-DEFICIT-INFANTRY c:max 0)
)

(defrule (true) =>
    (up-modify-goal SHADOW-REQ-DEFICIT-ANTI-CAVALRY g:= SHADOW-PROD-ANTI-CAVALRY)
    (up-modify-goal SHADOW-REQ-DEFICIT-ANTI-CAVALRY c:- SHADOW-PROD-COUNT-ANTI-CAVALRY)
    (up-modify-goal SHADOW-REQ-DEFICIT-ANTI-CAVALRY c:max 0)
)

(defrule (true) =>
    (up-modify-goal SHADOW-REQ-DEFICIT-RANGED g:= SHADOW-PROD-RANGED)
    (up-modify-goal SHADOW-REQ-DEFICIT-RANGED c:- SHADOW-PROD-COUNT-RANGED)
