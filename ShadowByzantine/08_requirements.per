; ============================================================
; REQUIREMENT PRESENCE
; ============================================================

(defrule
    (true)
=>
    (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-INACTIVE)
)

(defrule
    (up-compare-goal SHADOW-REQ-DEFICIT-INFANTRY > 0)
=>
    (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE)
)

(defrule
    (up-compare-goal SHADOW-REQ-DEFICIT-ANTI-CAVALRY > 0)
=>
    (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE)
)

(defrule
