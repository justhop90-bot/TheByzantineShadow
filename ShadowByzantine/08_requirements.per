    (up-modify-goal SHADOW-REQ-DEFICIT-AREA-SIEGE g:= SHADOW-PROD-AREA-SIEGE)
    (up-modify-goal SHADOW-REQ-DEFICIT-AREA-SIEGE c:- SHADOW-PROD-COUNT-AREA-SIEGE)
    (up-modify-goal SHADOW-REQ-DEFICIT-AREA-SIEGE c:max 0)
