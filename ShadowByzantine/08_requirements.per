; ============================================================
; THE BYZANTINE SHADOW
; MODULE 08 -- REQUIREMENTS
; ============================================================
;
; Authority: engine-derived construction cost/requirement data.
;
; This module translates the active construction request into an
; engine-defined four-resource requirement vector. It does not choose
; strategy, allocate escrow, grant authority, execute construction,
; verify completion, or recover a failed transaction.
;
; Numeric strategic thresholds remain outside this module.
; ============================================================

; ------------------------------------------------------------
; INITIALIZATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-REQUIREMENTS -1)
=>
    (set-goal BYZ-CONSTRUCTION-REQUIREMENTS BYZ-REQUIREMENTS-NOT-READY)
    (set-goal BYZ-REQUIREMENT-ACTIVE 0)
)

; ------------------------------------------------------------
; IDLE / NO REQUEST
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-REQUEST BYZ-REQUEST-INACTIVE)
=>
    (set-goal BYZ-CONSTRUCTION-REQUIREMENTS BYZ-REQUIREMENTS-NOT-READY)
    (set-goal BYZ-REQUIREMENT-ACTIVE 0)
)

; ------------------------------------------------------------
; REQUESTED OBJECT COSTS
; ------------------------------------------------------------
; The engine cost-data interface is initialized against a dedicated
; consecutive four-goal vector. The exact object is dispatched below
; because .per cannot treat an arbitrary goal value as a dynamic object
; constant in an engine cost command.

(defrule
    (goal BYZ-CONSTRUCTION-REQUEST BYZ-REQUEST-ACTIVE)
    (goal BYZ-CURRENT-BUILD-ITEM house)
=>
    (up-setup-cost-data 1 BYZ-REQUIREMENT-FOOD)
    (up-add-object-cost c: house c: 1)
    (set-goal BYZ-REQUIREMENT-ACTIVE 1)
    (set-goal BYZ-CONSTRUCTION-REQUIREMENTS BYZ-REQUIREMENTS-READY)
)

(defrule
    (goal BYZ-CONSTRUCTION-REQUEST BYZ-REQUEST-ACTIVE)
    (goal BYZ-CURRENT-BUILD-ITEM barracks)
=>
    (up-setup-cost-data 1 BYZ-REQUIREMENT-FOOD)
