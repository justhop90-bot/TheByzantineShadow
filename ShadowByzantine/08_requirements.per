; ============================================================
; ENGINE-DERIVED COST AGGREGATION
; ============================================================
;
; The aggregate Shadow vector is 500-503.
;
; Scratch vector 41-44 is populated with the engine cost of ONE
; concrete DE object. That vector is then multiplied by the
; production deficit with up-add-cost-data and accumulated into
; 500-503.
;
; This deliberately avoids hard-coded prices.
;
; Object IDs are concrete DE IDs from the AIRef object table.
;

(defrule
    (true)
=>
    (up-setup-cost-data 1 SHADOW-PROD-COST-FOOD)
)

; Militia-line -- DE Militia object 74.
(defrule (true) =>
    (up-setup-cost-data 1 41)
    (up-add-object-cost c: 74 c: 1)
    (up-setup-cost-data 0 SHADOW-PROD-COST-FOOD)
    (up-add-cost-data 41 g: SHADOW-REQ-DEFICIT-INFANTRY)
)

; Spearman-line -- Spearman object 93.
(defrule (true) =>
    (up-setup-cost-data 1 41)
    (up-add-object-cost c: 93 c: 1)
    (up-setup-cost-data 0 SHADOW-PROD-COST-FOOD)
    (up-add-cost-data 41 g: SHADOW-REQ-DEFICIT-ANTI-CAVALRY)
)

; Archer-line -- Archer object 4.
(defrule (true) =>
    (up-setup-cost-data 1 41)
    (up-add-object-cost c: 4 c: 1)
    (up-setup-cost-data 0 SHADOW-PROD-COST-FOOD)
    (up-add-cost-data 41 g: SHADOW-REQ-DEFICIT-RANGED)
)

; Skirmisher-line -- Skirmisher object 7.
