; Dromon -- DE object 1795.
(defrule (true) =>
    (up-setup-cost-data 1 41)
    (up-add-object-cost c: 1795 c: 1)
    (up-setup-cost-data 0 SHADOW-PROD-COST-FOOD)
    (up-add-cost-data 41 g: SHADOW-REQ-DEFICIT-IMPERIAL-NAVY)
)

; Petard -- object 440.
(defrule (true) =>
    (up-setup-cost-data 1 41)
    (up-add-object-cost c: 440 c: 1)
    (up-setup-cost-data 0 SHADOW-PROD-COST-FOOD)
    (up-add-cost-data 41 g: SHADOW-REQ-DEFICIT-PETARD)
)

