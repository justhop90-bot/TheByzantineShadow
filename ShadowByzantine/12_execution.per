; ------------------------------------------------------------
; POINT-PLACEMENT EXECUTION
; ------------------------------------------------------------
; The target-point pipeline is owned by Module 07. up-build place-point
; consumes the current target point; its third argument remains escrow mode.
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-EXECUTING)
    (goal BYZ-EXECUTION-STATE BYZ-EXECUTION-READY)
    (goal BYZ-PLACEMENT-STATE BYZ-PLACE-POINT)
    (goal BYZ-TARGET-STATE BYZ-TARGET-VALID)
    (goal BYZ-CURRENT-BUILD-ITEM mining-camp)
    (up-can-build BYZ-ESCROW-MODE c:< mining-camp)
=>
    (up-build place-point BYZ-ESCROW-MODE c:< mining-camp)
    (set-goal BYZ-EXECUTION-STATE BYZ-EXECUTION-ISSUED)
    (set-goal BYZ-EXECUTION-PENDING BYZ-EXECUTION-PENDING-VALUE)
)

; ------------------------------------------------------------
; AUTHORITY LOSS BEFORE COMMAND
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-EXECUTING)
    (goal BYZ-AUTHORITY-STATE BYZ-AUTHORITY-DENIED)
    (goal BYZ-EXECUTION-STATE BYZ-EXECUTION-READY)
=>
    (set-goal BYZ-EXECUTION-STATE BYZ-EXECUTION-FAILED)
    (set-goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-FAILED)
)

; INVARIANTS:
; lifecycle state and engine escrow mode are separate goals
; every build command has an up-can-build guard
; execution never verifies completion or releases escrow
; builder counts remain policy-unassigned
; ============================================================
