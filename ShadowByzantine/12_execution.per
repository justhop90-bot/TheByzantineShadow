; ============================================================
; THE BYZANTINE SHADOW
; MODULE 12 -- EXECUTION
; ============================================================
;
; Authority: issue engine construction commands only after construction
; authorization, escrow commitment, and placement validity are present.
;
; IMPORTANT DISTINCTION:
;   BYZ-ESCROW-STATE = lifecycle state
;   BYZ-ESCROW-MODE  = engine command mode
;
; The two must never be conflated. Shadow's gl-escrow-state is a command
; mode passed to up-build; the lifecycle/commitment state is a separate
; control concept in this Byzantine implementation.
; ============================================================

(defrule
    (goal BYZ-EXECUTION-STATE -1)
=>
    (set-goal BYZ-EXECUTION-STATE BYZ-EXECUTION-IDLE)
    (set-goal BYZ-EXECUTION-PENDING BYZ-EXECUTION-IDLE)
    (set-goal BYZ-ESCROW-MODE BYZ-ESCROW-EXCLUDED)
)

; ------------------------------------------------------------
; PREPARE ESCROW-INCLUSIVE EXECUTION
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-EXECUTING)
    (goal BYZ-AUTHORITY-STATE BYZ-AUTHORITY-GRANTED)
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-COMMITTED)
    (goal BYZ-TARGET-STATE BYZ-TARGET-VALID)
    (goal BYZ-EXECUTION-STATE BYZ-EXECUTION-IDLE)
=>
    (set-goal BYZ-ESCROW-MODE BYZ-ESCROW-INCLUDED)
    (set-goal BYZ-EXECUTION-STATE BYZ-EXECUTION-READY)
)

; ------------------------------------------------------------
; NORMAL-PLACEMENT EXECUTION
; ------------------------------------------------------------
; Each engine command has its corresponding up-can-build guard.

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-EXECUTING)
    (goal BYZ-EXECUTION-STATE BYZ-EXECUTION-READY)
    (goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
    (goal BYZ-CURRENT-BUILD-ITEM house)
    (up-can-build BYZ-ESCROW-MODE c:< house)
=>
    (up-build place-normal BYZ-ESCROW-MODE c:< house)
    (set-goal BYZ-EXECUTION-STATE BYZ-EXECUTION-ISSUED)
    (set-goal BYZ-EXECUTION-PENDING BYZ-EXECUTION-PENDING-VALUE)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-EXECUTING)
    (goal BYZ-EXECUTION-STATE BYZ-EXECUTION-READY)
    (goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
    (goal BYZ-CURRENT-BUILD-ITEM barracks)
    (up-can-build BYZ-ESCROW-MODE c:< barracks)
=>
    (up-build place-normal BYZ-ESCROW-MODE c:< barracks)
    (set-goal BYZ-EXECUTION-STATE BYZ-EXECUTION-ISSUED)
    (set-goal BYZ-EXECUTION-PENDING BYZ-EXECUTION-PENDING-VALUE)
)

