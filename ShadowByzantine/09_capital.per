; ============================================================
; THE BYZANTINE SHADOW
; MODULE 09 -- CAPITAL FEASIBILITY
; ============================================================
;
; CLOSED SLICE CONTRACT
; ---------------------
; Module 08 owns the engine-derived transaction cost vector:
;
;   475 food
;   476 wood
;   477 gold
;   478 stone
;
; Module 09 first computes GROSS capital feasibility.
;
; Strategic reserve is a separate policy input. Its numeric vector is
; deliberately not invented. The reserve-adjusted result therefore
; remains UNQUALIFIED until Module 07's provider handshake reports a
; bound reserve vector.
;
; ============================================================
; INITIALIZATION
; ============================================================

(defrule
    (goal AEGIS-CAPITAL-STATE -1)
=>
    (set-goal AEGIS-CAPITAL-STATE 0)
    (set-goal AEGIS-CAPITAL-SLACK-FOOD 0)
    (set-goal AEGIS-CAPITAL-SLACK-WOOD 0)
    (set-goal AEGIS-CAPITAL-SLACK-GOLD 0)
    (set-goal AEGIS-CAPITAL-SLACK-STONE 0)
    (set-goal AEGIS-CAPITAL-RESERVE-STATE AEGIS-RESERVE-CAPITAL-UNQUALIFIED)
    (set-goal AEGIS-RESERVE-CAPITAL-FEASIBILITY AEGIS-RESERVE-CAPITAL-UNQUALIFIED)
)

; ============================================================
; REQUIREMENT -> GROSS CAPITAL DELTA
; ============================================================
;
; 41-44 are scratch extended goals. The engine computes:
;
;   current stockpile - required transaction cost
;
; up-get-cost-delta does not account for strategic reserve or escrow.
;
(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (goal AEGIS-REQUIREMENT AEGIS-REQUIREMENT-SPEARMAN)
=>
    (up-setup-cost-data 1 41)
    (up-add-cost-data AEGIS-TRANSACTION-FOOD c: 1)
    (up-get-cost-delta 41)
    (up-modify-goal AEGIS-CAPITAL-SLACK-FOOD g:= 41)
    (up-modify-goal AEGIS-CAPITAL-SLACK-WOOD g:= 42)
    (up-modify-goal AEGIS-CAPITAL-SLACK-GOLD g:= 43)
    (up-modify-goal AEGIS-CAPITAL-SLACK-STONE g:= 44)
)

; ============================================================
; GROSS CAPITAL STATE
; ============================================================

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (goal AEGIS-REQUIREMENT AEGIS-REQUIREMENT-SPEARMAN)
    (up-compare-goal AEGIS-CAPITAL-SLACK-FOOD >= 0)
    (up-compare-goal AEGIS-CAPITAL-SLACK-WOOD >= 0)
    (up-compare-goal AEGIS-CAPITAL-SLACK-GOLD >= 0)
    (up-compare-goal AEGIS-CAPITAL-SLACK-STONE >= 0)
=>
    (set-goal AEGIS-CAPITAL-STATE 1)
    (set-goal AEGIS-CAPITAL-FEASIBILITY 1)
)

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (goal AEGIS-REQUIREMENT AEGIS-REQUIREMENT-SPEARMAN)
    (or
        (up-compare-goal AEGIS-CAPITAL-SLACK-FOOD < 0)
        (up-compare-goal AEGIS-CAPITAL-SLACK-WOOD < 0)
        (up-compare-goal AEGIS-CAPITAL-SLACK-GOLD < 0)
        (up-compare-goal AEGIS-CAPITAL-SLACK-STONE < 0)
    )
=>
    (set-goal AEGIS-CAPITAL-STATE 2)
    (set-goal AEGIS-CAPITAL-FEASIBILITY 0)
)

; ============================================================
; RESERVE-ADJUSTED CAPITAL -- ABI BOUNDARY ONLY
; ============================================================
;
; Required semantic result:
;
;   current(resource) - transaction-cost(resource)
;                         - reserve(resource) >= 0
;
; for every resource.
;
; The reserve vector is not considered valid until:
;
;   AEGIS-RESERVE-POLICY-READY == AEGIS-RESERVE-BOUND
;
; and the provider has populated the four reserve input slots.
;
; No arithmetic implementation is asserted here until the exact
; engine/UP operand contract is qualified. Therefore the state remains
; UNQUALIFIED rather than silently treating reserve as zero.
;
; ============================================================
; CONTRACT WITH MODULE 10
; ============================================================
;
; Current AEGIS-CAPITAL-FEASIBILITY remains the GROSS feasibility
; output used by the experimental closed slice.
;
; Reserve-adjusted feasibility is a distinct future authorization
; input. It must not be aliased to gross feasibility.
