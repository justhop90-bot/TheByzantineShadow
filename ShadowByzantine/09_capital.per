; ============================================================
; THE BYZANTINE SHADOW
; MODULE 09 -- CAPITAL FEASIBILITY
; ============================================================
;
; CLOSED SLICE CONTRACT
; ---------------------
; Module 08 owns the engine-derived transaction cost vector:
;
;   475 food
;   476 wood
;   477 gold
;   478 stone
;
; Module 09 answers only:
;
;   Can the current stockpile finance that requirement?
;
; It does not hard-code unit prices and it does not mutate escrow.
;
; The strategic-reserve subtraction remains an explicit downstream
; policy input. This first closed slice therefore qualifies the
; gross capital boundary first; reserve-policy qualification is not
; silently fabricated here.
;
; ============================================================
; INITIALIZATION
; ============================================================

(defrule
    (goal AEGIS-CAPITAL-STATE -1)
=>
    (set-goal AEGIS-CAPITAL-STATE 0)
    (set-goal AEGIS-CAPITAL-SLACK-FOOD 0)
    (set-goal AEGIS-CAPITAL-SLACK-WOOD 0)
    (set-goal AEGIS-CAPITAL-SLACK-GOLD 0)
    (set-goal AEGIS-CAPITAL-SLACK-STONE 0)
)

; ============================================================
; REQUIREMENT -> GROSS CAPITAL DELTA
; ============================================================
;
; 41-44 are scratch extended goals. We copy the Module 08 cost
; vector into that cost-data block and ask the engine for:
;
;   current stockpile - required cost
;
; up-get-cost-delta does not account for escrow; this module runs
; before escrow commitment, so that is the intended observation.
;
(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (goal AEGIS-REQUIREMENT AEGIS-REQUIREMENT-SPEARMAN)
=>
    (up-setup-cost-data 1 41)
    (up-add-cost-data AEGIS-TRANSACTION-FOOD c: 1)
    (up-get-cost-delta 41)
    (up-modify-goal AEGIS-CAPITAL-SLACK-FOOD g:= 41)
    (up-modify-goal AEGIS-CAPITAL-SLACK-WOOD g:= 42)
    (up-modify-goal AEGIS-CAPITAL-SLACK-GOLD g:= 43)
    (up-modify-goal AEGIS-CAPITAL-SLACK-STONE g:= 44)
)

; ============================================================
; CAPITAL STATE
; ============================================================
;
; Every resource must have a non-negative gross delta.
;
(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (goal AEGIS-REQUIREMENT AEGIS-REQUIREMENT-SPEARMAN)
    (up-compare-goal AEGIS-CAPITAL-SLACK-FOOD >= 0)
    (up-compare-goal AEGIS-CAPITAL-SLACK-WOOD >= 0)
    (up-compare-goal AEGIS-CAPITAL-SLACK-GOLD >= 0)
    (up-compare-goal AEGIS-CAPITAL-SLACK-STONE >= 0)
=>
    (set-goal AEGIS-CAPITAL-STATE 1)
    (set-goal AEGIS-CAPITAL-FEASIBILITY 1)
)

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (goal AEGIS-REQUIREMENT AEGIS-REQUIREMENT-SPEARMAN)
    (or
        (up-compare-goal AEGIS-CAPITAL-SLACK-FOOD < 0)
        (up-compare-goal AEGIS-CAPITAL-SLACK-WOOD < 0)
        (up-compare-goal AEGIS-CAPITAL-SLACK-GOLD < 0)
        (up-compare-goal AEGIS-CAPITAL-SLACK-STONE < 0)
    )
=>
    (set-goal AEGIS-CAPITAL-STATE 2)
    (set-goal AEGIS-CAPITAL-FEASIBILITY 0)
)

; ============================================================
; CONTRACT WITH MODULE 10
; ============================================================
;
; AEGIS-CAPITAL-FEASIBILITY=1 is the only capital output consumed
; by the escrow commit path. Module 09 never calls escrow commands.
;
; ============================================================
