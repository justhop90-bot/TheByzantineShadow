; ============================================
; THE BYZANTINE SHADOW
; MODULE 10 -- ESCROW AUTHORITY
; ============================================
;
; Closed production-slice implementation.
;
; Responsibility:
;   Own actual engine escrow mutation, commitment observation,
;   release execution, and release observation.
;
; Module 08 owns the transaction cost vector. No resource price is
; hard-coded here.
;
; ============================================
; REQUIREMENT -> ESCROW COMMIT
; ============================================
;
; The four transaction goals are a contiguous UP cost-data block:
;   475 food, 476 wood, 477 gold, 478 stone.
;
; The g: prefix is mandatory because the right-hand operand is a
; goal-store value, not a constant.
;
(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (goal AEGIS-CAPITAL-FEASIBILITY 1)
    (goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-COMMITTING)
=>
    (up-modify-escrow food c:max g: AEGIS-TRANSACTION-FOOD)
    (up-modify-escrow wood c:max g: AEGIS-TRANSACTION-WOOD)
    (up-modify-escrow gold c:max g: AEGIS-TRANSACTION-GOLD)
    (up-modify-escrow stone c:max g: AEGIS-TRANSACTION-STONE)
)

; ============================================
; COMMITTING -> COMMITTED
; ============================================
;
; Command issuance is not commitment completion. The engine must
; report the protected escrow quantities before COMMITTED is written.
;
(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-RESERVING)
    (goal AEGIS-CAPITAL-FEASIBILITY 1)
    (goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-COMMITTING)
    (escrow-amount food >= g: AEGIS-TRANSACTION-FOOD)
    (escrow-amount wood >= g: AEGIS-TRANSACTION-WOOD)
    (escrow-amount gold >= g: AEGIS-TRANSACTION-GOLD)
    (escrow-amount stone >= g: AEGIS-TRANSACTION-STONE)
=>
    (set-goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-COMMITTED)
    (set-goal AEGIS-TRANSACTION AEGIS-TRANSACTION-READY)
)

; ============================================
; COMMITTED -> RELEASING
; ============================================

(defrule
    (goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-COMMITTED)
    (goal AEGIS-ESCROW-RELEASE-REQUEST AEGIS-ESCROW-RELEASE-YES)
    (or
        (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-COMPLETE)
        (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-FAILED)
    )
=>
    (up-release-escrow)
    (set-goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-RELEASING)
)

; ============================================
; RELEASING -> RELEASED
; ============================================
;
; Actual engine state is authoritative.
;
(defrule
    (goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-RELEASING)
    (escrow-amount food < 1)
    (escrow-amount wood < 1)
    (escrow-amount gold < 1)
    (escrow-amount stone < 1)
=>
    (set-goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-RELEASED)
)

; ============================================
; RELEASED -> UNCOMMITTED
; ============================================

(defrule
    (goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-RELEASED)
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-IDLE)
=>
    (set-goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-UNCOMMITTED)
    (set-goal AEGIS-ESCROW-RELEASE-REQUEST AEGIS-ESCROW-RELEASE-NO)
)
