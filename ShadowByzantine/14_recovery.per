; ============================================
; THE BYZANTINE SHADOW
; MODULE 14 -- RECOVERY
; ============================================
;
; Responsibility:
;   Convert a failed transaction into a controlled recovery state.
;
; Recovery boundary:
;
;   FAILED
;      -> REQUIRED
;      -> RELEASE REQUESTED
;      -> RELEASE OBSERVED
;      -> RECOVERY-CLEARED
;      -> REASSESSMENT
;
; This module does NOT:
;   - choose a new objective;
;   - mutate engine escrow directly;
;   - release engine escrow directly;
;   - grant authority;
;   - execute production;
;   - declare world-state success.
;
; Module 10 remains the sole owner of actual engine escrow release.
;
; ============================================
; ENTER RECOVERY
; ============================================

(defrule
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-FAILED)
    (goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-IDLE)
=>
    (set-goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-REQUIRED)
)

; ============================================
; REQUEST ESCROW RELEASE
; ============================================

(defrule
    (goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-REQUIRED)
    (goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-COMMITTED)
=>
    (set-goal AEGIS-ESCROW-RELEASE-REQUEST AEGIS-ESCROW-RELEASE-YES)
    (set-goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-RELEASING)
)

; ============================================
; OBSERVE RELEASE
; ============================================
;
; Recovery does not infer completion from the request. Module 10
; must first observe all escrow balances at zero.
;
(defrule
    (goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-RELEASING)
    (goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-RELEASED)
=>
    (set-goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-RELEASED)
)

; ============================================
; RELEASED -> RECOVERY-CLEARED
; ============================================
;
; This is the explicit lifecycle boundary consumed by Module 15.
; Recovery must not reset the transaction to IDLE itself.
;
(defrule
    (goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-RELEASED)
    (goal AEGIS-TRANSACTION AEGIS-TRANSACTION-FAILED)
    (goal AEGIS-ESCROW-STATUS AEGIS-ESCROW-RELEASED)
=>
    (set-goal AEGIS-RECOVERY-STATE AEGIS-RECOVERY-CLEARED)
)
