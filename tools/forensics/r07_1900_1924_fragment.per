; ============================================================
; R07 RULE 1900
; ============================================================
; State reads: goal gl-strategy FLUSH; current build item != STONEMC1; build progress == StoneMC1Number.
; State writes: gl-current-build-item = STONEMC1; wood escrow percentage = LOW-ESCROW.
; Pending guards: none.
; Commands: none.
; Placement operations: none.
; Completion observers: none.
; Explicit jumps: none; fall-through -> 1901.
(defrule
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-current-build-item != STONEMC1)
    (up-compare-goal gl-build-progress == StoneMC1Number)
=>
    ;	(chat-to-player me "Setting current build item to STONEMC1")
    (set-goal gl-current-build-item STONEMC1)
    (set-escrow-percentage wood LOW-ESCROW)
)

; ============================================================
; R07 RULE 1901
; ============================================================
; State reads: dropsite-min-distance stone < 5; gl-current-build-item = STONEMC1.
; State writes: gl-build-progress += 1.
; Pending guards: none.
; Commands: none.
; Placement operations: none.
; Completion observer: dropsite-min-distance stone < 5.
; Explicit jumps: none; fall-through -> 1902.
(defrule
    (dropsite-min-distance stone < 5)
    (goal gl-current-build-item STONEMC1)
=>
    ;	(chat-to-player me "First Stone Mining Camp Built")
    (up-modify-goal gl-build-progress c:+ 1)
)

; ============================================================
; R07 RULE 1902
; ============================================================
; State reads: game-time >= 1480 OR (game-time >= 1140 AND gl-strategy KRUSH); t-mc status; gold/stone dropsite distances; gl-escrow-state via up-can-build.
; State writes: adjacent-dropsite policy=0; placement-fail-delta=0; placement-zone-size=5; t-mc=280.
; Pending guards: none.
; Commands: up-build place-normal gl-escrow-state c: mining-camp.
; Placement operations: NORMAL mining-camp placement.
; Completion observers: none.
; Explicit jumps: none; fall-through -> 1903.
(defrule
    (or	(game-time >= 1480)	;24 min
    (and(game-time >= 1140)	;19 min
    (goal gl-strategy KRUSH)))
    (or	(up-timer-status t-mc != timer-running)
    (or (dropsite-min-distance gold >= 6)
    (dropsite-min-distance stone >= 6)))
    (up-can-build gl-escrow-state c: mining-camp)
=>
    (set-strategic-number sn-allow-adjacent-dropsites 0)
    (set-strategic-number sn-placement-fail-delta 0)
    (set-strategic-number sn-placement-zone-size 5)
    ;	(chat-to-player me "ADDITIONAL MC")
    (enable-timer t-mc 280)
    (up-build place-normal gl-escrow-state c: mining-camp)
)

; ============================================================
; R07 RULE 1903
; ============================================================
; State reads: gl-progression-pause=-1; can-build-with-escrow university; gl-current-build-item=UNIVERSITY.
; State writes: placement data; placement-zone-size=3.
; Pending guards: none.
; Commands: up-build place-control gl-escrow-state c: university.
; Placement operations: CONTROL university placement.
; Completion observers: none.
; Explicit jumps: none; fall-through -> 1904.
(defrule
    (goal gl-progression-pause -1)
    (can-build-with-escrow university)
    (goal gl-current-build-item UNIVERSITY)
=>
    (up-chat-data-to-player me "University(%d)" g: goal)
    (up-set-placement-data me -1 c: -5)
    (set-strategic-number sn-placement-zone-size 3)
    (up-build place-control gl-escrow-state c: university)
)

; ============================================================
; R07 RULE 1904
; ============================================================
; State reads: gl-strategy=FLUSH; university count < 1; gl-build-progress > UniversityNumber.
; State writes: gl-build-progress = UniversityNumber.
; Pending guards: none.
; Commands: none.
; Placement operations: none.
; Completion observer: university count < 1 is reconciliation evidence.
; Explicit jumps: none; fall-through -> 1905.
(defrule	;come back if skipped
    (goal gl-strategy FLUSH)
    (building-type-count-total university < 1)
    (up-compare-goal gl-build-progress > UniversityNumber)
=>
    (set-goal gl-build-progress UniversityNumber)
)

