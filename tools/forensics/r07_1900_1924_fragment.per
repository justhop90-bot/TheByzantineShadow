; ============================================================
; R07 RULE 1906
; ============================================================
; State reads: gl-strategy=FLUSH; gl-current-build-item=UNIVERSITY.
; State writes: wood escrow=MID-ESCROW; food/gold escrow=0; releases food/gold.
; Pending guards: none.
; Commands: none.
; Placement operations: none.
; Completion observers: none.
; Explicit jumps: none; fall-through -> 1907.
(defrule
    (goal gl-strategy FLUSH)
    (up-compare-goal gl-current-build-item == UNIVERSITY)
=>
    (set-escrow-percentage wood MID-ESCROW)
    (set-escrow-percentage food 0)
    (set-escrow-percentage gold 0)
    (release-escrow food)
    (release-escrow gold)
)

; ============================================================
; R07 RULE 1907
; ============================================================
; State reads: gl-current-build-item=UNIVERSITY; university count >= 1.
; State writes: gl-build-progress += 1.
; Pending guards: none.
; Commands: none.
; Placement operations: none.
; Completion observer: university count >= 1.
; Explicit jumps: none; fall-through -> 1908.
(defrule
    (goal gl-current-build-item UNIVERSITY)
    (building-type-count-total university >= 1)
=>
    (up-modify-goal gl-build-progress c:+ 1)
    ;	(chat-to-player me "University Built")
)

