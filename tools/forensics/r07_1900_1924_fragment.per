; ============================================================
; R07 RULE 1913
; ============================================================
; End-of-script timer stamp.
; State reads: true.
; State writes: timer 45 = 0 via up-set-timer.
; Pending guards: none.
; Commands: up-set-timer; up-get-timer.
; Placement operations: none.
; Completion observers: timer retrieval only; no construction completion.
; Explicit jumps: none; fall-through -> 1914.
(defrule ;Find time stamp to compare to start of next pass
    (true)
=>
    (up-set-timer c: 45 c: 0)
    (up-get-timer c: 45 512)
)

; ============================================================
; R07 RULE 1914
; ============================================================
; State reads: game-time > 45; gl-position FLANK.
; State writes: self disabled.
; Pending guards: none.
; Commands: enemy chat messages; disable-self.
; Placement operations: none.
; Completion observers: none.
; Explicit jumps: none; fall-through -> 1915.
(defrule
    (game-time > 45)
    (goal gl-position FLANK)
=>
    (chat-to-player every-enemy "Beware.")
    (chat-to-player every-enemy "The descent of the Shadow has begun...")
    (disable-self)
)

