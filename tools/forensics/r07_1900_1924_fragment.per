; ============================================================
; R07 RULE 1917
; ============================================================
; State reads: game-time > 20; game-time < 40; death-match-game OR current-age > dark-age OR not civ-selected viking.
; State writes: self disabled.
; Pending guards: none.
; Commands: chat-to-all; disable-self.
; Placement operations: none.
; Completion observers: none.
; Explicit jumps: none; fall-through -> 1918.
(defrule
    (game-time > 20)
    (game-time < 40)
    (or	(death-match-game)
    (or	(current-age > dark-age)
    (not(civ-selected viking))))
=>
    (chat-to-all "Untested settings detected. My play will be weaker.")
    (disable-self)
)

; ============================================================
; R07 RULE 1918
; ============================================================
; State reads: gl-strategy FLUSH; taunt-detected me/any-ally/any-enemy.
; State writes: none.
; Pending guards: none.
; Commands: chat-to-all; acknowledge-taunt this-any-enemy/this-any-ally/me.
; Placement operations: none.
; Completion observers: none.
; Explicit jumps: none; fall-through -> 1919.
(defrule
    (goal gl-strategy FLUSH)
    (or	(taunt-detected me 250)
    (or	(taunt-detected any-ally 250)
    (taunt-detected any-enemy 250)))
=>
    (chat-to-all "I'm Flushing")
    (acknowledge-taunt this-any-enemy 250)
    (acknowledge-taunt this-any-ally 250)
    (acknowledge-taunt me 250)
)

; ============================================================
; R07 RULE 1919
; ============================================================
