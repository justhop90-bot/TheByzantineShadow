; ============================================================
; R07 RULE 1920
; ============================================================
; State reads: false; game-time < 660; EARLY-MINING-NOTICE != YES; target mining-camp count > 0.
; State writes: EARLY-MINING-NOTICE = YES.
; Pending guards: none.
; Commands: chat-to-player.
; Placement operations: none.
; Completion observers: target mining-camp count > 0.
; Explicit jumps: none; fall-through -> 1921.
(defrule
    (false)
    (game-time < 660)
    (not(goal EARLY-MINING-NOTICE YES))
    (players-building-type-count target-player mining-camp > 0)
=>
    (chat-to-player me "Enemy mining early")
    (set-goal EARLY-MINING-NOTICE YES)
)

; ============================================================
; R07 RULE 1921
; ============================================================
; State reads: false; gl-enemy-strategy=-1; target age-time > 100; target current-age > dark-age.
; State writes: self disabled.
; Pending guards: none.
; Commands: chat-to-player; up-chat-data-to-player; disable-self.
; Placement operations: none.
; Completion observers: target age/time predicates only.
; Explicit jumps: none; fall-through -> 1922.
(defrule
    (false)
    (goal gl-enemy-strategy -1)
    (players-current-age-time target-player > 100)
    (players-current-age target-player > dark-age)
=>
    (chat-to-player me "SCOUTING MISSION HAS FAILED")
    (up-chat-data-to-player me "ENEMY STRAT STILL UNKNOWN(%d)" g: gl-enemy-strategy)
    (disable-self)
)

; ============================================================
; R07 RULE 1922
; ============================================================
; State reads: false; gl-enemy-strategy=-1; target current-age=dark-age; target military population > 2.
; State writes: gl-enemy-strategy = DRUSH; self disabled.
; Pending guards: none.
; Commands: chat-to-player; disable-self.
; Placement operations: none.
; Completion observers: target age/military population predicates.
; Explicit jumps: none; fall-through -> 1923.
(defrule
    (false)
    (goal gl-enemy-strategy -1)
    (players-current-age target-player == dark-age)
    (players-military-population target-player > 2)
=>
    (chat-to-player me "12Target is drushing")
    (set-goal gl-enemy-strategy DRUSH)
    (disable-self)
)

; ============================================================
; R07 RULE 1923
; ============================================================
; State reads: false; gl-enemy-strategy != RANGED-FLUSH; target current-age=feudal-age; target age-time < 100 with military-pop > 4 and range=1 OR range=2.
; State writes: gl-enemy-strategy-type = RANGED-FLUSH; gl-enemy-strategy = FLUSH; self disabled.
; Pending guards: none.
; Commands: chat-to-player; disable-self.
; Placement operations: none.
; Completion observers: target age/time, military population, and archery-range predicates.
; Explicit jumps: none; fall-through -> 1924.
(defrule
    (false)
    (not(goal gl-enemy-strategy RANGED-FLUSH))
    (players-current-age target-player == feudal-age)
    (or	(and(players-current-age-time target-player < 100)
    (and(players-military-population target-player > 4)
    (players-building-type-count target-player archery-range == 1)))
    (players-building-type-count target-player archery-range == 2))
=>
    (chat-to-player me "12ENEMY FLUSHING")
    (set-goal gl-enemy-strategy-type RANGED-FLUSH)
    (set-goal gl-enemy-strategy FLUSH)
    (disable-self)
)

; ============================================================
; R07 RULE 1924
; ============================================================
; State reads: false; gl-enemy-strategy != SCRUSH; target current-age=feudal-age; target archery-range < 2; target scout-cavalry count > 1 OR stable > 0.
; State writes: gl-enemy-strategy-type = FLUSH; gl-enemy-strategy = SCRUSH.
; Pending guards: none.
; Commands: chat-to-player.
; Placement operations: none.
; Completion observers: target age, archery-range, scout-cavalry and stable predicates.
; Explicit jumps: none; end of requested interval falls through to 1925.
(defrule
    (false)
    (not(goal gl-enemy-strategy SCRUSH))
    (players-current-age target-player == feudal-age)
    (players-building-type-count target-player archery-range < 2)
    (or	(players-unit-type-count target-player scout-cavalry-line > 1)
    (players-building-type-count target-player stable > 0))
=>
    (chat-to-player me "12Target is going for a scrush")
    (set-goal gl-enemy-strategy-type FLUSH)
    (set-goal gl-enemy-strategy SCRUSH)
)
