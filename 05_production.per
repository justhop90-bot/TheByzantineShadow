;=============================================================
; THE BYZANTINE SHADOW
; MODULE 05 -- PRODUCTION AUTHORITY
;=============================================================
;
; Production is an economic commitment consumer, not a teaching
; example. The module owns the military production demand below,
; its production reserve, and admission of training actions.
;
; Shadow principles:
;   - production demand is explicit
;   - existing + queued units count toward the target
;   - resources are accumulated through escrow
;   - escrow is released only at an executable commitment point
;   - release is followed immediately by execution
;   - engine feasibility remains the final admission gate
;   - satisfied demand releases only resources owned here
;   - prerequisite execution is allowed only while this module's
;     commitment is active
;
; Cost profile: goals 500-503 (food, wood, stone, gold).
; Production state: goal 507.
; Training escrow state: goal 508.
;
(defconst SHADOW-PROD-COST-FOOD 500)
(defconst SHADOW-PROD-COST-WOOD 501)
(defconst SHADOW-PROD-COST-STONE 502)
(defconst SHADOW-PROD-COST-GOLD 503)
(defconst SHADOW-PROD-STATE 507)
(defconst SHADOW-PROD-ESCROW-STATE 508)

(defconst SHADOW-PROD-ACCUMULATING 1)
(defconst SHADOW-PROD-SATISFIED 2)
(defconst SHADOW-PROD-SPEAR-TARGET 3)
(defconst SHADOW-PROD-ESCROW-PERCENT 35)
(defconst SHADOW-PROD-BARRACKS-ESCROW-PERCENT 60)

;=============================================================
; INITIALIZATION
;=============================================================
;
; The cost-data API stores four consecutive resource goals in
; FOOD/WOOD/STONE/GOLD order. This is a static package profile,
; not runtime affordability evidence.
;
(defrule
    (goal SHADOW-PROD-STATE -1)
=>
    (up-setup-cost-data 1 SHADOW-PROD-COST-FOOD)
    (up-add-object-cost c: spearman c: SHADOW-PROD-SPEAR-TARGET)
    (set-goal SHADOW-PROD-ESCROW-STATE escrow-included)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
)

;=============================================================
; BARRACKS CAPITAL RESERVATION
;=============================================================
;
; Shadow-style saving: protect wood before the prerequisite exists.
; can-build-with-escrow is the admission test because the reserved
; wood is intentionally unavailable to ordinary can-build.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks < 1)
    (unit-type-count-total spearman-line < SHADOW-PROD-SPEAR-TARGET)
    (up-pending-objects c: barracks < 1)
    (goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
=>
    (set-escrow-percentage wood SHADOW-PROD-BARRACKS-ESCROW-PERCENT)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
)

; Release the reserved wood only when this production commitment is
; active and the engine says the barracks is executable.
;
; The explicit state gate prevents an unrelated pre-existing escrow
; balance from becoming an implicit production authorization.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks < 1)
    (unit-type-count-total spearman-line < SHADOW-PROD-SPEAR-TARGET)
    (up-pending-objects c: barracks < 1)
    (goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
    (can-build-with-escrow barracks)
=>
    (release-escrow wood)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (build barracks)
)

;=============================================================
; PRODUCTION RESERVE ACQUISITION
;=============================================================
;
; Once the barracks exists, protect food and wood for the actual
; military commitment. Gold and stone are deliberately untouched.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks > 0)
    (unit-type-count-total spearman-line < SHADOW-PROD-SPEAR-TARGET)
    (goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
=>
    (set-escrow-percentage food SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
)

;=============================================================
; TRAINING ADMISSION / EXECUTION
;=============================================================
;
; up-train-site-ready is deliberately checked with the root Spearman
; object, as required by UserPatch. It answers a different question
; from affordability: whether an appropriate training site is ready.
;
; The explicit escrow state tells the UP training commands to include
; the committed production reserve in their feasibility calculation.
; Release occurs immediately before execution, then the reserve
; posture is restored for the next commitment.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks > 0)
    (unit-type-count-total spearman-line < SHADOW-PROD-SPEAR-TARGET)
    (goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
    (up-train-site-ready spearman)
    (up-can-train SHADOW-PROD-ESCROW-STATE c: spearman)
=>
    (release-escrow food)
    (release-escrow wood)
    (set-escrow-percentage food SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (up-train SHADOW-PROD-ESCROW-STATE c: spearman)
)

;=============================================================
; DEMAND COMPLETION / CAPITAL RELEASE
;=============================================================
;
; unit-type-count-total includes queued units, so the target is a
; real production commitment rather than merely completed bodies.
;
(defrule
    (unit-type-count-total spearman-line >= SHADOW-PROD-SPEAR-TARGET)
    (goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
=>
    (release-escrow food)
    (release-escrow wood)
    (set-escrow-percentage food 0)
    (set-escrow-percentage wood 0)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
)

; If the committed army later falls below the target, the reserve
; acquisition rule above reopens the production commitment.
