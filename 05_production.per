(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total dromon g:< SHADOW-PROD-IMPERIAL-NAVY)
    (can-train dromon)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 417)
    (up-train SHADOW-PROD-ESCROW-STATE c: dromon)
)

;=============================================================
; COMPLETION / WITHDRAWAL
;=============================================================
;
; A domain is complete when unit-type-count-total reaches the absolute
; policy target. Reducing a target does not cancel queued training.
; Existing queue state therefore remains engine-owned.
;
(defrule
    (goal SHADOW-PROD-LOCK 0)
    (goal SHADOW-PROD-INFANTRY 0)
    (goal SHADOW-PROD-ANTI-CAVALRY 0)
    (goal SHADOW-PROD-RANGED 0)
    (goal SHADOW-PROD-ANTI-RANGED 0)
    (goal SHADOW-PROD-LIGHT-CAVALRY 0)
    (goal SHADOW-PROD-HEAVY-CAVALRY 0)
    (goal SHADOW-PROD-MOBILE-RANGED 0)
    (goal SHADOW-PROD-UNIQUE-CAVALRY 0)
    (goal SHADOW-PROD-RAM-SIEGE 0)
    (goal SHADOW-PROD-AREA-SIEGE 0)
    (goal SHADOW-PROD-ANTI-MASS-SIEGE 0)
    (goal SHADOW-PROD-GUNPOWDER-SIEGE 0)
    (goal SHADOW-PROD-CASTLE-SIEGE 0)
    (goal SHADOW-PROD-MONK 0)
    (goal SHADOW-PROD-GALLEY-NAVY 0)
    (goal SHADOW-PROD-FIRE-NAVY 0)
    (goal SHADOW-PROD-DEMO-NAVY 0)
    (goal SHADOW-PROD-IMPERIAL-NAVY 0)
=>
    (release-escrow food)
    (release-escrow wood)
    (release-escrow gold)
    (release-escrow stone)
    (set-escrow-percentage food 0)
    (set-escrow-percentage wood 0)
    (set-escrow-percentage gold 0)
    (set-escrow-percentage stone 0)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
)

; Re-establish the production escrow policy when any demand exists.
(defrule
    (goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
=>
    (set-escrow-percentage food SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage gold SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage stone SHADOW-PROD-ESCROW-PERCENT)
)

;=============================================================
; NOTES ON CURRENT QUALIFICATION
;=============================================================
;
; 1. Policy is absolute desired state.
; 2. Production Authority owns admission and execution.
; 3. Engine can-train remains prerequisite/availability authority.
; 4. unit-type-count-total counts queued units.
; 5. No hidden queue cancellation is performed.
; 6. No goal-valued dynamic unit dispatch is assumed.
; 7. Dromon is explicitly represented because current DE Byzantines
;    receive Dromon and lose Cannon Galleon.
; 8. Naval demand remains policy-controlled; no fabricated naval
;    activity is generated by this file.
