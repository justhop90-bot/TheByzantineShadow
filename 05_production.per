;=============================================================
; THE BYZANTINE SHADOW
; MODULE 05 -- PRODUCTION AUTHORITY
;=============================================================
;
; Complete production authority for the Byzantine military tree.
;
; POLICY -> absolute domain targets
; REGISTRY -> static engine production map
; AUTHORITY -> site / capital / escrow / admission / execution
;
; The implementation intentionally uses static unit-line symbols rather
; than speculative goal-valued unit dispatch. AIRef documents that unit
; lines are valid production targets and that unit-type-count-total
; includes queued units. The engine remains authoritative for actual
; availability and affordability through can-train/up-can-train.
;
; The preserved Shadow donor uses escrow as a capital-commitment layer,
; selective release, and explicit production-state reasoning. This file
; preserves that model while extending it across the Byzantine roster.
;
; IMPORTANT LOAD ORDER:
;   05_production_registry.per
;   05_composition_policy.per
;   05_production.per
;
; The repository currently contains no verified aggregate loader for these
; modules. Therefore this branch does not silently invent one.
;
;=============================================================
; INITIALIZATION
;=============================================================

(defrule
    (goal SHADOW-PROD-STATE -1)
=>
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
    (set-goal SHADOW-PROD-ESCROW-STATE escrow-included)
    (set-goal SHADOW-PROD-SITE-STATE 0)
    (set-goal SHADOW-PROD-ADMISSION 0)
    (set-goal SHADOW-PROD-LOCK 0)
    (set-goal SHADOW-PROD-REASSESS 0)
    (set-escrow-percentage food SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage gold SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage stone SHADOW-PROD-ESCROW-PERCENT)
)

; Engine cost vector is initialized once. The production executor does
; not use a manually maintained unit price for admission; up-can-train
; remains the affordability authority.

(defrule
    (goal SHADOW-PROD-COST-FOOD -1)
=>
    (up-setup-cost-data 1 SHADOW-PROD-COST-FOOD)
    (up-add-object-cost c: spearman c: 1)
)

;=============================================================
; PASS RESET / ADMISSION CONTROL
;=============================================================
;
; One successful production/build action per rule pass is deliberate.
; UserPatch documents the training queue as an optional global feature;
; Shadow's architecture instead treats production as an admitted
; transaction. This lock gives every production domain a deterministic
; arbitration point without requiring speculative dynamic dispatch.

(defrule
    (true)
=>
    (set-goal SHADOW-PROD-LOCK 0)
    (set-goal SHADOW-PROD-ADMISSION 0)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
)

;=============================================================
; DEMAND STATE OBSERVATION
;=============================================================
;
; Each domain uses unit-type-count-total. This deliberately counts both
; completed and queued units, preventing duplicate admission while a unit
; is already in a training queue.

(defrule (unit-type-count-total militia-line g:< SHADOW-PROD-INFANTRY) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total spearman-line g:< SHADOW-PROD-ANTI-CAVALRY) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total archer-line g:< SHADOW-PROD-RANGED) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total skirmisher-line g:< SHADOW-PROD-ANTI-RANGED) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total scout-line g:< SHADOW-PROD-LIGHT-CAVALRY) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total knight-line g:< SHADOW-PROD-HEAVY-CAVALRY) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total cavalry-archer-line g:< SHADOW-PROD-MOBILE-RANGED) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total cataphract g:< SHADOW-PROD-UNIQUE-CAVALRY) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total battering-ram-line g:< SHADOW-PROD-RAM-SIEGE) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total mangonel-line g:< SHADOW-PROD-AREA-SIEGE) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total scorpion-line g:< SHADOW-PROD-ANTI-MASS-SIEGE) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total bombard-cannon g:< SHADOW-PROD-GUNPOWDER-SIEGE) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total trebuchet g:< SHADOW-PROD-CASTLE-SIEGE) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total monk g:< SHADOW-PROD-MONK) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total galley-line g:< SHADOW-PROD-GALLEY-NAVY) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total fire-ship-line g:< SHADOW-PROD-FIRE-NAVY) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total demolition-ship-line g:< SHADOW-PROD-DEMO-NAVY) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))
(defrule (unit-type-count-total dromon g:< SHADOW-PROD-IMPERIAL-NAVY) => (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING))

;=============================================================
; PREREQUISITE SITE AUTHORITY
;=============================================================
;
; The production authority owns the production site prerequisite. The
; engine's can-build-with-escrow fact owns final feasibility. Only one
; site transaction may be admitted in a pass.

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (goal SHADOW-PROD-INFANTRY g:> 0)
    (building-type-count-total barracks < 1)
    (up-pending-objects c: barracks < 1)
    (can-build-with-escrow barracks)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-SITE-STATE 1)
    (release-escrow wood)
    (set-escrow-percentage wood SHADOW-PROD-SITE-ESCROW-PERCENT)
    (build barracks)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (goal SHADOW-PROD-ANTI-CAVALRY g:> 0)
    (building-type-count-total barracks < 1)
    (up-pending-objects c: barracks < 1)
    (can-build-with-escrow barracks)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-SITE-STATE 1)
    (release-escrow wood)
    (set-escrow-percentage wood SHADOW-PROD-SITE-ESCROW-PERCENT)
    (build barracks)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (or
        (goal SHADOW-PROD-RANGED g:> 0)
        (goal SHADOW-PROD-ANTI-RANGED g:> 0)
        (goal SHADOW-PROD-MOBILE-RANGED g:> 0)
    )
    (building-type-count-total archery-range < 1)
    (up-pending-objects c: archery-range < 1)
    (can-build-with-escrow archery-range)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-SITE-STATE 1)
    (release-escrow wood)
    (set-escrow-percentage wood SHADOW-PROD-SITE-ESCROW-PERCENT)
    (build archery-range)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (or
        (goal SHADOW-PROD-LIGHT-CAVALRY g:> 0)
        (goal SHADOW-PROD-HEAVY-CAVALRY g:> 0)
    )
    (building-type-count-total stable < 1)
    (up-pending-objects c: stable < 1)
    (can-build-with-escrow stable)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-SITE-STATE 1)
    (release-escrow wood)
    (set-escrow-percentage wood SHADOW-PROD-SITE-ESCROW-PERCENT)
    (build stable)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (or
        (goal SHADOW-PROD-RAM-SIEGE g:> 0)
        (goal SHADOW-PROD-AREA-SIEGE g:> 0)
        (goal SHADOW-PROD-ANTI-MASS-SIEGE g:> 0)
        (goal SHADOW-PROD-GUNPOWDER-SIEGE g:> 0)
    )
    (current-age >= castle-age)
    (building-type-count-total siege-workshop < 1)
    (up-pending-objects c: siege-workshop < 1)
    (can-build-with-escrow siege-workshop)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-SITE-STATE 1)
    (release-escrow wood)
    (set-escrow-percentage wood SHADOW-PROD-SITE-ESCROW-PERCENT)
    (build siege-workshop)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (or
        (goal SHADOW-PROD-UNIQUE-CAVALRY g:> 0)
        (goal SHADOW-PROD-CASTLE-SIEGE g:> 0)
    )
    (current-age >= castle-age)
    (building-type-count-total castle < 1)
    (up-pending-objects c: castle < 1)
    (can-build-with-escrow castle)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-SITE-STATE 1)
    (release-escrow wood)
    (release-escrow stone)
    (set-escrow-percentage wood SHADOW-PROD-SITE-ESCROW-PERCENT)
    (set-escrow-percentage stone SHADOW-PROD-SITE-ESCROW-PERCENT)
    (build castle)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage stone SHADOW-PROD-ESCROW-PERCENT)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (goal SHADOW-PROD-MONK g:> 0)
    (current-age >= castle-age)
    (building-type-count-total monastery < 1)
    (up-pending-objects c: monastery < 1)
    (can-build-with-escrow monastery)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-SITE-STATE 1)
    (release-escrow wood)
    (set-escrow-percentage wood SHADOW-PROD-SITE-ESCROW-PERCENT)
    (build monastery)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (or
        (goal SHADOW-PROD-GALLEY-NAVY g:> 0)
        (goal SHADOW-PROD-FIRE-NAVY g:> 0)
        (goal SHADOW-PROD-DEMO-NAVY g:> 0)
        (goal SHADOW-PROD-IMPERIAL-NAVY g:> 0)
    )
    (building-type-count-total dock < 1)
    (up-pending-objects c: dock < 1)
    (can-build-with-escrow dock)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-SITE-STATE 1)
    (release-escrow wood)
    (set-escrow-percentage wood SHADOW-PROD-SITE-ESCROW-PERCENT)
    (build dock)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
)

;=============================================================
; STATIC TRAINING AUTHORITY
;=============================================================
;
; These rules are intentionally written as static dispatches. No goal
; value is passed as a unit id. This is the qualified path supported by
; the existing AI scripting model and avoids unverified dynamic-unit
; semantics.
;
; Rule order is the production admission priority when multiple domains
; share a production site. The first successful transaction claims the
; pass through SHADOW-PROD-LOCK.
;
;------------------------- Barracks -----------------------------

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total militia-line g:< SHADOW-PROD-INFANTRY)
    (can-train militia-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 400)
    (up-train SHADOW-PROD-ESCROW-STATE c: militia-line)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total spearman-line g:< SHADOW-PROD-ANTI-CAVALRY)
    (can-train spearman-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 401)
    (up-train SHADOW-PROD-ESCROW-STATE c: spearman-line)
)

;------------------------- Archery Range ------------------------

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total archer-line g:< SHADOW-PROD-RANGED)
    (can-train archer-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 402)
    (up-train SHADOW-PROD-ESCROW-STATE c: archer-line)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total skirmisher-line g:< SHADOW-PROD-ANTI-RANGED)
    (can-train skirmisher-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 403)
    (up-train SHADOW-PROD-ESCROW-STATE c: skirmisher-line)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total cavalry-archer-line g:< SHADOW-PROD-MOBILE-RANGED)
    (can-train cavalry-archer-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 406)
    (up-train SHADOW-PROD-ESCROW-STATE c: cavalry-archer-line)
)

;------------------------- Stable -------------------------------

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total scout-line g:< SHADOW-PROD-LIGHT-CAVALRY)
    (can-train scout-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 404)
    (up-train SHADOW-PROD-ESCROW-STATE c: scout-line)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total knight-line g:< SHADOW-PROD-HEAVY-CAVALRY)
    (can-train knight-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 405)
    (up-train SHADOW-PROD-ESCROW-STATE c: knight-line)
)

;------------------------- Castle --------------------------------

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total cataphract g:< SHADOW-PROD-UNIQUE-CAVALRY)
    (can-train cataphract)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 407)
    (up-train SHADOW-PROD-ESCROW-STATE c: cataphract)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total trebuchet g:< SHADOW-PROD-CASTLE-SIEGE)
    (can-train trebuchet)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 412)
    (up-train SHADOW-PROD-ESCROW-STATE c: trebuchet)
)

;------------------------- Siege Workshop ------------------------

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total battering-ram-line g:< SHADOW-PROD-RAM-SIEGE)
    (can-train battering-ram-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 408)
    (up-train SHADOW-PROD-ESCROW-STATE c: battering-ram-line)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total mangonel-line g:< SHADOW-PROD-AREA-SIEGE)
    (can-train mangonel-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 409)
    (up-train SHADOW-PROD-ESCROW-STATE c: mangonel-line)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total scorpion-line g:< SHADOW-PROD-ANTI-MASS-SIEGE)
    (can-train scorpion-line)
