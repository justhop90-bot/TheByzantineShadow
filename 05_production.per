;=============================================================
; THE BYZANTINE SHADOW
; MODULE 05 -- PRODUCTION AUTHORITY
;=============================================================
;
; Production is an economic commitment consumer.
;
; AUTHORITY BOUNDARY
;   Composition Policy -> desired Spearman target
;   Production Authority -> reservation / admission / execution /
;                           completion / release
;
; Production Authority MUST NOT write the demand target.
;
; The composition-facing target is SHADOW-PROD-DEMAND-SPEAR.
; A target of 0 means no Spearman demand.
;
; Cost profile: goals 500-503 (food, wood, stone, gold).
; Production state: goal 507.
; Training escrow state: goal 508.
;
(defconst SHADOW-PROD-DEMAND-SPEAR 497)
(defconst SHADOW-PROD-COST-FOOD 500)
(defconst SHADOW-PROD-COST-WOOD 501)
(defconst SHADOW-PROD-COST-STONE 502)
(defconst SHADOW-PROD-COST-GOLD 503)
(defconst SHADOW-PROD-STATE 507)
(defconst SHADOW-PROD-ESCROW-STATE 508)

(defconst SHADOW-PROD-ACCUMULATING 1)
(defconst SHADOW-PROD-SATISFIED 2)
(defconst SHADOW-PROD-ESCROW-PERCENT 35)
(defconst SHADOW-PROD-BARRACKS-ESCROW-PERCENT 60)

;=============================================================
; INITIALIZATION
;=============================================================
;
; Cost data remains an engine-defined one-Spearman reference
; profile. Runtime affordability is established by up-can-train.
; The demand target is deliberately NOT initialized here: policy
; owns that goal.
;
(defrule
    (goal SHADOW-PROD-STATE -1)
=>
    (up-setup-cost-data 1 SHADOW-PROD-COST-FOOD)
    (up-add-object-cost c: spearman c: 1)
    (set-goal SHADOW-PROD-ESCROW-STATE escrow-included)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
)

;=============================================================
; NO ACTIVE SPEARMAN DEMAND
;=============================================================
;
; A zero target is a policy withdrawal. Production Authority does
; not create a transaction and releases only production-owned food/
; wood escrow that is no longer required.
;
(defrule
    (goal SHADOW-PROD-DEMAND-SPEAR 0)
    (goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
=>
    (release-escrow food)
    (release-escrow wood)
    (set-escrow-percentage food 0)
    (set-escrow-percentage wood 0)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
)

;=============================================================
; BARRACKS CAPITAL RESERVATION
;=============================================================
;
; Production Authority derives prerequisite demand from the policy
; target. Composition policy does not issue the build.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks < 1)
    (unit-type-count-total spearman-line g:< SHADOW-PROD-DEMAND-SPEAR)
    (up-pending-objects c: barracks < 1)
    (goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
=>
    (set-escrow-percentage wood SHADOW-PROD-BARRACKS-ESCROW-PERCENT)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
)

; Release the reserved wood only when this authority commitment is
; active and the engine says the barracks is executable.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks < 1)
    (unit-type-count-total spearman-line g:< SHADOW-PROD-DEMAND-SPEAR)
    (up-pending-objects c: barracks < 1)
    (goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
    (can-build-with-escrow barracks)
=>
    (release-escrow wood)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (build barracks)
)

;=============================================================
; PRODUCTION RESERVE ACQUISITION
;=============================================================
;
; Once the barracks exists, protect food and wood for the requested
; military commitment. Gold and stone remain outside this executor.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks > 0)
    (unit-type-count-total spearman-line g:< SHADOW-PROD-DEMAND-SPEAR)
    (goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
=>
    (set-escrow-percentage food SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
)

;=============================================================
; TRAINING ADMISSION / EXECUTION
;=============================================================
;
; Site readiness and affordability remain separate gates.
; up-train-site-ready uses the root Spearman object.
; up-can-train uses escrow-included through goal 508.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks > 0)
    (unit-type-count-total spearman-line g:< SHADOW-PROD-DEMAND-SPEAR)
    (goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
    (up-train-site-ready spearman)
    (up-can-train SHADOW-PROD-ESCROW-STATE c: spearman)
=>
    (release-escrow food)
    (release-escrow wood)
    (set-escrow-percentage food SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (up-train SHADOW-PROD-ESCROW-STATE c: spearman)
)

;=============================================================
; DEMAND COMPLETION / CAPITAL RELEASE
;=============================================================
;
; Composition policy owns the target. Production Authority observes
; the engine's current + queued total and declares the commitment
; satisfied only when the requested target is reached.
;
(defrule
    (unit-type-count-total spearman-line g:>= SHADOW-PROD-DEMAND-SPEAR)
    (goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
=>
    (release-escrow food)
    (release-escrow wood)
    (set-escrow-percentage food 0)
    (set-escrow-percentage wood 0)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
)

; A reduced target is handled as desired-state convergence, not
; implicit cancellation. Existing queue orders are not cancelled.
