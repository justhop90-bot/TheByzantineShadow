;------------------------- Monastery -----------------------------

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total monk g:< SHADOW-PROD-MONK)
    (can-train monk)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 413)
    (up-train SHADOW-PROD-ESCROW-STATE c: monk)
)

;------------------------- Dock ----------------------------------

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total galley-line g:< SHADOW-PROD-GALLEY-NAVY)
    (can-train galley-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 414)
    (up-train SHADOW-PROD-ESCROW-STATE c: galley-line)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total fire-ship-line g:< SHADOW-PROD-FIRE-NAVY)
    (can-train fire-ship-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 415)
    (up-train SHADOW-PROD-ESCROW-STATE c: fire-ship-line)
)

(defrule
    (goal SHADOW-PROD-LOCK 0)
    (unit-type-count-total demolition-ship-line g:< SHADOW-PROD-DEMO-NAVY)
    (can-train demolition-ship-line)
=>
    (set-goal SHADOW-PROD-LOCK 1)
    (set-goal SHADOW-PROD-ADMISSION 416)
