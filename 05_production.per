;=============================================================
; THE BYZANTINE SHADOW
; MODULE 05 -- PRODUCTION AUTHORITY
;=============================================================
;
; Production is an economic commitment consumer, not a teaching
; example.  The module owns the military production demand below,
; its production reserve, and the admission of training actions.
;
; Shadow principles used here:
;   - production demand is explicit
;   - existing + queued units count toward the target
;   - resources can be accumulated through escrow
;   - escrow is released only at an executable commitment point
;   - release is followed by the actual production action
;   - production feasibility remains an engine decision
;   - escrow is returned to its production posture after training
;   - satisfied demand releases only the resources this module owns
;
; Cost profile: goals 500-503 (food, wood, stone, gold).
; Production state: goal 507.
; Training escrow state: goal 508.
;
(defconst SHADOW-PROD-COST-FOOD 500)
(defconst SHADOW-PROD-COST-WOOD 501)
(defconst SHADOW-PROD-COST-STONE 502)
(defconst SHADOW-PROD-COST-GOLD 503)
(defconst SHADOW-PROD-STATE 507)
(defconst SHADOW-PROD-ESCROW-STATE 508)

(defconst SHADOW-PROD-ACCUMULATING 1)
(defconst SHADOW-PROD-SATISFIED 2)
(defconst SHADOW-PROD-SPEAR-TARGET 3)
(defconst SHADOW-PROD-ESCROW-PERCENT 35)

;=============================================================
; INITIALIZATION
;=============================================================
;
; Build the authoritative cost profile once.  The cost-data API
; stores four consecutive resource goals in FOOD/WOOD/STONE/GOLD
; order.  The profile is a static production package definition;
; it is not treated as runtime affordability evidence.
;
(defrule
    (goal SHADOW-PROD-STATE -1)
=>
    (up-setup-cost-data 1 SHADOW-PROD-COST-FOOD)
    (up-add-object-cost c: spearman-line c: SHADOW-PROD-SPEAR-TARGET)
    (set-goal SHADOW-PROD-ESCROW-STATE escrow-included)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
)

;=============================================================
; PRODUCTION RESERVE ACQUISITION
;=============================================================
;
; Once the Feudal military foundation exists, accumulate food and
; wood for the spear commitment.  Gold and stone remain untouched:
; this module does not claim those escrow resources.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks > 0)
    (unit-type-count-total spearman-line < SHADOW-PROD-SPEAR-TARGET)
    (goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
=>
    (set-escrow-percentage food SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
)

;=============================================================
; BARRACKS AUTHORITY
;=============================================================
;
; Production owns the barracks prerequisite for its own demand.
; The total count plus pending-object guard prevents duplicate
; construction requests.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks < 1)
    (unit-type-count-total spearman-line < SHADOW-PROD-SPEAR-TARGET)
    (up-pending-objects c: barracks < 1)
    (can-build barracks)
=>
    (build barracks)
)

;=============================================================
; TRAINING ADMISSION
;=============================================================
;
; up-can-train uses the explicit escrow state.  With
; escrow-included, the engine evaluates the committed escrow as
; available capital.  Training is admitted only when the engine
; itself confirms the unit can actually enter the queue.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks > 0)
    (unit-type-count-total spearman-line < SHADOW-PROD-SPEAR-TARGET)
    (goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
    (up-can-train SHADOW-PROD-ESCROW-STATE c: spearman-line)
=>
    ; Release the committed production capital into liquid resources.
    (release-escrow food)
    (release-escrow wood)
    ; Immediately restore the production saving posture for the next unit.
    (set-escrow-percentage food SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (up-train SHADOW-PROD-ESCROW-STATE c: spearman-line)
)

;=============================================================
; DEMAND COMPLETION / CAPITAL RELEASE
;=============================================================
;
; unit-type-count-total includes queued units, so reaching the target
; means the production commitment is actually represented in the
; engine queue or completed army.  Release only the resources owned
; by this production authority.
;
(defrule
    (unit-type-count-total spearman-line >= SHADOW-PROD-SPEAR-TARGET)
    (goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
=>
    (release-escrow food)
    (release-escrow wood)
    (set-escrow-percentage food 0)
    (set-escrow-percentage wood 0)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
)

;=============================================================
; PRODUCTION RECOVERY
;=============================================================
;
; If committed units later fall below the target, production can
; re-enter accumulation without requiring a separate reset path.
;
(defrule
    (current-age >= feudal-age)
    (building-type-count-total barracks > 0)
    (unit-type-count-total spearman-line < SHADOW-PROD-SPEAR-TARGET)
    (goal SHADOW-PROD-STATE SHADOW-PROD-SATISFIED)
=>
    (set-escrow-percentage food SHADOW-PROD-ESCROW-PERCENT)
    (set-escrow-percentage wood SHADOW-PROD-ESCROW-PERCENT)
    (set-goal SHADOW-PROD-STATE SHADOW-PROD-ACCUMULATING)
)
