; ============================================================
; REQUIREMENT PRESENCE
; ============================================================

(defrule
    (true)
=>
    (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-INACTIVE)
)

(defrule (up-compare-goal SHADOW-REQ-DEFICIT-INFANTRY > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-ANTI-CAVALRY > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-RANGED > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-ANTI-RANGED > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-LIGHT-CAVALRY > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-HEAVY-CAVALRY > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-CAMEL > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-MOBILE-RANGED > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-UNIQUE-CAVALRY > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-RAM-SIEGE > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-AREA-SIEGE > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-ANTI-MASS-SIEGE > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-SIEGE-TOWER > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-GUNPOWDER-SIEGE > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-CASTLE-SIEGE > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-MONK > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-HAND-CANNONEER > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-GALLEY-NAVY > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-FIRE-NAVY > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-DEMO-NAVY > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-IMPERIAL-NAVY > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))
(defrule (up-compare-goal SHADOW-REQ-DEFICIT-PETARD > 0) => (set-goal SHADOW-REQ-ACTIVE SHADOW-REQ-ACTIVE-VALUE))

; ============================================================
; ENGINE COST AGGREGATION
; ============================================================
;
; One four-goal cost vector is materialized from all current deficits.
; The object costs are read from the engine, not hard-coded here.
;
; Cost vector: 500 food / 501 wood / 502 stone / 503 gold.
; This vector is consumed by later capital-feasibility logic.
;
(defrule
    (true)
=>
    (up-setup-cost-data 1 SHADOW-PROD-COST-FOOD)
    (up-add-object-cost c: militia-line g: SHADOW-REQ-DEFICIT-INFANTRY)
    (up-add-object-cost c: spearman-line g: SHADOW-REQ-DEFICIT-ANTI-CAVALRY)
    (up-add-object-cost c: archer-line g: SHADOW-REQ-DEFICIT-RANGED)
    (up-add-object-cost c: skirmisher-line g: SHADOW-REQ-DEFICIT-ANTI-RANGED)
    (up-add-object-cost c: scout-cavalry-line g: SHADOW-REQ-DEFICIT-LIGHT-CAVALRY)
    (up-add-object-cost c: knight-line g: SHADOW-REQ-DEFICIT-HEAVY-CAVALRY)
    (up-add-object-cost c: camel-line g: SHADOW-REQ-DEFICIT-CAMEL)
    (up-add-object-cost c: cavalry-archer-line g: SHADOW-REQ-DEFICIT-MOBILE-RANGED)
    (up-add-object-cost c: cataphract-line g: SHADOW-REQ-DEFICIT-UNIQUE-CAVALRY)
    (up-add-object-cost c: battering-ram-line g: SHADOW-REQ-DEFICIT-RAM-SIEGE)
    (up-add-object-cost c: mangonel-line g: SHADOW-REQ-DEFICIT-AREA-SIEGE)
    (up-add-object-cost c: scorpion-line g: SHADOW-REQ-DEFICIT-ANTI-MASS-SIEGE)
    (up-add-object-cost c: siege-tower g: SHADOW-REQ-DEFICIT-SIEGE-TOWER)
    (up-add-object-cost c: bombard-cannon g: SHADOW-REQ-DEFICIT-GUNPOWDER-SIEGE)
    (up-add-object-cost c: trebuchet-set g: SHADOW-REQ-DEFICIT-CASTLE-SIEGE)
    (up-add-object-cost c: monk-set g: SHADOW-REQ-DEFICIT-MONK)
    (up-add-object-cost c: hand-cannoneer g: SHADOW-REQ-DEFICIT-HAND-CANNONEER)
    (up-add-object-cost c: galley-line g: SHADOW-REQ-DEFICIT-GALLEY-NAVY)
    (up-add-object-cost c: fire-ship-line g: SHADOW-REQ-DEFICIT-FIRE-NAVY)
    (up-add-object-cost c: demolition-ship-line g: SHADOW-REQ-DEFICIT-DEMO-NAVY)
    (up-add-object-cost c: dromon g: SHADOW-REQ-DEFICIT-IMPERIAL-NAVY)
    (up-add-object-cost c: petard g: SHADOW-REQ-DEFICIT-PETARD)
)

; ============================================================
; END MODULE 08
; ============================================================
