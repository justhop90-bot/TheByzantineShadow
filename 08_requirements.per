    (up-modify-goal SHADOW-REQ-DEFICIT-RANGED g:= SHADOW-PROD-RANGED)
    (up-modify-goal SHADOW-REQ-DEFICIT-RANGED c:- SHADOW-PROD-COUNT-RANGED)
    (up-modify-goal SHADOW-REQ-DEFICIT-RANGED c:max 0)
)

(defrule (true) =>
    (up-modify-goal SHADOW-REQ-DEFICIT-ANTI-RANGED g:= SHADOW-PROD-ANTI-RANGED)
