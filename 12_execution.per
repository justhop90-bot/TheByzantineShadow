; ============================================================
; THE BYZANTINE SHADOW
; MODULE 12 -- EXECUTION
; ============================================================
;
; Authority: issue engine construction commands only after construction
; authorization, escrow state, and placement validity are present.
;
; Shadow-derived engine contract:
;   up-can-build -> up-build
; with the escrow-state goal passed as the engine escrow mode.
;
; Sources document that up-build takes placement type, escrow-state goal,
; and building ID; place-point uses the current target point. Each build
; command below therefore has its corresponding up-can-build guard.
; ============================================================

; ------------------------------------------------------------
; INITIALIZATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-EXECUTION-STATE -1)
=>
    (set-goal BYZ-EXECUTION-STATE BYZ-EXECUTION-IDLE)
    (set-goal BYZ-EXECUTION-PENDING BYZ-EXECUTION-IDLE)
)

; ------------------------------------------------------------
; PREPARE ESCROW-INCLUSIVE EXECUTION
; ------------------------------------------------------------
; The escrow mode is a command parameter, not an escrow balance.
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-EXECUTING)
    (goal BYZ-AUTHORITY-STATE BYZ-AUTHORITY-GRANTED)
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-COMMITTED)
    (goal BYZ-TARGET-STATE BYZ-TARGET-VALID)
    (goal BYZ-EXECUTION-STATE BYZ-EXECUTION-IDLE)
=>
    (set-goal BYZ-ESCROW-STATE BYZ-ESCROW-INCLUDED)
    (set-goal BYZ-EXECUTION-STATE BYZ-EXECUTION-READY)
)

; ------------------------------------------------------------
; NORMAL-PLACEMENT EXECUTION
; ------------------------------------------------------------
; Current build item is a goal value; each engine object is therefore
; dispatched through a target-specific rule rather than pretending that
; a goal value can be passed as a dynamic object constant.

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-EXECUTING)
    (goal BYZ-EXECUTION-STATE BYZ-EXECUTION-READY)
    (goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
    (goal BYZ-CURRENT-BUILD-ITEM house)
    (up-can-build BYZ-ESCROW-STATE c:< house)
=>
    (up-build place-normal BYZ-ESCROW-STATE c:< house)
    (set-goal BYZ-EXECUTION-STATE BYZ-EXECUTION-ISSUED)
    (set-goal BYZ-EXECUTION-PENDING BYZ-EXECUTION-PENDING-VALUE)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-EXECUTING)
    (goal BYZ-EXECUTION-STATE BYZ-EXECUTION-READY)
    (goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
    (goal BYZ-CURRENT-BUILD-ITEM barracks)
    (up-can-build BYZ-ESCROW-STATE c:< barracks)
=>
    (up-build place-normal BYZ-ESCROW-STATE c:< barracks)
    (set-goal BYZ-EXECUTION-STATE BYZ-EXECUTION-ISSUED)
    (set-goal BYZ-EXECUTION-PENDING BYZ-EXECUTION-PENDING-VALUE)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-EXECUTING)
    (goal BYZ-EXECUTION-STATE BYZ-EXECUTION-READY)
    (goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
    (goal BYZ-CURRENT-BUILD-ITEM lumber-camp)
    (up-can-build BYZ-ESCROW-STATE c:< lumber-camp)
=>
    (up-build place-normal BYZ-ESCROW-STATE c:< lumber-camp)
