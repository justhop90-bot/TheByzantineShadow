    (goal BYZ-EXECUTION-STATE BYZ-EXECUTION-READY)
    (goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
    (goal BYZ-CURRENT-BUILD-ITEM university)
    (up-can-build BYZ-ESCROW-STATE c:< university)
