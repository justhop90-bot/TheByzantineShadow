; ============================================
; AEGIS PROOF OF CONCEPT
; MODULE 07 — STRATEGIC RESERVE
; ============================================
;
; PURPOSE
; -------
; Derive resource-specific strategic reserves
; from current engine state and explicit AEGIS
; reserve policy.
;
; ARCHITECTURE
; ------------
; ENGINE STATE
;     |
;     +-- current-age
;     |
;     +-- military-population
;     |
;     v
; RESERVE POLICY
;     |
;     v
; RESOURCE-SPECIFIC RESERVE
;     |
;     v
; MODULE 09
; LIQUID - RESERVE = DISCRETIONARY
;
; IMPORTANT
; ---------
; Strategic reserve is NOT engine escrow.
;
; Engine escrow = committed capital.
; Strategic reserve = capital AEGIS deliberately
; protects from discretionary allocation.
;
; Constants are declared centrally in
; 01_constants.per.
;
; This module does NOT:
;   - modify engine escrow
;   - build
;   - train
;   - research
;   - authorize a transaction
;   - execute a transaction
;
; ============================================


; ============================================
; INITIALIZE POLICY
; ============================================

(defrule
    (true)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-EARLY)
)


; ============================================
; DARK AGE
; ============================================
;
; Protect basic transition capital.
;
; ============================================

(defrule
    (current-age == dark-age)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-EARLY)
)

(defrule
    (current-age == feudal-age)
    (military-population < 6)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-DEVELOPMENT)
)

(defrule
    (current-age == feudal-age)
    (military-population >= 6)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-MILITARY)
)

(defrule
    (current-age == castle-age)
    (military-population < 12)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-DEVELOPMENT)
)

(defrule
    (current-age == castle-age)
    (military-population >= 12)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-MILITARY)
)

(defrule
    (current-age == imperial-age)
=>
    (set-goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-LATE)
)


; ============================================
; APPLY EARLY RESERVE
; ============================================

(defrule
    (goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-EARLY)
=>
    (set-goal AEGIS-RESERVE-FOOD AEGIS-EARLY-FOOD-RESERVE)
    (set-goal AEGIS-RESERVE-WOOD AEGIS-EARLY-WOOD-RESERVE)
    (set-goal AEGIS-RESERVE-GOLD AEGIS-EARLY-GOLD-RESERVE)
    (set-goal AEGIS-RESERVE-STONE AEGIS-EARLY-STONE-RESERVE)
)


; ============================================
; APPLY DEVELOPMENT RESERVE
; ============================================

(defrule
    (goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-DEVELOPMENT)
=>
    (set-goal AEGIS-RESERVE-FOOD AEGIS-DEVELOPMENT-FOOD-RESERVE)
    (set-goal AEGIS-RESERVE-WOOD AEGIS-DEVELOPMENT-WOOD-RESERVE)
    (set-goal AEGIS-RESERVE-GOLD AEGIS-DEVELOPMENT-GOLD-RESERVE)
    (set-goal AEGIS-RESERVE-STONE AEGIS-DEVELOPMENT-STONE-RESERVE)
)


; ============================================
; APPLY MILITARY RESERVE
; ============================================

(defrule
    (goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-MILITARY)
=>
    (set-goal AEGIS-RESERVE-FOOD AEGIS-MILITARY-FOOD-RESERVE)
    (set-goal AEGIS-RESERVE-WOOD AEGIS-MILITARY-WOOD-RESERVE)
    (set-goal AEGIS-RESERVE-GOLD AEGIS-MILITARY-GOLD-RESERVE)
    (set-goal AEGIS-RESERVE-STONE AEGIS-MILITARY-STONE-RESERVE)
)


; ============================================
; APPLY LATE RESERVE
; ============================================

(defrule
    (goal AEGIS-RESERVE-POLICY AEGIS-RESERVE-LATE)
=>
    (set-goal AEGIS-RESERVE-FOOD AEGIS-LATE-FOOD-RESERVE)
    (set-goal AEGIS-RESERVE-WOOD AEGIS-LATE-WOOD-RESERVE)
    (set-goal AEGIS-RESERVE-GOLD AEGIS-LATE-GOLD-RESERVE)
    (set-goal AEGIS-RESERVE-STONE AEGIS-LATE-STONE-RESERVE)
)
