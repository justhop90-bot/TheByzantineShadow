; ============================================================
; THE BYZANTINE SHADOW
; MODULE 07 -- STRATEGIC RESERVE
; ============================================================
;
; PURPOSE
; -------
; Establish the capital floor that downstream economic and
; authority modules must protect before discretionary allocation.
;
; ARCHITECTURE
; ------------
; ENGINE AGE + MILITARY POSTURE
;            |
;            v
;     RESERVE POLICY STATE
;            |
;            v
; RESOURCE-SPECIFIC RESERVE FLOORS
;
; Strategic reserve is NOT engine escrow.
; Escrow represents capital already committed by the engine.
; These goals represent capital Shadow deliberately protects
; from discretionary allocation.
;
; This module does NOT:
;   - modify engine escrow
;   - build
;   - train
;   - research
;   - execute production
;   - authorize a transaction
;   - release escrow
;
; ============================================================

; ------------------------------------------------------------
; INITIALIZATION
; ------------------------------------------------------------

(defrule
    (goal SHADOW-RESERVE-INITIALIZED -1)
=>
    (set-goal SHADOW-RESERVE-INITIALIZED 1)
    (set-goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-TRANSITION)
    (set-goal SHADOW-RESERVE-FOOD SHADOW-RESERVE-TRANSITION-FOOD)
    (set-goal SHADOW-RESERVE-WOOD SHADOW-RESERVE-TRANSITION-WOOD)
    (set-goal SHADOW-RESERVE-GOLD SHADOW-RESERVE-TRANSITION-GOLD)
    (set-goal SHADOW-RESERVE-STONE SHADOW-RESERVE-TRANSITION-STONE)
)

; ------------------------------------------------------------
; POLICY SELECTION
; ------------------------------------------------------------
;
; Precedence is encoded by mutually exclusive state predicates:
;
;   IMPERIAL/LATE
;       > MILITARY POSTURE
;       > DEVELOPMENT
;       > TRANSITION
;
; Military posture is consumed only after Module 06 has classified it.
; No resource side effect occurs here.

(defrule
    (current-age == dark-age)
=>
    (set-goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-TRANSITION)
)

(defrule
    (current-age == feudal-age)
    (goal SHADOW-MIL-POSTURE SHADOW-MIL-POSTURE-BUILDUP)
=>
    (set-goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-DEVELOPMENT)
)

(defrule
    (current-age == feudal-age)
    (or
        (goal SHADOW-MIL-POSTURE SHADOW-MIL-POSTURE-DEFENSIVE)
        (goal SHADOW-MIL-POSTURE SHADOW-MIL-POSTURE-ATTACK-READY)
        (goal SHADOW-MIL-POSTURE SHADOW-MIL-POSTURE-EMERGENCY))
=>
    (set-goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-MILITARY)
)

(defrule
    (current-age == castle-age)
    (goal SHADOW-MIL-POSTURE SHADOW-MIL-POSTURE-BUILDUP)
=>
    (set-goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-DEVELOPMENT)
)

(defrule
    (current-age == castle-age)
    (or
        (goal SHADOW-MIL-POSTURE SHADOW-MIL-POSTURE-DEFENSIVE)
        (goal SHADOW-MIL-POSTURE SHADOW-MIL-POSTURE-ATTACK-READY)
        (goal SHADOW-MIL-POSTURE SHADOW-MIL-POSTURE-EMERGENCY))
=>
    (set-goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-MILITARY)
)

(defrule
    (current-age == imperial-age)
=>
    (set-goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-LATE)
)

; ------------------------------------------------------------
; RESERVE MATERIALIZATION
; ------------------------------------------------------------
;
; Each policy writes all four resource floors. No partial policy
; is permitted to survive from a previous rule pass.

(defrule
    (goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-TRANSITION)
=>
    (set-goal SHADOW-RESERVE-FOOD SHADOW-RESERVE-TRANSITION-FOOD)
    (set-goal SHADOW-RESERVE-WOOD SHADOW-RESERVE-TRANSITION-WOOD)
    (set-goal SHADOW-RESERVE-GOLD SHADOW-RESERVE-TRANSITION-GOLD)
    (set-goal SHADOW-RESERVE-STONE SHADOW-RESERVE-TRANSITION-STONE)
)

(defrule
    (goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-DEVELOPMENT)
=>
    (set-goal SHADOW-RESERVE-FOOD SHADOW-RESERVE-DEVELOPMENT-FOOD)
    (set-goal SHADOW-RESERVE-WOOD SHADOW-RESERVE-DEVELOPMENT-WOOD)
    (set-goal SHADOW-RESERVE-GOLD SHADOW-RESERVE-DEVELOPMENT-GOLD)
    (set-goal SHADOW-RESERVE-STONE SHADOW-RESERVE-DEVELOPMENT-STONE)
)

(defrule
    (goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-MILITARY)
=>
    (set-goal SHADOW-RESERVE-FOOD SHADOW-RESERVE-MILITARY-FOOD)
    (set-goal SHADOW-RESERVE-WOOD SHADOW-RESERVE-MILITARY-WOOD)
    (set-goal SHADOW-RESERVE-GOLD SHADOW-RESERVE-MILITARY-GOLD)
    (set-goal SHADOW-RESERVE-STONE SHADOW-RESERVE-MILITARY-STONE)
)

(defrule
    (goal SHADOW-RESERVE-POLICY SHADOW-RESERVE-POLICY-LATE)
=>
    (set-goal SHADOW-RESERVE-FOOD SHADOW-RESERVE-LATE-FOOD)
    (set-goal SHADOW-RESERVE-WOOD SHADOW-RESERVE-LATE-WOOD)
    (set-goal SHADOW-RESERVE-GOLD SHADOW-RESERVE-LATE-GOLD)
    (set-goal SHADOW-RESERVE-STONE SHADOW-RESERVE-LATE-STONE)
)
