; ============================================================
; THE BYZANTINE SHADOW
; MODULE 13 -- VERIFICATION
; ============================================================
;
; Authority: world-state verification for construction transactions.
;
; Core invariant:
;   command issued != pending != completion
;
; Target-specific observers provide BYZ-VERIFY-OBSERVATION-READY only
; after collecting admissible world-state evidence. This module does not
; assume that a build command or pending placement proves completion.
; ============================================================

; ------------------------------------------------------------
; INITIALIZATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-VERIFY-STATE -1)
=>
    (set-goal BYZ-VERIFY-STATE BYZ-VERIFY-NOT-STARTED)
    (set-goal BYZ-VERIFY-OBSERVATION-READY 0)
)

; ------------------------------------------------------------
; EXECUTION -> PENDING VERIFICATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-VERIFY-STATE BYZ-VERIFY-NOT-STARTED)
=>
    (set-goal BYZ-VERIFY-STATE BYZ-VERIFY-PENDING)
)

; ------------------------------------------------------------
; OBSERVATION WINDOW
; ------------------------------------------------------------
(defrule
    (goal BYZ-VERIFY-STATE BYZ-VERIFY-PENDING)
    (goal BYZ-VERIFY-OBSERVATION-READY 1)
=>
    (set-goal BYZ-VERIFY-STATE BYZ-VERIFY-OBSERVING)
)

; ------------------------------------------------------------
; CONFIRMATION
; ------------------------------------------------------------
; The observation-ready marker is an interface from target-specific
; evidence collectors. It must not be set merely because execution ran.
(defrule
    (goal BYZ-VERIFY-STATE BYZ-VERIFY-OBSERVING)
    (goal BYZ-VERIFY-OBSERVATION-READY 1)
=>
    (set-goal BYZ-VERIFY-STATE BYZ-VERIFY-CONFIRMED)
)

; ------------------------------------------------------------
; VERIFIED CONSTRUCTION -> ESCROW RELEASE REQUEST
; ------------------------------------------------------------
; Release remains a separate action owned by Module 10.
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-COMPLETE)
    (goal BYZ-VERIFY-STATE BYZ-VERIFY-CONFIRMED)
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-COMMITTED)
=>
    (set-goal BYZ-ESCROW-RELEASE-REQUEST BYZ-ESCROW-RELEASE-YES)
)

; ------------------------------------------------------------
; CONTRADICTION / FAILURE
; ------------------------------------------------------------
; An explicit contradiction from a target observer is failure evidence,
; not a silent pass.
(defrule
    (goal BYZ-VERIFY-STATE BYZ-VERIFY-OBSERVING)
    (goal BYZ-VERIFY-OBSERVATION-READY 0)
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
=>
    (set-goal BYZ-VERIFY-STATE BYZ-VERIFY-CONTRADICTED)
)

; Authority loss while pending/observing invalidates the transaction.
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-AUTHORITY-STATE BYZ-AUTHORITY-DENIED)
=>
    (set-goal BYZ-VERIFY-STATE BYZ-VERIFY-FAILED)
)

; INVARIANTS:
; no command is completion evidence
; no pending object is completion evidence
; verification does not select strategy
; verification does not execute construction
; verification does not itself release escrow
; ============================================================
