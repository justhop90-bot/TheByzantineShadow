    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-CURRENT-BUILD-ITEM mining-camp)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count mining-camp g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-CURRENT-BUILD-ITEM archery-range)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count archery-range g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-CURRENT-BUILD-ITEM stable)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count stable g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-CURRENT-BUILD-ITEM blacksmith)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count blacksmith g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
