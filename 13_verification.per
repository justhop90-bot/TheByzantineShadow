; ============================================================
; THE BYZANTINE SHADOW
; MODULE 13 -- VERIFICATION
; ============================================================
;
; Authority: world-state verification for construction transactions.
;
; Core invariant:
;   command issued != pending != completion
;
; For ordinary buildings, verification uses a pre-execution baseline from
; building-type-count and requires the completed-building count to exceed
; that baseline. building-type-count-total is deliberately not used as
; completion evidence because it includes queued construction.
; ============================================================

; ------------------------------------------------------------
; INITIALIZATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-VERIFY-STATE -1)
=>
    (set-goal BYZ-VERIFY-STATE BYZ-VERIFY-NOT-STARTED)
    (set-goal BYZ-VERIFY-OBSERVATION-READY 0)
    (set-goal BYZ-VERIFY-CONTRADICTION 0)
    (set-goal BYZ-VERIFY-BASELINE 0)
    (set-goal BYZ-VERIFY-BASELINE-CAPTURED 0)
)

; ------------------------------------------------------------
; NEW TRANSACTION BASELINE
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-REQUESTED)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 0)
=>
    (set-goal BYZ-VERIFY-BASELINE-CAPTURED 0)
    (set-goal BYZ-VERIFY-OBSERVATION-READY 0)
    (set-goal BYZ-VERIFY-CONTRADICTION 0)
)

; ------------------------------------------------------------
; BASELINE CAPTURE -- STATIC OBJECT DISPATCH
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM house)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 0)
=>
    (up-get-fact building-type-count house BYZ-VERIFY-BASELINE)
    (set-goal BYZ-VERIFY-BASELINE-CAPTURED 1)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM barracks)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 0)
=>
    (up-get-fact building-type-count barracks BYZ-VERIFY-BASELINE)
    (set-goal BYZ-VERIFY-BASELINE-CAPTURED 1)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM lumber-camp)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 0)
=>
    (up-get-fact building-type-count lumber-camp BYZ-VERIFY-BASELINE)
    (set-goal BYZ-VERIFY-BASELINE-CAPTURED 1)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM mill)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 0)
=>
    (up-get-fact building-type-count mill BYZ-VERIFY-BASELINE)
    (set-goal BYZ-VERIFY-BASELINE-CAPTURED 1)
)

