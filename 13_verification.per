    (goal BYZ-CURRENT-BUILD-ITEM monastery)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count monastery g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
