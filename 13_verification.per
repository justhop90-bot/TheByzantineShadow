    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM farm)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 0)
=>
    (up-get-fact building-type-count farm BYZ-VERIFY-BASELINE)
    (set-goal BYZ-VERIFY-BASELINE-CAPTURED 1)
