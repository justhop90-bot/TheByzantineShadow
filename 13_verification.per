    (goal BYZ-VERIFY-BASELINE-CAPTURED 0)
=>
    (up-get-fact building-type-count blacksmith BYZ-VERIFY-BASELINE)
    (set-goal BYZ-VERIFY-BASELINE-CAPTURED 1)
