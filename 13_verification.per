    (goal BYZ-CURRENT-BUILD-ITEM castle)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count castle g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
