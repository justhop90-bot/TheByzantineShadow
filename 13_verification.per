    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM university)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 0)
=>
    (up-get-fact building-type-count university BYZ-VERIFY-BASELINE)
    (set-goal BYZ-VERIFY-BASELINE-CAPTURED 1)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM castle)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 0)
=>
    (up-get-fact building-type-count castle BYZ-VERIFY-BASELINE)
    (set-goal BYZ-VERIFY-BASELINE-CAPTURED 1)
)

; ------------------------------------------------------------
; PENDING -> VERIFICATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-VERIFY-STATE BYZ-VERIFY-NOT-STARTED)
=>
    (set-goal BYZ-VERIFY-STATE BYZ-VERIFY-PENDING)
)

; ------------------------------------------------------------
; WORLD-STATE OBSERVATION -- STATIC OBJECT DISPATCH
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-CURRENT-BUILD-ITEM house)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count house g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-CURRENT-BUILD-ITEM barracks)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count barracks g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-CURRENT-BUILD-ITEM lumber-camp)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count lumber-camp g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-CURRENT-BUILD-ITEM mill)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count mill g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
)

