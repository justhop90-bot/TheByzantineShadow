(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-PENDING)
    (goal BYZ-CURRENT-BUILD-ITEM market)
    (goal BYZ-VERIFY-BASELINE-CAPTURED 1)
    (building-type-count market g:> BYZ-VERIFY-BASELINE)
=>
    (set-goal BYZ-VERIFY-OBSERVATION-READY 1)
