; ============================================================
; THE BYZANTINE SHADOW
; MODULE 14 -- RECOVERY
; ============================================================
;
; Authority: recovery of divergent construction transactions.
;
; Recovery diagnoses and routes failure. It does not invent strategy,
; execute construction, or directly mutate engine escrow.
; ============================================================

; ------------------------------------------------------------
; INITIALIZATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-RECOVERY-STATE -1)
=>
    (set-goal BYZ-RECOVERY-STATE BYZ-RECOVERY-NONE)
    (set-goal BYZ-RECOVERY-CAUSE BYZ-RECOVERY-NONE)
)

; ------------------------------------------------------------
; DETECT FAILURE
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-FAILED)
    (goal BYZ-RECOVERY-STATE BYZ-RECOVERY-NONE)
=>
    (set-goal BYZ-RECOVERY-CAUSE BYZ-RECOVERY-CONSTRUCTION-FAILED)
    (set-goal BYZ-RECOVERY-STATE BYZ-RECOVERY-DETECTED)
)

(defrule
    (goal BYZ-VERIFY-STATE BYZ-VERIFY-CONTRADICTED)
    (goal BYZ-RECOVERY-STATE BYZ-RECOVERY-NONE)
=>
    (set-goal BYZ-RECOVERY-CAUSE BYZ-RECOVERY-VERIFICATION-CONTRADICTION)
    (set-goal BYZ-RECOVERY-STATE BYZ-RECOVERY-DETECTED)
)

; ------------------------------------------------------------
; DIAGNOSIS
; ------------------------------------------------------------
(defrule
    (goal BYZ-RECOVERY-STATE BYZ-RECOVERY-DETECTED)
=>
    (set-goal BYZ-RECOVERY-STATE BYZ-RECOVERY-DIAGNOSING)
)

; ------------------------------------------------------------
; ESCROW HANDOFF
; ------------------------------------------------------------
; Recovery requests release through Module 10. It never calls the
; engine release operation itself.
(defrule
    (goal BYZ-RECOVERY-STATE BYZ-RECOVERY-DIAGNOSING)
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-COMMITTED)
=>
    (set-goal BYZ-ESCROW-RELEASE-REQUEST BYZ-ESCROW-RELEASE-YES)
    (set-goal BYZ-RECOVERY-STATE BYZ-RECOVERY-ESCROW-RELEASE)
)

; If no escrow is committed, recovery can proceed to requeue/cancel
; without fabricating a release operation.
(defrule
    (goal BYZ-RECOVERY-STATE BYZ-RECOVERY-DIAGNOSING)
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-IDLE)
=>
    (set-goal BYZ-RECOVERY-STATE BYZ-RECOVERY-REQUEUE)
)

; ------------------------------------------------------------
; RELEASE CONFIRMATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-RECOVERY-STATE BYZ-RECOVERY-ESCROW-RELEASE)
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-RELEASED)
=>
    (set-goal BYZ-RECOVERY-STATE BYZ-RECOVERY-REQUEUE)
)

; ------------------------------------------------------------
; REQUEUE ONLY AFTER RECONCILIATION
; ------------------------------------------------------------
; Re-entry is handed back to construction policy. Recovery does not
; select the next building or assign a retry count.
(defrule
    (goal BYZ-RECOVERY-STATE BYZ-RECOVERY-REQUEUE)
    (goal BYZ-ESCROW-STATE BYZ-ESCROW-IDLE)
=>
    (set-goal BYZ-CONSTRUCTION-REQUEST BYZ-REQUEST-INACTIVE)
    (set-goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-IDLE)
    (set-goal BYZ-RECOVERY-STATE BYZ-RECOVERY-COMPLETE)
)

; ------------------------------------------------------------
; IDEMPOTENCE
; ------------------------------------------------------------
; Once recovery is complete, no further recovery action is issued until
; another transaction establishes a new failure state.
(defrule
    (goal BYZ-RECOVERY-STATE BYZ-RECOVERY-COMPLETE)
=>
    (set-goal BYZ-RECOVERY-STATE BYZ-RECOVERY-NONE)
    (set-goal BYZ-RECOVERY-CAUSE BYZ-RECOVERY-NONE)
)

; INVARIANTS:
; recovery does not choose strategy
; recovery does not execute construction
; recovery does not directly release escrow
; recovery re-enters only after state reconciliation
; repeated evaluation must not double-release or double-advance
; ============================================================
