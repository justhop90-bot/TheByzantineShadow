; ============================================================
; THE BYZANTINE SHADOW
; MODULE 07 -- PLACEMENT
; ============================================================
;
; Authority: placement-mode state, target handoff, and validation.
;
; Geometry, search radius, fail policy, and builder counts remain policy
; inputs. This module does not choose strategic objectives, grant
; authority, release escrow, execute build commands, or verify completion.
; ============================================================

; ------------------------------------------------------------
; INITIALIZATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-PLACEMENT-STATE -1)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
    (set-goal BYZ-TARGET-STATE BYZ-TARGET-NONE)
)

; ------------------------------------------------------------
; NEW REQUEST RESET
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-REQUESTED)
=>
    (set-goal BYZ-TARGET-STATE BYZ-TARGET-NONE)
)

; ------------------------------------------------------------
; SHADOW-DERIVED MINING-CAMP PLACEMENT CLASS
; ------------------------------------------------------------
; Shadow's resource-site construction uses explicit point resolution for
; mining camps. The target search itself remains policy-owned because its
; resource choice and geometric constraints are Byzantine strategy inputs.
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM mining-camp)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-POINT)
    (set-goal BYZ-TARGET-STATE BYZ-TARGET-NONE)
)

; All other currently supported construction targets use ordinary managed
; placement unless a future placement policy explicitly changes the mode.
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM house)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM barracks)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM lumber-camp)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM mill)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM farm)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM archery-range)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM stable)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM blacksmith)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM market)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM monastery)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM university)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-CURRENT-BUILD-ITEM castle)
=>
    (set-goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
)

; ------------------------------------------------------------
; NORMAL TARGET HANDOFF
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-PLACEMENT-STATE BYZ-PLACE-NORMAL)
=>
    (set-goal BYZ-TARGET-STATE BYZ-TARGET-VALID)
)

; ------------------------------------------------------------
; POINT TARGET HANDOFF
; ------------------------------------------------------------
; An upstream target resolver must establish BYZ-TARGET-POINT. This
; module converts that resolved point into a valid execution target.
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-PLACEMENT-STATE BYZ-PLACE-POINT)
    (goal BYZ-TARGET-STATE BYZ-TARGET-POINT)
=>
    (set-goal BYZ-TARGET-STATE BYZ-TARGET-VALID)
)

; ------------------------------------------------------------
; CONTROLLED TARGET HANDOFF
; ------------------------------------------------------------
(defrule
    (goal BYZ-CONSTRUCTION-STATE BYZ-CONSTRUCTION-AUTHORIZED)
    (goal BYZ-PLACEMENT-STATE BYZ-PLACE-CONTROL)
    (goal BYZ-TARGET-STATE BYZ-TARGET-CONTROL)
=>
    (set-goal BYZ-TARGET-STATE BYZ-TARGET-VALID)
)

; ------------------------------------------------------------
; INVALIDATION
; ------------------------------------------------------------
(defrule
    (goal BYZ-TARGET-STATE BYZ-TARGET-INVALID)
=>
    (set-goal BYZ-TARGET-STATE BYZ-TARGET-SEARCHING)
)

; INVARIANTS:
; placement != strategy
; placement != escrow
; placement != authority
; placement != execution
; placement != completion
; mining-camp uses point-placement semantics derived from Shadow
; ============================================================
